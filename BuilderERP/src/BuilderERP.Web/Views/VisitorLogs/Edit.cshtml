@model BuilderERP.Application.DTOs.UpdateVisitorLogDto
@{
    ViewData["Title"] = "Edit Visitor Log";
}

<h1 class="h3 mb-4">Edit Visitor Log</h1>

<form asp-action="Edit" method="post" class="col-md-6">
    <input type="hidden" asp-for="Id" />
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
    <div class="mb-3">
        <label asp-for="ProjectId" class="form-label">Project</label>
        <select asp-for="ProjectId" asp-items="ViewBag.Projects" class="form-select">
            <option value="">-- Select Project --</option>
        </select>
        <span asp-validation-for="ProjectId" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="VisitorName" class="form-label"></label>
        <input asp-for="VisitorName" class="form-control" />
        <span asp-validation-for="VisitorName" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Phone" class="form-label"></label>
        <input asp-for="Phone" class="form-control" />
        <span asp-validation-for="Phone" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="PurposeOfVisit" class="form-label"></label>
        <input asp-for="PurposeOfVisit" class="form-control" />
        <span asp-validation-for="PurposeOfVisit" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="HostName" class="form-label"></label>
        <input asp-for="HostName" class="form-control" />
        <span asp-validation-for="HostName" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="CheckInTime" class="form-label"></label>
        <input asp-for="CheckInTime" type="date" class="form-control" />
        <span asp-validation-for="CheckInTime" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="CheckOutTime" class="form-label"></label>
        <input asp-for="CheckOutTime" type="date" class="form-control" />
        <span asp-validation-for="CheckOutTime" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="IdProofNumber" class="form-label"></label>
        <input asp-for="IdProofNumber" class="form-control" />
        <span asp-validation-for="IdProofNumber" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="VehicleNumber" class="form-label"></label>
        <input asp-for="VehicleNumber" class="form-control" />
        <span asp-validation-for="VehicleNumber" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Remarks" class="form-label"></label>
        <textarea asp-for="Remarks" class="form-control"></textarea>
        <span asp-validation-for="Remarks" class="text-danger"></span>
    </div>
    <button type="submit" class="btn btn-primary">Save</button>
    <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
</form>
