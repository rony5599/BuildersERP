@using BuilderERP.Application.Common
@using BuilderERP.Shared.Constants
@using BuilderERP.Shared.Authorization
@model PagedResult<BuilderERP.Application.DTOs.VisitorLogDto>

<div class="table-responsive">
<table class="table table-striped table-hover bg-white">
    <thead>
        <tr>
            <th>Project</th>
            <th>Visitor Name</th>
            <th>Phone</th>
            <th>Purpose Of Visit</th>
            <th>Host Name</th>
            <th>Check In Time</th>
            <th>Active</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.Items)
        {
            <tr>
                <td>@item.ProjectName</td>
                <td>@item.VisitorName</td>
                <td>@item.Phone</td>
                <td>@item.PurposeOfVisit</td>
                <td>@item.HostName</td>
                <td>@item.CheckInTime</td>
                <td>
                    <span class="badge @(item.IsActive ? "bg-success" : "bg-secondary")">
                        @(item.IsActive ? "Active" : "Inactive")
                    </span>
                </td>
                <td class="text-end">
                    @if (User.HasClaim(PermissionClaimTypes.Permission, PermissionNames.VisitorLogManage))
                    {
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">Edit</a>
                        <form asp-action="ToggleActive" asp-route-id="@item.Id" asp-route-isActive="@item.IsActive" method="post" class="d-inline">
                            <button type="submit" class="btn btn-sm btn-outline-danger">
                                @(item.IsActive ? "Deactivate" : "Activate")
                            </button>
                        </form>
                    }
                </td>
            </tr>
        }
        @if (Model.Items.Count == 0)
        {
            <tr>
                <td colspan="7" class="text-center text-muted">No visitor logs found.</td>
            </tr>
        }
    </tbody>
</table>
</div>

<partial name="_Pagination" model="@(new BuilderERP.Web.Models.PaginationViewModel
{
    Page = Model.Page,
    PageSize = Model.PageSize,
    TotalPages = Model.TotalPages,
    TotalCount = Model.TotalCount,
    Action = "Index",
    RouteValues = new()
})" />
