@model IReadOnlyList<BuilderERP.Application.DTOs.BuildingDto>
@using BuilderERP.Shared.Constants
@using BuilderERP.Shared.Authorization
@{
    ViewData["Title"] = "Buildings";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Buildings</h1>
    @if (User.HasClaim(PermissionClaimTypes.Permission, PermissionNames.BuildingManage))
    {
        <a asp-action="Create" asp-route-projectId="@ViewBag.SelectedProjectId" class="btn btn-primary">New Building</a>
    }
</div>

<form method="get" class="mb-3 col-md-4">
    <label class="form-label">Project</label>
    <select name="projectId" asp-items="ViewBag.Projects" class="form-select" onchange="this.form.submit()">
        <option value="">-- All Projects --</option>
    </select>
</form>

<table class="table table-striped table-hover bg-white">
    <thead>
        <tr>
            <th>Name</th>
            <th>Code</th>
            <th>Project</th>
            <th>Total Floors</th>
            <th>Status</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var building in Model)
        {
            <tr>
                <td>@building.Name</td>
                <td>@building.Code</td>
                <td>@building.ProjectName</td>
                <td>@building.TotalFloors</td>
                <td>
                    <span class="badge @(building.IsActive ? "bg-success" : "bg-secondary")">
                        @(building.IsActive ? "Active" : "Inactive")
                    </span>
                </td>
                <td class="text-end">
                    @if (User.HasClaim(PermissionClaimTypes.Permission, PermissionNames.BuildingManage))
                    {
                        <a asp-action="Edit" asp-route-id="@building.Id" class="btn btn-sm btn-outline-secondary">Edit</a>
                        <form asp-action="ToggleActive" asp-route-id="@building.Id" asp-route-isActive="@building.IsActive" method="post" class="d-inline">
                            <button type="submit" class="btn btn-sm btn-outline-danger">
                                @(building.IsActive ? "Deactivate" : "Activate")
                            </button>
                        </form>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>
