@model BuilderERP.Application.DTOs.CreateSnagItemDto
@using BuilderERP.Domain.Enums
@{
    ViewData["Title"] = "New Snag Item";
}

<h1 class="h3 mb-4">New Snag Item</h1>

<form asp-action="Create" method="post" class="col-md-6">
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
    <div class="mb-3">
        <label asp-for="PropertyUnitId" class="form-label">Property Unit</label>
        <select asp-for="PropertyUnitId" asp-items="ViewBag.PropertyUnits" class="form-select">
            <option value="">-- Select Property Unit --</option>
        </select>
        <span asp-validation-for="PropertyUnitId" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="SnagNumber" class="form-label"></label>
        <input asp-for="SnagNumber" class="form-control" />
        <span asp-validation-for="SnagNumber" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Description" class="form-label"></label>
        <textarea asp-for="Description" class="form-control"></textarea>
        <span asp-validation-for="Description" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Location" class="form-label"></label>
        <input asp-for="Location" class="form-control" />
        <span asp-validation-for="Location" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Severity" class="form-label"></label>
        <select asp-for="Severity" asp-items="Html.GetEnumSelectList<SnagSeverity>()" class="form-select"></select>
        <span asp-validation-for="Severity" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Status" class="form-label"></label>
        <select asp-for="Status" asp-items="Html.GetEnumSelectList<SnagStatus>()" class="form-select"></select>
        <span asp-validation-for="Status" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="ReportedDate" class="form-label"></label>
        <input asp-for="ReportedDate" type="date" class="form-control" />
        <span asp-validation-for="ReportedDate" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="ResolvedDate" class="form-label"></label>
        <input asp-for="ResolvedDate" type="date" class="form-control" />
        <span asp-validation-for="ResolvedDate" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Remarks" class="form-label"></label>
        <textarea asp-for="Remarks" class="form-control"></textarea>
        <span asp-validation-for="Remarks" class="text-danger"></span>
    </div>
    <button type="submit" class="btn btn-primary">Save</button>
    <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
</form>
