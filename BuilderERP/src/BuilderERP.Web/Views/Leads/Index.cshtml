@model IReadOnlyList<BuilderERP.Application.DTOs.LeadDto>
@using BuilderERP.Shared.Constants
@using BuilderERP.Shared.Authorization
@{
    ViewData["Title"] = "Leads";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Leads</h1>
    @if (User.HasClaim(PermissionClaimTypes.Permission, PermissionNames.LeadManage))
    {
        <a asp-action="Create" class="btn btn-primary">New Lead</a>
    }
</div>

<table class="table table-striped table-hover bg-white">
    <thead>
        <tr>
            <th>Name</th>
            <th>Phone</th>
            <th>Email</th>
            <th>Status</th>
            <th>Assigned To</th>
            <th>Active</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var lead in Model)
        {
            <tr>
                <td>@lead.Name</td>
                <td>@lead.Phone</td>
                <td>@lead.Email</td>
                <td>@lead.Status</td>
                <td>@lead.AssignedToUserName</td>
                <td>
                    <span class="badge @(lead.IsActive ? "bg-success" : "bg-secondary")">
                        @(lead.IsActive ? "Active" : "Inactive")
                    </span>
                </td>
                <td class="text-end">
                    @if (User.HasClaim(PermissionClaimTypes.Permission, PermissionNames.LeadManage))
                    {
                        <a asp-action="Edit" asp-route-id="@lead.Id" class="btn btn-sm btn-outline-secondary">Edit</a>
                        <form asp-action="ToggleActive" asp-route-id="@lead.Id" asp-route-isActive="@lead.IsActive" method="post" class="d-inline">
                            <button type="submit" class="btn btn-sm btn-outline-danger">
                                @(lead.IsActive ? "Deactivate" : "Activate")
                            </button>
                        </form>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>
