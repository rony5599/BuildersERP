@model BuilderERP.Application.DTOs.CreateMaintenanceRequestDto
@using BuilderERP.Domain.Enums
@{
    ViewData["Title"] = "New Maintenance Request";
}

<h1 class="h3 mb-4">New Maintenance Request</h1>

<form asp-action="Create" method="post" class="col-md-6">
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
    <div class="mb-3">
        <label asp-for="PropertyUnitId" class="form-label">Property Unit</label>
        <select asp-for="PropertyUnitId" asp-items="ViewBag.PropertyUnits" class="form-select">
            <option value="">-- Select Property Unit --</option>
        </select>
        <span asp-validation-for="PropertyUnitId" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="RequestNumber" class="form-label"></label>
        <input asp-for="RequestNumber" class="form-control" />
        <span asp-validation-for="RequestNumber" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="RequestType" class="form-label"></label>
        <select asp-for="RequestType" asp-items="Html.GetEnumSelectList<MaintenanceRequestType>()" class="form-select"></select>
        <span asp-validation-for="RequestType" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Description" class="form-label"></label>
        <textarea asp-for="Description" class="form-control"></textarea>
        <span asp-validation-for="Description" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Priority" class="form-label"></label>
        <select asp-for="Priority" asp-items="Html.GetEnumSelectList<RequestPriority>()" class="form-select"></select>
        <span asp-validation-for="Priority" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Status" class="form-label"></label>
        <select asp-for="Status" asp-items="Html.GetEnumSelectList<MaintenanceRequestStatus>()" class="form-select"></select>
        <span asp-validation-for="Status" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="RequestDate" class="form-label"></label>
        <input asp-for="RequestDate" type="date" class="form-control" />
        <span asp-validation-for="RequestDate" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="ResolvedDate" class="form-label"></label>
        <input asp-for="ResolvedDate" type="date" class="form-control" />
        <span asp-validation-for="ResolvedDate" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="AssignedTo" class="form-label"></label>
        <input asp-for="AssignedTo" class="form-control" />
        <span asp-validation-for="AssignedTo" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Remarks" class="form-label"></label>
        <textarea asp-for="Remarks" class="form-control"></textarea>
        <span asp-validation-for="Remarks" class="text-danger"></span>
    </div>
    <button type="submit" class="btn btn-primary">Save</button>
    <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
</form>
