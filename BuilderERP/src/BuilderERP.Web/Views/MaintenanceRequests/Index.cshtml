@model IReadOnlyList<BuilderERP.Application.DTOs.MaintenanceRequestDto>
@using BuilderERP.Shared.Constants
@using BuilderERP.Shared.Authorization
@{
    ViewData["Title"] = "Maintenance Requests";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Maintenance Requests</h1>
    @if (User.HasClaim(PermissionClaimTypes.Permission, PermissionNames.MaintenanceRequestManage))
    {
        <a asp-action="Create" class="btn btn-primary">New Maintenance Request</a>
    }
</div>

<div class="table-responsive">
<table class="table table-striped table-hover bg-white">
    <thead>
        <tr>
            <th>Property Unit</th>
            <th>Request Number</th>
            <th>Request Type</th>
            <th>Priority</th>
            <th>Status</th>
            <th>Request Date</th>
            <th>Active</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.PropertyUnitName</td>
                <td>@item.RequestNumber</td>
                <td>@item.RequestType</td>
                <td>@item.Priority</td>
                <td>@item.Status</td>
                <td>@item.RequestDate</td>
                <td>
                    <span class="badge @(item.IsActive ? "bg-success" : "bg-secondary")">
                        @(item.IsActive ? "Active" : "Inactive")
                    </span>
                </td>
                <td class="text-end">
                    @if (User.HasClaim(PermissionClaimTypes.Permission, PermissionNames.MaintenanceRequestManage))
                    {
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">Edit</a>
                        <form asp-action="ToggleActive" asp-route-id="@item.Id" asp-route-isActive="@item.IsActive" method="post" class="d-inline">
                            <button type="submit" class="btn btn-sm btn-outline-danger">
                                @(item.IsActive ? "Deactivate" : "Activate")
                            </button>
                        </form>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>
</div>
