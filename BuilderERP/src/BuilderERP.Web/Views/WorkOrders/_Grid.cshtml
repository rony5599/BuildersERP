@using BuilderERP.Application.Common
@using BuilderERP.Shared.Constants
@using BuilderERP.Shared.Authorization
@using BuilderERP.Domain.Enums
@model PagedResult<BuilderERP.Application.DTOs.WorkOrderDto>
@{
    string StatusBadgeClass(WorkOrderStatus status) => status switch
    {
        WorkOrderStatus.Draft => "bg-secondary",
        WorkOrderStatus.Issued => "bg-info",
        WorkOrderStatus.InProgress => "bg-primary",
        WorkOrderStatus.Completed => "bg-success",
        WorkOrderStatus.Cancelled => "bg-danger",
        _ => "bg-secondary"
    };
}

<table class="table table-striped table-hover bg-white">
    <thead>
        <tr>
            <th>WO #</th>
            <th>Contractor</th>
            <th>Project</th>
            <th>Order Date</th>
            <th>Amount</th>
            <th>Status</th>
            <th>Active</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var workOrder in Model.Items)
        {
            <tr>
                <td>@workOrder.WorkOrderNumber</td>
                <td>@workOrder.ContractorName</td>
                <td>@workOrder.ProjectName</td>
                <td>@workOrder.OrderDate.ToString("yyyy-MM-dd")</td>
                <td>@workOrder.Amount</td>
                <td>
                    <span class="badge @StatusBadgeClass(workOrder.Status)">@workOrder.Status</span>
                </td>
                <td>
                    <span class="badge @(workOrder.IsActive ? "bg-success" : "bg-secondary")">
                        @(workOrder.IsActive ? "Active" : "Inactive")
                    </span>
                </td>
                <td class="text-end">
                    @if (User.HasClaim(PermissionClaimTypes.Permission, PermissionNames.WorkOrderManage))
                    {
                        <a asp-action="Edit" asp-route-id="@workOrder.Id" class="btn btn-sm btn-outline-secondary">Edit</a>
                        <form asp-action="ToggleActive" asp-route-id="@workOrder.Id" asp-route-isActive="@workOrder.IsActive" method="post" class="d-inline">
                            <button type="submit" class="btn btn-sm btn-outline-danger">
                                @(workOrder.IsActive ? "Deactivate" : "Activate")
                            </button>
                        </form>
                    }
                </td>
            </tr>
        }
        @if (Model.Items.Count == 0)
        {
            <tr>
                <td colspan="8" class="text-center text-muted">No work orders found.</td>
            </tr>
        }
    </tbody>
</table>

<partial name="_Pagination" model="@(new BuilderERP.Web.Models.PaginationViewModel
{
    Page = Model.Page,
    PageSize = Model.PageSize,
    TotalPages = Model.TotalPages,
    TotalCount = Model.TotalCount,
    Action = "Index",
    RouteValues = new()
})" />
