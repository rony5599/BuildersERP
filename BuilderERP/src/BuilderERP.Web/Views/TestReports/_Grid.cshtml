@using BuilderERP.Application.Common
@using BuilderERP.Shared.Constants
@using BuilderERP.Shared.Authorization
@using BuilderERP.Domain.Enums
@model PagedResult<BuilderERP.Application.DTOs.TestReportDto>

<table class="table table-striped table-hover bg-white">
    <thead>
        <tr>
            <th>Report Number</th>
            <th>Project</th>
            <th>Material</th>
            <th>Test Type</th>
            <th>Test Date</th>
            <th>Lab Name</th>
            <th>Result</th>
            <th>File</th>
            <th>Active</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.Items)
        {
            <tr>
                <td>@item.ReportNumber</td>
                <td>@item.ProjectName</td>
                <td>@(item.MaterialName ?? "—")</td>
                <td>@item.TestType</td>
                <td>@item.TestDate.ToString("yyyy-MM-dd")</td>
                <td>@item.LabName</td>
                <td>
                    @{
                        var resultBadge = item.Result switch
                        {
                            QcResult.Pass => "bg-success",
                            QcResult.Fail => "bg-danger",
                            _ => "bg-secondary"
                        };
                    }
                    <span class="badge @resultBadge">@item.Result</span>
                </td>
                <td><a href="@item.FilePath" target="_blank">View</a></td>
                <td>
                    <span class="badge @(item.IsActive ? "bg-success" : "bg-secondary")">
                        @(item.IsActive ? "Active" : "Inactive")
                    </span>
                </td>
                <td class="text-end">
                    @if (User.HasClaim(PermissionClaimTypes.Permission, PermissionNames.TestReportManage))
                    {
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">Edit</a>
                        <form asp-action="ToggleActive" asp-route-id="@item.Id" asp-route-isActive="@item.IsActive" method="post" class="d-inline">
                            <button type="submit" class="btn btn-sm btn-outline-danger">
                                @(item.IsActive ? "Deactivate" : "Activate")
                            </button>
                        </form>
                    }
                </td>
            </tr>
        }
        @if (Model.Items.Count == 0)
        {
            <tr>
                <td colspan="10" class="text-center text-muted">No test reports found.</td>
            </tr>
        }
    </tbody>
</table>

<partial name="_Pagination" model="@(new BuilderERP.Web.Models.PaginationViewModel
{
    Page = Model.Page,
    PageSize = Model.PageSize,
    TotalPages = Model.TotalPages,
    TotalCount = Model.TotalCount,
    Action = "Index",
    RouteValues = new Dictionary<string, string?> { ["projectId"] = ViewBag.SelectedProjectId?.ToString() }
})" />
