@model BuilderERP.Application.DTOs.CreateTestReportDto
@using BuilderERP.Domain.Enums
@{
    ViewData["Title"] = "New Test Report";
}

<h1 class="h3 mb-4">New Test Report</h1>

<form asp-action="Create" method="post" enctype="multipart/form-data" class="col-md-6">
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
    <div class="mb-3">
        <label asp-for="ProjectId" class="form-label"></label>
        <select asp-for="ProjectId" asp-items="ViewBag.Projects" class="form-select">
            <option value="">-- Select Project --</option>
        </select>
        <span asp-validation-for="ProjectId" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="MaterialId" class="form-label"></label>
        <select asp-for="MaterialId" asp-items="ViewBag.Materials" class="form-select">
            <option value="">-- None --</option>
        </select>
        <span asp-validation-for="MaterialId" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="ReportNumber" class="form-label"></label>
        <input asp-for="ReportNumber" class="form-control" />
        <span asp-validation-for="ReportNumber" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="TestType" class="form-label"></label>
        <input asp-for="TestType" class="form-control" />
        <span asp-validation-for="TestType" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="TestDate" class="form-label"></label>
        <input asp-for="TestDate" type="date" class="form-control" />
        <span asp-validation-for="TestDate" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="LabName" class="form-label"></label>
        <input asp-for="LabName" class="form-control" />
        <span asp-validation-for="LabName" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Result" class="form-label"></label>
        <select asp-for="Result" asp-items="Html.GetEnumSelectList<QcResult>()" class="form-select"></select>
        <span asp-validation-for="Result" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label class="form-label">Report File</label>
        <input type="file" name="file" class="form-control" />
    </div>
    <button type="submit" class="btn btn-primary">Save</button>
    <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
</form>
