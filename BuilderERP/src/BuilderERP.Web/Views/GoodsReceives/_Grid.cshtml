@using BuilderERP.Application.Common
@using BuilderERP.Shared.Constants
@using BuilderERP.Shared.Authorization
@model PagedResult<BuilderERP.Application.DTOs.GoodsReceiveDto>

<table class="table table-striped table-hover bg-white">
    <thead>
        <tr>
            <th>GRN #</th>
            <th>Purchase Order</th>
            <th>Received Amount</th>
            <th>Received Date</th>
            <th>Remarks</th>
            <th>Active</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var receive in Model.Items)
        {
            <tr>
                <td>@receive.GrnNumber</td>
                <td>@receive.PONumber</td>
                <td>@receive.ReceivedAmount</td>
                <td>@receive.ReceivedDate.ToString("yyyy-MM-dd")</td>
                <td>@receive.Remarks</td>
                <td>
                    <span class="badge @(receive.IsActive ? "bg-success" : "bg-secondary")">
                        @(receive.IsActive ? "Active" : "Inactive")
                    </span>
                </td>
                <td class="text-end">
                    @if (User.HasClaim(PermissionClaimTypes.Permission, PermissionNames.GoodsReceiveManage))
                    {
                        <a asp-action="Edit" asp-route-id="@receive.Id" class="btn btn-sm btn-outline-secondary">Edit</a>
                        <form asp-action="ToggleActive" asp-route-id="@receive.Id" asp-route-isActive="@receive.IsActive" method="post" class="d-inline">
                            <button type="submit" class="btn btn-sm btn-outline-danger">
                                @(receive.IsActive ? "Deactivate" : "Activate")
                            </button>
                        </form>
                    }
                </td>
            </tr>
        }
        @if (Model.Items.Count == 0)
        {
            <tr>
                <td colspan="7" class="text-center text-muted">No goods receives found.</td>
            </tr>
        }
    </tbody>
</table>

<partial name="_Pagination" model="@(new BuilderERP.Web.Models.PaginationViewModel
{
    Page = Model.Page,
    PageSize = Model.PageSize,
    TotalPages = Model.TotalPages,
    TotalCount = Model.TotalCount,
    Action = "Index",
    RouteValues = new()
})" />
