@model BuilderERP.Application.DTOs.UpdateGoodsReceiveDto
@using BuilderERP.Domain.Enums
@{
    ViewData["Title"] = "Edit Goods Receive";
}

<h1 class="h3 mb-4">Edit Goods Receive</h1>

<form asp-action="Edit" method="post">
    <input type="hidden" asp-for="Id" />
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
    <div class="row col-md-8">
        <div class="mb-3 col-md-4">
            <label asp-for="GrnNumber" class="form-label"></label>
            <input asp-for="GrnNumber" class="form-control" />
            <span asp-validation-for="GrnNumber" class="text-danger"></span>
        </div>
        <div class="mb-3 col-md-4">
            <label asp-for="PurchaseOrderId" class="form-label"></label>
            <select asp-for="PurchaseOrderId" asp-items="ViewBag.PurchaseOrders" class="form-select" id="purchaseOrderSelect">
                <option value="">-- Select Purchase Order --</option>
            </select>
            <span asp-validation-for="PurchaseOrderId" class="text-danger"></span>
        </div>
        <div class="mb-3 col-md-4">
            <label asp-for="WarehouseId" class="form-label"></label>
            <select asp-for="WarehouseId" asp-items="ViewBag.Warehouses" class="form-select">
                <option value="">-- Select Warehouse --</option>
            </select>
            <span asp-validation-for="WarehouseId" class="text-danger"></span>
        </div>
        <div class="mb-3 col-md-4">
            <label asp-for="Status" class="form-label"></label>
            <select asp-for="Status" asp-items="Html.GetEnumSelectList<GrnStatus>()" class="form-select"></select>
        </div>
        <div class="mb-3 col-md-4">
            <label asp-for="ReceivedDate" class="form-label"></label>
            <input asp-for="ReceivedDate" type="date" class="form-control" />
        </div>
        <div class="mb-3 col-md-8">
            <label asp-for="Remarks" class="form-label"></label>
            <textarea asp-for="Remarks" class="form-control"></textarea>
            <span asp-validation-for="Remarks" class="text-danger"></span>
        </div>
    </div>

    <div class="mb-2">
        <button type="button" class="btn btn-sm btn-outline-secondary" id="loadPoLinesBtn">Reload Open Lines from Purchase Order</button>
    </div>

    <h5 class="mt-3">Line Items</h5>
    <table class="table table-sm" id="grn-details-table">
        <thead>
            <tr>
                <th>PO Line</th>
                <th>Material</th>
                <th>Qty</th>
                <th>Unit</th>
                <th>Unit Price</th>
                <th>Batch #</th>
                <th>Serial #</th>
                <th>VAT %</th>
                <th>Tax %</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @for (var i = 0; i < Model.Details.Count; i++)
            {
                <tr class="detail-row">
                    <td>
                        <input type="hidden" name="Details[@i].PurchaseOrderDetailId" class="po-detail-id" value="@Model.Details[i].PurchaseOrderDetailId" />
                        <input type="hidden" name="Details[@i].MaterialId" class="material-id" value="@Model.Details[i].MaterialId" />
                        <span class="po-line-label text-muted small">line</span>
                    </td>
                    <td><span class="material-name"></span></td>
                    <td><input name="Details[@i].ReceivedQuantity" type="number" step="0.001" value="@Model.Details[i].ReceivedQuantity" class="form-control form-control-sm" /></td>
                    <td>
                        <select name="Details[@i].UnitOfMeasure" asp-items="Html.GetEnumSelectList<UnitOfMeasure>()" class="form-select form-select-sm"></select>
                    </td>
                    <td><input name="Details[@i].UnitPrice" type="number" step="0.01" value="@Model.Details[i].UnitPrice" class="form-control form-control-sm" /></td>
                    <td><input name="Details[@i].BatchNo" value="@Model.Details[i].BatchNo" class="form-control form-control-sm" /></td>
                    <td><input name="Details[@i].SerialNo" value="@Model.Details[i].SerialNo" class="form-control form-control-sm" /></td>
                    <td><input name="Details[@i].VatPercent" type="number" step="0.01" value="@Model.Details[i].VatPercent" class="form-control form-control-sm" /></td>
                    <td><input name="Details[@i].TaxPercent" type="number" step="0.01" value="@Model.Details[i].TaxPercent" class="form-control form-control-sm" /></td>
                    <td><button type="button" class="btn btn-sm btn-outline-danger" data-remove-row>Remove</button></td>
                </tr>
            }
            <tr class="detail-row-template">
                <td>
                    <input type="hidden" name="Details[__index__].PurchaseOrderDetailId" class="po-detail-id" />
                    <input type="hidden" name="Details[__index__].MaterialId" class="material-id" />
                    <span class="po-line-label text-muted small">-- pick from list --</span>
                </td>
                <td><span class="material-name"></span></td>
                <td><input name="Details[__index__].ReceivedQuantity" type="number" step="0.001" class="form-control form-control-sm" /></td>
                <td>
                    <select name="Details[__index__].UnitOfMeasure" asp-items="Html.GetEnumSelectList<UnitOfMeasure>()" class="form-select form-select-sm"></select>
                </td>
                <td><input name="Details[__index__].UnitPrice" type="number" step="0.01" class="form-control form-control-sm" /></td>
                <td><input name="Details[__index__].BatchNo" class="form-control form-control-sm" /></td>
                <td><input name="Details[__index__].SerialNo" class="form-control form-control-sm" /></td>
                <td><input name="Details[__index__].VatPercent" type="number" step="0.01" value="0" class="form-control form-control-sm" /></td>
                <td><input name="Details[__index__].TaxPercent" type="number" step="0.01" value="0" class="form-control form-control-sm" /></td>
                <td><button type="button" class="btn btn-sm btn-outline-danger" data-remove-row>Remove</button></td>
            </tr>
        </tbody>
    </table>

    <div>
        <button type="submit" class="btn btn-primary">Save</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
    </div>
</form>

<partial name="_DetailLineItemsScripts" />
<script>
    document.addEventListener('DOMContentLoaded', function () {
        initDetailTable('grn-details-table', 'Details');

        document.getElementById('loadPoLinesBtn').addEventListener('click', function () {
            var poId = document.getElementById('purchaseOrderSelect').value;
            if (!poId) {
                alert('Select a purchase order first.');
                return;
            }

            fetch('@Url.Action("GetOpenPurchaseOrderLines")?purchaseOrderId=' + poId)
                .then(function (r) { return r.json(); })
                .then(function (lines) {
                    var table = document.getElementById('grn-details-table');
                    var tbody = table.querySelector('tbody');
                    tbody.querySelectorAll('tr.detail-row').forEach(function (row) { row.remove(); });
                    var template = tbody.querySelector('tr.detail-row-template');

                    lines.forEach(function (line) {
                        if (line.remainingQuantity <= 0) return;
                        var clone = template.cloneNode(true);
                        clone.classList.remove('d-none');
                        clone.classList.add('detail-row');
                        clone.querySelector('.po-detail-id').value = line.purchaseOrderDetailId;
                        clone.querySelector('.material-id').value = line.materialId;
                        clone.querySelector('.po-line-label').textContent = line.materialName + ' (remaining ' + line.remainingQuantity + ')';
                        clone.querySelector('.material-name').textContent = line.materialName;
                        clone.querySelector('input[name*="ReceivedQuantity"]').value = line.remainingQuantity;
                        clone.querySelector('input[name*="UnitPrice"]').value = line.unitPrice;
                        tbody.appendChild(clone);
                    });

                    initDetailTable('grn-details-table', 'Details');
                });
        });
    });
</script>
