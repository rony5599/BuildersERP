@model BuilderERP.Application.DTOs.ProjectProcurementDashboardDto
@using System.Text.Json
@{
    ViewData["Title"] = "Project-wise Procurement Dashboard";
    var maxCommitment = Model.Rows.Count == 0 ? 0 : Model.Rows.Max(x => x.TotalCommittedAmount);
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <div>
        <h1 class="h3 mb-1">Project-wise Procurement Dashboard</h1>
        <p class="text-muted mb-0">PO, EWO and cash purchase activity from requisition through order.</p>
    </div>
    <div class="d-flex gap-2">
        <form asp-action="RefreshProcurementDashboard" method="post" class="d-inline">
            <input type="hidden" name="projectId" value="@Model.ProjectId" />
            <input type="hidden" name="dateFrom" value="@Model.DateFrom?.ToString("yyyy-MM-dd")" />
            <input type="hidden" name="dateTo" value="@Model.DateTo?.ToString("yyyy-MM-dd")" />
            <button type="submit" class="btn btn-primary btn-sm" title="Clear the report cache and load the latest data">
                <i class="bi bi-arrow-clockwise me-1"></i>Refresh Data
            </button>
        </form>
        <a asp-action="ExportProcurementDashboardExcel" asp-route-projectId="@Model.ProjectId" asp-route-dateFrom="@Model.DateFrom?.ToString("yyyy-MM-dd")" asp-route-dateTo="@Model.DateTo?.ToString("yyyy-MM-dd")" class="btn btn-success btn-sm"><i class="bi bi-file-earmark-excel me-1"></i>Excel</a>
        <a asp-action="ExportProcurementDashboardPdf" asp-route-projectId="@Model.ProjectId" asp-route-dateFrom="@Model.DateFrom?.ToString("yyyy-MM-dd")" asp-route-dateTo="@Model.DateTo?.ToString("yyyy-MM-dd")" class="btn btn-danger btn-sm"><i class="bi bi-file-earmark-pdf me-1"></i>PDF</a>
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm">Report Catalog</a>
    </div>
</div>

<div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>
<form method="get" class="card card-body mb-4">
    <div class="row g-2 align-items-end">
        <div class="col-md-5">
            <label class="form-label">Project</label>
            <select name="projectId" class="form-select">
                <option value="">All projects</option>
                @foreach (var project in Model.Projects)
                {
                    <option value="@project.Id" selected="@(Model.ProjectId == project.Id)">@project.Name</option>
                }
            </select>
        </div>
        <div class="col-md-2"><label class="form-label">From date</label><input type="date" name="dateFrom" value="@Model.DateFrom?.ToString("yyyy-MM-dd")" class="form-control" /></div>
        <div class="col-md-2"><label class="form-label">To date</label><input type="date" name="dateTo" value="@Model.DateTo?.ToString("yyyy-MM-dd")" class="form-control" /></div>
        <div class="col-md-3"><button class="btn btn-primary" type="submit">Apply</button> <a asp-action="ProcurementDashboard" class="btn btn-outline-secondary">Clear</a></div>
    </div>
</form>

<div class="row g-3 mb-4 procurement-kpi-grid">
    <div class="col-md-4">
        <div class="d-grid gap-3 h-100">
            <div class="procurement-kpi po-req"><i class="bi bi-clipboard-check procurement-kpi-icon"></i><div class="procurement-kpi-title">PO Requisitions</div><div class="procurement-kpi-value">@Model.PurchaseRequisitionAmount.ToString("N0")</div><span class="procurement-kpi-count">@Model.PurchaseRequisitionCount docs</span></div>
            <div class="procurement-kpi po-order"><i class="bi bi-cart-check procurement-kpi-icon"></i><div class="procurement-kpi-title">Purchase Orders</div><div class="procurement-kpi-value">@Model.PurchaseOrderAmount.ToString("N0")</div><span class="procurement-kpi-count">@Model.PurchaseOrderCount docs</span></div>
            <div class="procurement-kpi po-bill"><i class="bi bi-receipt procurement-kpi-icon"></i><div class="procurement-kpi-title">PO Bills</div><div class="procurement-kpi-value">@Model.PoBillAmount.ToString("N0")</div><span class="procurement-kpi-count">@Model.PoBillCount bills</span></div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="d-grid gap-3 h-100">
            <div class="procurement-kpi ewo-req"><i class="bi bi-file-earmark-text procurement-kpi-icon"></i><div class="procurement-kpi-title">EWO Requisitions</div><div class="procurement-kpi-value">@Model.EwoRequisitionAmount.ToString("N0")</div><span class="procurement-kpi-count">@Model.EwoRequisitionCount docs</span></div>
            <div class="procurement-kpi ewo-order"><i class="bi bi-tools procurement-kpi-icon"></i><div class="procurement-kpi-title">Engineer Work Orders</div><div class="procurement-kpi-value">@Model.EwoAmount.ToString("N0")</div><span class="procurement-kpi-count">@Model.EwoCount docs</span></div>
            <div class="procurement-kpi ewo-bill"><i class="bi bi-receipt-cutoff procurement-kpi-icon"></i><div class="procurement-kpi-title">EWO Bills (Net Payable)</div><div class="procurement-kpi-value">@Model.EwoBillAmount.ToString("N0")</div><span class="procurement-kpi-count">@Model.EwoBillCount bills</span></div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="d-grid gap-3 h-100">
            <div class="procurement-kpi cash-req"><i class="bi bi-cash-coin procurement-kpi-icon"></i><div class="procurement-kpi-title">Cash PO Requisitions</div><div class="procurement-kpi-value">@Model.CashRequisitionAmount.ToString("N0")</div><span class="procurement-kpi-count">@Model.CashRequisitionCount docs</span></div>
            <div class="procurement-kpi cash-order"><i class="bi bi-bag-check procurement-kpi-icon"></i><div class="procurement-kpi-title">Cash Purchase Orders</div><div class="procurement-kpi-value">@Model.CashPurchaseOrderAmount.ToString("N0")</div><span class="procurement-kpi-count">@Model.CashPurchaseOrderCount docs</span></div>
            <div class="procurement-kpi cash-bill"><i class="bi bi-wallet2 procurement-kpi-icon"></i><div class="procurement-kpi-title">Cash PO Bills</div><div class="procurement-kpi-value">@Model.CashPoBillAmount.ToString("N0")</div><span class="procurement-kpi-count">@Model.CashPoBillCount bills</span></div>
        </div>
    </div>
</div>

<style>
    .procurement-kpi {
        position: relative;
        min-height: 150px;
        overflow: hidden;
        padding: 1.15rem 1.2rem;
        border-radius: 1rem;
        color: #fff;
        box-shadow: 0 .65rem 1.35rem rgba(31, 45, 61, .16);
        isolation: isolate;
        transition: transform .18s ease, box-shadow .18s ease;
    }
    .procurement-kpi::after {
        content: "";
        position: absolute;
        right: -35px;
        bottom: -55px;
        width: 145px;
        height: 145px;
        border-radius: 50%;
        background: rgba(255,255,255,.13);
        z-index: -1;
    }
    .procurement-kpi:hover { transform: translateY(-3px); box-shadow: 0 .9rem 1.65rem rgba(31, 45, 61, .22); }
    .procurement-kpi-icon {
        display: inline-grid;
        place-items: center;
        width: 46px;
        height: 46px;
        margin-bottom: .75rem;
        border-radius: 14px;
        background: linear-gradient(145deg, rgba(255,255,255,.55), rgba(255,255,255,.18));
        box-shadow: inset 0 1px 0 rgba(255,255,255,.65), 0 .3rem .65rem rgba(0,0,0,.12);
        font-size: 1.45rem;
        text-shadow: 0 1px 2px rgba(0,0,0,.12);
    }
    .procurement-kpi-title { font-size: .82rem; font-weight: 600; opacity: .9; }
    .procurement-kpi-value { margin-top: .12rem; font-size: 1.55rem; font-weight: 750; line-height: 1.15; }
    .procurement-kpi-count {
        position: absolute;
        right: 1rem;
        bottom: 1rem;
        padding: .28rem .6rem;
        border: 1px solid rgba(255,255,255,.24);
        border-radius: 999px;
        background: rgba(255,255,255,.2);
        box-shadow: inset 0 1px 0 rgba(255,255,255,.24);
        font-size: .72rem;
        font-weight: 700;
        backdrop-filter: blur(4px);
    }
    .po-req { background: linear-gradient(145deg, #69b9ff, #3294e8); }
    .po-order { background: linear-gradient(145deg, #338fea, #1768c5); }
    .po-bill { background: linear-gradient(145deg, #185db8, #0b347f); }
    .ewo-req { background: linear-gradient(145deg, #ffd86a, #f2ad22); color:#3d3000; }
    .ewo-order { background: linear-gradient(145deg, #f5ae2b, #dc7414); }
    .ewo-bill { background: linear-gradient(145deg, #c9680e, #823600); }
    .cash-req { background: linear-gradient(145deg, #f58b9a, #dc6174); }
    .cash-order { background: linear-gradient(145deg, #da5268, #b72c45); }
    .cash-bill { background: linear-gradient(145deg, #a72440, #67112a); }

    .procurement-flow .nav-link { color: var(--bs-secondary-color); font-weight: 600; }
    .procurement-flow .nav-link.active { color: var(--bs-primary); }
    .procurement-flow-step {
        min-width: 0;
        padding: 1rem !important;
        border: 1px solid transparent;
        border-radius: .75rem;
        box-shadow: 0 .2rem .65rem rgba(33, 37, 41, .08);
        transition: transform .15s ease, box-shadow .15s ease;
    }
    .procurement-flow-step:hover { transform: translateY(-2px); box-shadow: 0 .35rem .9rem rgba(33, 37, 41, .13); }
    .procurement-flow-step .text-uppercase { font-weight: 700; letter-spacing: .04em; }
    .procurement-flow-arrow { color: var(--bs-secondary-color); font-size: 1.2rem; }
    .procurement-flow-amount { font-size: 1.15rem; font-weight: 700; text-decoration: none; }
    .procurement-flow-amount:hover { text-decoration: underline; }

    /* All: neutral progression across the combined workflow. */
    #flow-all .procurement-flow-step:nth-child(1) { background:#f8f9fa; border-color:#dee2e6; }
    #flow-all .procurement-flow-step:nth-child(3) { background:#e9ecef; border-color:#ced4da; }
    #flow-all .procurement-flow-step:nth-child(5) { background:#495057; border-color:#495057; color:#fff; }
    #flow-all .procurement-flow-step:nth-child(5) .text-muted,
    #flow-all .procurement-flow-step:nth-child(5) .procurement-flow-amount { color:#fff !important; }

    /* PO: light blue requisition, stronger blue order, deep blue bill. */
    #flow-po .procurement-flow-step:nth-child(1) { background:#e7f1ff; border-color:#b6d4fe; }
    #flow-po .procurement-flow-step:nth-child(3) { background:#6ea8fe; border-color:#3d8bfd; color:#052c65; }
    #flow-po .procurement-flow-step:nth-child(5) { background:#0d6efd; border-color:#0a58ca; color:#fff; }
    #flow-po .procurement-flow-step:nth-child(1) .procurement-flow-amount { color:#0a58ca; }
    #flow-po .procurement-flow-step:nth-child(3) .text-muted,
    #flow-po .procurement-flow-step:nth-child(3) .procurement-flow-amount { color:#052c65 !important; }
    #flow-po .procurement-flow-step:nth-child(5) .text-muted,
    #flow-po .procurement-flow-step:nth-child(5) .procurement-flow-amount { color:#fff !important; }

    /* EWO: light amber requisition, gold order, deep amber bill. */
    #flow-ewo .procurement-flow-step:nth-child(1) { background:#fff3cd; border-color:#ffecb5; }
    #flow-ewo .procurement-flow-step:nth-child(3) { background:#ffca2c; border-color:#ffc107; color:#3d3000; }
    #flow-ewo .procurement-flow-step:nth-child(5) { background:#a95600; border-color:#854500; color:#fff; }
    #flow-ewo .procurement-flow-step:nth-child(1) .procurement-flow-amount { color:#854500; }
    #flow-ewo .procurement-flow-step:nth-child(3) .text-muted,
    #flow-ewo .procurement-flow-step:nth-child(3) .procurement-flow-amount { color:#3d3000 !important; }
    #flow-ewo .procurement-flow-step:nth-child(5) .text-muted,
    #flow-ewo .procurement-flow-step:nth-child(5) .procurement-flow-amount { color:#fff !important; }

    /* Cash PO: light red requisition, rose order, deep red bill. */
    #flow-cpo .procurement-flow-step:nth-child(1) { background:#f8d7da; border-color:#f1aeb5; }
    #flow-cpo .procurement-flow-step:nth-child(3) { background:#ea868f; border-color:#e35d6a; color:#58151c; }
    #flow-cpo .procurement-flow-step:nth-child(5) { background:#b02a37; border-color:#842029; color:#fff; }
    #flow-cpo .procurement-flow-step:nth-child(1) .procurement-flow-amount { color:#842029; }
    #flow-cpo .procurement-flow-step:nth-child(3) .text-muted,
    #flow-cpo .procurement-flow-step:nth-child(3) .procurement-flow-amount { color:#58151c !important; }
    #flow-cpo .procurement-flow-step:nth-child(5) .text-muted,
    #flow-cpo .procurement-flow-step:nth-child(5) .procurement-flow-amount { color:#fff !important; }

    @@media (max-width: 767.98px) {
        .procurement-flow-arrow { transform: rotate(90deg); }
        .procurement-flow-step { width: 100%; }
    }
</style>

<div class="card procurement-flow mb-4">
    <div class="card-header bg-white pb-0">
        <ul class="nav nav-tabs border-bottom-0" id="procurement-flow-tabs" role="tablist">
            <li class="nav-item" role="presentation"><button class="nav-link active" id="flow-all-tab" data-bs-toggle="tab" data-bs-target="#flow-all" type="button" role="tab" aria-controls="flow-all" aria-selected="true">All</button></li>
            <li class="nav-item" role="presentation"><button class="nav-link" id="flow-po-tab" data-bs-toggle="tab" data-bs-target="#flow-po" type="button" role="tab" aria-controls="flow-po" aria-selected="false">PO</button></li>
            <li class="nav-item" role="presentation"><button class="nav-link" id="flow-ewo-tab" data-bs-toggle="tab" data-bs-target="#flow-ewo" type="button" role="tab" aria-controls="flow-ewo" aria-selected="false">Engineer Work Order</button></li>
            <li class="nav-item" role="presentation"><button class="nav-link" id="flow-cpo-tab" data-bs-toggle="tab" data-bs-target="#flow-cpo" type="button" role="tab" aria-controls="flow-cpo" aria-selected="false">Cash PO</button></li>
        </ul>
    </div>
    <div class="card-body tab-content" id="procurement-flow-content">
        <div class="tab-pane fade show active" id="flow-all" role="tabpanel" aria-labelledby="flow-all-tab" tabindex="0">
            <div class="d-flex flex-column flex-md-row align-items-stretch align-items-md-center gap-3">
                <div class="procurement-flow-step flex-fill text-center p-2"><div class="text-muted small text-uppercase">Requisitions</div><div class="small mb-1">@(Model.PurchaseRequisitionCount + Model.EwoRequisitionCount + Model.CashRequisitionCount) documents</div><a class="procurement-flow-amount" href="#project-wise-report" title="View the project-wise breakdown">@((Model.PurchaseRequisitionAmount + Model.EwoRequisitionAmount + Model.CashRequisitionAmount).ToString("N0"))</a></div>
                <i class="bi bi-arrow-right procurement-flow-arrow align-self-center" aria-hidden="true"></i>
                <div class="procurement-flow-step flex-fill text-center p-2"><div class="text-muted small text-uppercase">Orders</div><div class="small mb-1">@(Model.PurchaseOrderCount + Model.EwoCount + Model.CashPurchaseOrderCount) documents</div><a class="procurement-flow-amount" href="#project-wise-report" title="View the project-wise breakdown">@Model.TotalCommittedAmount.ToString("N0")</a></div>
                <i class="bi bi-arrow-right procurement-flow-arrow align-self-center" aria-hidden="true"></i>
                <div class="procurement-flow-step flex-fill text-center p-2"><div class="text-muted small text-uppercase">Bills</div><div class="small mb-1">@(Model.PoBillCount + Model.EwoBillCount + Model.CashPoBillCount) documents</div><a class="procurement-flow-amount" href="#project-wise-report" title="View the project-wise breakdown">@Model.TotalBilledAmount.ToString("N0")</a></div>
            </div>
            <div class="small text-muted text-center mt-2">Choose a document type tab to open its filtered lists.</div>
        </div>
        <div class="tab-pane fade" id="flow-po" role="tabpanel" aria-labelledby="flow-po-tab" tabindex="0">
            <div class="d-flex flex-column flex-md-row align-items-stretch align-items-md-center gap-3">
                <div class="procurement-flow-step flex-fill text-center p-2"><div class="text-muted small text-uppercase">Requisitions</div><div class="small mb-1">@Model.PurchaseRequisitionCount documents</div><a class="procurement-flow-amount" asp-controller="PurchaseRequisitions" asp-action="Index" asp-route-projectId="@Model.ProjectId" asp-route-dateFrom="@Model.DateFrom?.ToString("yyyy-MM-dd")" asp-route-dateTo="@Model.DateTo?.ToString("yyyy-MM-dd")">@Model.PurchaseRequisitionAmount.ToString("N0")</a></div>
                <i class="bi bi-arrow-right procurement-flow-arrow align-self-center" aria-hidden="true"></i>
                <div class="procurement-flow-step flex-fill text-center p-2"><div class="text-muted small text-uppercase">Orders</div><div class="small mb-1">@Model.PurchaseOrderCount documents</div><a class="procurement-flow-amount" asp-controller="PurchaseOrders" asp-action="Index" asp-route-orderDateFrom="@Model.DateFrom?.ToString("yyyy-MM-dd")" asp-route-orderDateTo="@Model.DateTo?.ToString("yyyy-MM-dd")">@Model.PurchaseOrderAmount.ToString("N0")</a></div>
                <i class="bi bi-arrow-right procurement-flow-arrow align-self-center" aria-hidden="true"></i>
                <div class="procurement-flow-step flex-fill text-center p-2"><div class="text-muted small text-uppercase">Bills</div><div class="small mb-1">@Model.PoBillCount documents</div><a class="procurement-flow-amount" asp-controller="PoBills" asp-action="Index" asp-route-dateFrom="@Model.DateFrom?.ToString("yyyy-MM-dd")" asp-route-dateTo="@Model.DateTo?.ToString("yyyy-MM-dd")">@Model.PoBillAmount.ToString("N0")</a></div>
            </div>
        </div>
        <div class="tab-pane fade" id="flow-ewo" role="tabpanel" aria-labelledby="flow-ewo-tab" tabindex="0">
            <div class="d-flex flex-column flex-md-row align-items-stretch align-items-md-center gap-3">
                <div class="procurement-flow-step flex-fill text-center p-2"><div class="text-muted small text-uppercase">Requisitions</div><div class="small mb-1">@Model.EwoRequisitionCount documents</div><a class="procurement-flow-amount" asp-controller="EngineerWorkOrderRequisitions" asp-action="Index" asp-route-projectId="@Model.ProjectId" asp-route-dateFrom="@Model.DateFrom?.ToString("yyyy-MM-dd")" asp-route-dateTo="@Model.DateTo?.ToString("yyyy-MM-dd")">@Model.EwoRequisitionAmount.ToString("N0")</a></div>
                <i class="bi bi-arrow-right procurement-flow-arrow align-self-center" aria-hidden="true"></i>
                <div class="procurement-flow-step flex-fill text-center p-2"><div class="text-muted small text-uppercase">Orders</div><div class="small mb-1">@Model.EwoCount documents</div><a class="procurement-flow-amount" asp-controller="EngineerWorkOrders" asp-action="Index" asp-route-projectId="@Model.ProjectId" asp-route-dateFrom="@Model.DateFrom?.ToString("yyyy-MM-dd")" asp-route-dateTo="@Model.DateTo?.ToString("yyyy-MM-dd")">@Model.EwoAmount.ToString("N0")</a></div>
                <i class="bi bi-arrow-right procurement-flow-arrow align-self-center" aria-hidden="true"></i>
                <div class="procurement-flow-step flex-fill text-center p-2"><div class="text-muted small text-uppercase">Bills</div><div class="small mb-1">@Model.EwoBillCount documents</div><a class="procurement-flow-amount" asp-controller="EwoBills" asp-action="Index" asp-route-dateFrom="@Model.DateFrom?.ToString("yyyy-MM-dd")" asp-route-dateTo="@Model.DateTo?.ToString("yyyy-MM-dd")">@Model.EwoBillAmount.ToString("N0")</a></div>
            </div>
        </div>
        <div class="tab-pane fade" id="flow-cpo" role="tabpanel" aria-labelledby="flow-cpo-tab" tabindex="0">
            <div class="d-flex flex-column flex-md-row align-items-stretch align-items-md-center gap-3">
                <div class="procurement-flow-step flex-fill text-center p-2"><div class="text-muted small text-uppercase">Requisitions</div><div class="small mb-1">@Model.CashRequisitionCount documents</div><a class="procurement-flow-amount" asp-controller="CashRequisitions" asp-action="Index" asp-route-projectId="@Model.ProjectId" asp-route-dateFrom="@Model.DateFrom?.ToString("yyyy-MM-dd")" asp-route-dateTo="@Model.DateTo?.ToString("yyyy-MM-dd")">@Model.CashRequisitionAmount.ToString("N0")</a></div>
                <i class="bi bi-arrow-right procurement-flow-arrow align-self-center" aria-hidden="true"></i>
                <div class="procurement-flow-step flex-fill text-center p-2"><div class="text-muted small text-uppercase">Orders</div><div class="small mb-1">@Model.CashPurchaseOrderCount documents</div><a class="procurement-flow-amount" asp-controller="CashPurchaseOrders" asp-action="Index" asp-route-projectId="@Model.ProjectId" asp-route-dateFrom="@Model.DateFrom?.ToString("yyyy-MM-dd")" asp-route-dateTo="@Model.DateTo?.ToString("yyyy-MM-dd")">@Model.CashPurchaseOrderAmount.ToString("N0")</a></div>
                <i class="bi bi-arrow-right procurement-flow-arrow align-self-center" aria-hidden="true"></i>
                <div class="procurement-flow-step flex-fill text-center p-2"><div class="text-muted small text-uppercase">Bills</div><div class="small mb-1">@Model.CashPoBillCount documents</div><a class="procurement-flow-amount" asp-controller="CashPoBills" asp-action="Index" asp-route-dateFrom="@Model.DateFrom?.ToString("yyyy-MM-dd")" asp-route-dateTo="@Model.DateTo?.ToString("yyyy-MM-dd")">@Model.CashPoBillAmount.ToString("N0")</a></div>
            </div>
        </div>
    </div>
</div>

<div class="card mb-4">
    <div class="card-header bg-white d-flex flex-wrap justify-content-between align-items-center gap-2">
        <div><strong>BOQ budget vs committed</strong><div class="small text-muted">Committed = PO + EWO + CPO. Only active, approved BOQs are included.</div></div>
        <span class="badge @(Model.IsBudgetExceeded ? "bg-danger" : "bg-success") fs-6">
            @(Model.IsBudgetExceeded ? $"Over budget by {Math.Abs(Model.BudgetVariance):N0}" : $"Available {Model.BudgetVariance:N0}")
        </span>
    </div>
    <div class="card-body">
        @foreach (var row in Model.Rows.OrderByDescending(x => x.BudgetUtilizationPercent))
        {
            var utilizationWidth = Math.Min(row.BudgetUtilizationPercent, 100m);
            var utilizationWidthCss = utilizationWidth.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);
            <div class="mb-3">
                <div class="d-flex flex-wrap justify-content-between gap-2 small mb-1">
                    <span><strong>@row.ProjectCode</strong> <span class="text-muted">@row.ProjectName</span></span>
                    <span><strong class="@(row.IsBudgetExceeded ? "text-danger" : "")">@row.BudgetUtilizationPercent.ToString("N1")%</strong> <span class="text-muted">@row.TotalCommittedAmount.ToString("N0") / @row.BoqBudgetAmount.ToString("N0")</span></span>
                </div>
                <div class="progress" style="height:12px" role="progressbar" aria-label="@row.ProjectName budget utilization" aria-valuenow="@utilizationWidthCss" aria-valuemin="0" aria-valuemax="100">
                    <div class="progress-bar @(row.IsBudgetExceeded ? "bg-danger" : row.BudgetUtilizationPercent >= 80 ? "bg-warning" : "bg-success")" style="width:@utilizationWidthCss%"></div>
                </div>
            </div>
        }
        @if (Model.Rows.Count == 0) { <div class="text-center text-muted py-3">No projects found.</div> }
    </div>
    <div class="table-responsive">
        <table class="table table-sm align-middle mb-0">
            <thead class="table-light"><tr><th>Project</th><th class="text-end">BOQ Budget</th><th class="text-end">PO + EWO + CPO</th><th class="text-end">Available / Overrun</th><th class="text-end">Used</th><th>Status</th></tr></thead>
            <tbody>
            @foreach (var row in Model.Rows.OrderByDescending(x => x.BudgetUtilizationPercent))
            {
                <tr class="@(row.IsBudgetExceeded ? "table-danger" : "")">
                    <td><strong>@row.ProjectCode</strong><div class="small text-muted">@row.ProjectName</div></td>
                    <td class="text-end">@row.BoqBudgetAmount.ToString("N0")</td>
                    <td class="text-end fw-semibold">@row.TotalCommittedAmount.ToString("N0")</td>
                    <td class="text-end @(row.IsBudgetExceeded ? "text-danger fw-bold" : "text-success")">@(row.IsBudgetExceeded ? $"({Math.Abs(row.BudgetVariance):N0})" : row.BudgetVariance.ToString("N0"))</td>
                    <td class="text-end">@row.BudgetUtilizationPercent.ToString("N1")%</td>
                    <td><span class="badge @(row.IsBudgetExceeded ? "bg-danger" : row.BoqBudgetAmount == 0 && row.TotalCommittedAmount == 0 ? "bg-secondary" : "bg-success")">@(row.IsBudgetExceeded ? "Exceeded" : row.BoqBudgetAmount == 0 ? "No BOQ" : "Within budget")</span></td>
                </tr>
            }
            @if (Model.Rows.Count == 0) { <tr><td colspan="6" class="text-center text-muted py-4">No projects found.</td></tr> }
            </tbody>
        </table>
    </div>
</div>

<div class="card mb-4">
    <div class="card-header bg-white">
        <strong>Monthly commitments</strong>
        <span class="float-end text-muted">PO + EWO + Cash PO</span>
    </div>
    <div class="card-body">
        @if (Model.MonthlyCommitments.Count > 0)
        {
            <div style="position:relative; min-height:360px">
                <canvas id="monthly-procurement-chart" aria-label="Monthly stacked PO, EWO and Cash PO commitments" role="img"></canvas>
            </div>
        }
        else
        {
            <div class="text-center text-muted py-4">No monthly procurement data found for the selected filters.</div>
        }
    </div>
</div>

<div class="card mb-4">
    <div class="card-header bg-white"><strong>Committed amount by project</strong><span class="float-end text-muted">Total @Model.TotalCommittedAmount.ToString("N0")</span></div>
    <div class="card-body">
        @foreach (var row in Model.Rows.OrderByDescending(x => x.TotalCommittedAmount).Take(10))
        {
            var width = maxCommitment == 0 ? 0 : Math.Round(row.TotalCommittedAmount * 100m / maxCommitment, 1);
            <div class="mb-3">
                <div class="d-flex justify-content-between small mb-1"><span>@row.ProjectName</span><strong>@row.TotalCommittedAmount.ToString("N0")</strong></div>
                <div class="progress" style="height:8px"><div class="progress-bar" style="width:@width%"></div></div>
            </div>
        }
        @if (Model.Rows.Count == 0) { <div class="text-center text-muted py-3">No projects found.</div> }
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js@4"></script>
@if (Model.MonthlyCommitments.Count > 0)
{
    <script>
        (() => {
            const months = @Html.Raw(JsonSerializer.Serialize(Model.MonthlyCommitments.Select(x => new
            {
                label = new DateTime(x.Year, x.Month, 1).ToString("MMM yyyy"),
                po = x.PurchaseOrderAmount,
                ewo = x.EwoAmount,
                cpo = x.CashPurchaseOrderAmount,
                pie = x.PieAmount
            })));
            const context = document.getElementById('monthly-procurement-chart');
            const stackTotals = {
                id: 'stackTotals',
                afterDatasetsDraw(chart) {
                    const { ctx } = chart;
                    ctx.save();
                    ctx.fillStyle = '#495057';
                    ctx.font = '600 12px system-ui, sans-serif';
                    ctx.textAlign = 'center';
                    ctx.textBaseline = 'bottom';
                    months.forEach((month, index) => {
                        const bars = chart.data.datasets
                            .map((_, datasetIndex) => chart.getDatasetMeta(datasetIndex).data[index])
                            .filter(Boolean);
                        if (bars.length === 0) return;
                        const top = Math.min(...bars.map(bar => bar.y));
                        ctx.fillText(Number(month.pie).toLocaleString(), bars[0].x, top - 6);
                    });
                    ctx.restore();
                }
            };
            new Chart(context, {
                type: 'bar',
                data: {
                    labels: months.map(x => x.label),
                    datasets: [
                        { label: 'PO', data: months.map(x => x.po), backgroundColor: '#198754', stack: 'commitments' },
                        { label: 'EWO', data: months.map(x => x.ewo), backgroundColor: '#ffc107', stack: 'commitments' },
                        { label: 'Cash PO', data: months.map(x => x.cpo), backgroundColor: '#dc3545', stack: 'commitments' }
                    ]
                },
                plugins: [stackTotals],
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    interaction: { mode: 'index', intersect: false },
                    layout: { padding: { top: 24 } },
                    scales: {
                        x: { stacked: true },
                        y: {
                            stacked: true,
                            beginAtZero: true,
                            ticks: { callback: value => Number(value).toLocaleString() },
                            title: { display: true, text: 'Amount' }
                        }
                    },
                    plugins: {
                        tooltip: { callbacks: { label: item => `${item.dataset.label}: ${Number(item.raw).toLocaleString()}` } }
                    }
                }
            });
        })();
    </script>
}

<div class="card" id="project-wise-report">
    <div class="card-header bg-white"><strong>Project-wise report</strong></div>
    <div class="table-responsive">
        <table class="table table-sm table-hover align-middle mb-0">
            <thead class="table-light"><tr><th rowspan="2">Project</th><th colspan="2" class="text-center">PO Requisition</th><th colspan="2" class="text-center">PO</th><th colspan="2" class="text-center">PO Bill</th><th colspan="2" class="text-center">EWO Requisition</th><th colspan="2" class="text-center">EWO</th><th colspan="2" class="text-center">EWO Bill</th><th colspan="2" class="text-center">Cash PO Requisition</th><th colspan="2" class="text-center">Cash PO</th><th colspan="2" class="text-center">Cash PO Bill</th><th rowspan="2" class="text-end">Committed</th><th rowspan="2" class="text-end">Billed</th></tr><tr>@for (var i = 0; i < 9; i++) { <th class="text-end">Count</th><th class="text-end">Amount</th> }</tr></thead>
            <tbody>
            @foreach (var row in Model.Rows)
            {
                <tr><td><strong>@row.ProjectCode</strong><div class="small text-muted">@row.ProjectName</div></td><td class="text-end">@row.PurchaseRequisitionCount</td><td class="text-end">@row.PurchaseRequisitionAmount.ToString("N0")</td><td class="text-end">@row.PurchaseOrderCount</td><td class="text-end">@row.PurchaseOrderAmount.ToString("N0")</td><td class="text-end">@row.PoBillCount</td><td class="text-end">@row.PoBillAmount.ToString("N0")</td><td class="text-end">@row.EwoRequisitionCount</td><td class="text-end">@row.EwoRequisitionAmount.ToString("N0")</td><td class="text-end">@row.EwoCount</td><td class="text-end">@row.EwoAmount.ToString("N0")</td><td class="text-end">@row.EwoBillCount</td><td class="text-end">@row.EwoBillAmount.ToString("N0")</td><td class="text-end">@row.CashRequisitionCount</td><td class="text-end">@row.CashRequisitionAmount.ToString("N0")</td><td class="text-end">@row.CashPurchaseOrderCount</td><td class="text-end">@row.CashPurchaseOrderAmount.ToString("N0")</td><td class="text-end">@row.CashPoBillCount</td><td class="text-end">@row.CashPoBillAmount.ToString("N0")</td><td class="text-end fw-bold">@row.TotalCommittedAmount.ToString("N0")</td><td class="text-end fw-bold">@row.TotalBilledAmount.ToString("N0")</td></tr>
            }
            @if (Model.Rows.Count == 0) { <tr><td colspan="21" class="text-center text-muted py-4">No data found for the selected filters.</td></tr> }
            </tbody>
        </table>
    </div>
</div>
