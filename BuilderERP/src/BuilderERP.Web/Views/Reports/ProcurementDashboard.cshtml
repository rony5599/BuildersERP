@model BuilderERP.Application.DTOs.ProjectProcurementDashboardDto
@using System.Text.Json
@{
    ViewData["Title"] = "Project-wise Procurement Dashboard";
    var maxCommitment = Model.Rows.Count == 0 ? 0 : Model.Rows.Max(x => x.TotalCommittedAmount);
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <div>
        <h1 class="h3 mb-1">Project-wise Procurement Dashboard</h1>
        <p class="text-muted mb-0">PO, EWO and cash purchase activity from requisition through order.</p>
    </div>
    <div class="d-flex gap-2">
        <form asp-action="RefreshProcurementDashboard" method="post" class="d-inline">
            <input type="hidden" name="projectId" value="@Model.ProjectId" />
            <input type="hidden" name="dateFrom" value="@Model.DateFrom?.ToString("yyyy-MM-dd")" />
            <input type="hidden" name="dateTo" value="@Model.DateTo?.ToString("yyyy-MM-dd")" />
            <button type="submit" class="btn btn-primary btn-sm" title="Clear the report cache and load the latest data">
                <i class="bi bi-arrow-clockwise me-1"></i>Refresh Data
            </button>
        </form>
        <a asp-action="ExportProcurementDashboardExcel" asp-route-projectId="@Model.ProjectId" asp-route-dateFrom="@Model.DateFrom?.ToString("yyyy-MM-dd")" asp-route-dateTo="@Model.DateTo?.ToString("yyyy-MM-dd")" class="btn btn-success btn-sm"><i class="bi bi-file-earmark-excel me-1"></i>Excel</a>
        <a asp-action="ExportProcurementDashboardPdf" asp-route-projectId="@Model.ProjectId" asp-route-dateFrom="@Model.DateFrom?.ToString("yyyy-MM-dd")" asp-route-dateTo="@Model.DateTo?.ToString("yyyy-MM-dd")" class="btn btn-danger btn-sm"><i class="bi bi-file-earmark-pdf me-1"></i>PDF</a>
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm">Report Catalog</a>
    </div>
</div>

<div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>
<form method="get" class="card card-body mb-4">
    <div class="row g-2 align-items-end">
        <div class="col-md-5">
            <label class="form-label">Project</label>
            <select name="projectId" class="form-select">
                <option value="">All projects</option>
                @foreach (var project in Model.Projects)
                {
                    <option value="@project.Id" selected="@(Model.ProjectId == project.Id)">@project.Name</option>
                }
            </select>
        </div>
        <div class="col-md-2"><label class="form-label">From date</label><input type="date" name="dateFrom" value="@Model.DateFrom?.ToString("yyyy-MM-dd")" class="form-control" /></div>
        <div class="col-md-2"><label class="form-label">To date</label><input type="date" name="dateTo" value="@Model.DateTo?.ToString("yyyy-MM-dd")" class="form-control" /></div>
        <div class="col-md-3"><button class="btn btn-primary" type="submit">Apply</button> <a asp-action="ProcurementDashboard" class="btn btn-outline-secondary">Clear</a></div>
    </div>
</form>

<div class="row g-3 mb-4">
    <div class="col-sm-6 col-xl-4"><div class="card h-100 border-start border-primary border-4"><div class="card-body"><div class="text-muted small">PO Requisitions</div><div class="d-flex justify-content-between align-items-end"><strong class="h4 mb-0">@Model.PurchaseRequisitionAmount.ToString("N0")</strong><span class="badge bg-primary">@Model.PurchaseRequisitionCount docs</span></div></div></div></div>
    <div class="col-sm-6 col-xl-4"><div class="card h-100 border-start border-success border-4"><div class="card-body"><div class="text-muted small">Purchase Orders</div><div class="d-flex justify-content-between align-items-end"><strong class="h4 mb-0">@Model.PurchaseOrderAmount.ToString("N0")</strong><span class="badge bg-success">@Model.PurchaseOrderCount docs</span></div></div></div></div>
    <div class="col-sm-6 col-xl-4"><div class="card h-100 border-start border-info border-4"><div class="card-body"><div class="text-muted small">EWO Requisitions</div><div class="d-flex justify-content-between align-items-end"><strong class="h4 mb-0">@Model.EwoRequisitionAmount.ToString("N0")</strong><span class="badge bg-info text-dark">@Model.EwoRequisitionCount docs</span></div></div></div></div>
    <div class="col-sm-6 col-xl-4"><div class="card h-100 border-start border-warning border-4"><div class="card-body"><div class="text-muted small">Engineer Work Orders</div><div class="d-flex justify-content-between align-items-end"><strong class="h4 mb-0">@Model.EwoAmount.ToString("N0")</strong><span class="badge bg-warning text-dark">@Model.EwoCount docs</span></div></div></div></div>
    <div class="col-sm-6 col-xl-4"><div class="card h-100 border-start border-secondary border-4"><div class="card-body"><div class="text-muted small">Cash PO Requisitions</div><div class="d-flex justify-content-between align-items-end"><strong class="h4 mb-0">@Model.CashRequisitionAmount.ToString("N0")</strong><span class="badge bg-secondary">@Model.CashRequisitionCount docs</span></div></div></div></div>
    <div class="col-sm-6 col-xl-4"><div class="card h-100 border-start border-danger border-4"><div class="card-body"><div class="text-muted small">Cash Purchase Orders</div><div class="d-flex justify-content-between align-items-end"><strong class="h4 mb-0">@Model.CashPurchaseOrderAmount.ToString("N0")</strong><span class="badge bg-danger">@Model.CashPurchaseOrderCount docs</span></div></div></div></div>
    <div class="col-sm-6 col-xl-4"><div class="card h-100 border-start border-success border-4"><div class="card-body"><div class="text-muted small">PO Bills</div><div class="d-flex justify-content-between align-items-end"><strong class="h4 mb-0">@Model.PoBillAmount.ToString("N0")</strong><span class="badge bg-success">@Model.PoBillCount bills</span></div></div></div></div>
    <div class="col-sm-6 col-xl-4"><div class="card h-100 border-start border-warning border-4"><div class="card-body"><div class="text-muted small">EWO Bills (Net Payable)</div><div class="d-flex justify-content-between align-items-end"><strong class="h4 mb-0">@Model.EwoBillAmount.ToString("N0")</strong><span class="badge bg-warning text-dark">@Model.EwoBillCount bills</span></div></div></div></div>
    <div class="col-sm-6 col-xl-4"><div class="card h-100 border-start border-danger border-4"><div class="card-body"><div class="text-muted small">Cash PO Bills</div><div class="d-flex justify-content-between align-items-end"><strong class="h4 mb-0">@Model.CashPoBillAmount.ToString("N0")</strong><span class="badge bg-danger">@Model.CashPoBillCount bills</span></div></div></div></div>
</div>

<div class="card mb-4">
    <div class="card-header bg-white d-flex flex-wrap justify-content-between align-items-center gap-2">
        <div><strong>BOQ budget vs committed</strong><div class="small text-muted">Committed = PO + EWO + CPO. Only active, approved BOQs are included.</div></div>
        <span class="badge @(Model.IsBudgetExceeded ? "bg-danger" : "bg-success") fs-6">
            @(Model.IsBudgetExceeded ? $"Over budget by {Math.Abs(Model.BudgetVariance):N0}" : $"Available {Model.BudgetVariance:N0}")
        </span>
    </div>
    <div class="card-body">
        <div style="position:relative; min-height:360px">
            <canvas id="boq-commitment-chart" aria-label="Project-wise BOQ budget compared with PO, EWO and CPO committed amount" role="img"></canvas>
        </div>
    </div>
    <div class="table-responsive">
        <table class="table table-sm align-middle mb-0">
            <thead class="table-light"><tr><th>Project</th><th class="text-end">BOQ Budget</th><th class="text-end">PO + EWO + CPO</th><th class="text-end">Available / Overrun</th><th class="text-end">Used</th><th>Status</th></tr></thead>
            <tbody>
            @foreach (var row in Model.Rows.OrderByDescending(x => x.BudgetUtilizationPercent))
            {
                <tr class="@(row.IsBudgetExceeded ? "table-danger" : "")">
                    <td><strong>@row.ProjectCode</strong><div class="small text-muted">@row.ProjectName</div></td>
                    <td class="text-end">@row.BoqBudgetAmount.ToString("N0")</td>
                    <td class="text-end fw-semibold">@row.TotalCommittedAmount.ToString("N0")</td>
                    <td class="text-end @(row.IsBudgetExceeded ? "text-danger fw-bold" : "text-success")">@(row.IsBudgetExceeded ? $"({Math.Abs(row.BudgetVariance):N0})" : row.BudgetVariance.ToString("N0"))</td>
                    <td class="text-end">@row.BudgetUtilizationPercent.ToString("N1")%</td>
                    <td><span class="badge @(row.IsBudgetExceeded ? "bg-danger" : row.BoqBudgetAmount == 0 && row.TotalCommittedAmount == 0 ? "bg-secondary" : "bg-success")">@(row.IsBudgetExceeded ? "Exceeded" : row.BoqBudgetAmount == 0 ? "No BOQ" : "Within budget")</span></td>
                </tr>
            }
            @if (Model.Rows.Count == 0) { <tr><td colspan="6" class="text-center text-muted py-4">No projects found.</td></tr> }
            </tbody>
        </table>
    </div>
</div>

<div class="card mb-4">
    <div class="card-header bg-white">
        <strong>Month-wise PO, EWO, CPO and PIE</strong>
        <span class="float-end text-muted">PIE = PO + EWO + CPO</span>
    </div>
    <div class="card-body">
        @if (Model.MonthlyCommitments.Count > 0)
        {
            <div style="position:relative; min-height:360px">
                <canvas id="monthly-procurement-chart" aria-label="Month-wise procurement amount bar chart" role="img"></canvas>
            </div>
        }
        else
        {
            <div class="text-center text-muted py-4">No monthly procurement data found for the selected filters.</div>
        }
    </div>
</div>

<div class="card mb-4">
    <div class="card-header bg-white"><strong>Committed amount by project</strong><span class="float-end text-muted">Total @Model.TotalCommittedAmount.ToString("N0")</span></div>
    <div class="card-body">
        @foreach (var row in Model.Rows.OrderByDescending(x => x.TotalCommittedAmount).Take(10))
        {
            var width = maxCommitment == 0 ? 0 : Math.Round(row.TotalCommittedAmount * 100m / maxCommitment, 1);
            <div class="mb-3">
                <div class="d-flex justify-content-between small mb-1"><span>@row.ProjectName</span><strong>@row.TotalCommittedAmount.ToString("N0")</strong></div>
                <div class="progress" style="height:8px"><div class="progress-bar" style="width:@width%"></div></div>
            </div>
        }
        @if (Model.Rows.Count == 0) { <div class="text-center text-muted py-3">No projects found.</div> }
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js@4"></script>
@if (Model.MonthlyCommitments.Count > 0)
{
    <script>
        (() => {
            const months = @Html.Raw(JsonSerializer.Serialize(Model.MonthlyCommitments.Select(x => new
            {
                label = new DateTime(x.Year, x.Month, 1).ToString("MMM yyyy"),
                po = x.PurchaseOrderAmount,
                ewo = x.EwoAmount,
                cpo = x.CashPurchaseOrderAmount,
                pie = x.PieAmount
            })));
            const context = document.getElementById('monthly-procurement-chart');
            new Chart(context, {
                type: 'bar',
                data: {
                    labels: months.map(x => x.label),
                    datasets: [
                        { label: 'PO', data: months.map(x => x.po), backgroundColor: '#198754' },
                        { label: 'EWO', data: months.map(x => x.ewo), backgroundColor: '#ffc107' },
                        { label: 'CPO', data: months.map(x => x.cpo), backgroundColor: '#dc3545' },
                        { label: 'PIE (Total)', data: months.map(x => x.pie), backgroundColor: '#0d6efd' }
                    ]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    interaction: { mode: 'index', intersect: false },
                    scales: {
                        y: {
                            beginAtZero: true,
                            ticks: { callback: value => Number(value).toLocaleString() },
                            title: { display: true, text: 'Amount' }
                        }
                    },
                    plugins: {
                        tooltip: { callbacks: { label: item => `${item.dataset.label}: ${Number(item.raw).toLocaleString()}` } }
                    }
                }
            });
        })();
    </script>
}

<script>
    (() => {
        const projects = @Html.Raw(JsonSerializer.Serialize(Model.Rows.Select(x => new
        {
            label = x.ProjectCode,
            boq = x.BoqBudgetAmount,
            committed = x.TotalCommittedAmount,
            exceeded = x.IsBudgetExceeded
        })));
        const context = document.getElementById('boq-commitment-chart');
        new Chart(context, {
            type: 'bar',
            data: {
                labels: projects.map(x => x.label),
                datasets: [
                    { label: 'BOQ Budget', data: projects.map(x => x.boq), backgroundColor: '#0d6efd' },
                    { label: 'PO + EWO + CPO', data: projects.map(x => x.committed), backgroundColor: projects.map(x => x.exceeded ? '#dc3545' : '#198754') }
                ]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                interaction: { mode: 'index', intersect: false },
                scales: { y: { beginAtZero: true, ticks: { callback: value => Number(value).toLocaleString() }, title: { display: true, text: 'Amount' } } },
                plugins: { tooltip: { callbacks: { label: item => `${item.dataset.label}: ${Number(item.raw).toLocaleString()}` } } }
            }
        });
    })();
</script>

<div class="card">
    <div class="card-header bg-white"><strong>Project-wise report</strong></div>
    <div class="table-responsive">
        <table class="table table-sm table-hover align-middle mb-0">
            <thead class="table-light"><tr><th rowspan="2">Project</th><th colspan="2" class="text-center">PO Requisition</th><th colspan="2" class="text-center">PO</th><th colspan="2" class="text-center">PO Bill</th><th colspan="2" class="text-center">EWO Requisition</th><th colspan="2" class="text-center">EWO</th><th colspan="2" class="text-center">EWO Bill</th><th colspan="2" class="text-center">Cash PO Requisition</th><th colspan="2" class="text-center">Cash PO</th><th colspan="2" class="text-center">Cash PO Bill</th><th rowspan="2" class="text-end">Committed</th><th rowspan="2" class="text-end">Billed</th></tr><tr>@for (var i = 0; i < 9; i++) { <th class="text-end">Count</th><th class="text-end">Amount</th> }</tr></thead>
            <tbody>
            @foreach (var row in Model.Rows)
            {
                <tr><td><strong>@row.ProjectCode</strong><div class="small text-muted">@row.ProjectName</div></td><td class="text-end">@row.PurchaseRequisitionCount</td><td class="text-end">@row.PurchaseRequisitionAmount.ToString("N0")</td><td class="text-end">@row.PurchaseOrderCount</td><td class="text-end">@row.PurchaseOrderAmount.ToString("N0")</td><td class="text-end">@row.PoBillCount</td><td class="text-end">@row.PoBillAmount.ToString("N0")</td><td class="text-end">@row.EwoRequisitionCount</td><td class="text-end">@row.EwoRequisitionAmount.ToString("N0")</td><td class="text-end">@row.EwoCount</td><td class="text-end">@row.EwoAmount.ToString("N0")</td><td class="text-end">@row.EwoBillCount</td><td class="text-end">@row.EwoBillAmount.ToString("N0")</td><td class="text-end">@row.CashRequisitionCount</td><td class="text-end">@row.CashRequisitionAmount.ToString("N0")</td><td class="text-end">@row.CashPurchaseOrderCount</td><td class="text-end">@row.CashPurchaseOrderAmount.ToString("N0")</td><td class="text-end">@row.CashPoBillCount</td><td class="text-end">@row.CashPoBillAmount.ToString("N0")</td><td class="text-end fw-bold">@row.TotalCommittedAmount.ToString("N0")</td><td class="text-end fw-bold">@row.TotalBilledAmount.ToString("N0")</td></tr>
            }
            @if (Model.Rows.Count == 0) { <tr><td colspan="21" class="text-center text-muted py-4">No data found for the selected filters.</td></tr> }
            </tbody>
        </table>
    </div>
</div>
