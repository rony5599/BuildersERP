@using BuilderERP.Application.Features.Reports
@model BuilderERP.Application.Common.PagedResult<ReportRow>
@{
    var spec = (IReportSpec)ViewBag.Spec;
    var filter = (ReportFilter)ViewBag.Filter;
    ViewData["Title"] = spec.Name;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1 class="h3 mb-0">@spec.Name</h1>
        <p class="text-muted small mb-0">@spec.Category</p>
    </div>
    <div>
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm">Back to Catalog</a>
        <a asp-action="ExportExcel" asp-route-key="@spec.Key"
           asp-route-Search="@filter.Search" asp-route-DateFrom="@filter.DateFrom" asp-route-DateTo="@filter.DateTo" asp-route-ProjectId="@filter.ProjectId"
           class="btn btn-success btn-sm">Export Excel</a>
        <a asp-action="ExportPdf" asp-route-key="@spec.Key"
           asp-route-Search="@filter.Search" asp-route-DateFrom="@filter.DateFrom" asp-route-DateTo="@filter.DateTo" asp-route-ProjectId="@filter.ProjectId"
           class="btn btn-danger btn-sm">Export PDF</a>
    </div>
</div>

<form method="get" asp-action="View" class="row g-2 mb-3">
    <input type="hidden" name="key" value="@spec.Key" />
    <div class="col-md-3">
        <input type="text" name="Search" value="@filter.Search" class="form-control" placeholder="Search..." />
    </div>
    <div class="col-md-2">
        <input type="date" name="DateFrom" value="@(filter.DateFrom?.ToString("yyyy-MM-dd"))" class="form-control" />
    </div>
    <div class="col-md-2">
        <input type="date" name="DateTo" value="@(filter.DateTo?.ToString("yyyy-MM-dd"))" class="form-control" />
    </div>
    <div class="col-md-2">
        <input type="text" name="ProjectId" value="@filter.ProjectId" class="form-control" placeholder="Project Id (optional)" />
    </div>
    <div class="col-md-3">
        <button type="submit" class="btn btn-primary">Apply Filters</button>
        <a asp-action="View" asp-route-key="@spec.Key" class="btn btn-outline-secondary">Clear</a>
    </div>
</form>

<div class="table-responsive">
    <table class="table table-striped table-hover bg-white">
        <thead>
            <tr>
                @foreach (var col in spec.Columns)
                {
                    <th>@col.Header</th>
                }
            </tr>
        </thead>
        <tbody>
            @foreach (var row in Model.Items)
            {
                <tr>
                    @foreach (var col in spec.Columns)
                    {
                        <td>@(row.Cells.GetValueOrDefault(col.Key) ?? "—")</td>
                    }
                </tr>
            }
            @if (Model.Items.Count == 0)
            {
                <tr>
                    <td colspan="@spec.Columns.Count" class="text-center text-muted">No results found.</td>
                </tr>
            }
        </tbody>
    </table>
</div>

@if (Model.TotalPages > 1)
{
    <nav>
        <ul class="pagination">
            @for (var p = 1; p <= Model.TotalPages; p++)
            {
                <li class="page-item @(p == Model.Page ? "active" : "")">
                    <a class="page-link" asp-action="View" asp-route-key="@spec.Key" asp-route-page="@p" asp-route-pageSize="@Model.PageSize"
                       asp-route-Search="@filter.Search" asp-route-DateFrom="@filter.DateFrom" asp-route-DateTo="@filter.DateTo" asp-route-ProjectId="@filter.ProjectId">@p</a>
                </li>
            }
        </ul>
    </nav>
}

<p class="text-muted small">@Model.TotalCount total record(s).</p>
