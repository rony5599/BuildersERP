@model BuilderERP.Application.DTOs.SupplierLedgerDto
@{
    Layout = null;
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Supplier Ledger - @Model.SupplierName</title>
    <style>
        * { box-sizing: border-box; }
        body { font-family: 'Segoe UI', Arial, sans-serif; color: #222; margin: 0; background: #e9ecef; }
        .toolbar { padding: 12px 24px; background: #fff; border-bottom: 1px solid #dee2e6; }
        .toolbar button { padding: 8px 16px; border-radius: 4px; border: 1px solid #0d6efd; background: #0d6efd; color: #fff; font-size: 14px; cursor: pointer; }
        .sheet { position: relative; max-width: 800px; margin: 24px auto; background: #fff; padding: 48px; box-shadow: 0 0 8px rgba(0,0,0,0.1); }
        .letterhead { position: relative; margin-bottom: 16px; min-height: 64px; }
        .company-logo { position: absolute; left: 0; top: 0; max-height: 64px; max-width: 140px; object-fit: contain; }
        .title { text-align: center; font-size: 26px; font-weight: 800; margin: 0; }
        .subtitle { text-align: center; font-size: 12px; color: #555; }
        .party { font-size: 12px; line-height: 1.5; margin: 16px 0; }
        table.ledger { width: 100%; border-collapse: collapse; }
        table.ledger th { background: #0d6efd; color: #fff; text-align: left; padding: 6px 8px; font-size: 11px; }
        table.ledger td { padding: 5px 8px; font-size: 11px; border-bottom: 1px solid #adb5bd; }
        table.ledger .num { text-align: right; }
        table.ledger tfoot td { font-weight: 700; border-top: 1px solid #333; }
        table.ledger tr.open td { font-weight: 600; background: #eef1f3; }
        .note { margin-top: 12px; font-size: 9px; color: #666; }
        .audit-stamp { margin-top: 24px; font-size: 7px; color: #aaa; }
        @@page { margin: 10mm; }
        @@media print {
            body { background: #fff; }
            .toolbar { display: none; }
            .sheet { box-shadow: none; margin: 0; max-width: none; padding: 12px; }
            table.ledger tr { page-break-inside: avoid; }
        }
    </style>
</head>
<body>
    <div class="toolbar"><button onclick="window.print()">Print</button></div>
    <div class="sheet">
        <div class="letterhead">
            <img src="~/uploads/padlogo/padlogo.png" class="company-logo" alt="logo" />
            <div class="title">SUPPLIER LEDGER</div>
            <div class="subtitle">@Model.CompanyName</div>
            @if (Model.Source != BuilderERP.Application.DTOs.SupplierLedgerSource.All)
            {
                <div class="subtitle"><strong>@(Model.Source == BuilderERP.Application.DTOs.SupplierLedgerSource.Po ? "PO" : "EWO") transactions only</strong></div>
            }
            <div class="subtitle">
                @if (Model.DateFrom.HasValue || Model.DateTo.HasValue)
                {
                    <span>Period: @(Model.DateFrom?.ToString("dd-MMM-yyyy") ?? "Beginning") to @(Model.DateTo?.ToString("dd-MMM-yyyy") ?? "Date")</span>
                }
                else
                {
                    <span>All transactions</span>
                }
            </div>
        </div>

        <div class="party">
            <strong>@Model.SupplierName</strong><br />
            @if (!string.IsNullOrWhiteSpace(Model.SupplierAddress)) { <span>@Model.SupplierAddress<br /></span> }
            @if (!string.IsNullOrWhiteSpace(Model.SupplierPhone)) { <span>Phone: @Model.SupplierPhone</span> }
        </div>

        <table class="ledger">
            <thead>
                <tr>
                    <th style="width: 85px;">Date</th>
                    <th>Type</th>
                    <th>Document #</th>
                    <th>Reference</th>
                    <th class="num">Debit</th>
                    <th class="num">Credit</th>
                    <th class="num">Balance</th>
                </tr>
            </thead>
            <tbody>
                <tr class="open"><td colspan="6">Opening Balance</td><td class="num">@Model.OpeningBalance.ToString("N2")</td></tr>
                @foreach (var r in Model.Rows)
                {
                    <tr>
                        <td>@r.Date.ToString("dd-MMM-yyyy")</td>
                        <td>@r.Type</td>
                        <td>@r.DocumentNumber</td>
                        <td>@r.Reference</td>
                        <td class="num">@(r.Debit == 0 ? "" : r.Debit.ToString("N2"))</td>
                        <td class="num">@(r.Credit == 0 ? "" : r.Credit.ToString("N2"))</td>
                        <td class="num">@r.Balance.ToString("N2")</td>
                    </tr>
                }
            </tbody>
            <tfoot>
                <tr>
                    <td colspan="4" class="num">Totals / Closing Balance</td>
                    <td class="num">@Model.TotalDebit.ToString("N2")</td>
                    <td class="num">@Model.TotalCredit.ToString("N2")</td>
                    <td class="num">@Model.ClosingBalance.ToString("N2")</td>
                </tr>
            </tfoot>
        </table>
        <div class="note">Balance = amount payable to the supplier (credits &minus; debits).</div>
        <div class="audit-stamp">Printed by @Model.PrintedBy on @Model.PrintedAt.ToString("dd-MMM-yyyy HH:mm")</div>
    </div>
</body>
</html>
