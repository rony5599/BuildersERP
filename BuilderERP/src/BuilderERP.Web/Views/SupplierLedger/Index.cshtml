@model BuilderERP.Application.DTOs.SupplierLedgerDto?
@using Microsoft.AspNetCore.Mvc.Rendering
@{
    ViewData["Title"] = "Supplier Ledger";
    var supplierId = ViewBag.SupplierId as long?;
    var dateFrom = ViewBag.DateFrom as DateTime?;
    var dateTo = ViewBag.DateTo as DateTime?;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Supplier Ledger</h1>
    @if (Model is not null)
    {
        <a asp-action="Print" asp-route-supplierId="@supplierId" asp-route-dateFrom="@(dateFrom?.ToString("yyyy-MM-dd"))" asp-route-dateTo="@(dateTo?.ToString("yyyy-MM-dd"))" class="btn btn-outline-primary" target="_blank">Print</a>
    }
</div>

<div class="card mb-3">
    <div class="card-body">
        <form asp-action="Index" method="get" class="row gy-3 gx-4 align-items-end">
            <div class="col-12 col-md-4">
                <label class="form-label small mb-1">Supplier</label>
                <select name="supplierId" asp-items="@(ViewBag.Suppliers as SelectList)" class="form-select" required>
                    <option value="">-- Select Supplier --</option>
                </select>
            </div>
            <div class="col-6 col-md-2">
                <label class="form-label small mb-1">From</label>
                <input type="date" name="dateFrom" value="@(dateFrom?.ToString("yyyy-MM-dd"))" class="form-control" />
            </div>
            <div class="col-6 col-md-2">
                <label class="form-label small mb-1">To</label>
                <input type="date" name="dateTo" value="@(dateTo?.ToString("yyyy-MM-dd"))" class="form-control" />
            </div>
            <div class="col-12 col-md-2">
                <button type="submit" class="btn btn-primary w-100">Show Ledger</button>
            </div>
        </form>
    </div>
</div>

@if (Model is null)
{
    <div class="text-muted">Select a supplier to view their ledger.</div>
}
else
{
    <div class="card">
        <div class="card-body pb-0">
            <h5 class="mb-0">@Model.SupplierName</h5>
            <div class="text-muted small">@Model.SupplierAddress @(string.IsNullOrWhiteSpace(Model.SupplierPhone) ? "" : "| " + Model.SupplierPhone)</div>
        </div>
        <div class="table-responsive">
            <table class="table table-striped table-hover mb-0 mt-2">
                <thead>
                    <tr>
                        <th>Date</th>
                        <th>Type</th>
                        <th>Document #</th>
                        <th>Reference</th>
                        <th class="text-end">Debit</th>
                        <th class="text-end">Credit</th>
                        <th class="text-end">Balance</th>
                    </tr>
                </thead>
                <tbody>
                    <tr class="fw-semibold">
                        <td colspan="6">Opening Balance</td>
                        <td class="text-end">@Model.OpeningBalance.ToString("N2")</td>
                    </tr>
                    @foreach (var r in Model.Rows)
                    {
                        <tr>
                            <td>@r.Date.ToString("dd-MMM-yyyy")</td>
                            <td>@r.Type</td>
                            <td>@r.DocumentNumber</td>
                            <td>@r.Reference</td>
                            <td class="text-end">@(r.Debit == 0 ? "" : r.Debit.ToString("N2"))</td>
                            <td class="text-end">@(r.Credit == 0 ? "" : r.Credit.ToString("N2"))</td>
                            <td class="text-end">@r.Balance.ToString("N2")</td>
                        </tr>
                    }
                    @if (Model.Rows.Count == 0)
                    {
                        <tr><td colspan="7" class="text-center text-muted">No transactions in this period.</td></tr>
                    }
                </tbody>
                <tfoot>
                    <tr class="fw-bold">
                        <td colspan="4" class="text-end">Totals</td>
                        <td class="text-end">@Model.TotalDebit.ToString("N2")</td>
                        <td class="text-end">@Model.TotalCredit.ToString("N2")</td>
                        <td class="text-end">@Model.ClosingBalance.ToString("N2")</td>
                    </tr>
                </tfoot>
            </table>
        </div>
        <div class="card-body pt-2 text-muted small">Balance = amount payable to the supplier (credits &minus; debits). Credits: approved PO bills. Debits: payments and approved/completed purchase returns.</div>
    </div>
}
