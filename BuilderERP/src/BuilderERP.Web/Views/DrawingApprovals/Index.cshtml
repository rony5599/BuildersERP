@using BuilderERP.Application.Common
@model PagedResult<BuilderERP.Application.DTOs.DrawingApprovalDto>
@using BuilderERP.Domain.Enums
@using BuilderERP.Shared.Constants
@using BuilderERP.Shared.Authorization
@{
    ViewData["Title"] = "Drawing Approvals";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Drawing Approvals</h1>
    @if (User.HasClaim(PermissionClaimTypes.Permission, PermissionNames.DrawingApprovalManage))
    {
        <a asp-action="Create" class="btn btn-primary">New Drawing Approval</a>
    }
</div>

<div data-grid-container>
    <partial name="_Grid" model="Model" />
</div>
