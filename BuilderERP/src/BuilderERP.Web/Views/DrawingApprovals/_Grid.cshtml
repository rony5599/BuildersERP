@using BuilderERP.Application.Common
@using BuilderERP.Domain.Enums
@using BuilderERP.Shared.Constants
@using BuilderERP.Shared.Authorization
@model PagedResult<BuilderERP.Application.DTOs.DrawingApprovalDto>

<table class="table table-striped table-hover bg-white">
    <thead>
        <tr>
            <th>Drawing Number</th>
            <th>Revision Code</th>
            <th>Approver Name</th>
            <th>Status</th>
            <th>Requested Date</th>
            <th>Action Date</th>
            <th>Comments</th>
            <th>Active</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var approval in Model.Items)
        {
            <tr>
                <td>@approval.DrawingNumber</td>
                <td>@(approval.RevisionCode ?? "—")</td>
                <td>@approval.ApproverName</td>
                <td>
                    @{
                        var badgeClass = approval.Status switch
                        {
                            ApprovalStatus.Approved => "bg-success",
                            ApprovalStatus.Rejected => "bg-danger",
                            _ => "bg-warning"
                        };
                    }
                    <span class="badge @badgeClass">@approval.Status</span>
                </td>
                <td>@approval.RequestedDate.ToString("yyyy-MM-dd")</td>
                <td>@(approval.ActionDate.HasValue ? approval.ActionDate.Value.ToString("yyyy-MM-dd") : "—")</td>
                <td>@(string.IsNullOrEmpty(approval.Comments) ? "—" : (approval.Comments.Length > 50 ? approval.Comments.Substring(0, 50) + "…" : approval.Comments))</td>
                <td>
                    <span class="badge @(approval.IsActive ? "bg-success" : "bg-secondary")">
                        @(approval.IsActive ? "Active" : "Inactive")
                    </span>
                </td>
                <td class="text-end">
                    @if (User.HasClaim(PermissionClaimTypes.Permission, PermissionNames.DrawingApprovalManage))
                    {
                        <a asp-action="Edit" asp-route-id="@approval.Id" class="btn btn-sm btn-outline-secondary">Edit</a>
                        <form asp-action="ToggleActive" asp-route-id="@approval.Id" asp-route-isActive="@approval.IsActive" method="post" class="d-inline">
                            <button type="submit" class="btn btn-sm btn-outline-danger">
                                @(approval.IsActive ? "Deactivate" : "Activate")
                            </button>
                        </form>
                    }
                </td>
            </tr>
        }
        @if (Model.Items.Count == 0)
        {
            <tr>
                <td colspan="9" class="text-center text-muted">No drawing approvals found.</td>
            </tr>
        }
    </tbody>
</table>

<partial name="_Pagination" model="@(new BuilderERP.Web.Models.PaginationViewModel
{
    Page = Model.Page,
    PageSize = Model.PageSize,
    TotalPages = Model.TotalPages,
    TotalCount = Model.TotalCount,
    Action = "Index",
    RouteValues = new()
})" />
