@model BuilderERP.Web.Models.AccountingPostingAssignmentPageViewModel
@{ ViewData["Title"] = "Accounting Posting Assignment"; }
<div class="d-flex justify-content-between align-items-start mb-4"><div><div class="text-primary small mb-1">Administration / Action Assignment</div><h1 class="h3 mb-1">Accounting Posting Assignment</h1><p class="text-muted mb-0">Assign which accounting documents each user may post or reverse.</p></div></div>
@if (TempData["StatusMessage"] is string message) { <div class="alert alert-success">@message</div> }
<div class="card shadow-sm border-0"><div class="card-header bg-white py-3"><h2 class="h6 mb-1">User posting matrix</h2><div class="small text-muted">The user must also have the Accounting.Post role permission. Assignments are enforced on the server.</div></div>
<form method="post"><div class="table-responsive"><table class="table table-hover align-middle mb-0"><thead class="table-light small text-uppercase"><tr><th>User</th><th>Role</th><th class="text-center">PO Bill</th><th class="text-center">EWO Bill</th><th class="text-center">Supplier Payment</th><th class="text-center">Customer Receipt</th><th class="text-center">Manual Journal</th><th class="text-center">Reversal</th></tr></thead><tbody>
@for (var i=0; i<Model.Users.Count; i++) { <tr><td><input asp-for="Users[i].UserId" type="hidden"/><div class="fw-semibold">@Model.Users[i].FullName</div><div class="small text-muted">@Model.Users[i].Email</div></td><td><span class="badge bg-secondary">@Model.Users[i].Role</span></td><td class="text-center"><input asp-for="Users[i].CanPostPoBill" class="form-check-input"/></td><td class="text-center"><input asp-for="Users[i].CanPostEwoBill" class="form-check-input"/></td><td class="text-center"><input asp-for="Users[i].CanPostSupplierPayment" class="form-check-input"/></td><td class="text-center"><input asp-for="Users[i].CanPostCustomerReceipt" class="form-check-input"/></td><td class="text-center"><input asp-for="Users[i].CanPostManualJournal" class="form-check-input"/></td><td class="text-center"><input asp-for="Users[i].CanReverse" class="form-check-input"/></td></tr> }
</tbody></table></div><div class="card-footer bg-white d-flex justify-content-between align-items-center py-3"><span class="small text-muted"><strong>Recommended:</strong> assign reversal only to finance managers.</span><button class="btn btn-primary"><i class="bi bi-check2"></i> Save assignments</button></div></form></div>
