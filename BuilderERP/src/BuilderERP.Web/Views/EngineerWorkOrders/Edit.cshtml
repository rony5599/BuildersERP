@model BuilderERP.Application.DTOs.UpdateEngineerWorkOrderDto
@using BuilderERP.Domain.Enums
@{
    ViewData["Title"] = "Edit Engineer Work Order";
}

@section Styles {
    <link rel="stylesheet" href="~/css/multicolumn-dropdown.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/procurement.css" asp-append-version="true" />
    <style>
        #requisition-menu .multicolumn-dropdown-column:nth-child(1) { flex: 0 0 150px; }
        #requisition-menu .multicolumn-dropdown-column:nth-child(2) { flex: 1; }
    </style>
}

<div class="procurement-form-header ewo-form-header">
    <a asp-action="Index" class="procurement-back" aria-label="Back to engineer work orders"><i class="bi bi-arrow-left"></i></a>
    <div>
        <div class="page-eyebrow"><i class="bi bi-tools"></i> Engineering Procurement</div>
        <h1>Edit Engineer Work Order</h1>
        <p>Update the contractor, commercial terms, line items, and payment stages.</p>
    </div>
</div>

<form asp-action="Edit" method="post" class="ewo-form">
    <input type="hidden" asp-for="Id" />
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
    <div class="ewo-editor-layout">
    <div class="ewo-editor-main">
    <section class="ewo-card ewo-info-card">
        <div class="ewo-card-heading">
            <h5>Work order details</h5>
            <p>Document reference, source requisition, contractor, and commercial terms.</p>
        </div>
    <div class="row g-3 ewo-details-grid">
        <div class="mb-3 col-md-4">
            <label asp-for="WorkOrderNo" class="form-label">Work Order No.</label>
            <input asp-for="WorkOrderNo" class="form-control" />
            <span asp-validation-for="WorkOrderNo" class="text-danger"></span>
        </div>
        <div class="mb-3 col-md-4">
            <label asp-for="EngineerWorkOrderRequisitionId" class="form-label">Engineering Requisition</label>
            <div class="input-group">
                <div class="multicolumn-dropdown-wrapper" style="width: 1%; flex: 1 1 auto;">
                    <div class="multicolumn-dropdown-container" id="requisition-container">
                        <input type="hidden" asp-for="EngineerWorkOrderRequisitionId" id="requisition" />
                        <div class="multicolumn-dropdown-trigger">
                            <input type="text"
                                   class="multicolumn-dropdown-filter form-control"
                                   placeholder="-- Select Requisition --"
                                   autocomplete="off"
                                   id="requisition-filter" />
                            <span class="multicolumn-dropdown-icon"><i class="bi bi-chevron-down"></i></span>
                        </div>
                        <div class="multicolumn-dropdown-menu" id="requisition-menu" style="display: none;">
                            <div class="multicolumn-dropdown-header">
                                <div class="multicolumn-dropdown-column">Requisition No.</div>
                                <div class="multicolumn-dropdown-column">Project Name</div>
                            </div>
                            <div class="multicolumn-dropdown-items">
                                @foreach (var requisition in (List<SelectListItem>)ViewBag.EngineerWorkOrderRequisitions)
                                {
                                    var parts = requisition.Text?.Split(" | ") ?? new[] { "", "" };
                                    <div class="multicolumn-dropdown-item" data-value="@requisition.Value">
                                        <div class="multicolumn-dropdown-column">@(parts.Length > 0 ? parts[0].Trim() : "")</div>
                                        <div class="multicolumn-dropdown-column">@(parts.Length > 1 ? parts[1].Trim() : "")</div>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                </div>
                <button type="button" id="load-requisition-items" class="btn btn-outline-secondary">Load Items</button>
            </div>
            <span asp-validation-for="EngineerWorkOrderRequisitionId" class="text-danger"></span>
        </div>
        <div class="mb-3 col-md-4">
            <label asp-for="SupplierId" class="form-label">Contractor / Supplier</label>
            <select asp-for="SupplierId" asp-items="ViewBag.Suppliers" class="form-select">
                <option value="">-- Select Supplier --</option>
            </select>
            <span asp-validation-for="SupplierId" class="text-danger"></span>
        </div>
        <input asp-for="Status" type="hidden" value="@EngineerWorkOrderStatus.Draft" />
        <div class="mb-3 col-12">
            <label asp-for="TermsAndCondition" class="form-label">Terms and Conditions</label>
            <textarea asp-for="TermsAndCondition" class="form-control" rows="3" placeholder="Enter commercial terms, scope notes, and conditions"></textarea>
        </div>
    </div>
    </section>

    <section class="ewo-card ewo-lines-card">
        <div class="ewo-section-title ewo-section-title-with-action">
            <div><h5>Line Items</h5><p>Update the materials, quantities, rates, and scope remarks.</p></div>
            <button type="button" class="btn btn-sm btn-outline-primary" data-add-row-for="ewo-details-table"><i class="bi bi-plus-lg"></i> Add Item</button>
        </div>
        <div class="table-responsive ewo-table-wrap">
    <table class="table table-sm align-middle" id="ewo-details-table">
        <thead>
            <tr>
                <th>Material</th>
                <th>Unit</th>
                <th>Qty</th>
                <th>Rate</th>
                <th>Remarks</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @for (var i = 0; i < Model.Details.Count; i++)
            {
                <tr class="detail-row">
                    <td>
                        <div class="multicolumn-dropdown-wrapper">
                            <div class="multicolumn-dropdown-container" id="material-@(i)-container">
                                <input type="hidden" asp-for="Details[i].MaterialId" id="material-@(i)" value="@Model.Details[i].MaterialId" />
                                <div class="multicolumn-dropdown-trigger">
                                    <input type="text"
                                           class="multicolumn-dropdown-filter form-control form-control-sm"
                                           placeholder="Search Material..."
                                           autocomplete="off"
                                           id="material-@(i)-filter" />
                                    <span class="multicolumn-dropdown-icon">
                                        <i class="bi bi-chevron-down"></i>
                                    </span>
                                </div>
                                <div class="multicolumn-dropdown-menu" id="material-@(i)-menu" style="display: none;">
                                    <div class="multicolumn-dropdown-header">
                                        <div class="multicolumn-dropdown-column">Code</div>
                                        <div class="multicolumn-dropdown-column">Name</div>
                                        <div class="multicolumn-dropdown-column">Category</div>
                                    </div>
                                    <div class="multicolumn-dropdown-items">
                                        @foreach (var material in (IEnumerable<dynamic>)ViewBag.Materials ?? new List<dynamic>())
                                        {
                                            var parts = material.Text?.Split(" | ") ?? new[] { "", "", "" };
                                            <div class="multicolumn-dropdown-item" data-value="@material.Value">
                                                <div class="multicolumn-dropdown-column">@(parts.Length > 0 ? parts[0]?.Trim() ?? "" : "")</div>
                                                <div class="multicolumn-dropdown-column">@(parts.Length > 1 ? parts[1]?.Trim() ?? "" : "")</div>
                                                <div class="multicolumn-dropdown-column">@(parts.Length > 2 ? parts[2]?.Trim() ?? "" : "")</div>
                                            </div>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    </td>
                    <td>
                        <select asp-for="Details[i].UnitOfMeasure" asp-items="Html.GetEnumSelectList<UnitOfMeasure>()" class="form-select form-select-sm"></select>
                    </td>
                    <td><input name="Details[@i].Qty" type="number" step="0.001" value="@Model.Details[i].Qty" class="form-control form-control-sm" /></td>
                    <td><input name="Details[@i].Rate" type="number" step="0.01" value="@Model.Details[i].Rate" class="form-control form-control-sm" /></td>
                    <td><input name="Details[@i].Remarks" value="@Model.Details[i].Remarks" class="form-control form-control-sm" /></td>
                    <td><button type="button" class="btn btn-sm btn-outline-danger" data-remove-row>Remove</button></td>
                </tr>
            }
            <tr class="detail-row-template">
                <td>
                    <div class="multicolumn-dropdown-wrapper material-dropdown-template">
                        <div class="multicolumn-dropdown-container" id="material-__index__-container">
                            <input type="hidden" name="Details[__index__].MaterialId" id="material-__index__" value="" />
                            <div class="multicolumn-dropdown-trigger">
                                <input type="text"
                                       class="multicolumn-dropdown-filter form-control form-control-sm"
                                       placeholder="Search Material..."
                                       autocomplete="off"
                                       id="material-__index__-filter" />
                                <span class="multicolumn-dropdown-icon">
                                    <i class="bi bi-chevron-down"></i>
                                </span>
                            </div>
                            <div class="multicolumn-dropdown-menu" id="material-__index__-menu" style="display: none;">
                                <div class="multicolumn-dropdown-header">
                                    <div class="multicolumn-dropdown-column">Code</div>
                                    <div class="multicolumn-dropdown-column">Name</div>
                                    <div class="multicolumn-dropdown-column">Category</div>
                                </div>
                                <div class="multicolumn-dropdown-items">
                                    @foreach (var material in (IEnumerable<dynamic>)ViewBag.Materials ?? new List<dynamic>())
                                    {
                                        var parts = material.Text?.Split(" | ") ?? new[] { "", "", "" };
                                        <div class="multicolumn-dropdown-item" data-value="@material.Value">
                                            <div class="multicolumn-dropdown-column">@(parts.Length > 0 ? parts[0]?.Trim() ?? "" : "")</div>
                                            <div class="multicolumn-dropdown-column">@(parts.Length > 1 ? parts[1]?.Trim() ?? "" : "")</div>
                                            <div class="multicolumn-dropdown-column">@(parts.Length > 2 ? parts[2]?.Trim() ?? "" : "")</div>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                </td>
                <td>
                    <select name="Details[__index__].UnitOfMeasure" asp-items="Html.GetEnumSelectList<UnitOfMeasure>()" class="form-select form-select-sm"></select>
                </td>
                <td><input name="Details[__index__].Qty" type="number" step="0.001" class="form-control form-control-sm" /></td>
                <td><input name="Details[__index__].Rate" type="number" step="0.01" class="form-control form-control-sm" /></td>
                <td><input name="Details[__index__].Remarks" class="form-control form-control-sm" /></td>
                <td><button type="button" class="btn btn-sm btn-outline-danger" data-remove-row>Remove</button></td>
            </tr>
        </tbody>
    </table>
        </div>
    </section>

    <section class="ewo-card ewo-payment-card">
        <partial name="_PaymentHeadsTable" model="Model.PaymentHeads" />
    </section>
    </div>
    <partial name="_EditorSidebar" />
    </div>

    <div class="procurement-form-actions ewo-form-actions">
        <a asp-action="Index" class="btn btn-outline-secondary">Discard changes</a>
        <button type="submit" class="btn btn-primary"><i class="bi bi-check2"></i> Save draft</button>
    </div>
</form>

<partial name="_DetailLineItemsScripts" />
<script src="~/js/multicolumn-dropdown.js" asp-append-version="true"></script>
<script>
    document.addEventListener('DOMContentLoaded', function () {
        new MultiColumnDropdown('requisition-container');

        initDetailTable('ewo-details-table', 'Details');

        function updateWorkOrderSummary() {
            var total = 0;
            var rows = document.querySelectorAll('#ewo-details-table tbody tr.detail-row');
            rows.forEach(function (row) {
                var qty = Number(row.querySelector('[name$=".Qty"]')?.value || 0);
                var rate = Number(row.querySelector('[name$=".Rate"]')?.value || 0);
                total += qty * rate;
            });
            document.getElementById('ewo-summary-lines').textContent = rows.length;
            document.getElementById('ewo-summary-total').textContent = '৳ ' + total.toLocaleString('en-BD', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
        }

        updateWorkOrderSummary();
        document.getElementById('ewo-details-table').addEventListener('input', updateWorkOrderSummary);
        document.getElementById('ewo-details-table').addEventListener('change', updateWorkOrderSummary);
        document.getElementById('ewo-details-table').addEventListener('click', function (event) {
            if (event.target.closest('[data-remove-row]')) setTimeout(updateWorkOrderSummary, 0);
        });

        // Initialize material dropdowns in a specific row
        function initializeDropdownsInRow(row) {
            const containers = row.querySelectorAll('[id$="-container"]');
            containers.forEach(container => {
                if (container.id.includes('material-')) {
                    new MultiColumnDropdown(container.id);
                }
            });
        }

        // Initialize dropdowns for rows already present on page load
        document.querySelectorAll('#ewo-details-table tbody tr.detail-row').forEach(function (row) {
            initializeDropdownsInRow(row);
        });

        // Hook into the row addition process
        var addBtn = document.querySelector('[data-add-row-for="ewo-details-table"]');
        if (addBtn) {
            addBtn.addEventListener('click', function () {
                setTimeout(function () {
                    var rows = document.querySelectorAll('#ewo-details-table tbody tr.detail-row');
                    var lastRow = rows[rows.length - 1];
                    if (lastRow) {
                        initializeDropdownsInRow(lastRow);
                        updateWorkOrderSummary();
                    }
                }, 10);
            });
        }

        var loadBtn = document.getElementById('load-requisition-items');
        var requisitionSelect = document.querySelector('[name="EngineerWorkOrderRequisitionId"]');
        if (loadBtn && requisitionSelect) {
            loadBtn.addEventListener('click', function () {
                var requisitionId = requisitionSelect.value;
                if (!requisitionId) {
                    alert('Select a requisition first.');
                    return;
                }

                fetch('@Url.Action("RequisitionItems", "EngineerWorkOrders")?requisitionId=' + requisitionId)
                    .then(function (response) {
                        if (!response.ok) throw new Error('Failed to load requisition items.');
                        return response.json();
                    })
                    .then(function (items) {
                        clearDetailRows('ewo-details-table', 'Details');
                        items.forEach(function (item) {
                            var row = addDetailRow('ewo-details-table', 'Details', {
                                MaterialId: item.materialId,
                                UnitOfMeasure: item.unitOfMeasure,
                                Qty: item.qty,
                                Rate: item.rate,
                                Remarks: item.remarks
                            });
                            if (row) {
                                initializeDropdownsInRow(row);
                            }
                        });
                        updateWorkOrderSummary();
                    })
                    .catch(function (err) {
                        alert(err.message);
                    });
            });
        }
    });
</script>
