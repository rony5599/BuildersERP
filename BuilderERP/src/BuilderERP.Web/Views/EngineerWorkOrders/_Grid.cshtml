@using BuilderERP.Application.Common
@using BuilderERP.Domain.Enums
@using BuilderERP.Shared.Constants
@using BuilderERP.Shared.Authorization
@using BuilderERP.Domain.Entities
@using BuilderERP.Web.Models
@using Microsoft.AspNetCore.Mvc.Rendering
@model PagedResult<BuilderERP.Application.DTOs.EngineerWorkOrderDto>
@{
    var workOrderNo = ViewBag.WorkOrderNo as string;
    var projectId = ViewBag.ProjectId as long?;
    var status = ViewBag.Status as EngineerWorkOrderStatus?;
    var dateFrom = ViewBag.DateFrom as DateTime?;
    var dateTo = ViewBag.DateTo as DateTime?;
    var hasFilters = !string.IsNullOrWhiteSpace(workOrderNo) || projectId.HasValue || status.HasValue || dateFrom.HasValue || dateTo.HasValue;
    var assignment = ViewBag.ActionAssignment as EngineerWorkOrderActionAssignment;
}

<div class="ewo-filter-card">
    <div class="ewo-filter-heading">
        <div><i class="bi bi-funnel"></i><span>Filter work orders</span></div>
        @if (hasFilters)
        {
            <a asp-action="Index" class="ewo-clear-filters"><i class="bi bi-x-circle"></i> Clear all</a>
        }
    </div>
    <div class="ewo-filter-body">
        <form asp-action="Index" method="get" class="row gy-3 gx-4 align-items-end grid-search-form">
            <div class="col-12 col-sm-6 col-lg-2">
                <label class="form-label small mb-1">WO #</label>
                <input type="search" name="workOrderNo" value="@workOrderNo" class="form-control" placeholder="WO #" />
            </div>
            <div class="col-12 col-sm-6 col-lg-2">
                <label class="form-label small mb-1">Project</label>
                <select name="projectId" asp-items="@(ViewBag.Projects as SelectList)" class="form-select">
                    <option value="">All Projects</option>
                </select>
            </div>
            <div class="col-12 col-sm-6 col-lg-2">
                <label class="form-label small mb-1">Status</label>
                <select name="status" asp-items="@(ViewBag.Statuses as SelectList)" class="form-select">
                    <option value="">All Statuses</option>
                </select>
            </div>
            <div class="col-12 col-sm-6 col-lg-2">
                <label class="form-label small mb-1">Date From</label>
                <input type="date" name="dateFrom" value="@(dateFrom?.ToString("yyyy-MM-dd"))" class="form-control" />
            </div>
            <div class="col-12 col-sm-6 col-lg-2">
                <label class="form-label small mb-1">Date To</label>
                <input type="date" name="dateTo" value="@(dateTo?.ToString("yyyy-MM-dd"))" class="form-control" />
            </div>
            <div class="col-12 col-sm-6 col-lg-2 d-flex gap-2">
                <button type="submit" class="btn btn-primary flex-grow-1"><i class="bi bi-search"></i> Apply Filters</button>
            </div>
        </form>
    </div>
</div>

<div class="ewo-list-card">
    <div class="ewo-list-heading">
        <div>
            <h5>Work Order Register</h5>
            <p>@Model.TotalCount work order@(Model.TotalCount == 1 ? "" : "s") found</p>
        </div>
    </div>
    <div class="table-responsive">
    <table class="table ewo-list-table mb-0">
        <thead>
            <tr>
                <th>WO #</th>
                <th>Requisition</th>
                <th>Project</th>
                <th>Supplier</th>
                <th>Rev #</th>
                <th>Total Amount</th>
                <th>Status</th>
                <th class="text-end">Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var order in Model.Items)
            {
                <tr>
                    <td><span class="document-number">@order.WorkOrderNo</span></td>
                    <td><span class="reference-chip">@order.RequisitionNumber</span></td>
                    <td>@order.ProjectName</td>
                    <td>@order.SupplierName</td>
                    <td>
                        @if (order.PreviousWorkOrderId.HasValue)
                        {
                            <a href="#" class="link-primary" data-load-wo-details="@order.PreviousWorkOrderId" title="View previous revision">@order.RevisionNo</a>
                        }
                        else
                        {
                            @order.RevisionNo
                        }
                    </td>
                    <td class="amount-cell">@order.TotalAmount.ToString("N2")</td>
                    <td>
                        <span class="procurement-status @(order.Status == EngineerWorkOrderStatus.Draft && !string.IsNullOrWhiteSpace(order.RejectionReason) ? "status-danger" : StatusBadgeClass(order.Status))"><span class="badge-dot"></span>@(order.Status == EngineerWorkOrderStatus.Draft && !string.IsNullOrWhiteSpace(order.RejectionReason) ? "Revision Required" : HumanizeStatus(order.Status))</span>
                        @if (!string.IsNullOrWhiteSpace(order.RejectionReason)) { <span class="document-subtitle text-danger">Returned: @order.RejectionReason</span> }
                    </td>
                    <td class="text-end">
                        <div class="dropdown ewo-row-actions">
                            <button class="btn btn-sm" type="button" data-bs-toggle="dropdown" aria-expanded="false" aria-label="Actions for @order.WorkOrderNo">
                                <i class="bi bi-three-dots-vertical"></i>
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end">
                                <li><a asp-action="Print" asp-route-id="@order.Id" class="dropdown-item" target="_blank"><i class="bi bi-printer"></i> Print Work Order</a></li>
                                @if (User.HasClaim(PermissionClaimTypes.Permission, PermissionNames.EngineerWorkOrderManage))
                                {
                                    @if (assignment?.CanDraftEdit == true && order.Status == EngineerWorkOrderStatus.Draft)
                                    {
                                        <li><a asp-action="Edit" asp-route-id="@order.Id" class="dropdown-item"><i class="bi bi-pencil"></i> Edit</a></li>
                                    }
                                    @if (assignment?.CanSubmit == true && order.Status == EngineerWorkOrderStatus.Draft)
                                    {
                                        <li><partial name="_WorkflowButton" model="@(new EngineerWorkOrderWorkflowButtonViewModel(order.Id, "submit", "Submit", ""))" /></li>
                                    }
                                    @if (assignment?.CanRequestApproval == true && order.Status == EngineerWorkOrderStatus.Submitted)
                                    {
                                        <li><partial name="_WorkflowButton" model="@(new EngineerWorkOrderWorkflowButtonViewModel(order.Id, "request", "Request approval", ""))" /></li>
                                    }
                                    @if (assignment?.CanApprove == true && order.Status == EngineerWorkOrderStatus.UnderApproval)
                                    {
                                        <li><partial name="_WorkflowButton" model="@(new EngineerWorkOrderWorkflowButtonViewModel(order.Id, "approve", "Approve", ""))" /></li>
                                    }
                                    @if (assignment?.CanReject == true && order.Status is EngineerWorkOrderStatus.Submitted or EngineerWorkOrderStatus.UnderApproval or EngineerWorkOrderStatus.Approved or EngineerWorkOrderStatus.Active)
                                    {
                                        <li><partial name="_WorkflowButton" model="@(new EngineerWorkOrderWorkflowButtonViewModel(order.Id, "reject", "Reject", ""))" /></li>
                                    }
                                    @if (assignment?.CanCancel == true && order.Status is EngineerWorkOrderStatus.Draft or EngineerWorkOrderStatus.Submitted or EngineerWorkOrderStatus.UnderApproval or EngineerWorkOrderStatus.Rejected)
                                    {
                                        <li><partial name="_WorkflowButton" model="@(new EngineerWorkOrderWorkflowButtonViewModel(order.Id, "cancel", "Cancel", ""))" /></li>
                                    }
                                    @if (order.IsLatestRevision && (order.Status == EngineerWorkOrderStatus.Approved || order.Status == EngineerWorkOrderStatus.Active))
                                    {
                                        @if (assignment?.CanDraftEdit == true)
                                        {
                                            <li><a asp-action="Revise" asp-route-id="@order.Id" class="dropdown-item"><i class="bi bi-arrow-repeat"></i> Create Revision</a></li>
                                        }
                                        <li><a asp-action="PaymentHeads" asp-route-id="@order.Id" class="dropdown-item"><i class="bi bi-percent"></i> Payment Heads</a></li>
                                    }
                                }
                                @if (order.IsLatestRevision && (order.Status == EngineerWorkOrderStatus.Approved || order.Status == EngineerWorkOrderStatus.Active))
                                {
                                    @if (User.HasClaim(PermissionClaimTypes.Permission, PermissionNames.EwoBillManage))
                                    {
                                        <li><hr class="dropdown-divider" /></li>
                                        <li><a asp-controller="EwoBills" asp-action="Create" asp-route-engineerWorkOrderId="@order.Id" class="dropdown-item"><i class="bi bi-receipt"></i> Create Bill</a></li>
                                    }
                                    @if (User.HasClaim(PermissionClaimTypes.Permission, PermissionNames.EwoBillView))
                                    {
                                        <li><a asp-controller="EwoBills" asp-action="Statement" asp-route-engineerWorkOrderId="@order.Id" class="dropdown-item" target="_blank"><i class="bi bi-file-earmark-bar-graph"></i> View Statement</a></li>
                                    }
                                }
                            </ul>
                        </div>
                    </td>
                </tr>
            }
            @if (Model.Items.Count == 0)
            {
                <tr>
                    <td colspan="8" class="procurement-empty"><i class="bi bi-clipboard-x"></i><strong>No work orders found</strong><span>Try adjusting the filters or create a new work order.</span></td>
                </tr>
            }
        </tbody>
    </table>
    </div>
    <div class="procurement-pagination">
        <partial name="_Pagination" model="@(new BuilderERP.Web.Models.PaginationViewModel
        {
            Page = Model.Page,
            PageSize = Model.PageSize,
            TotalPages = Model.TotalPages,
            TotalCount = Model.TotalCount,
            Action = "Index",
            RouteValues = BuildFilterRouteValues(workOrderNo, projectId, status, dateFrom, dateTo)
        })" />
    </div>
</div>

@functions {
    private static Dictionary<string, string?> BuildFilterRouteValues(string? workOrderNo, long? projectId, EngineerWorkOrderStatus? status, DateTime? dateFrom, DateTime? dateTo)
    {
        var values = new Dictionary<string, string?>();
        if (!string.IsNullOrWhiteSpace(workOrderNo)) values["workOrderNo"] = workOrderNo;
        if (projectId.HasValue) values["projectId"] = projectId.Value.ToString();
        if (status.HasValue) values["status"] = status.Value.ToString();
        if (dateFrom.HasValue) values["dateFrom"] = dateFrom.Value.ToString("yyyy-MM-dd");
        if (dateTo.HasValue) values["dateTo"] = dateTo.Value.ToString("yyyy-MM-dd");
        return values;
    }

    private static string StatusBadgeClass(EngineerWorkOrderStatus status) => status switch
    {
        EngineerWorkOrderStatus.Draft => "status-neutral",
        EngineerWorkOrderStatus.Submitted => "status-warning",
        EngineerWorkOrderStatus.UnderApproval => "status-warning",
        EngineerWorkOrderStatus.Approved => "status-info",
        EngineerWorkOrderStatus.Active => "status-success",
        EngineerWorkOrderStatus.Superseded => "status-neutral",
        EngineerWorkOrderStatus.Cancelled => "status-danger",
        EngineerWorkOrderStatus.Rejected => "status-danger",
        _ => "status-neutral"
    };

    private static string HumanizeStatus(EngineerWorkOrderStatus status) =>
        status == EngineerWorkOrderStatus.UnderApproval ? "Under Approval" : status.ToString();
}

