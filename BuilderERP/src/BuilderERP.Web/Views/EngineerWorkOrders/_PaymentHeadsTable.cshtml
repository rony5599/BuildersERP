@model List<BuilderERP.Application.DTOs.EngineerWorkOrderPaymentHeadDto>
@* Requires the _DetailLineItemsScripts partial on the page. Posts as PaymentHeads[i].HeadName / .Percent. *@

<h5 class="mt-4">Payment Heads</h5>
<p class="text-muted small mb-2">Stages the contractor is paid by as work progresses (e.g. Vertical 18%, Internal 22%, Security 10%). They must total 100%. Needed before the work order can be billed.</p>
<div class="mb-2">@Html.ValidationMessage("PaymentHeads", null, new { @class = "text-danger small" })</div>
<table class="table table-sm" id="ewo-heads-table" style="max-width: 640px;">
    <thead>
        <tr>
            <th>Head</th>
            <th style="width: 140px;">Percent</th>
            <th style="width: 90px;"></th>
        </tr>
    </thead>
    <tbody>
        @for (var i = 0; i < Model.Count; i++)
        {
            <tr class="detail-row">
                <td><input name="PaymentHeads[@i].HeadName" value="@Model[i].HeadName" maxlength="100" class="form-control form-control-sm" /></td>
                <td><input name="PaymentHeads[@i].Percent" type="number" step="0.01" min="0" max="100" value="@Model[i].Percent.ToString(System.Globalization.CultureInfo.InvariantCulture)" class="form-control form-control-sm head-percent" /></td>
                <td><button type="button" class="btn btn-sm btn-outline-danger" data-remove-row>Remove</button></td>
            </tr>
        }
        <tr class="detail-row-template">
            <td><input name="PaymentHeads[__index__].HeadName" maxlength="100" class="form-control form-control-sm" /></td>
            <td><input name="PaymentHeads[__index__].Percent" type="number" step="0.01" min="0" max="100" class="form-control form-control-sm head-percent" /></td>
            <td><button type="button" class="btn btn-sm btn-outline-danger" data-remove-row>Remove</button></td>
        </tr>
    </tbody>
    <tfoot>
        <tr>
            <th class="text-end">Total</th>
            <th id="ewo-heads-total">0.00%</th>
            <th></th>
        </tr>
    </tfoot>
</table>
<div class="mb-3 d-flex gap-2">
    <button type="button" class="btn btn-sm btn-outline-primary" data-add-row-for="ewo-heads-table">Add Head</button>
    <button type="button" class="btn btn-sm btn-outline-secondary" id="ewo-heads-standard">Use standard split (Vertical 18 / Internal 22 / RCC 15 / Roof 15 / Finishing 20 / Security 10)</button>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        initDetailTable('ewo-heads-table', 'PaymentHeads');
        var table = document.getElementById('ewo-heads-table');
        var totalEl = document.getElementById('ewo-heads-total');

        function recalcHeads() {
            var total = 0;
            table.querySelectorAll('tbody tr.detail-row .head-percent').forEach(function (el) { total += parseFloat(el.value) || 0; });
            total = Math.round(total * 100) / 100;
            totalEl.textContent = total.toFixed(2) + '%';
            totalEl.className = total === 100 || total === 0 ? '' : 'text-danger';
        }

        table.addEventListener('input', recalcHeads);
        table.addEventListener('click', function () { setTimeout(recalcHeads, 0); });

        document.getElementById('ewo-heads-standard').addEventListener('click', function () {
            var hasValues = Array.prototype.some.call(table.querySelectorAll('tbody tr.detail-row input'), function (el) { return el.value; });
            if (hasValues && !confirm('Replace the current payment heads with the standard split?')) return;
            clearDetailRows('ewo-heads-table', 'PaymentHeads');
            [['Vertical', 18], ['Internal', 22], ['RCC', 15], ['Roof', 15], ['Finishing', 20], ['Security', 10]].forEach(function (h) {
                addDetailRow('ewo-heads-table', 'PaymentHeads', { HeadName: h[0], Percent: h[1] });
            });
            recalcHeads();
        });

        recalcHeads();
    });
</script>
