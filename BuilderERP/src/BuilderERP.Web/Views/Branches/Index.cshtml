@model IReadOnlyList<BuilderERP.Application.DTOs.BranchDto>
@using BuilderERP.Shared.Constants
@using BuilderERP.Shared.Authorization
@{
    ViewData["Title"] = "Branches";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Branches</h1>
    @if (User.HasClaim(PermissionClaimTypes.Permission, PermissionNames.BranchManage))
    {
        <a asp-action="Create" class="btn btn-primary">New Branch</a>
    }
</div>

<table class="table table-striped table-hover bg-white">
    <thead>
        <tr>
            <th>Name</th>
            <th>Code</th>
            <th>Company</th>
            <th>Status</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var branch in Model)
        {
            <tr>
                <td>@branch.Name</td>
                <td>@branch.Code</td>
                <td>@branch.CompanyName</td>
                <td>
                    <span class="badge @(branch.IsActive ? "bg-success" : "bg-secondary")">
                        @(branch.IsActive ? "Active" : "Inactive")
                    </span>
                </td>
                <td class="text-end">
                    @if (User.HasClaim(PermissionClaimTypes.Permission, PermissionNames.BranchManage))
                    {
                        <a asp-action="Edit" asp-route-id="@branch.Id" class="btn btn-sm btn-outline-secondary">Edit</a>
                        <form asp-action="ToggleActive" asp-route-id="@branch.Id" asp-route-isActive="@branch.IsActive" method="post" class="d-inline">
                            <button type="submit" class="btn btn-sm btn-outline-danger">
                                @(branch.IsActive ? "Deactivate" : "Activate")
                            </button>
                        </form>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>
