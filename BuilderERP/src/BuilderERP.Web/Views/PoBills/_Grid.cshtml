@using BuilderERP.Application.Common
@using BuilderERP.Domain.Enums
@using BuilderERP.Shared.Constants
@using BuilderERP.Shared.Authorization
@using Microsoft.AspNetCore.Mvc.Rendering
@using BuilderERP.Domain.Entities
@using BuilderERP.Web.Models
@model PagedResult<BuilderERP.Application.DTOs.PoBillDto>
@{
    var assignment = ViewBag.ActionAssignment as PoBillActionAssignment;
    var billNumber = ViewBag.BillNumber as string;
    var supplier = ViewBag.Supplier as string;
    var status = ViewBag.Status as PoBillStatus?;
    var dateFrom = ViewBag.DateFrom as DateTime?;
    var dateTo = ViewBag.DateTo as DateTime?;
    var hasFilters = !string.IsNullOrWhiteSpace(billNumber) || !string.IsNullOrWhiteSpace(supplier) || status.HasValue || dateFrom.HasValue || dateTo.HasValue;
}

<div class="card mb-3">
    <div class="card-body">
        <form asp-action="Index" method="get" class="row gy-3 gx-4 align-items-end grid-search-form">
            <div class="col-12 col-sm-6 col-lg-2">
                <label class="form-label small mb-1">Bill # / PO #</label>
                <input type="search" name="billNumber" value="@billNumber" class="form-control" placeholder="Bill # or PO #" />
            </div>
            <div class="col-12 col-sm-6 col-lg-2">
                <label class="form-label small mb-1">Supplier</label>
                <input type="search" name="supplier" value="@supplier" class="form-control" placeholder="Supplier" />
            </div>
            <div class="col-12 col-sm-6 col-lg-2">
                <label class="form-label small mb-1">Status</label>
                <select name="status" asp-items="@(ViewBag.Statuses as SelectList)" class="form-select">
                    <option value="">All Statuses</option>
                </select>
            </div>
            <div class="col-12 col-sm-6 col-lg-2">
                <label class="form-label small mb-1">Date From</label>
                <input type="date" name="dateFrom" value="@(dateFrom?.ToString("yyyy-MM-dd"))" class="form-control" />
            </div>
            <div class="col-12 col-sm-6 col-lg-2">
                <label class="form-label small mb-1">Date To</label>
                <input type="date" name="dateTo" value="@(dateTo?.ToString("yyyy-MM-dd"))" class="form-control" />
            </div>
            <div class="col-12 col-sm-6 col-lg-2 d-flex gap-2">
                <button type="submit" class="btn btn-primary flex-grow-1">Filter</button>
                @if (hasFilters)
                {
                    <a asp-action="Index" class="btn btn-outline-secondary flex-grow-1">Clear</a>
                }
            </div>
        </form>
    </div>
</div>

<div class="card">
    <table class="table table-striped table-hover mb-0">
        <thead>
            <tr>
                <th>Bill #</th>
                <th>Date</th>
                <th>PO #</th>
                <th>Supplier</th>
                <th>Supplier Inv #</th>
                <th class="text-end">Amount</th>
                <th>Prepared By</th>
                <th>Status</th>
                <th>Active</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var bill in Model.Items)
            {
                <tr>
                    <td>@bill.BillNumber</td>
                    <td>@bill.BillDate.ToString("dd-MMM-yyyy")</td>
                    <td>@bill.PONumber</td>
                    <td>@bill.SupplierName</td>
                    <td>@bill.SupplierInvoiceNumber</td>
                    <td class="text-end">@bill.TotalAmount.ToString("N2")</td>
                    <td>@bill.PreparedBy</td>
                    <td>
                        <span class="badge @(bill.Status == PoBillStatus.Draft && !string.IsNullOrWhiteSpace(bill.RejectionReason) ? "bg-danger" : StatusBadgeClass(bill.Status))"><span class="badge-dot"></span>@(bill.Status == PoBillStatus.Draft && !string.IsNullOrWhiteSpace(bill.RejectionReason) ? "Revision Required" : HumanizeStatus(bill.Status))</span>
                        @if (!string.IsNullOrWhiteSpace(bill.RejectionReason)) { <div class="small text-danger mt-1" title="@bill.RejectionReason"><i class="bi bi-arrow-counterclockwise"></i> Returned: @bill.RejectionReason</div> }
                    </td>
                    <td>
                        <span class="badge @(bill.IsActive ? "bg-success" : "bg-secondary")">
                            <span class="badge-dot"></span>@(bill.IsActive ? "Active" : "Inactive")
                        </span>
                    </td>
                    <td class="text-end">
                        <a asp-action="Print" asp-route-id="@bill.Id" class="btn btn-sm btn-outline-primary" target="_blank">Print</a>
                        @if (User.HasClaim(PermissionClaimTypes.Permission, PermissionNames.PoBillManage))
                        {
                            @if (assignment?.CanDraftEdit == true && bill.Status == PoBillStatus.Draft) { <a asp-action="Edit" asp-route-id="@bill.Id" class="btn btn-sm btn-outline-secondary">Edit</a> }
                            @if (assignment?.CanSubmit == true && bill.Status == PoBillStatus.Draft) { <partial name="_WorkflowButton" model="@(new PoBillWorkflowButtonViewModel(bill.Id, "submit", "Submit", "btn-outline-primary"))" /> }
                            @if (assignment?.CanRequestApproval == true && bill.Status == PoBillStatus.Submitted) { <partial name="_WorkflowButton" model="@(new PoBillWorkflowButtonViewModel(bill.Id, "request", "Request approval", "btn-outline-primary"))" /> }
                            @if (assignment?.CanApprove == true && bill.Status == PoBillStatus.AwaitingApproval) { <partial name="_WorkflowButton" model="@(new PoBillWorkflowButtonViewModel(bill.Id, "approve", "Approve", "btn-success"))" /> }
                            @if (assignment?.CanReject == true && bill.Status is PoBillStatus.Submitted or PoBillStatus.AwaitingApproval or PoBillStatus.Approved) { <partial name="_WorkflowButton" model="@(new PoBillWorkflowButtonViewModel(bill.Id, "reject", "Reject", "btn-outline-danger"))" /> }
                            @if (assignment?.CanCancel == true && bill.Status is PoBillStatus.Draft or PoBillStatus.Submitted or PoBillStatus.AwaitingApproval or PoBillStatus.Rejected) { <partial name="_WorkflowButton" model="@(new PoBillWorkflowButtonViewModel(bill.Id, "cancel", "Cancel", "btn-outline-danger"))" /> }
                            <form asp-action="ToggleActive" asp-route-id="@bill.Id" asp-route-isActive="@bill.IsActive" method="post" class="d-inline">
                                <button type="submit" class="btn btn-sm btn-outline-danger">
                                    @(bill.IsActive ? "Deactivate" : "Activate")
                                </button>
                            </form>
                        }
                    </td>
                </tr>
            }
            @if (Model.Items.Count == 0)
            {
                <tr>
                    <td colspan="10" class="text-center text-muted">No PO bills found.</td>
                </tr>
            }
        </tbody>
    </table>
    <div class="card-body pt-2">
        <partial name="_Pagination" model="@(new BuilderERP.Web.Models.PaginationViewModel
        {
            Page = Model.Page,
            PageSize = Model.PageSize,
            TotalPages = Model.TotalPages,
            TotalCount = Model.TotalCount,
            Action = "Index",
            RouteValues = BuildFilterRouteValues(billNumber, supplier, status, dateFrom, dateTo)
        })" />
    </div>
</div>

@functions {
    private static Dictionary<string, string?> BuildFilterRouteValues(string? billNumber, string? supplier, PoBillStatus? status, DateTime? dateFrom, DateTime? dateTo)
    {
        var values = new Dictionary<string, string?>();
        if (!string.IsNullOrWhiteSpace(billNumber)) values["billNumber"] = billNumber;
        if (!string.IsNullOrWhiteSpace(supplier)) values["supplier"] = supplier;
        if (status.HasValue) values["status"] = status.Value.ToString();
        if (dateFrom.HasValue) values["dateFrom"] = dateFrom.Value.ToString("yyyy-MM-dd");
        if (dateTo.HasValue) values["dateTo"] = dateTo.Value.ToString("yyyy-MM-dd");
        return values;
    }

    private static string StatusBadgeClass(PoBillStatus status) => status switch
    {
        PoBillStatus.Draft => "bg-warning",
        PoBillStatus.Submitted => "bg-primary",
        PoBillStatus.AwaitingApproval => "bg-warning",
        PoBillStatus.Approved => "bg-success",
        PoBillStatus.Rejected => "bg-danger",
        PoBillStatus.Cancelled => "bg-secondary",
        _ => "bg-secondary"
    };
    private static string HumanizeStatus(PoBillStatus status) => status == PoBillStatus.AwaitingApproval ? "Awaiting Approval" : status.ToString();
}
