@model BuilderERP.Web.Models.PoBillWorkflowButtonViewModel
@{ var iconClass = Model.WorkflowAction switch { "submit" => "bi-send", "request" => "bi-person-check", "approve" => "bi-check-lg", "reject" => "bi-x-lg", "cancel" => "bi-slash-circle", _ => "bi-arrow-right" }; }
@if (Model.WorkflowAction == "reject")
{
    <button type="button" class="btn btn-sm @Model.Css workflow-action" data-bs-toggle="modal" data-bs-target="#reject-po-bill-modal" data-bill-id="@Model.Id" title="@Model.Label" aria-label="@Model.Label"><i class="bi @iconClass"></i></button>
}
else
{
    <form asp-action="WorkflowAction" asp-route-id="@Model.Id" method="post" class="d-inline workflow-action-form"><input type="hidden" name="workflowAction" value="@Model.WorkflowAction" /><button type="submit" class="btn btn-sm @Model.Css workflow-action" data-workflow-action="@Model.WorkflowAction" title="@Model.Label" aria-label="@Model.Label"><i class="bi @iconClass"></i></button></form>
}
