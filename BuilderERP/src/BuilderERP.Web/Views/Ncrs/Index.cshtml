@model IReadOnlyList<BuilderERP.Application.DTOs.NcrDto>
@using BuilderERP.Shared.Constants
@using BuilderERP.Shared.Authorization
@using BuilderERP.Domain.Enums
@{
    ViewData["Title"] = "NCRs";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Non-Conformance Reports</h1>
    @if (User.HasClaim(PermissionClaimTypes.Permission, PermissionNames.NcrManage))
    {
        <a asp-action="Create" class="btn btn-primary">New NCR</a>
    }
</div>

<table class="table table-striped table-hover bg-white">
    <thead>
        <tr>
            <th>NCR Number</th>
            <th>Project</th>
            <th>Raised Date</th>
            <th>Description</th>
            <th>Severity</th>
            <th>Status</th>
            <th>Closed Date</th>
            <th>Active</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.NcrNumber</td>
                <td>@item.ProjectName</td>
                <td>@item.RaisedDate.ToString("yyyy-MM-dd")</td>
                <td>@(item.Description.Length > 60 ? item.Description.Substring(0, 60) + "..." : item.Description)</td>
                <td>
                    @{
                        var severityBadge = item.Severity switch
                        {
                            NcrSeverity.Minor => "bg-info",
                            NcrSeverity.Major => "bg-warning",
                            NcrSeverity.Critical => "bg-danger",
                            _ => "bg-secondary"
                        };
                    }
                    <span class="badge @severityBadge">@item.Severity</span>
                </td>
                <td>
                    @{
                        var statusBadge = item.Status switch
                        {
                            NcrStatus.Open => "bg-danger",
                            NcrStatus.InReview => "bg-warning",
                            NcrStatus.Closed => "bg-success",
                            _ => "bg-secondary"
                        };
                    }
                    <span class="badge @statusBadge">@item.Status</span>
                </td>
                <td>@(item.ClosedDate.HasValue ? item.ClosedDate.Value.ToString("yyyy-MM-dd") : "—")</td>
                <td>
                    <span class="badge @(item.IsActive ? "bg-success" : "bg-secondary")">
                        @(item.IsActive ? "Active" : "Inactive")
                    </span>
                </td>
                <td class="text-end">
                    @if (User.HasClaim(PermissionClaimTypes.Permission, PermissionNames.NcrManage))
                    {
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">Edit</a>
                        <form asp-action="ToggleActive" asp-route-id="@item.Id" asp-route-isActive="@item.IsActive" method="post" class="d-inline">
                            <button type="submit" class="btn btn-sm btn-outline-danger">
                                @(item.IsActive ? "Deactivate" : "Activate")
                            </button>
                        </form>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>
