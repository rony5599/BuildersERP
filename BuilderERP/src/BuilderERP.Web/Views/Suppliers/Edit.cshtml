@model BuilderERP.Application.DTOs.UpdateSupplierDto
@{
    ViewData["Title"] = "Edit Supplier/Contractor";
}

<h1 class="h3 mb-4">Edit Supplier/Contractor</h1>

<form asp-action="Edit" method="post" class="col-md-8">
    <input type="hidden" asp-for="Id" />
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
    <div class="row">
        <div class="mb-3 col-md-4">
            <label asp-for="SupplierCode" class="form-label">Supplier/Contractor Code</label>
            <input asp-for="SupplierCode" class="form-control" />
            <span asp-validation-for="SupplierCode" class="text-danger"></span>
        </div>
        <div class="mb-3 col-md-4">
            <label asp-for="Name" class="form-label"></label>
            <input asp-for="Name" class="form-control" />
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>
        <div class="mb-3 col-md-4">
            <label asp-for="VendorCategory" class="form-label"></label>
            <input asp-for="VendorCategory" class="form-control" />
            <span asp-validation-for="VendorCategory" class="text-danger"></span>
        </div>
        <div class="mb-3 col-md-4">
            <label asp-for="ContactPerson" class="form-label"></label>
            <input asp-for="ContactPerson" class="form-control" />
            <span asp-validation-for="ContactPerson" class="text-danger"></span>
        </div>
        <div class="mb-3 col-md-4">
            <label asp-for="Phone" class="form-label"></label>
            <input asp-for="Phone" class="form-control" />
            <span asp-validation-for="Phone" class="text-danger"></span>
        </div>
        <div class="mb-3 col-md-4">
            <label asp-for="Email" class="form-label"></label>
            <input asp-for="Email" class="form-control" />
            <span asp-validation-for="Email" class="text-danger"></span>
        </div>
        <div class="mb-3 col-md-8">
            <label asp-for="Address" class="form-label"></label>
            <input asp-for="Address" class="form-control" />
            <span asp-validation-for="Address" class="text-danger"></span>
        </div>
        <div class="mb-3 col-md-4">
            <label asp-for="TaxRegistrationNumber" class="form-label"></label>
            <input asp-for="TaxRegistrationNumber" class="form-control" />
            <span asp-validation-for="TaxRegistrationNumber" class="text-danger"></span>
        </div>
        <div class="mb-3 col-md-4">
            <label asp-for="VatRegistrationNumber" class="form-label"></label>
            <input asp-for="VatRegistrationNumber" class="form-control" />
            <span asp-validation-for="VatRegistrationNumber" class="text-danger"></span>
        </div>
        <div class="mb-3 col-md-4">
            <label asp-for="PaymentTerms" class="form-label"></label>
            <input asp-for="PaymentTerms" class="form-control" placeholder="e.g. Net 30" />
            <span asp-validation-for="PaymentTerms" class="text-danger"></span>
        </div>
        <div class="mb-3 col-md-4">
            <label asp-for="CreditLimit" class="form-label"></label>
            <input asp-for="CreditLimit" class="form-control" />
            <span asp-validation-for="CreditLimit" class="text-danger"></span>
        </div>
        <div class="mb-3 col-md-4">
            <label asp-for="Rating" class="form-label">Rating (0-5)</label>
            <input asp-for="Rating" class="form-control" />
            <span asp-validation-for="Rating" class="text-danger"></span>
        </div>
        <div class="mb-3 col-md-4">
            <label asp-for="BankName" class="form-label"></label>
            <input asp-for="BankName" class="form-control" />
            <span asp-validation-for="BankName" class="text-danger"></span>
        </div>
        <div class="mb-3 col-md-4">
            <label asp-for="BankAccountNumber" class="form-label"></label>
            <input asp-for="BankAccountNumber" class="form-control" />
            <span asp-validation-for="BankAccountNumber" class="text-danger"></span>
        </div>
        <div class="mb-3 col-md-4">
            <label asp-for="BankBranch" class="form-label"></label>
            <input asp-for="BankBranch" class="form-control" />
            <span asp-validation-for="BankBranch" class="text-danger"></span>
        </div>
        <div class="mb-3 col-md-4">
            <label asp-for="BankRoutingOrSwiftCode" class="form-label"></label>
            <input asp-for="BankRoutingOrSwiftCode" class="form-control" />
            <span asp-validation-for="BankRoutingOrSwiftCode" class="text-danger"></span>
        </div>
    </div>
    <button type="submit" class="btn btn-primary">Save</button>
    <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
</form>
