@using BuilderERP.Application.Common
@using BuilderERP.Shared.Constants
@using BuilderERP.Shared.Authorization
@model PagedResult<BuilderERP.Application.DTOs.CustomerCommunicationDto>

<table class="table table-striped table-hover bg-white">
    <thead>
        <tr>
            <th>Date</th>
            <th>Customer</th>
            <th>Type</th>
            <th>Subject</th>
            <th>Active</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.Items)
        {
            <tr>
                <td>@item.CommunicationDate.ToString("yyyy-MM-dd")</td>
                <td>@item.CustomerName</td>
                <td>@item.Type</td>
                <td>@item.Subject</td>
                <td>
                    <span class="badge @(item.IsActive ? "bg-success" : "bg-secondary")">
                        @(item.IsActive ? "Active" : "Inactive")
                    </span>
                </td>
                <td class="text-end">
                    @if (User.HasClaim(PermissionClaimTypes.Permission, PermissionNames.CustomerCommunicationManage))
                    {
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">Edit</a>
                        <form asp-action="ToggleActive" asp-route-id="@item.Id" asp-route-isActive="@item.IsActive" method="post" class="d-inline">
                            <button type="submit" class="btn btn-sm btn-outline-danger">
                                @(item.IsActive ? "Deactivate" : "Activate")
                            </button>
                        </form>
                    }
                </td>
            </tr>
        }
        @if (Model.Items.Count == 0)
        {
            <tr>
                <td colspan="6" class="text-center text-muted">No communications found.</td>
            </tr>
        }
    </tbody>
</table>

<partial name="_Pagination" model="@(new BuilderERP.Web.Models.PaginationViewModel
{
    Page = Model.Page,
    PageSize = Model.PageSize,
    TotalPages = Model.TotalPages,
    TotalCount = Model.TotalCount,
    Action = "Index",
    RouteValues = new()
})" />
