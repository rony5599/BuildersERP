@model IReadOnlyList<BuilderERP.Application.DTOs.BrokerDto>
@using BuilderERP.Shared.Constants
@using BuilderERP.Shared.Authorization
@{
    ViewData["Title"] = "Brokers / Agents";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Brokers / Agents</h1>
    @if (User.HasClaim(PermissionClaimTypes.Permission, PermissionNames.BrokerManage))
    {
        <a asp-action="Create" class="btn btn-primary">New Broker</a>
    }
</div>

<table class="table table-striped table-hover bg-white">
    <thead>
        <tr>
            <th>Name</th>
            <th>Phone</th>
            <th>Email</th>
            <th>License #</th>
            <th>Default Commission %</th>
            <th>Active</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var broker in Model)
        {
            <tr>
                <td>@broker.Name</td>
                <td>@broker.Phone</td>
                <td>@broker.Email</td>
                <td>@broker.LicenseNumber</td>
                <td>@broker.DefaultCommissionRate.ToString("N2")%</td>
                <td>
                    <span class="badge @(broker.IsActive ? "bg-success" : "bg-secondary")">
                        @(broker.IsActive ? "Active" : "Inactive")
                    </span>
                </td>
                <td class="text-end">
                    @if (User.HasClaim(PermissionClaimTypes.Permission, PermissionNames.BrokerManage))
                    {
                        <a asp-action="Edit" asp-route-id="@broker.Id" class="btn btn-sm btn-outline-secondary">Edit</a>
                        <form asp-action="ToggleActive" asp-route-id="@broker.Id" asp-route-isActive="@broker.IsActive" method="post" class="d-inline">
                            <button type="submit" class="btn btn-sm btn-outline-danger">
                                @(broker.IsActive ? "Deactivate" : "Activate")
                            </button>
                        </form>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>
