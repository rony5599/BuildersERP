@model IReadOnlyList<BuilderERP.Application.DTOs.QualityChecklistDto>
@using BuilderERP.Shared.Constants
@using BuilderERP.Shared.Authorization
@{
    ViewData["Title"] = "Quality Checklists";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Quality Checklists</h1>
    @if (User.HasClaim(PermissionClaimTypes.Permission, PermissionNames.QualityChecklistManage))
    {
        <a asp-action="Create" class="btn btn-primary">New Quality Checklist</a>
    }
</div>

<table class="table table-striped table-hover bg-white">
    <thead>
        <tr>
            <th>Project</th>
            <th>Checklist Name</th>
            <th>Category</th>
            <th>Checklist Date</th>
            <th>Checked By</th>
            <th>Result</th>
            <th>Active</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.ProjectName</td>
                <td>@item.ChecklistName</td>
                <td>@item.Category</td>
                <td>@item.ChecklistDate.ToString("yyyy-MM-dd")</td>
                <td>@item.CheckedBy</td>
                <td>
                    <span class="badge @(item.Result switch { BuilderERP.Domain.Enums.QcResult.Pass => "bg-success", BuilderERP.Domain.Enums.QcResult.Fail => "bg-danger", _ => "bg-secondary" })">
                        @item.Result
                    </span>
                </td>
                <td>
                    <span class="badge @(item.IsActive ? "bg-success" : "bg-secondary")">
                        @(item.IsActive ? "Active" : "Inactive")
                    </span>
                </td>
                <td class="text-end">
                    @if (User.HasClaim(PermissionClaimTypes.Permission, PermissionNames.QualityChecklistManage))
                    {
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">Edit</a>
                        <form asp-action="ToggleActive" asp-route-id="@item.Id" asp-route-isActive="@item.IsActive" method="post" class="d-inline">
                            <button type="submit" class="btn btn-sm btn-outline-danger">
                                @(item.IsActive ? "Deactivate" : "Activate")
                            </button>
                        </form>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>
