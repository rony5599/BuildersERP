@model BuilderERP.Web.Models.CashPoBillWorkflowButtonViewModel
@{ var icon = Model.WorkflowAction switch { "submit" => "bi-send", "request" => "bi-person-check", "approve" => "bi-check-lg", "reject" => "bi-x-lg", "cancel" => "bi-slash-circle", _ => "bi-arrow-right" }; }
@if (Model.WorkflowAction == "reject") { <button type="button" class="btn btn-sm @Model.Css" data-bs-toggle="modal" data-bs-target="#cash-reject-modal" data-document-id="@Model.Id" title="Reject"><i class="bi @icon"></i><span class="ms-1">@Model.Label</span></button> }
else { <form asp-action="WorkflowAction" asp-route-id="@Model.Id" method="post" class="d-inline workflow-action-form"><input type="hidden" name="workflowAction" value="@Model.WorkflowAction" /><button type="submit" class="btn btn-sm @Model.Css" title="@Model.Label"><i class="bi @icon"></i><span class="ms-1">@Model.Label</span></button></form> }
