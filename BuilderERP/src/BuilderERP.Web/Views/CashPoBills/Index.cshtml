@using BuilderERP.Application.Common
@model PagedResult<BuilderERP.Application.DTOs.CashPoBillDto>
@using BuilderERP.Shared.Constants
@using BuilderERP.Shared.Authorization
@{
    ViewData["Title"] = "Cash PO Bills";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div class="d-flex align-items-center gap-3">
        <h1 class="h3 mb-0">Cash PO Bills</h1>
        <partial name="_CashWorkflowHelp" />
    </div>
    @if (User.HasClaim(PermissionClaimTypes.Permission, PermissionNames.CashPoBillManage) && (ViewBag.ActionAssignment as BuilderERP.Domain.Entities.CashPoBillActionAssignment)?.CanDraftEdit == true)
    {
        <a asp-action="Create" class="btn btn-primary">New Cash PO Bill</a>
    }
</div>

@if (TempData["ErrorMessage"] is string error) { <div class="alert alert-danger">@error</div> }
@if (TempData["StatusMessage"] is string message) { <div class="alert alert-success">@message</div> }

<div data-grid-container>
    <partial name="_Grid" model="Model" />
</div>
