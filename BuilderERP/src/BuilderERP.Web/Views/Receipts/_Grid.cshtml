@using BuilderERP.Application.Common
@model PagedResult<BuilderERP.Application.DTOs.ReceiptDto>
@using BuilderERP.Shared.Constants
@using BuilderERP.Shared.Authorization

<table class="table table-striped table-hover bg-white">
    <thead>
        <tr>
            <th>Receipt #</th>
            <th>Installment #</th>
            <th>Payment Date</th>
            <th>Amount Paid</th>
            <th>Method</th>
            <th>Active</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var receipt in Model.Items)
        {
            <tr>
                <td>@receipt.ReceiptNumber</td>
                <td>@receipt.InstallmentNumber</td>
                <td>@receipt.PaymentDate.ToString("yyyy-MM-dd")</td>
                <td>@receipt.AmountPaid</td>
                <td>@receipt.PaymentMethod</td>
                <td>
                    <span class="badge @(receipt.IsActive ? "bg-success" : "bg-secondary")">
                        @(receipt.IsActive ? "Active" : "Inactive")
                    </span>
                </td>
                <td class="text-end">
                    @if (User.HasClaim(PermissionClaimTypes.Permission, PermissionNames.ReceiptManage))
                    {
                        <a asp-action="Edit" asp-route-id="@receipt.Id" class="btn btn-sm btn-outline-secondary">Edit</a>
                        <form asp-action="ToggleActive" asp-route-id="@receipt.Id" asp-route-isActive="@receipt.IsActive" method="post" class="d-inline">
                            <button type="submit" class="btn btn-sm btn-outline-danger">
                                @(receipt.IsActive ? "Deactivate" : "Activate")
                            </button>
                        </form>
                    }
                </td>
            </tr>
        }
        @if (Model.Items.Count == 0)
        {
            <tr>
                <td colspan="7" class="text-center text-muted">No receipts found.</td>
            </tr>
        }
    </tbody>
</table>

<partial name="_Pagination" model="@(new BuilderERP.Web.Models.PaginationViewModel
{
    Page = Model.Page,
    PageSize = Model.PageSize,
    TotalPages = Model.TotalPages,
    TotalCount = Model.TotalCount,
    Action = "Index",
    RouteValues = new()
})" />
