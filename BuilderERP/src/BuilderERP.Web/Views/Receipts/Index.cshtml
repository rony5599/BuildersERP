@model IReadOnlyList<BuilderERP.Application.DTOs.ReceiptDto>
@using BuilderERP.Shared.Constants
@using BuilderERP.Shared.Authorization
@{
    ViewData["Title"] = "Receipts";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Receipts</h1>
    @if (User.HasClaim(PermissionClaimTypes.Permission, PermissionNames.ReceiptManage))
    {
        <a asp-action="Create" class="btn btn-primary">New Receipt</a>
    }
</div>

<table class="table table-striped table-hover bg-white">
    <thead>
        <tr>
            <th>Receipt #</th>
            <th>Installment #</th>
            <th>Payment Date</th>
            <th>Amount Paid</th>
            <th>Method</th>
            <th>Active</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var receipt in Model)
        {
            <tr>
                <td>@receipt.ReceiptNumber</td>
                <td>@receipt.InstallmentNumber</td>
                <td>@receipt.PaymentDate.ToString("yyyy-MM-dd")</td>
                <td>@receipt.AmountPaid</td>
                <td>@receipt.PaymentMethod</td>
                <td>
                    <span class="badge @(receipt.IsActive ? "bg-success" : "bg-secondary")">
                        @(receipt.IsActive ? "Active" : "Inactive")
                    </span>
                </td>
                <td class="text-end">
                    @if (User.HasClaim(PermissionClaimTypes.Permission, PermissionNames.ReceiptManage))
                    {
                        <a asp-action="Edit" asp-route-id="@receipt.Id" class="btn btn-sm btn-outline-secondary">Edit</a>
                        <form asp-action="ToggleActive" asp-route-id="@receipt.Id" asp-route-isActive="@receipt.IsActive" method="post" class="d-inline">
                            <button type="submit" class="btn btn-sm btn-outline-danger">
                                @(receipt.IsActive ? "Deactivate" : "Activate")
                            </button>
                        </form>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>
