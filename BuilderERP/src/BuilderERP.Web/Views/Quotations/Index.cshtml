@model IReadOnlyList<BuilderERP.Application.DTOs.QuotationDto>
@using BuilderERP.Shared.Constants
@using BuilderERP.Shared.Authorization
@{
    ViewData["Title"] = "Quotations";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Quotations</h1>
    @if (User.HasClaim(PermissionClaimTypes.Permission, PermissionNames.QuotationManage))
    {
        <a asp-action="Create" class="btn btn-primary">New Quotation</a>
    }
</div>

<table class="table table-striped table-hover bg-white">
    <thead>
        <tr>
            <th>Customer</th>
            <th>Property Unit</th>
            <th>Quoted Price</th>
            <th>Valid Until</th>
            <th>Status</th>
            <th>Active</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var quotation in Model)
        {
            <tr>
                <td>@quotation.CustomerName</td>
                <td>@quotation.PropertyUnitNumber</td>
                <td>@quotation.QuotedPrice</td>
                <td>@quotation.ValidUntil?.ToString("yyyy-MM-dd")</td>
                <td>@quotation.Status</td>
                <td>
                    <span class="badge @(quotation.IsActive ? "bg-success" : "bg-secondary")">
                        @(quotation.IsActive ? "Active" : "Inactive")
                    </span>
                </td>
                <td class="text-end">
                    @if (User.HasClaim(PermissionClaimTypes.Permission, PermissionNames.QuotationManage))
                    {
                        <a asp-action="Edit" asp-route-id="@quotation.Id" class="btn btn-sm btn-outline-secondary">Edit</a>
                        <form asp-action="ToggleActive" asp-route-id="@quotation.Id" asp-route-isActive="@quotation.IsActive" method="post" class="d-inline">
                            <button type="submit" class="btn btn-sm btn-outline-danger">
                                @(quotation.IsActive ? "Deactivate" : "Activate")
                            </button>
                        </form>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>
