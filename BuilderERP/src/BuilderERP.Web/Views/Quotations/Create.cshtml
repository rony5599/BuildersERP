@model BuilderERP.Application.DTOs.CreateQuotationDto
@using BuilderERP.Domain.Enums
@{
    ViewData["Title"] = "New Quotation";
}

<h1 class="h3 mb-4">New Quotation</h1>

<form asp-action="Create" method="post" class="col-md-6">
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
    <div class="mb-3">
        <label asp-for="CustomerId" class="form-label"></label>
        <select asp-for="CustomerId" asp-items="ViewBag.Customers" class="form-select">
            <option value="">-- Select Customer --</option>
        </select>
        <span asp-validation-for="CustomerId" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="PropertyUnitId" class="form-label"></label>
        <select asp-for="PropertyUnitId" asp-items="ViewBag.PropertyUnits" class="form-select">
            <option value="">-- Select Property Unit --</option>
        </select>
        <span asp-validation-for="PropertyUnitId" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="QuotedPrice" class="form-label"></label>
        <input asp-for="QuotedPrice" class="form-control" />
        <span asp-validation-for="QuotedPrice" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="ValidUntil" class="form-label"></label>
        <input asp-for="ValidUntil" type="date" class="form-control" />
    </div>
    <div class="mb-3">
        <label asp-for="Status" class="form-label"></label>
        <select asp-for="Status" asp-items="Html.GetEnumSelectList<QuotationStatus>()" class="form-select"></select>
        <span asp-validation-for="Status" class="text-danger"></span>
    </div>
    <button type="submit" class="btn btn-primary">Save</button>
    <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
</form>
