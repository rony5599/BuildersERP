@model IReadOnlyList<BuilderERP.Application.DTOs.DrawingRevisionDto>
@using BuilderERP.Shared.Constants
@using BuilderERP.Shared.Authorization
@{
    ViewData["Title"] = "Drawing Revisions";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Drawing Revisions</h1>
    @if (User.HasClaim(PermissionClaimTypes.Permission, PermissionNames.DrawingRevisionManage))
    {
        <a asp-action="Create" class="btn btn-primary">New Revision</a>
    }
</div>

<table class="table table-striped table-hover bg-white">
    <thead>
        <tr>
            <th>Drawing Number</th>
            <th>Revision Code</th>
            <th>Revised Date</th>
            <th>Change Description</th>
            <th>Current</th>
            <th>File</th>
            <th>Active</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.DrawingNumber</td>
                <td>@item.RevisionCode</td>
                <td>@item.RevisedDate.ToString("yyyy-MM-dd")</td>
                <td>@item.ChangeDescription</td>
                <td>
                    <span class="badge @(item.IsCurrent ? "bg-success" : "bg-secondary")">
                        @(item.IsCurrent ? "Yes" : "No")
                    </span>
                </td>
                <td><a href="@item.FilePath" target="_blank">View</a></td>
                <td>
                    <span class="badge @(item.IsActive ? "bg-success" : "bg-secondary")">
                        @(item.IsActive ? "Active" : "Inactive")
                    </span>
                </td>
                <td class="text-end">
                    @if (User.HasClaim(PermissionClaimTypes.Permission, PermissionNames.DrawingRevisionManage))
                    {
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">Edit</a>
                        <form asp-action="ToggleActive" asp-route-id="@item.Id" asp-route-isActive="@item.IsActive" method="post" class="d-inline">
                            <button type="submit" class="btn btn-sm btn-outline-danger">
                                @(item.IsActive ? "Deactivate" : "Activate")
                            </button>
                        </form>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>
