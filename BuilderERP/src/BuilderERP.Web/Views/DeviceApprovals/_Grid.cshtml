@using BuilderERP.Application.Common
@using BuilderERP.Domain.Entities
@using BuilderERP.Shared.Constants
@using BuilderERP.Shared.Authorization
@model PagedResult<BuilderERP.Application.DTOs.DeviceApprovalDto>
@{
    string StatusBadgeClass(DeviceStatus status) => status switch
    {
        DeviceStatus.Approved => "bg-success",
        DeviceStatus.Pending => "bg-warning text-dark",
        DeviceStatus.Rejected => "bg-danger",
        DeviceStatus.Revoked => "bg-secondary",
        DeviceStatus.Blocked => "bg-dark",
        _ => "bg-secondary"
    };
}

<table class="table table-striped table-hover bg-white">
    <thead>
        <tr>
            <th>User</th>
            <th>Device Name</th>
            <th>Type</th>
            <th>Browser</th>
            <th>OS</th>
            <th>IP Address</th>
            <th>Requested Date</th>
            <th>Status</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var device in Model.Items)
        {
            <tr>
                <td>@device.UserName <span class="text-muted">(@device.UserEmail)</span></td>
                <td>@device.DeviceName</td>
                <td>@device.DeviceType</td>
                <td>@device.Browser</td>
                <td>@device.OperatingSystem</td>
                <td>@device.IPAddress</td>
                <td>@device.RequestedDate.ToLocalTime().ToString("g")</td>
                <td><span class="badge @StatusBadgeClass(device.Status)">@device.Status</span></td>
                <td class="text-end">
                    @if (device.Status == DeviceStatus.Pending && User.HasClaim(PermissionClaimTypes.Permission, PermissionNames.DeviceApprovalManage))
                    {
                        <form asp-action="Approve" asp-route-id="@device.Id" method="post" class="d-inline" onsubmit="return confirm('Approve this device for @device.UserEmail?');">
                            <button type="submit" class="btn btn-sm btn-success">Approve</button>
                        </form>
                        <form asp-action="Reject" asp-route-id="@device.Id" method="post" class="d-inline" onsubmit="return confirm('Reject this device for @device.UserEmail?');">
                            <button type="submit" class="btn btn-sm btn-outline-danger">Reject</button>
                        </form>
                    }
                </td>
            </tr>
        }
        @if (Model.Items.Count == 0)
        {
            <tr>
                <td colspan="9" class="text-center text-muted">No device requests found.</td>
            </tr>
        }
    </tbody>
</table>

<partial name="_Pagination" model="@(new BuilderERP.Web.Models.PaginationViewModel
{
    Page = Model.Page,
    PageSize = Model.PageSize,
    TotalPages = Model.TotalPages,
    TotalCount = Model.TotalCount,
    Action = "Index",
    RouteValues = new()
})" />
