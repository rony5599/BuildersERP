@model BuilderERP.Application.DTOs.CreateSupplierPaymentDto
@using BuilderERP.Domain.Enums
@{
    ViewData["Title"] = "New Supplier Payment";
    var bills = (IReadOnlyList<BuilderERP.Application.DTOs.PayableBillDto>)ViewBag.PayableBills;
}

<h1 class="h3 mb-4">New Supplier Payment</h1>

<form asp-action="Create" method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
    <div class="row col-lg-10">
        <div class="mb-3 col-md-12">
            <label for="billKey" class="form-label">Approved Bill (with outstanding balance)</label>
            <input type="hidden" asp-for="PoBillId" id="poBillId" />
            <input type="hidden" asp-for="EwoBillId" id="ewoBillId" />
            <select id="billKey" class="form-select">
                <option value="">-- Select bill (Bill # | Supplier | PO / EWO # | Outstanding) --</option>
                @foreach (var group in bills.GroupBy(b => b.IsEwoBill).OrderBy(g => g.Key))
                {
                    <optgroup label="@(group.Key ? "EWO Bills" : "PO Bills")">
                        @foreach (var b in group)
                        {
                            var selected = b.IsEwoBill ? b.Id == Model.EwoBillId : b.Id == Model.PoBillId;
                            <option value="@(b.IsEwoBill ? "EWO" : "PO"):@b.Id" data-outstanding="@b.Outstanding.ToString(System.Globalization.CultureInfo.InvariantCulture)" selected="@selected">@b.BillNumber | @b.SupplierName | @b.PONumber | Outstanding @b.Outstanding.ToString("N2")</option>
                        }
                    </optgroup>
                }
            </select>
        </div>
        <div class="mb-3 col-md-3">
            <label asp-for="PaymentDate" class="form-label"></label>
            <input asp-for="PaymentDate" type="date" class="form-control" />
        </div>
        <div class="mb-3 col-md-3">
            <label asp-for="Amount" class="form-label"></label>
            <input asp-for="Amount" type="number" step="0.01" class="form-control" id="amount" />
            <span asp-validation-for="Amount" class="text-danger"></span>
        </div>
        <div class="mb-3 col-md-3">
            <label asp-for="Method" class="form-label"></label>
            <select asp-for="Method" asp-items="Html.GetEnumSelectList<PaymentMethod>()" class="form-select"></select>
        </div>
        <div class="mb-3 col-md-3">
            <label asp-for="ReferenceNumber" class="form-label">Cheque / Ref #</label>
            <input asp-for="ReferenceNumber" class="form-control" />
        </div>
        <div class="mb-3 col-md-12">
            <label asp-for="Remarks" class="form-label"></label>
            <textarea asp-for="Remarks" class="form-control" rows="2"></textarea>
        </div>
    </div>
    <div>
        <button type="submit" class="btn btn-primary">Save</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
    </div>
</form>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        var select = document.getElementById('billKey');
        var poBillId = document.getElementById('poBillId');
        var ewoBillId = document.getElementById('ewoBillId');
        var amount = document.getElementById('amount');
        function sync() {
            var parts = select.value.split(':');
            poBillId.value = parts[0] === 'PO' ? parts[1] : '';
            ewoBillId.value = parts[0] === 'EWO' ? parts[1] : '';
        }
        select.addEventListener('change', function () {
            sync();
            var opt = select.options[select.selectedIndex];
            if (opt && opt.dataset.outstanding) amount.value = opt.dataset.outstanding;
        });
        sync();
        // Opened from a bill's "Pay" link: suggest the outstanding amount.
        var initial = select.options[select.selectedIndex];
        if (initial && initial.dataset.outstanding && !(parseFloat(amount.value) > 0)) amount.value = initial.dataset.outstanding;
    });
</script>
