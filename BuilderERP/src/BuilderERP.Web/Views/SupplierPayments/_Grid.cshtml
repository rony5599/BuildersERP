@using BuilderERP.Application.Common
@using BuilderERP.Shared.Constants
@using BuilderERP.Shared.Authorization
@model PagedResult<BuilderERP.Application.DTOs.SupplierPaymentDto>
@{
    var search = ViewBag.Search as string;
    var dateFrom = ViewBag.DateFrom as DateTime?;
    var dateTo = ViewBag.DateTo as DateTime?;
    var hasFilters = !string.IsNullOrWhiteSpace(search) || dateFrom.HasValue || dateTo.HasValue;
    var routeValues = new Dictionary<string, string?>();
    if (!string.IsNullOrWhiteSpace(search)) routeValues["search"] = search;
    if (dateFrom.HasValue) routeValues["dateFrom"] = dateFrom.Value.ToString("yyyy-MM-dd");
    if (dateTo.HasValue) routeValues["dateTo"] = dateTo.Value.ToString("yyyy-MM-dd");
}

<div class="card mb-3">
    <div class="card-body">
        <form asp-action="Index" method="get" class="row gy-3 gx-4 align-items-end grid-search-form">
            <div class="col-12 col-sm-6 col-lg-4">
                <label class="form-label small mb-1">Payment # / Bill # / Supplier</label>
                <input type="search" name="search" value="@search" class="form-control" placeholder="Search" />
            </div>
            <div class="col-12 col-sm-6 col-lg-2">
                <label class="form-label small mb-1">Date From</label>
                <input type="date" name="dateFrom" value="@(dateFrom?.ToString("yyyy-MM-dd"))" class="form-control" />
            </div>
            <div class="col-12 col-sm-6 col-lg-2">
                <label class="form-label small mb-1">Date To</label>
                <input type="date" name="dateTo" value="@(dateTo?.ToString("yyyy-MM-dd"))" class="form-control" />
            </div>
            <div class="col-12 col-sm-6 col-lg-2 d-flex gap-2">
                <button type="submit" class="btn btn-primary flex-grow-1">Filter</button>
                @if (hasFilters)
                {
                    <a asp-action="Index" class="btn btn-outline-secondary flex-grow-1">Clear</a>
                }
            </div>
        </form>
    </div>
</div>

<div class="card">
    <table class="table table-striped table-hover mb-0">
        <thead>
            <tr>
                <th>Payment #</th>
                <th>Date</th>
                <th>Supplier</th>
                <th>Bill #</th>
                <th>Method</th>
                <th>Reference</th>
                <th class="text-end">Amount</th>
                <th>Prepared By</th>
                <th>Active</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var p in Model.Items)
            {
                <tr>
                    <td>@p.PaymentNumber</td>
                    <td>@p.PaymentDate.ToString("dd-MMM-yyyy")</td>
                    <td>@p.SupplierName</td>
                    <td>@p.BillNumber <span class="badge bg-light text-dark border">@p.BillType</span></td>
                    <td>@p.Method</td>
                    <td>@p.ReferenceNumber</td>
                    <td class="text-end">@p.Amount.ToString("N2")</td>
                    <td>@p.PreparedBy</td>
                    <td>
                        <span class="badge @(p.IsActive ? "bg-success" : "bg-secondary")">
                            <span class="badge-dot"></span>@(p.IsActive ? "Active" : "Void")
                        </span>
                    </td>
                    <td class="text-end">
                        @if (User.HasClaim(PermissionClaimTypes.Permission, PermissionNames.SupplierPaymentManage))
                        {
                            <form asp-action="ToggleActive" asp-route-id="@p.Id" asp-route-isActive="@p.IsActive" method="post" class="d-inline">
                                <button type="submit" class="btn btn-sm btn-outline-danger">@(p.IsActive ? "Void" : "Restore")</button>
                            </form>
                        }
                    </td>
                </tr>
            }
            @if (Model.Items.Count == 0)
            {
                <tr><td colspan="10" class="text-center text-muted">No payments found.</td></tr>
            }
        </tbody>
    </table>
    <div class="card-body pt-2">
        <partial name="_Pagination" model="@(new BuilderERP.Web.Models.PaginationViewModel
        {
            Page = Model.Page,
            PageSize = Model.PageSize,
            TotalPages = Model.TotalPages,
            TotalCount = Model.TotalCount,
            Action = "Index",
            RouteValues = routeValues
        })" />
    </div>
</div>
