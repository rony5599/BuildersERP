@model BuilderERP.Application.DTOs.UpdateInstallmentDto
@using BuilderERP.Domain.Enums
@{
    ViewData["Title"] = "Edit Installment";
}

<h1 class="h3 mb-4">Edit Installment</h1>

<form asp-action="Edit" method="post" class="col-md-6">
    <input type="hidden" asp-for="Id" />
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
    <div class="mb-3">
        <label asp-for="InstallmentNumber" class="form-label"></label>
        <input asp-for="InstallmentNumber" class="form-control" />
        <span asp-validation-for="InstallmentNumber" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="InstallmentPlanId" class="form-label"></label>
        <select asp-for="InstallmentPlanId" asp-items="ViewBag.InstallmentPlans" class="form-select">
            <option value="">-- Select Plan --</option>
        </select>
        <span asp-validation-for="InstallmentPlanId" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="DueDate" class="form-label"></label>
        <input asp-for="DueDate" type="date" class="form-control" />
    </div>
    <div class="mb-3">
        <label asp-for="DueAmount" class="form-label"></label>
        <input asp-for="DueAmount" class="form-control" />
        <span asp-validation-for="DueAmount" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="PenaltyAmount" class="form-label"></label>
        <input asp-for="PenaltyAmount" class="form-control" />
        <span asp-validation-for="PenaltyAmount" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="PaidAmount" class="form-label"></label>
        <input asp-for="PaidAmount" class="form-control" />
        <span asp-validation-for="PaidAmount" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Status" class="form-label"></label>
        <select asp-for="Status" asp-items="Html.GetEnumSelectList<InstallmentStatus>()" class="form-select"></select>
        <span asp-validation-for="Status" class="text-danger"></span>
    </div>
    <button type="submit" class="btn btn-primary">Save</button>
    <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
</form>
