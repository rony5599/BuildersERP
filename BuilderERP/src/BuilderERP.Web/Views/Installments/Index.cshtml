@model IReadOnlyList<BuilderERP.Application.DTOs.InstallmentDto>
@using BuilderERP.Shared.Constants
@using BuilderERP.Shared.Authorization
@{
    ViewData["Title"] = "Installments";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Installments</h1>
    @if (User.HasClaim(PermissionClaimTypes.Permission, PermissionNames.InstallmentManage))
    {
        <a asp-action="Create" class="btn btn-primary">New Installment</a>
    }
</div>

<form method="get" class="row g-2 mb-3">
    <div class="col-md-3">
        <label class="form-label">Project</label>
        <select name="projectId" asp-items="ViewBag.Projects" class="form-select" onchange="this.form.submit()">
            <option value="">-- All Projects --</option>
        </select>
    </div>
    <div class="col-md-3">
        <label class="form-label">Property Unit</label>
        <select name="propertyUnitId" asp-items="ViewBag.PropertyUnits" class="form-select" onchange="this.form.submit()">
            <option value="">-- All Units --</option>
        </select>
    </div>
    <div class="col-md-3">
        <label class="form-label">Customer</label>
        <select name="customerId" asp-items="ViewBag.Customers" class="form-select" onchange="this.form.submit()">
            <option value="">-- All Customers --</option>
        </select>
    </div>
</form>

<table class="table table-striped table-hover bg-white">
    <thead>
        <tr>
            <th>Installment #</th>
            <th>Customer</th>
            <th>Project</th>
            <th>Unit</th>
            <th>Due Date</th>
            <th>Due Amount</th>
            <th>Penalty</th>
            <th>Paid</th>
            <th>Status</th>
            <th>Active</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var installment in Model)
        {
            <tr>
                <td>@installment.InstallmentNumber</td>
                <td>@installment.CustomerName</td>
                <td>@installment.ProjectName</td>
                <td>@installment.UnitNumber</td>
                <td>@installment.DueDate.ToString("yyyy-MM-dd")</td>
                <td>@installment.DueAmount</td>
                <td>@installment.PenaltyAmount</td>
                <td>@installment.PaidAmount</td>
                <td>
                    @installment.Status
                    @if (installment.IsRescheduled)
                    {
                        <span class="badge bg-info" title="Original due date: @installment.OriginalDueDate?.ToString("yyyy-MM-dd") — @installment.RescheduleReason">Rescheduled</span>
                    }
                </td>
                <td>
                    <span class="badge @(installment.IsActive ? "bg-success" : "bg-secondary")">
                        @(installment.IsActive ? "Active" : "Inactive")
                    </span>
                </td>
                <td class="text-end">
                    @if (User.HasClaim(PermissionClaimTypes.Permission, PermissionNames.InstallmentManage))
                    {
                        <a asp-action="Edit" asp-route-id="@installment.Id" class="btn btn-sm btn-outline-secondary">Edit</a>
                        @if (installment.Status != BuilderERP.Domain.Enums.InstallmentStatus.Paid)
                        {
                            <a asp-action="Reschedule" asp-route-id="@installment.Id" class="btn btn-sm btn-outline-primary">Reschedule</a>
                        }
                        <form asp-action="ToggleActive" asp-route-id="@installment.Id" asp-route-isActive="@installment.IsActive" method="post" class="d-inline">
                            <button type="submit" class="btn btn-sm btn-outline-danger">
                                @(installment.IsActive ? "Deactivate" : "Activate")
                            </button>
                        </form>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>
