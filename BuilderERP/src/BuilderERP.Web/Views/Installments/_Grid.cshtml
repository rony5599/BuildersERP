@using BuilderERP.Application.Common
@using BuilderERP.Shared.Constants
@using BuilderERP.Shared.Authorization
@model PagedResult<BuilderERP.Application.DTOs.InstallmentDto>

<table class="table table-striped table-hover bg-white">
    <thead>
        <tr>
            <th>Installment #</th>
            <th>Customer</th>
            <th>Project</th>
            <th>Unit</th>
            <th>Due Date</th>
            <th>Due Amount</th>
            <th>Penalty</th>
            <th>Paid</th>
            <th>Status</th>
            <th>Active</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var installment in Model.Items)
        {
            <tr>
                <td>@installment.InstallmentNumber</td>
                <td>@installment.CustomerName</td>
                <td>@installment.ProjectName</td>
                <td>@installment.UnitNumber</td>
                <td>@installment.DueDate.ToString("yyyy-MM-dd")</td>
                <td>@installment.DueAmount</td>
                <td>@installment.PenaltyAmount</td>
                <td>@installment.PaidAmount</td>
                <td>
                    @installment.Status
                    @if (installment.IsRescheduled)
                    {
                        <span class="badge bg-info" title="Original due date: @installment.OriginalDueDate?.ToString("yyyy-MM-dd") — @installment.RescheduleReason">Rescheduled</span>
                    }
                </td>
                <td>
                    <span class="badge @(installment.IsActive ? "bg-success" : "bg-secondary")">
                        @(installment.IsActive ? "Active" : "Inactive")
                    </span>
                </td>
                <td class="text-end">
                    @if (User.HasClaim(PermissionClaimTypes.Permission, PermissionNames.InstallmentManage))
                    {
                        <a asp-action="Edit" asp-route-id="@installment.Id" class="btn btn-sm btn-outline-secondary">Edit</a>
                        @if (installment.Status != BuilderERP.Domain.Enums.InstallmentStatus.Paid)
                        {
                            <a asp-action="Reschedule" asp-route-id="@installment.Id" class="btn btn-sm btn-outline-primary">Reschedule</a>
                        }
                        <form asp-action="ToggleActive" asp-route-id="@installment.Id" asp-route-isActive="@installment.IsActive" method="post" class="d-inline">
                            <button type="submit" class="btn btn-sm btn-outline-danger">
                                @(installment.IsActive ? "Deactivate" : "Activate")
                            </button>
                        </form>
                    }
                </td>
            </tr>
        }
        @if (Model.Items.Count == 0)
        {
            <tr>
                <td colspan="11" class="text-center text-muted">No installments found.</td>
            </tr>
        }
    </tbody>
</table>

<partial name="_Pagination" model="@(new BuilderERP.Web.Models.PaginationViewModel
{
    Page = Model.Page,
    PageSize = Model.PageSize,
    TotalPages = Model.TotalPages,
    TotalCount = Model.TotalCount,
    Action = "Index",
    RouteValues = new Dictionary<string, string?>
    {
        ["projectId"] = ViewBag.SelectedProjectId?.ToString(),
        ["propertyUnitId"] = ViewBag.SelectedPropertyUnitId?.ToString(),
        ["customerId"] = ViewBag.SelectedCustomerId?.ToString()
    }
})" />
