@model BuilderERP.Application.DTOs.CreateInstallmentDto
@using BuilderERP.Domain.Enums
@{
    ViewData["Title"] = "New Installment";
}

<h1 class="h3 mb-4">New Installment</h1>

<form asp-action="Create" method="post" class="col-md-6">
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
    <div class="mb-3">
        <label asp-for="InstallmentNumber" class="form-label"></label>
        <input asp-for="InstallmentNumber" class="form-control" />
        <span asp-validation-for="InstallmentNumber" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="InstallmentPlanId" class="form-label"></label>
        <div class="mc-select" data-mc-select>
            <input type="text" class="form-control mc-select-input" placeholder="-- Select Plan --" autocomplete="off" data-mc-search />
            <input type="hidden" asp-for="InstallmentPlanId" data-mc-value />
            <div class="mc-select-dropdown" data-mc-dropdown>
                <table class="table table-sm table-hover mc-select-table">
                    <thead>
                        <tr>
                            <th>Installment Plan</th>
                            <th>Unit/Flat</th>
                            <th>Project</th>
                        </tr>
                    </thead>
                    <tbody data-mc-body>
                        @foreach (var plan in (IEnumerable<BuilderERP.Application.DTOs.InstallmentPlanDto>)ViewBag.InstallmentPlans)
                        {
                            <tr data-mc-option data-value="@plan.Id" data-label="@plan.SaleAgreementNumber" data-search="@($"{plan.SaleAgreementNumber} {plan.UnitNumber} {plan.ProjectName}".ToLower())">
                                <td>@plan.SaleAgreementNumber</td>
                                <td>@plan.UnitNumber</td>
                                <td>@plan.ProjectName</td>
                            </tr>
                        }
                    </tbody>
                </table>
                <div class="mc-select-empty" style="display:none">No installment plans found.</div>
            </div>
        </div>
        <span asp-validation-for="InstallmentPlanId" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="DueDate" class="form-label"></label>
        <input asp-for="DueDate" type="date" class="form-control" />
    </div>
    <div class="mb-3">
        <label asp-for="DueAmount" class="form-label"></label>
        <input asp-for="DueAmount" class="form-control" />
        <span asp-validation-for="DueAmount" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="PenaltyAmount" class="form-label"></label>
        <input asp-for="PenaltyAmount" class="form-control" />
        <span asp-validation-for="PenaltyAmount" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Status" class="form-label"></label>
        <select asp-for="Status" asp-items="Html.GetEnumSelectList<InstallmentStatus>()" class="form-select"></select>
        <span asp-validation-for="Status" class="text-danger"></span>
    </div>
    <button type="submit" class="btn btn-primary">Save</button>
    <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
</form>

@section Styles {
    <link rel="stylesheet" href="~/css/multi-column-select.css" asp-append-version="true" />
}
@section Scripts {
    <script src="~/js/multi-column-select.js" asp-append-version="true"></script>
}
