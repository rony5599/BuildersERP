@model BuilderERP.Application.DTOs.InstallmentDto
@{
    ViewData["Title"] = "Reschedule Installment";
}

<h1 class="h3 mb-4">Reschedule Installment</h1>

<dl class="row col-md-6">
    <dt class="col-sm-4">Installment #</dt>
    <dd class="col-sm-8">@Model.InstallmentNumber</dd>
    <dt class="col-sm-4">Current Due Date</dt>
    <dd class="col-sm-8">@Model.DueDate.ToString("yyyy-MM-dd")</dd>
    <dt class="col-sm-4">Outstanding</dt>
    <dd class="col-sm-8">@((Model.DueAmount + Model.PenaltyAmount - Model.PaidAmount).ToString("N2"))</dd>
    @if (Model.IsRescheduled)
    {
        <dt class="col-sm-4">Original Due Date</dt>
        <dd class="col-sm-8">@Model.OriginalDueDate?.ToString("yyyy-MM-dd")</dd>
    }
</dl>

<form asp-action="Reschedule" method="post" class="col-md-6">
    <input type="hidden" name="id" value="@Model.Id" />
    <div class="mb-3">
        <label class="form-label">New Due Date</label>
        <input name="newDueDate" type="date" class="form-control" required />
    </div>
    <div class="mb-3">
        <label class="form-label">Reason</label>
        <textarea name="reason" class="form-control" required></textarea>
    </div>
    <button type="submit" class="btn btn-primary">Reschedule</button>
    <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
</form>
