@using BuilderERP.Application.Common
@model PagedResult<BuilderERP.Application.DTOs.EmployeeDto>
@using BuilderERP.Shared.Constants
@using BuilderERP.Shared.Authorization

<table class="table table-striped table-hover bg-white">
    <thead>
        <tr>
            <th>Code</th>
            <th>Name</th>
            <th>Department</th>
            <th>Designation</th>
            <th>Branch</th>
            <th>Reporting To</th>
            <th>Mobile No</th>
            <th>Email</th>
            <th>Active</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var employee in Model.Items)
        {
            <tr>
                <td>@employee.EmployeeCode</td>
                <td>@employee.EmployeeName</td>
                <td>@employee.DepartmentName</td>
                <td>@employee.DesignationName</td>
                <td>@employee.BranchName</td>
                <td>@(employee.ReportingToName ?? "-")</td>
                <td>@employee.MobileNo</td>
                <td>@employee.Email</td>
                <td>
                    <span class="badge @(employee.IsActive ? "bg-success" : "bg-secondary")">
                        @(employee.IsActive ? "Active" : "Inactive")
                    </span>
                </td>
                <td class="text-end">
                    @if (User.HasClaim(PermissionClaimTypes.Permission, PermissionNames.EmployeeManage))
                    {
                        <a asp-action="Edit" asp-route-id="@employee.Id" class="btn btn-sm btn-outline-secondary">Edit</a>
                        <form asp-action="ToggleActive" asp-route-id="@employee.Id" asp-route-isActive="@employee.IsActive" method="post" class="d-inline">
                            <button type="submit" class="btn btn-sm btn-outline-danger">
                                @(employee.IsActive ? "Deactivate" : "Activate")
                            </button>
                        </form>
                    }
                </td>
            </tr>
        }
        @if (Model.Items.Count == 0)
        {
            <tr>
                <td colspan="10" class="text-center text-muted">No employees found.</td>
            </tr>
        }
    </tbody>
</table>

<partial name="_Pagination" model="@(new BuilderERP.Web.Models.PaginationViewModel
{
    Page = Model.Page,
    PageSize = Model.PageSize,
    TotalPages = Model.TotalPages,
    TotalCount = Model.TotalCount,
    Action = "Index",
    RouteValues = new()
})" />
