@using BuilderERP.Application.Common
@model PagedResult<BuilderERP.Application.DTOs.BudgetLineDto>
@using BuilderERP.Shared.Constants
@using BuilderERP.Shared.Authorization

<table class="table table-striped table-hover bg-white">
    <thead>
        <tr>
            <th>Period</th>
            <th>Project</th>
            <th>Category</th>
            <th>Budgeted Amount</th>
            <th>Actual Amount</th>
            <th>Variance</th>
            <th>Active</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var budgetLine in Model.Items)
        {
            var variance = budgetLine.BudgetedAmount - budgetLine.ActualAmount;
            <tr>
                <td>@budgetLine.PeriodStart.ToString("MMM yyyy")</td>
                <td>@budgetLine.ProjectName</td>
                <td>@budgetLine.Category</td>
                <td>@budgetLine.BudgetedAmount.ToString("N2")</td>
                <td>@budgetLine.ActualAmount.ToString("N2")</td>
                <td class="@(variance >= 0 ? "text-success" : "text-danger")">@variance.ToString("N2")</td>
                <td>
                    <span class="badge @(budgetLine.IsActive ? "bg-success" : "bg-secondary")">
                        @(budgetLine.IsActive ? "Active" : "Inactive")
                    </span>
                </td>
                <td class="text-end">
                    @if (User.HasClaim(PermissionClaimTypes.Permission, PermissionNames.BudgetLineManage))
                    {
                        <a asp-action="Edit" asp-route-id="@budgetLine.Id" class="btn btn-sm btn-outline-secondary">Edit</a>
                        <form asp-action="ToggleActive" asp-route-id="@budgetLine.Id" asp-route-isActive="@budgetLine.IsActive" method="post" class="d-inline">
                            <button type="submit" class="btn btn-sm btn-outline-danger">
                                @(budgetLine.IsActive ? "Deactivate" : "Activate")
                            </button>
                        </form>
                    }
                </td>
            </tr>
        }
        @if (Model.Items.Count == 0)
        {
            <tr>
                <td colspan="8" class="text-center text-muted">No budget lines found.</td>
            </tr>
        }
    </tbody>
</table>

<partial name="_Pagination" model="@(new BuilderERP.Web.Models.PaginationViewModel
{
    Page = Model.Page,
    PageSize = Model.PageSize,
    TotalPages = Model.TotalPages,
    TotalCount = Model.TotalCount,
    Action = "Index",
    RouteValues = new Dictionary<string, string?> { ["projectId"] = ViewBag.SelectedProjectId?.ToString() }
})" />
