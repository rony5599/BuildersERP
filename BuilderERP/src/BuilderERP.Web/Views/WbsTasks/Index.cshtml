@model IReadOnlyList<BuilderERP.Application.DTOs.WbsTaskDto>
@using BuilderERP.Shared.Constants
@using BuilderERP.Shared.Authorization
@{
    ViewData["Title"] = "WBS Tasks";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">WBS Tasks</h1>
    <div>
        <a asp-action="Gantt" class="btn btn-outline-primary">View Gantt Chart</a>
        @if (User.HasClaim(PermissionClaimTypes.Permission, PermissionNames.WbsTaskManage))
        {
            <a asp-action="Create" class="btn btn-primary">New WBS Task</a>
        }
    </div>
</div>

<table class="table table-striped table-hover bg-white">
    <thead>
        <tr>
            <th>Code</th>
            <th>Name</th>
            <th>Project</th>
            <th>Parent</th>
            <th>Start Date</th>
            <th>End Date</th>
            <th>% Complete</th>
            <th>Active</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var wbsTask in Model)
        {
            <tr>
                <td>@wbsTask.Code</td>
                <td>@wbsTask.Name</td>
                <td>@wbsTask.ProjectName</td>
                <td>@wbsTask.ParentCode</td>
                <td>@wbsTask.StartDate.ToShortDateString()</td>
                <td>@wbsTask.EndDate.ToShortDateString()</td>
                <td>
                    <div class="progress" style="height: 18px; min-width: 100px;">
                        <div class="progress-bar @(wbsTask.PercentComplete >= 100 ? "bg-success" : "bg-primary")" role="progressbar"
                             style="width: @wbsTask.PercentComplete%;">
                            @wbsTask.PercentComplete%
                        </div>
                    </div>
                </td>
                <td>
                    <span class="badge @(wbsTask.IsActive ? "bg-success" : "bg-secondary")">
                        @(wbsTask.IsActive ? "Active" : "Inactive")
                    </span>
                </td>
                <td class="text-end">
                    @if (User.HasClaim(PermissionClaimTypes.Permission, PermissionNames.WbsTaskManage))
                    {
                        <a asp-action="Edit" asp-route-id="@wbsTask.Id" class="btn btn-sm btn-outline-secondary">Edit</a>
                        <form asp-action="ToggleActive" asp-route-id="@wbsTask.Id" asp-route-isActive="@wbsTask.IsActive" method="post" class="d-inline">
                            <button type="submit" class="btn btn-sm btn-outline-danger">
                                @(wbsTask.IsActive ? "Deactivate" : "Activate")
                            </button>
                        </form>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>
