@model BuilderERP.Application.DTOs.CreateWbsTaskDto
@{
    ViewData["Title"] = "New WBS Task";
}

<h1 class="h3 mb-4">New WBS Task</h1>

<form asp-action="Create" method="post" class="col-md-6">
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
    <div class="mb-3">
        <label asp-for="Code" class="form-label"></label>
        <input asp-for="Code" class="form-control" />
        <span asp-validation-for="Code" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Name" class="form-label"></label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Description" class="form-label"></label>
        <textarea asp-for="Description" class="form-control"></textarea>
        <span asp-validation-for="Description" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="ProjectId" class="form-label"></label>
        <select asp-for="ProjectId" asp-items="ViewBag.Projects" class="form-select">
            <option value="">-- Select Project --</option>
        </select>
        <span asp-validation-for="ProjectId" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="ParentId" class="form-label"></label>
        <select asp-for="ParentId" asp-items="ViewBag.ParentTasks" class="form-select">
            <option value="">-- None (top level) --</option>
        </select>
        <span asp-validation-for="ParentId" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="PropertyUnitId" class="form-label">Property Unit</label>
        <select asp-for="PropertyUnitId" asp-items="ViewBag.PropertyUnits" class="form-select">
            <option value="">-- None (project-level task) --</option>
        </select>
        <span asp-validation-for="PropertyUnitId" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="StartDate" class="form-label"></label>
        <input asp-for="StartDate" type="date" class="form-control" />
        <span asp-validation-for="StartDate" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="EndDate" class="form-label"></label>
        <input asp-for="EndDate" type="date" class="form-control" />
        <span asp-validation-for="EndDate" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="PercentComplete" class="form-label"></label>
        <input asp-for="PercentComplete" class="form-control" />
        <span asp-validation-for="PercentComplete" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Sequence" class="form-label"></label>
        <input asp-for="Sequence" class="form-control" />
        <span asp-validation-for="Sequence" class="text-danger"></span>
    </div>
    <button type="submit" class="btn btn-primary">Save</button>
    <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
</form>
