@model IReadOnlyList<BuilderERP.Application.DTOs.WbsTaskDto>
@{
    ViewData["Title"] = "Gantt Chart (Unit-wise)";
    var minDate = Model.Any() ? Model.Min(t => t.StartDate) : DateTime.Today;
    var maxDate = Model.Any() ? Model.Max(t => t.EndDate) : DateTime.Today.AddDays(30);
    var totalDays = Math.Max(1, (maxDate - minDate).TotalDays);
}

<style>
    .gantt-row { display: flex; align-items: center; margin-bottom: 6px; }
    .gantt-label { width: 220px; flex-shrink: 0; font-size: .85rem; }
    .gantt-track { flex: 1; position: relative; height: 22px; background: #f1f3f9; border-radius: 4px; }
    .gantt-bar { position: absolute; top: 2px; bottom: 2px; border-radius: 4px; background: #4680ff; }
</style>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Gantt Chart (Property Unit-wise)</h1>
    <a asp-action="Index" class="btn btn-outline-secondary">Back to List</a>
</div>

<form method="get" class="mb-4 row g-2 col-md-8">
    <div class="col-md-6">
        <label class="form-label">Project</label>
        <select name="projectId" asp-items="ViewBag.Projects" class="form-select" onchange="this.form.submit()">
            <option value="">-- All Projects --</option>
        </select>
    </div>
    <div class="col-md-6">
        <label class="form-label">Property Unit</label>
        <select name="propertyUnitId" asp-items="ViewBag.PropertyUnits" class="form-select" onchange="this.form.submit()">
            <option value="">-- Select Property Unit --</option>
        </select>
    </div>
</form>

@if (ViewBag.SelectedPropertyUnitId is null)
{
    <p class="text-muted">Select a property unit above to view its task timeline.</p>
}
else if (!Model.Any())
{
    <p class="text-muted">No WBS tasks found for this property unit.</p>
}
else
{
    <div class="bg-white p-3 rounded">
        @foreach (var task in Model.OrderBy(t => t.Sequence))
        {
            var left = (task.StartDate - minDate).TotalDays / totalDays * 100;
            var width = Math.Max(1, (task.EndDate - task.StartDate).TotalDays / totalDays * 100);
            var barClass = task.PercentComplete >= 100 ? "bg-success" : "bg-primary";
            <div class="gantt-row">
                <div class="gantt-label">@task.Code - @task.Name</div>
                <div class="gantt-track">
                    <div class="gantt-bar @barClass" style="margin-left:@left.ToString(System.Globalization.CultureInfo.InvariantCulture)%;width:@width.ToString(System.Globalization.CultureInfo.InvariantCulture)%;"
                         title="@task.StartDate.ToShortDateString() - @task.EndDate.ToShortDateString() (@task.PercentComplete%)"></div>
                </div>
            </div>
        }
    </div>
}
