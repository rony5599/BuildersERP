@model BuilderERP.Application.DTOs.UpdateStockIssueDto
@{
    ViewData["Title"] = "Edit Stock Issue";
}

<h1 class="h3 mb-4">Edit Stock Issue</h1>

<form asp-action="Edit" method="post" class="col-md-6">
    <input type="hidden" asp-for="Id" />
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
    <div class="mb-3">
        <label asp-for="IssueNumber" class="form-label"></label>
        <input asp-for="IssueNumber" class="form-control" />
        <span asp-validation-for="IssueNumber" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="MaterialId" class="form-label"></label>
        <select asp-for="MaterialId" asp-items="ViewBag.Materials" class="form-select">
            <option value="">-- Select Material --</option>
        </select>
        <span asp-validation-for="MaterialId" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="WarehouseId" class="form-label"></label>
        <select asp-for="WarehouseId" asp-items="ViewBag.Warehouses" class="form-select">
            <option value="">-- Select Warehouse --</option>
        </select>
        <span asp-validation-for="WarehouseId" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="IssueDate" class="form-label"></label>
        <input asp-for="IssueDate" type="date" class="form-control" />
    </div>
    <div class="mb-3">
        <label asp-for="Quantity" class="form-label"></label>
        <input asp-for="Quantity" class="form-control" />
        <span asp-validation-for="Quantity" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="IssuedTo" class="form-label"></label>
        <input asp-for="IssuedTo" class="form-control" />
        <span asp-validation-for="IssuedTo" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Remarks" class="form-label"></label>
        <textarea asp-for="Remarks" class="form-control"></textarea>
        <span asp-validation-for="Remarks" class="text-danger"></span>
    </div>
    <button type="submit" class="btn btn-primary">Save</button>
    <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
</form>
