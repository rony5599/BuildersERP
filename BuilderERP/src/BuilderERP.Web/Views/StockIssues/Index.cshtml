@model IReadOnlyList<BuilderERP.Application.DTOs.StockIssueDto>
@using BuilderERP.Shared.Constants
@using BuilderERP.Shared.Authorization
@{
    ViewData["Title"] = "Stock Issues";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Stock Issues</h1>
    @if (User.HasClaim(PermissionClaimTypes.Permission, PermissionNames.StockIssueManage))
    {
        <a asp-action="Create" class="btn btn-primary">New Stock Issue</a>
    }
</div>

<form method="get" class="mb-3 col-md-4">
    <label class="form-label">Project</label>
    <select name="projectId" asp-items="ViewBag.Projects" class="form-select" onchange="this.form.submit()">
        <option value="">-- All Projects --</option>
    </select>
</form>

<table class="table table-striped table-hover bg-white">
    <thead>
        <tr>
            <th>Issue #</th>
            <th>Material</th>
            <th>Project</th>
            <th>Warehouse</th>
            <th>Quantity</th>
            <th>Consumed</th>
            <th>Wastage</th>
            <th>Issued To</th>
            <th>Date</th>
            <th>Active</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var issue in Model)
        {
            <tr>
                <td>@issue.IssueNumber</td>
                <td>@issue.MaterialName</td>
                <td>@issue.ProjectName</td>
                <td>@issue.WarehouseName</td>
                <td>@issue.Quantity</td>
                <td>@issue.ConsumedQuantity</td>
                <td class="@(issue.WastageQuantity > 0 ? "text-danger" : "")" title="@issue.WastageReason">@issue.WastageQuantity</td>
                <td>@issue.IssuedTo</td>
                <td>@issue.IssueDate.ToString("yyyy-MM-dd")</td>
                <td>
                    <span class="badge @(issue.IsActive ? "bg-success" : "bg-secondary")">
                        @(issue.IsActive ? "Active" : "Inactive")
                    </span>
                </td>
                <td class="text-end">
                    @if (User.HasClaim(PermissionClaimTypes.Permission, PermissionNames.StockIssueManage))
                    {
                        <a asp-action="Edit" asp-route-id="@issue.Id" class="btn btn-sm btn-outline-secondary">Edit</a>
                        <form asp-action="ToggleActive" asp-route-id="@issue.Id" asp-route-isActive="@issue.IsActive" method="post" class="d-inline">
                            <button type="submit" class="btn btn-sm btn-outline-danger">
                                @(issue.IsActive ? "Deactivate" : "Activate")
                            </button>
                        </form>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>
