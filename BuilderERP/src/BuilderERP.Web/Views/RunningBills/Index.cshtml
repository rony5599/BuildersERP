@model IReadOnlyList<BuilderERP.Application.DTOs.RunningBillDto>
@using BuilderERP.Shared.Constants
@using BuilderERP.Shared.Authorization
@using BuilderERP.Domain.Enums
@{
    ViewData["Title"] = "Running Bills";

    string StatusBadge(RunningBillStatus status) => status switch
    {
        RunningBillStatus.Draft => "bg-secondary",
        RunningBillStatus.Submitted => "bg-info",
        RunningBillStatus.Approved => "bg-primary",
        RunningBillStatus.Paid => "bg-success",
        _ => "bg-secondary"
    };
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Running Bills</h1>
    @if (User.HasClaim(PermissionClaimTypes.Permission, PermissionNames.RunningBillManage))
    {
        <a asp-action="Create" class="btn btn-primary">New Running Bill</a>
    }
</div>

<table class="table table-striped table-hover bg-white">
    <thead>
        <tr>
            <th>Bill #</th>
            <th>Work Order</th>
            <th>Bill Date</th>
            <th>Work Done</th>
            <th>Deduction</th>
            <th>Net Payable</th>
            <th>Status</th>
            <th>Active</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var bill in Model)
        {
            <tr>
                <td>@bill.BillNumber</td>
                <td>@bill.WorkOrderNumber</td>
                <td>@bill.BillDate.ToString("yyyy-MM-dd")</td>
                <td>@bill.WorkDoneAmount.ToString("N2")</td>
                <td>@bill.DeductionAmount.ToString("N2")</td>
                <td><strong>@bill.NetPayableAmount.ToString("C2")</strong></td>
                <td><span class="badge @StatusBadge(bill.Status)">@bill.Status</span></td>
                <td>
                    <span class="badge @(bill.IsActive ? "bg-success" : "bg-secondary")">
                        @(bill.IsActive ? "Active" : "Inactive")
                    </span>
                </td>
                <td class="text-end">
                    @if (User.HasClaim(PermissionClaimTypes.Permission, PermissionNames.RunningBillManage))
                    {
                        <a asp-action="Edit" asp-route-id="@bill.Id" class="btn btn-sm btn-outline-secondary">Edit</a>
                        <form asp-action="ToggleActive" asp-route-id="@bill.Id" asp-route-isActive="@bill.IsActive" method="post" class="d-inline">
                            <button type="submit" class="btn btn-sm btn-outline-danger">
                                @(bill.IsActive ? "Deactivate" : "Activate")
                            </button>
                        </form>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>
