@model BuilderERP.Application.DTOs.BoqPrintDto
@using BuilderERP.Domain.Enums
@{
    Layout = null;
    var statusText = Model.Status == BoqStatus.AwaitingApproval ? "Awaiting Approval" : Model.Status.ToString();
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>BOQ - @Model.BoqName</title>
    <style>
        * { box-sizing: border-box; }
        body { margin: 0; background: #edf0f3; color: #20242a; font-family: "Segoe UI", Arial, sans-serif; }
        .toolbar { display: flex; gap: 8px; padding: 12px 24px; background: #fff; border-bottom: 1px solid #d9dde2; }
        .toolbar button, .toolbar a { border: 1px solid #198754; border-radius: 5px; padding: 8px 16px; background: #198754; color: #fff; text-decoration: none; cursor: pointer; font-size: 14px; }
        .toolbar a { background: #fff; color: #198754; }
        .sheet { width: 1100px; min-height: 760px; margin: 24px auto; padding: 38px 44px; background: #fff; box-shadow: 0 2px 12px rgba(0,0,0,.12); }
        .letterhead { position: relative; min-height: 72px; text-align: center; }
        .company-logo { position: absolute; left: 0; top: 0; max-height: 64px; max-width: 145px; object-fit: contain; }
        .document-title { margin: 0; font-size: 26px; color: #173d2b; text-transform: uppercase; letter-spacing: 1px; }
        .company-name { margin-top: 7px; font-size: 16px; font-weight: 700; }
        .company-details { margin-top: 3px; color: #59636e; font-size: 10px; line-height: 1.45; }
        .heading { display: flex; justify-content: space-between; align-items: flex-start; margin-top: 16px; padding: 12px 0 14px; border-top: 1px solid #d9dde2; border-bottom: 2px solid #198754; }
        .boq-title { margin: 0; font-size: 18px; color: #173d2b; }
        .subtitle { margin-top: 4px; color: #67717d; }
        .status { padding: 6px 12px; border: 1px solid #adb5bd; border-radius: 20px; font-weight: 600; font-size: 12px; }
        .meta { display: grid; grid-template-columns: 2fr 1fr 1fr 1fr; gap: 18px; margin: 22px 0; }
        .label { color: #69727d; font-size: 10px; text-transform: uppercase; letter-spacing: .6px; }
        .value { margin-top: 3px; font-size: 13px; font-weight: 600; }
        table { width: 100%; border-collapse: collapse; font-size: 11px; }
        th { padding: 9px 7px; color: #fff; background: #265c43; text-align: left; text-transform: uppercase; font-size: 9px; letter-spacing: .4px; }
        td { padding: 8px 7px; border-bottom: 1px solid #dfe3e6; vertical-align: top; }
        .number { text-align: right; white-space: nowrap; }
        .group { font-weight: 600; white-space: nowrap; }
        .totals { width: 360px; margin: 18px 0 0 auto; font-size: 12px; }
        .total-row { display: flex; justify-content: space-between; padding: 5px 0; }
        .grand { margin-top: 4px; padding-top: 9px; border-top: 2px solid #265c43; font-size: 16px; font-weight: 700; }
        .note { margin-top: 24px; padding: 12px; border-left: 3px solid #dc3545; background: #fff5f5; font-size: 11px; }
        .approval { display: flex; justify-content: flex-end; margin-top: 42px; }
        .signature { width: 230px; padding-top: 8px; border-top: 1px solid #444; text-align: center; font-size: 11px; }
        .audit { margin-top: 24px; color: #8a929a; font-size: 8px; text-align: right; }
        @@page { size: A4 landscape; margin: 10mm; }
        @@media print {
            body { background: #fff; }
            .toolbar { display: none; }
            .sheet { width: auto; min-height: auto; margin: 0; padding: 0; box-shadow: none; }
            thead { display: table-header-group; }
            tr { break-inside: avoid; }
        }
    </style>
</head>
<body>
<div class="toolbar"><button type="button" onclick="window.print()">Print</button><a asp-action="Index">Back to BOQs</a></div>
<main class="sheet">
    <header class="letterhead">
        <img src="~/uploads/padlogo/padlogo.png" class="company-logo" alt="@Model.CompanyName logo" />
        <h1 class="document-title">Bill of Quantities</h1>
        <div class="company-name">@Model.CompanyName</div>
        <div class="company-details">
            @if (!string.IsNullOrWhiteSpace(Model.CompanyAddress)) { <div>@Model.CompanyAddress</div> }
            @if (!string.IsNullOrWhiteSpace(Model.CompanyPhone)) { <span>Mobile: @Model.CompanyPhone</span> }
            @if (!string.IsNullOrWhiteSpace(Model.CompanyEmail)) { <span> &nbsp; Email: @Model.CompanyEmail</span> }
        </div>
    </header>
    <section class="heading"><div><h2 class="boq-title">@Model.BoqName</h2><div class="subtitle">@Model.ProjectName</div></div><span class="status">@statusText</span></section>
    <section class="meta">
        <div><div class="label">Project</div><div class="value">@Model.ProjectName</div></div>
        <div><div class="label">Version</div><div class="value">@Model.VersionNumber</div></div>
        <div><div class="label">Created</div><div class="value">@Model.CreatedAt.ToLocalTime().ToString("dd MMM yyyy")</div></div>
        <div><div class="label">BOQ Reference</div><div class="value">BOQ-@Model.Id.ToString("D6")</div></div>
    </section>
    <table>
        <thead><tr><th style="width:36px">#</th><th style="width:170px">Work Group</th><th>Description</th><th style="width:90px">Unit</th><th class="number" style="width:100px">Quantity</th><th class="number" style="width:120px">Rate (৳)</th><th class="number" style="width:130px">Amount (৳)</th></tr></thead>
        <tbody>
        @for (var i = 0; i < Model.Lines.Count; i++)
        {
            var line = Model.Lines[i];
            <tr><td>@(i + 1)</td><td class="group">@line.WorkGroupCode — @line.WorkGroupName</td><td>@line.Description</td><td>@line.UnitOfMeasure</td><td class="number">@line.Quantity.ToString("N4").TrimEnd('0').TrimEnd('.')</td><td class="number">@line.Rate.ToString("N2")</td><td class="number">@line.Amount.ToString("N2")</td></tr>
        }
        </tbody>
    </table>
    <section class="totals">
        <div class="total-row"><span>Subtotal</span><strong>৳@Model.Subtotal.ToString("N2")</strong></div>
        <div class="total-row"><span>Contingency (@Model.ContingencyPercent.ToString("N2")%)</span><strong>৳@Model.ContingencyAmount.ToString("N2")</strong></div>
        <div class="total-row grand"><span>Estimated Total</span><span>৳@Model.EstimatedTotal.ToString("N2")</span></div>
    </section>
    @if (!string.IsNullOrWhiteSpace(Model.RejectionReason))
    {
        <div class="note"><strong>Revision reason:</strong> @Model.RejectionReason
        @if (!string.IsNullOrWhiteSpace(Model.RejectedBy) || Model.RejectedAt.HasValue) { <div>Returned @if (!string.IsNullOrWhiteSpace(Model.RejectedBy)) { <span>by @Model.RejectedBy</span> } @if (Model.RejectedAt.HasValue) { <span>on @Model.RejectedAt.GetValueOrDefault().ToLocalTime().ToString("dd MMM yyyy, hh:mm tt")</span> }</div> }</div>
    }
    @if (Model.Status == BoqStatus.Approved)
    {
        <div class="approval">
            <div class="signature">
                <strong>@(Model.ApprovedBy ?? "Approved")</strong>
                <div>Approved By</div>
                @if (Model.ApprovedAt.HasValue)
                {
                    <div>@Model.ApprovedAt.GetValueOrDefault().ToLocalTime().ToString("dd MMM yyyy")</div>
                }
            </div>
        </div>
    }
    <div class="audit">Printed by @(Model.PrintedBy ?? "System") on @Model.PrintedAt.ToString("dd MMM yyyy, hh:mm tt")</div>
</main>
</body>
</html>
