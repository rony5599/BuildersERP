@using BuilderERP.Application.Common
@using BuilderERP.Shared.Authorization
@using BuilderERP.Shared.Constants
@model PagedResult<BuilderERP.Application.DTOs.BoqSummaryDto>

<div class="card-header bg-white d-flex flex-wrap justify-content-between align-items-center gap-2 py-3">
    <div><span class="fw-semibold">BOQ masters</span>@if (ViewBag.SelectedProjectId != null || !string.IsNullOrWhiteSpace(ViewBag.SelectedBoqName as string)) { <span class="badge bg-light text-dark border ms-2">Filtered</span> }</div>
    <span class="text-muted small">@Model.TotalCount BOQ@(Model.TotalCount == 1 ? "" : "s") found</span>
</div>
<div class="table-responsive">
    <table class="table table-hover align-middle mb-0" style="min-width:900px">
        <thead class="table-light"><tr><th class="ps-3">BOQ</th><th>Project</th><th>Created</th><th class="text-end">Items</th><th class="text-end">Subtotal (৳)</th><th class="text-end">Contingency</th><th class="text-end">Estimated total (৳)</th><th class="text-end pe-3">Actions</th></tr></thead>
        <tbody>
            @foreach (var boq in Model.Items)
            {
                <tr>
                    <td class="ps-3"><div class="fw-semibold">@boq.BoqName</div><span class="badge bg-light text-dark border">Version @boq.VersionNumber</span> <span class="badge @(boq.IsActive ? "bg-success" : "bg-secondary")">@(boq.IsActive ? "Active" : "Inactive")</span></td>
                    <td>@boq.ProjectName</td>
                    <td>@boq.CreatedAt.ToLocalTime().ToString("dd MMM yyyy")</td>
                    <td class="text-end">@boq.ItemCount</td>
                    <td class="text-end">@boq.Subtotal.ToString("N2")</td>
                    <td class="text-end">@boq.ContingencyPercent.ToString("N2")%</td>
                    <td class="text-end fw-semibold">@boq.EstimatedTotal.ToString("N2")</td>
                    <td class="text-end pe-3">
                        @if (User.HasClaim(PermissionClaimTypes.Permission, PermissionNames.BoqItemManage))
                        {
                            <div class="d-inline-flex gap-1">
                                <a asp-action="Edit" asp-route-id="@boq.Id" class="btn btn-sm btn-outline-primary"><i class="bi bi-pencil-square me-1"></i>Edit</a>
                                <form asp-action="ToggleActive" method="post" class="d-inline" onsubmit="return confirm('@(boq.IsActive ? "Deactivate" : "Activate") this BOQ?');">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@boq.Id" />
                                    <input type="hidden" name="isActive" value="@boq.IsActive.ToString().ToLowerInvariant()" />
                                    <button type="submit" class="btn btn-sm @(boq.IsActive ? "btn-outline-danger" : "btn-outline-success")">@(boq.IsActive ? "Deactivate" : "Activate")</button>
                                </form>
                            </div>
                        }
                    </td>
                </tr>
            }
            @if (Model.Items.Count == 0)
            {
                <tr><td colspan="8" class="text-center py-5"><i class="bi bi-clipboard-x d-block fs-2 text-muted mb-2"></i><div class="fw-semibold">No BOQs found</div><div class="text-muted small">Create a BOQ or change the current filters.</div></td></tr>
            }
        </tbody>
    </table>
</div>
<div class="card-footer bg-white px-3 py-3">
    <partial name="_Pagination" model="@(new BuilderERP.Web.Models.PaginationViewModel
    {
        Page = Model.Page, PageSize = Model.PageSize, TotalPages = Model.TotalPages, TotalCount = Model.TotalCount, Action = "Index",
        RouteValues = new Dictionary<string, string?> { ["projectId"] = ViewBag.SelectedProjectId?.ToString(), ["boqName"] = ViewBag.SelectedBoqName as string }
    })" />
</div>
