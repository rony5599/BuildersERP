@model IReadOnlyList<BuilderERP.Application.DTOs.BoqItemDto>
@using BuilderERP.Shared.Constants
@using BuilderERP.Shared.Authorization
@{
    ViewData["Title"] = "BOQ Items";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">BOQ Items</h1>
    @if (User.HasClaim(PermissionClaimTypes.Permission, PermissionNames.BoqItemManage))
    {
        <a asp-action="Create" class="btn btn-primary">New BOQ Item</a>
    }
</div>

<table class="table table-striped table-hover bg-white">
    <thead>
        <tr>
            <th>Item Code</th>
            <th>Description</th>
            <th>Project</th>
            <th>Unit</th>
            <th>Quantity</th>
            <th>Rate</th>
            <th>Amount</th>
            <th>Category</th>
            <th>Active</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.ItemCode</td>
                <td>@item.Description</td>
                <td>@item.ProjectName</td>
                <td>@item.UnitOfMeasure</td>
                <td>@item.Quantity</td>
                <td>@item.Rate.ToString("N2")</td>
                <td>@item.Amount.ToString("N2")</td>
                <td>@item.Category</td>
                <td>
                    <span class="badge @(item.IsActive ? "bg-success" : "bg-secondary")">
                        @(item.IsActive ? "Active" : "Inactive")
                    </span>
                </td>
                <td class="text-end">
                    @if (User.HasClaim(PermissionClaimTypes.Permission, PermissionNames.BoqItemManage))
                    {
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">Edit</a>
                        <form asp-action="ToggleActive" asp-route-id="@item.Id" asp-route-isActive="@item.IsActive" method="post" class="d-inline">
                            <button type="submit" class="btn btn-sm btn-outline-danger">
                                @(item.IsActive ? "Deactivate" : "Activate")
                            </button>
                        </form>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>
