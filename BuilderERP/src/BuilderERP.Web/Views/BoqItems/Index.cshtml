@using BuilderERP.Application.Common
@using BuilderERP.Shared.Constants
@using BuilderERP.Shared.Authorization
@model PagedResult<BuilderERP.Application.DTOs.BoqSummaryDto>
@{
    ViewData["Title"] = "BOQ Items";
    var hasFilters = ViewBag.SelectedProjectId != null || !string.IsNullOrWhiteSpace(ViewBag.SelectedBoqName as string);
    var pageSize = (int)(ViewBag.SelectedPageSize ?? 25);
    var assignment = ViewBag.ActionAssignment as BuilderERP.Domain.Entities.BoqActionAssignment;
}

<div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-4">
    <div><h1 class="h3 mb-1">Bill of Quantities</h1><p class="text-muted mb-0">Review and manage project BOQs.</p></div>
    @if (User.HasClaim(PermissionClaimTypes.Permission, PermissionNames.BoqItemManage) && assignment?.CanDraftEdit == true)
    {
        <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-lg me-1"></i>Create BOQ</a>
    }
</div>

@if (TempData["StatusMessage"] is string statusMessage) { <div class="alert alert-success">@statusMessage</div> }
@if (TempData["ErrorMessage"] is string errorMessage) { <div class="alert alert-danger">@errorMessage</div> }

<div class="card shadow-sm mb-4">
    <div class="card-body">
        <form asp-action="Index" method="get" class="row g-3 align-items-end">
            <div class="col-lg-4 col-md-6"><label for="projectId" class="form-label">Project</label><select id="projectId" name="projectId" asp-items="ViewBag.Projects" class="form-select"><option value="">All projects</option></select></div>
            <div class="col-lg-4 col-md-6"><label for="boqName" class="form-label">BOQ name</label><div class="input-group"><span class="input-group-text bg-white"><i class="bi bi-search text-muted"></i></span><input id="boqName" name="boqName" value="@ViewBag.SelectedBoqName" class="form-control border-start-0" placeholder="Search BOQ name" /></div></div>
            <div class="col-lg-2 col-md-4 col-6"><label for="pageSize" class="form-label">Rows per page</label><select id="pageSize" name="pageSize" class="form-select">@foreach (var size in new[] { 10, 25, 50, 100 }) { <option value="@size" selected="@(pageSize == size)">@size rows</option> }</select></div>
            <div class="col-lg-2 col-md-8 col-6 d-flex gap-2"><button type="submit" class="btn btn-primary flex-grow-1"><i class="bi bi-funnel me-1"></i>Filter</button>@if (hasFilters) { <a asp-action="Index" asp-route-pageSize="@pageSize" class="btn btn-outline-secondary" title="Clear filters"><i class="bi bi-x-lg"></i></a> }</div>
        </form>
    </div>
</div>

<div class="card shadow-sm overflow-hidden" data-grid-container>
    <partial name="_Grid" model="Model" />
</div>

<div class="modal fade" id="reject-boq-modal" tabindex="-1" aria-hidden="true"><div class="modal-dialog modal-dialog-centered"><div class="modal-content"><form asp-action="WorkflowAction" method="post"><div class="modal-header"><h5 class="modal-title">Return BOQ for revision</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div><div class="modal-body"><input type="hidden" name="id" id="reject-boq-id" /><input type="hidden" name="workflowAction" value="reject" /><label for="boq-rejection-reason" class="form-label fw-semibold">Reason <span class="text-danger">*</span></label><textarea id="boq-rejection-reason" name="rejectionReason" class="form-control" rows="4" maxlength="1000" required></textarea></div><div class="modal-footer"><button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Close</button><button type="submit" class="btn btn-danger">Return to Draft</button></div></form></div></div></div>
@section Scripts { <script>document.getElementById('reject-boq-modal')?.addEventListener('show.bs.modal',e=>document.getElementById('reject-boq-id').value=e.relatedTarget.dataset.boqId);</script> }
