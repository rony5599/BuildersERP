@model IReadOnlyList<BuilderERP.Application.DTOs.EquipmentDto>
@using BuilderERP.Shared.Constants
@using BuilderERP.Shared.Authorization
@using BuilderERP.Domain.Enums
@{
    ViewData["Title"] = "Equipment";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Equipment</h1>
    @if (User.HasClaim(PermissionClaimTypes.Permission, PermissionNames.EquipmentManage))
    {
        <a asp-action="Create" class="btn btn-primary">New Equipment</a>
    }
</div>

<table class="table table-striped table-hover bg-white">
    <thead>
        <tr>
            <th>Code</th>
            <th>Name</th>
            <th>Type</th>
            <th>Model</th>
            <th>Registration Number</th>
            <th>Status</th>
            <th>Active</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var equipment in Model)
        {
            <tr>
                <td>@equipment.EquipmentCode</td>
                <td>@equipment.Name</td>
                <td><span class="badge bg-info text-dark">@equipment.Type</span></td>
                <td>@equipment.Model</td>
                <td>@equipment.RegistrationNumber</td>
                <td>
                    @{
                        var statusClass = equipment.Status switch
                        {
                            EquipmentStatus.Available => "bg-success",
                            EquipmentStatus.InUse => "bg-primary",
                            EquipmentStatus.UnderMaintenance => "bg-warning",
                            EquipmentStatus.Breakdown => "bg-danger",
                            EquipmentStatus.Retired => "bg-secondary",
                            _ => "bg-secondary"
                        };
                    }
                    <span class="badge @statusClass">@equipment.Status</span>
                </td>
                <td>
                    <span class="badge @(equipment.IsActive ? "bg-success" : "bg-secondary")">
                        @(equipment.IsActive ? "Active" : "Inactive")
                    </span>
                </td>
                <td class="text-end">
                    @if (User.HasClaim(PermissionClaimTypes.Permission, PermissionNames.EquipmentManage))
                    {
                        <a asp-action="Edit" asp-route-id="@equipment.Id" class="btn btn-sm btn-outline-secondary">Edit</a>
                        <form asp-action="ToggleActive" asp-route-id="@equipment.Id" asp-route-isActive="@equipment.IsActive" method="post" class="d-inline">
                            <button type="submit" class="btn btn-sm btn-outline-danger">
                                @(equipment.IsActive ? "Deactivate" : "Activate")
                            </button>
                        </form>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>
