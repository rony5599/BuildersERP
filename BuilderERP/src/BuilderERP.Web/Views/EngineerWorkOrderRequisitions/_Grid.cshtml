@using BuilderERP.Application.Common
@using BuilderERP.Shared.Constants
@using BuilderERP.Shared.Authorization
@using Microsoft.AspNetCore.Mvc.Rendering
@using BuilderERP.Domain.Entities
@using BuilderERP.Web.Models
@model PagedResult<BuilderERP.Application.DTOs.EngineerWorkOrderRequisitionDto>
@{
    var assignment = ViewBag.ActionAssignment as EngineerWorkOrderRequisitionActionAssignment;
    var requisitionNumber = ViewBag.RequisitionNumber as string;
    var projectId = ViewBag.ProjectId as long?;
    var status = ViewBag.Status as BuilderERP.Domain.Enums.RequisitionStatus?;
    var dateFrom = ViewBag.DateFrom as DateTime?;
    var dateTo = ViewBag.DateTo as DateTime?;
    var hasFilters = !string.IsNullOrWhiteSpace(requisitionNumber) || projectId.HasValue || status.HasValue || dateFrom.HasValue || dateTo.HasValue;
}

<div class="card mb-3">
    <div class="card-body">
        <form asp-action="Index" method="get" class="row gy-3 gx-4 align-items-end grid-search-form">
            <div class="col-12 col-sm-6 col-lg-2">
                <label class="form-label small mb-1">Requisition #</label>
                <input type="search" name="requisitionNumber" value="@requisitionNumber" class="form-control" placeholder="Requisition #" />
            </div>
            <div class="col-12 col-sm-6 col-lg-2">
                <label class="form-label small mb-1">Project</label>
                <select name="projectId" asp-items="@(ViewBag.Projects as SelectList)" class="form-select">
                    <option value="">All Projects</option>
                </select>
            </div>
            <div class="col-12 col-sm-6 col-lg-2">
                <label class="form-label small mb-1">Status</label>
                <select name="status" asp-items="@(ViewBag.Statuses as SelectList)" class="form-select">
                    <option value="">All Statuses</option>
                </select>
            </div>
            <div class="col-12 col-sm-6 col-lg-2">
                <label class="form-label small mb-1">Date From</label>
                <input type="date" name="dateFrom" value="@(dateFrom?.ToString("yyyy-MM-dd"))" class="form-control" />
            </div>
            <div class="col-12 col-sm-6 col-lg-2">
                <label class="form-label small mb-1">Date To</label>
                <input type="date" name="dateTo" value="@(dateTo?.ToString("yyyy-MM-dd"))" class="form-control" />
            </div>
            <div class="col-12 col-sm-6 col-lg-2 d-flex gap-2">
                <button type="submit" class="btn btn-primary flex-grow-1">Filter</button>
                @if (hasFilters)
                {
                    <a asp-action="Index" class="btn btn-outline-secondary flex-grow-1">Clear</a>
                }
            </div>
        </form>
    </div>
</div>

<div class="card">
    <table class="table table-striped table-hover mb-0">
        <thead>
            <tr>
                <th>Requisition #</th>
                <th>Project</th>
                <th>Required By</th>
                <th>Estimated Amount</th>
                <th>Status</th>
                <th>Active</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var requisition in Model.Items)
            {
                <tr>
                    <td>@requisition.RequisitionNumber</td>
                    <td>@requisition.ProjectName</td>
                    <td>@requisition.RequiredByDate.ToString("yyyy-MM-dd")</td>
                    <td>@requisition.EstimatedAmount</td>
                    <td>
                        <span class="badge @(requisition.Status == BuilderERP.Domain.Enums.RequisitionStatus.Draft && !string.IsNullOrWhiteSpace(requisition.RejectionReason) ? "bg-danger" : StatusBadgeClass(requisition.Status))"><span class="badge-dot"></span>@(requisition.Status == BuilderERP.Domain.Enums.RequisitionStatus.Draft && !string.IsNullOrWhiteSpace(requisition.RejectionReason) ? "Revision Required" : HumanizeStatus(requisition.Status))</span>
                        @if (!string.IsNullOrWhiteSpace(requisition.RejectionReason)) { <div class="small text-danger mt-1">Returned: @requisition.RejectionReason</div> }
                    </td>
                    <td>
                        <span class="badge @(requisition.IsActive ? "bg-success" : "bg-secondary")">
                            <span class="badge-dot"></span>@(requisition.IsActive ? "Active" : "Inactive")
                        </span>
                    </td>
                    <td class="text-end">
                        <a asp-action="Print" asp-route-id="@requisition.Id" class="btn btn-sm btn-outline-primary" target="_blank">Print</a>
                        @if (User.HasClaim(PermissionClaimTypes.Permission, PermissionNames.EngineerWorkOrderRequisitionManage))
                        {
                            @if (assignment?.CanDraftEdit == true && requisition.Status == BuilderERP.Domain.Enums.RequisitionStatus.Draft)
                            { <a asp-action="Edit" asp-route-id="@requisition.Id" class="btn btn-sm btn-outline-secondary">Edit</a> }
                            @if (assignment?.CanSubmit == true && requisition.Status == BuilderERP.Domain.Enums.RequisitionStatus.Draft)
                            { <partial name="_WorkflowButton" model="@(new EngineerWorkOrderRequisitionWorkflowButtonViewModel(requisition.Id, "submit", "Submit", "btn-outline-primary"))" /> }
                            @if (assignment?.CanRequestApproval == true && requisition.Status == BuilderERP.Domain.Enums.RequisitionStatus.Submitted)
                            { <partial name="_WorkflowButton" model="@(new EngineerWorkOrderRequisitionWorkflowButtonViewModel(requisition.Id, "request", "Request approval", "btn-outline-primary"))" /> }
                            @if (assignment?.CanApprove == true && requisition.Status == BuilderERP.Domain.Enums.RequisitionStatus.AwaitingApproval)
                            { <partial name="_WorkflowButton" model="@(new EngineerWorkOrderRequisitionWorkflowButtonViewModel(requisition.Id, "approve", "Approve", "btn-success"))" /> }
                            @if (assignment?.CanReject == true && requisition.Status is BuilderERP.Domain.Enums.RequisitionStatus.Submitted or BuilderERP.Domain.Enums.RequisitionStatus.AwaitingApproval or BuilderERP.Domain.Enums.RequisitionStatus.Approved)
                            { <partial name="_WorkflowButton" model="@(new EngineerWorkOrderRequisitionWorkflowButtonViewModel(requisition.Id, "reject", "Reject", "btn-outline-danger"))" /> }
                            @if (assignment?.CanCancel == true && requisition.Status is BuilderERP.Domain.Enums.RequisitionStatus.Draft or BuilderERP.Domain.Enums.RequisitionStatus.Submitted or BuilderERP.Domain.Enums.RequisitionStatus.AwaitingApproval or BuilderERP.Domain.Enums.RequisitionStatus.Rejected)
                            { <partial name="_WorkflowButton" model="@(new EngineerWorkOrderRequisitionWorkflowButtonViewModel(requisition.Id, "cancel", "Cancel", "btn-outline-danger"))" /> }
                            <form asp-action="ToggleActive" asp-route-id="@requisition.Id" asp-route-isActive="@requisition.IsActive" method="post" class="d-inline">
                                <button type="submit" class="btn btn-sm btn-outline-danger">
                                    @(requisition.IsActive ? "Deactivate" : "Activate")
                                </button>
                            </form>
                        }
                    </td>
                </tr>
            }
            @if (Model.Items.Count == 0)
            {
                <tr>
                    <td colspan="7" class="text-center text-muted">No engineer work order requisitions found.</td>
                </tr>
            }
        </tbody>
    </table>
    <div class="card-body pt-2">
        <partial name="_Pagination" model="@(new BuilderERP.Web.Models.PaginationViewModel
        {
            Page = Model.Page,
            PageSize = Model.PageSize,
            TotalPages = Model.TotalPages,
            TotalCount = Model.TotalCount,
            Action = "Index",
            RouteValues = BuildFilterRouteValues(requisitionNumber, projectId, status, dateFrom, dateTo)
        })" />
    </div>
</div>

@functions {
    private static Dictionary<string, string?> BuildFilterRouteValues(string? requisitionNumber, long? projectId, BuilderERP.Domain.Enums.RequisitionStatus? status, DateTime? dateFrom, DateTime? dateTo)
    {
        var values = new Dictionary<string, string?>();
        if (!string.IsNullOrWhiteSpace(requisitionNumber)) values["requisitionNumber"] = requisitionNumber;
        if (projectId.HasValue) values["projectId"] = projectId.Value.ToString();
        if (status.HasValue) values["status"] = status.Value.ToString();
        if (dateFrom.HasValue) values["dateFrom"] = dateFrom.Value.ToString("yyyy-MM-dd");
        if (dateTo.HasValue) values["dateTo"] = dateTo.Value.ToString("yyyy-MM-dd");
        return values;
    }

    private static string StatusBadgeClass(BuilderERP.Domain.Enums.RequisitionStatus status) => status switch
    {
        BuilderERP.Domain.Enums.RequisitionStatus.Draft => "bg-secondary",
        BuilderERP.Domain.Enums.RequisitionStatus.Submitted => "bg-warning",
        BuilderERP.Domain.Enums.RequisitionStatus.AwaitingApproval => "bg-warning",
        BuilderERP.Domain.Enums.RequisitionStatus.Approved => "bg-success",
        BuilderERP.Domain.Enums.RequisitionStatus.Rejected => "bg-danger",
        BuilderERP.Domain.Enums.RequisitionStatus.Converted => "bg-primary",
        BuilderERP.Domain.Enums.RequisitionStatus.Cancelled => "bg-danger",
        _ => "bg-secondary"
    };

    private static string HumanizeStatus(BuilderERP.Domain.Enums.RequisitionStatus status) =>
        status == BuilderERP.Domain.Enums.RequisitionStatus.AwaitingApproval ? "Awaiting Approval" : status.ToString();
}
