@model IReadOnlyList<BuilderERP.Application.DTOs.StockAdjustmentDto>
@using BuilderERP.Shared.Constants
@using BuilderERP.Shared.Authorization
@{
    ViewData["Title"] = "Stock Adjustments";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Stock Adjustments</h1>
    @if (User.HasClaim(PermissionClaimTypes.Permission, PermissionNames.StockAdjustmentManage))
    {
        <a asp-action="Create" class="btn btn-primary">New Stock Adjustment</a>
    }
</div>

<form method="get" class="mb-3 col-md-4">
    <label class="form-label">Project</label>
    <select name="projectId" asp-items="ViewBag.Projects" class="form-select" onchange="this.form.submit()">
        <option value="">-- All Projects --</option>
    </select>
</form>

<table class="table table-striped table-hover bg-white">
    <thead>
        <tr>
            <th>Adjustment #</th>
            <th>Material</th>
            <th>Project</th>
            <th>Warehouse</th>
            <th>Quantity Delta</th>
            <th>Reason</th>
            <th>Date</th>
            <th>Active</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var adjustment in Model)
        {
            <tr>
                <td>@adjustment.AdjustmentNumber</td>
                <td>@adjustment.MaterialName</td>
                <td>@adjustment.ProjectName</td>
                <td>@adjustment.WarehouseName</td>
                <td>@adjustment.QuantityDelta</td>
                <td>@adjustment.Reason</td>
                <td>@adjustment.AdjustmentDate.ToString("yyyy-MM-dd")</td>
                <td>
                    <span class="badge @(adjustment.IsActive ? "bg-success" : "bg-secondary")">
                        @(adjustment.IsActive ? "Active" : "Inactive")
                    </span>
                </td>
                <td class="text-end">
                    @if (User.HasClaim(PermissionClaimTypes.Permission, PermissionNames.StockAdjustmentManage))
                    {
                        <a asp-action="Edit" asp-route-id="@adjustment.Id" class="btn btn-sm btn-outline-secondary">Edit</a>
                        <form asp-action="ToggleActive" asp-route-id="@adjustment.Id" asp-route-isActive="@adjustment.IsActive" method="post" class="d-inline">
                            <button type="submit" class="btn btn-sm btn-outline-danger">
                                @(adjustment.IsActive ? "Deactivate" : "Activate")
                            </button>
                        </form>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>
