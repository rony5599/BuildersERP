@using BuilderERP.Application.Common
@using BuilderERP.Shared.Constants
@using BuilderERP.Shared.Authorization
@using Microsoft.AspNetCore.Mvc.Rendering
@model PagedResult<BuilderERP.Application.DTOs.StockAdjustmentDto>
@{
    var projectId = ViewBag.SelectedProjectId as long?;
    var adjustmentNumber = ViewBag.AdjustmentNumber as string;
    var materialId = ViewBag.SelectedMaterialId as long?;
    var dateFrom = ViewBag.DateFrom as DateTime?;
    var dateTo = ViewBag.DateTo as DateTime?;
    var hasFilters = projectId.HasValue || !string.IsNullOrWhiteSpace(adjustmentNumber) || materialId.HasValue || dateFrom.HasValue || dateTo.HasValue;
}

<div class="card mb-3">
    <div class="card-body">
        <form asp-action="Index" method="get" class="row gy-3 gx-4 align-items-end grid-search-form">
            <div class="col-12 col-sm-6 col-lg-2">
                <label class="form-label small mb-1">Adjustment #</label>
                <input type="search" name="adjustmentNumber" value="@adjustmentNumber" class="form-control" placeholder="Adjustment #" />
            </div>
            <div class="col-12 col-sm-6 col-lg-2">
                <label class="form-label small mb-1">Material</label>
                <select name="materialId" asp-items="@(ViewBag.MaterialFilterOptions as SelectList)" class="form-select">
                    <option value="">All Materials</option>
                </select>
            </div>
            <div class="col-12 col-sm-6 col-lg-2">
                <label class="form-label small mb-1">Project</label>
                <select name="projectId" asp-items="@(ViewBag.Projects as SelectList)" class="form-select">
                    <option value="">All Projects</option>
                </select>
            </div>
            <div class="col-12 col-sm-6 col-lg-2">
                <label class="form-label small mb-1">Date From</label>
                <input type="date" name="dateFrom" value="@(dateFrom?.ToString("yyyy-MM-dd"))" class="form-control" />
            </div>
            <div class="col-12 col-sm-6 col-lg-2">
                <label class="form-label small mb-1">Date To</label>
                <input type="date" name="dateTo" value="@(dateTo?.ToString("yyyy-MM-dd"))" class="form-control" />
            </div>
            <div class="col-12 col-sm-6 col-lg-2 d-flex gap-2">
                <button type="submit" class="btn btn-primary flex-grow-1">Filter</button>
                @if (hasFilters)
                {
                    <a asp-action="Index" class="btn btn-outline-secondary flex-grow-1">Clear</a>
                }
            </div>
        </form>
    </div>
</div>

<div class="card">
    <table class="table table-striped table-hover mb-0">
        <thead>
            <tr>
                <th>Adjustment #</th>
                <th>Material</th>
                <th>Project</th>
                <th>Warehouse</th>
                <th>Quantity Delta</th>
                <th>Reason</th>
                <th>Date</th>
                <th>Active</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var adjustment in Model.Items)
            {
                <tr>
                    <td>@adjustment.AdjustmentNumber</td>
                    <td>@adjustment.MaterialName</td>
                    <td>@adjustment.ProjectName</td>
                    <td>@adjustment.WarehouseName</td>
                    <td>@adjustment.QuantityDelta</td>
                    <td>@adjustment.Reason</td>
                    <td>@adjustment.AdjustmentDate.ToString("yyyy-MM-dd")</td>
                    <td>
                        <span class="badge @(adjustment.IsActive ? "bg-success" : "bg-secondary")">
                            <span class="badge-dot"></span>@(adjustment.IsActive ? "Active" : "Inactive")
                        </span>
                    </td>
                    <td class="text-end">
                        @if (User.HasClaim(PermissionClaimTypes.Permission, PermissionNames.StockAdjustmentManage))
                        {
                            <a asp-action="Edit" asp-route-id="@adjustment.Id" class="btn btn-sm btn-outline-secondary">Edit</a>
                            <form asp-action="ToggleActive" asp-route-id="@adjustment.Id" asp-route-isActive="@adjustment.IsActive" method="post" class="d-inline">
                                <button type="submit" class="btn btn-sm btn-outline-danger">
                                    @(adjustment.IsActive ? "Deactivate" : "Activate")
                                </button>
                            </form>
                        }
                    </td>
                </tr>
            }
            @if (Model.Items.Count == 0)
            {
                <tr>
                    <td colspan="9" class="text-center text-muted">No stock adjustments found.</td>
                </tr>
            }
        </tbody>
    </table>
    <div class="card-body pt-2">
        <partial name="_Pagination" model="@(new BuilderERP.Web.Models.PaginationViewModel
        {
            Page = Model.Page,
            PageSize = Model.PageSize,
            TotalPages = Model.TotalPages,
            TotalCount = Model.TotalCount,
            Action = "Index",
            RouteValues = BuildFilterRouteValues(projectId, adjustmentNumber, materialId, dateFrom, dateTo)
        })" />
    </div>
</div>

@functions {
    private static Dictionary<string, string?> BuildFilterRouteValues(long? projectId, string? adjustmentNumber, long? materialId, DateTime? dateFrom, DateTime? dateTo)
    {
        var values = new Dictionary<string, string?>();
        if (projectId.HasValue) values["projectId"] = projectId.Value.ToString();
        if (!string.IsNullOrWhiteSpace(adjustmentNumber)) values["adjustmentNumber"] = adjustmentNumber;
        if (materialId.HasValue) values["materialId"] = materialId.Value.ToString();
        if (dateFrom.HasValue) values["dateFrom"] = dateFrom.Value.ToString("yyyy-MM-dd");
        if (dateTo.HasValue) values["dateTo"] = dateTo.Value.ToString("yyyy-MM-dd");
        return values;
    }
}
