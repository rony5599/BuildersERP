@using BuilderERP.Application.Common
@model PagedResult<BuilderERP.Application.DTOs.UtilityBillDto>
@using BuilderERP.Shared.Constants
@using BuilderERP.Shared.Authorization
@{
    ViewData["Title"] = "Utility Bills";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Utility Bills</h1>
    @if (User.HasClaim(PermissionClaimTypes.Permission, PermissionNames.UtilityBillManage))
    {
        <a asp-action="Create" class="btn btn-primary">New Utility Bill</a>
    }
</div>

<div data-grid-container>
    <partial name="_Grid" model="Model" />
</div>
