@model BuilderERP.Application.DTOs.UpdateCommissionDto
@using BuilderERP.Domain.Enums
@{
    ViewData["Title"] = "Edit Commission";
}

<h1 class="h3 mb-4">Edit Commission</h1>

<form asp-action="Edit" method="post" class="col-md-6">
    <input type="hidden" asp-for="Id" />
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
    <div class="mb-3">
        <label asp-for="BrokerId" class="form-label"></label>
        <select asp-for="BrokerId" asp-items="ViewBag.Brokers" class="form-select">
            <option value="">-- Select Broker --</option>
        </select>
        <span asp-validation-for="BrokerId" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="BookingId" class="form-label"></label>
        <select asp-for="BookingId" asp-items="ViewBag.Bookings" class="form-select">
            <option value="">-- Select Booking --</option>
        </select>
        <span asp-validation-for="BookingId" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="CommissionRate" class="form-label">Commission Rate (%)</label>
        <input asp-for="CommissionRate" class="form-control" />
        <span asp-validation-for="CommissionRate" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="CommissionAmount" class="form-label">Commission Amount (leave blank to auto-calculate from booking amount × rate)</label>
        <input asp-for="CommissionAmount" class="form-control" />
        <span asp-validation-for="CommissionAmount" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Status" class="form-label"></label>
        <select asp-for="Status" asp-items="Html.GetEnumSelectList<CommissionStatus>()" class="form-select"></select>
        <span asp-validation-for="Status" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="PaymentDate" class="form-label"></label>
        <input asp-for="PaymentDate" type="date" class="form-control" />
        <span asp-validation-for="PaymentDate" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Remarks" class="form-label"></label>
        <textarea asp-for="Remarks" class="form-control"></textarea>
        <span asp-validation-for="Remarks" class="text-danger"></span>
    </div>
    <button type="submit" class="btn btn-primary">Save</button>
    <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
</form>
