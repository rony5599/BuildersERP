@model IReadOnlyList<BuilderERP.Application.DTOs.DocumentDto>
@using BuilderERP.Shared.Constants
@using BuilderERP.Shared.Authorization
@{
    ViewData["Title"] = "Documents";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Documents</h1>
    @if (User.HasClaim(PermissionClaimTypes.Permission, PermissionNames.DocumentManage))
    {
        <a asp-action="Create" class="btn btn-primary">New Document</a>
    }
</div>

<table class="table table-striped table-hover bg-white">
    <thead>
        <tr>
            <th>Document Number</th>
            <th>Title</th>
            <th>Type</th>
            <th>Customer</th>
            <th>Project</th>
            <th>Issue Date</th>
            <th>Expiry Date</th>
            <th>File</th>
            <th>Active</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.DocumentNumber</td>
                <td>@item.Title</td>
                <td><span class="badge bg-info text-dark">@item.DocumentType</span></td>
                <td>@(item.CustomerName ?? "—")</td>
                <td>@(item.ProjectName ?? "—")</td>
                <td>@(item.IssueDate.HasValue ? item.IssueDate.Value.ToString("yyyy-MM-dd") : "—")</td>
                <td>
                    @if (item.ExpiryDate.HasValue)
                    {
                        <span class="@(item.ExpiryDate.Value.Date < DateTime.UtcNow.Date ? "text-danger" : "")">
                            @item.ExpiryDate.Value.ToString("yyyy-MM-dd")
                        </span>
                    }
                    else
                    {
                        <text>—</text>
                    }
                </td>
                <td><a href="@item.FilePath" target="_blank">View</a></td>
                <td>
                    <span class="badge @(item.IsActive ? "bg-success" : "bg-secondary")">
                        @(item.IsActive ? "Active" : "Inactive")
                    </span>
                </td>
                <td class="text-end">
                    @if (User.HasClaim(PermissionClaimTypes.Permission, PermissionNames.DocumentManage))
                    {
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">Edit</a>
                        <form asp-action="ToggleActive" asp-route-id="@item.Id" asp-route-isActive="@item.IsActive" method="post" class="d-inline">
                            <button type="submit" class="btn btn-sm btn-outline-danger">
                                @(item.IsActive ? "Deactivate" : "Activate")
                            </button>
                        </form>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>
