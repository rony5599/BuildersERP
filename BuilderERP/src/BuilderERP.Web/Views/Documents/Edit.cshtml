@model BuilderERP.Application.DTOs.UpdateDocumentDto
@using BuilderERP.Domain.Enums
@{
    ViewData["Title"] = "Edit Document";
}

<h1 class="h3 mb-4">Edit Document</h1>

<form asp-action="Edit" method="post" enctype="multipart/form-data" class="col-md-6">
    <input type="hidden" asp-for="Id" />
    <input type="hidden" asp-for="FilePath" />
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
    <div class="mb-3">
        <a href="@Model.FilePath" target="_blank">View current file</a>
    </div>
    <div class="mb-3">
        <label asp-for="DocumentNumber" class="form-label"></label>
        <input asp-for="DocumentNumber" class="form-control" />
        <span asp-validation-for="DocumentNumber" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Title" class="form-label"></label>
        <input asp-for="Title" class="form-control" />
        <span asp-validation-for="Title" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="DocumentType" class="form-label"></label>
        <select asp-for="DocumentType" asp-items="Html.GetEnumSelectList<DocumentType>()" class="form-select"></select>
        <span asp-validation-for="DocumentType" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label class="form-label">Replace File</label>
        <input type="file" name="file" class="form-control" />
    </div>
    <div class="mb-3">
        <label asp-for="CustomerId" class="form-label"></label>
        <select asp-for="CustomerId" asp-items="ViewBag.Customers" class="form-select">
            <option value="">-- None --</option>
        </select>
        <span asp-validation-for="CustomerId" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="ProjectId" class="form-label"></label>
        <select asp-for="ProjectId" asp-items="ViewBag.Projects" class="form-select">
            <option value="">-- None --</option>
        </select>
        <span asp-validation-for="ProjectId" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="IssueDate" class="form-label"></label>
        <input asp-for="IssueDate" type="date" class="form-control" />
        <span asp-validation-for="IssueDate" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="ExpiryDate" class="form-label"></label>
        <input asp-for="ExpiryDate" type="date" class="form-control" />
        <span asp-validation-for="ExpiryDate" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Remarks" class="form-label"></label>
        <textarea asp-for="Remarks" class="form-control"></textarea>
        <span asp-validation-for="Remarks" class="text-danger"></span>
    </div>
    <button type="submit" class="btn btn-primary">Save</button>
    <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
</form>
