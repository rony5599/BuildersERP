@model IReadOnlyList<BuilderERP.Application.DTOs.BookingDto>
@using BuilderERP.Shared.Constants
@using BuilderERP.Shared.Authorization
@{
    ViewData["Title"] = "Bookings";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Bookings</h1>
    @if (User.HasClaim(PermissionClaimTypes.Permission, PermissionNames.BookingManage))
    {
        <a asp-action="Create" class="btn btn-primary">New Booking</a>
    }
</div>

<table class="table table-striped table-hover bg-white">
    <thead>
        <tr>
            <th>Customer</th>
            <th>Property Unit</th>
            <th>Booking Date</th>
            <th>Amount</th>
            <th>Status</th>
            <th>Active</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var booking in Model)
        {
            <tr>
                <td>@booking.CustomerName</td>
                <td>@booking.PropertyUnitNumber</td>
                <td>@booking.BookingDate.ToString("yyyy-MM-dd")</td>
                <td>@booking.BookingAmount</td>
                <td>@booking.Status</td>
                <td>
                    <span class="badge @(booking.IsActive ? "bg-success" : "bg-secondary")">
                        @(booking.IsActive ? "Active" : "Inactive")
                    </span>
                </td>
                <td class="text-end">
                    @if (User.HasClaim(PermissionClaimTypes.Permission, PermissionNames.BookingManage))
                    {
                        <a asp-action="Edit" asp-route-id="@booking.Id" class="btn btn-sm btn-outline-secondary">Edit</a>
                        <form asp-action="ToggleActive" asp-route-id="@booking.Id" asp-route-isActive="@booking.IsActive" method="post" class="d-inline">
                            <button type="submit" class="btn btn-sm btn-outline-danger">
                                @(booking.IsActive ? "Deactivate" : "Activate")
                            </button>
                        </form>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>
