@model BuilderERP.Application.DTOs.CreateBookingDto
@using BuilderERP.Domain.Enums
@{
    ViewData["Title"] = "New Booking";
}

<h1 class="h3 mb-4">New Booking</h1>

<form asp-action="Create" method="post" class="col-md-6">
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
    <div class="mb-3">
        <label asp-for="CustomerId" class="form-label"></label>
        <select asp-for="CustomerId" asp-items="ViewBag.Customers" class="form-select">
            <option value="">-- Select Customer --</option>
        </select>
        <span asp-validation-for="CustomerId" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label class="form-label">Project</label>
        <select id="ProjectFilter" class="form-select">
            <option value="">-- Select Project --</option>
            @foreach (var project in (IEnumerable<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>)ViewBag.Projects)
            {
                <option value="@project.Value">@project.Text</option>
            }
        </select>
    </div>
    <div class="mb-3">
        <label asp-for="PropertyUnitId" class="form-label"></label>
        <select asp-for="PropertyUnitId" class="form-select" id="PropertyUnitId">
            <option value="">-- Select Property Unit --</option>
            @foreach (var unit in (IEnumerable<BuilderERP.Application.DTOs.PropertyUnitDto>)ViewBag.PropertyUnits)
            {
                <option value="@unit.Id" data-project-id="@unit.ProjectId">@unit.UnitNumber</option>
            }
        </select>
        <span asp-validation-for="PropertyUnitId" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="BookingDate" class="form-label"></label>
        <input asp-for="BookingDate" type="date" class="form-control" />
    </div>
    <div class="mb-3">
        <label asp-for="BookingAmount" class="form-label"></label>
        <input asp-for="BookingAmount" class="form-control" />
        <span asp-validation-for="BookingAmount" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Status" class="form-label"></label>
        <select asp-for="Status" asp-items="Html.GetEnumSelectList<BookingRequestStatus>()" class="form-select"></select>
        <span asp-validation-for="Status" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="CancellationReason" class="form-label"></label>
        <textarea asp-for="CancellationReason" class="form-control"></textarea>
        <span asp-validation-for="CancellationReason" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="BrokerId" class="form-label">Broker / Agent</label>
        <select asp-for="BrokerId" asp-items="ViewBag.Brokers" class="form-select">
            <option value="">-- None --</option>
        </select>
        <span asp-validation-for="BrokerId" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="CollectionOfficerId" class="form-label">Collection Officer</label>
        <select asp-for="CollectionOfficerId" asp-items="ViewBag.CollectionOfficers" class="form-select">
            <option value="">-- None --</option>
        </select>
        <span asp-validation-for="CollectionOfficerId" class="text-danger"></span>
    </div>
    <button type="submit" class="btn btn-primary">Save</button>
    <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
</form>

@section Scripts {
    <script>
        (function () {
            var projectSelect = document.getElementById('ProjectFilter');
            var unitSelect = document.getElementById('PropertyUnitId');
            var unitOptions = Array.prototype.slice.call(unitSelect.options);

            function filterUnits() {
                var projectId = projectSelect.value;
                unitSelect.innerHTML = '';
                unitSelect.appendChild(unitOptions[0].cloneNode(true));
                unitOptions.forEach(function (opt) {
                    if (opt.value === '') return;
                    if (!projectId || opt.getAttribute('data-project-id') === projectId) {
                        unitSelect.appendChild(opt.cloneNode(true));
                    }
                });
            }

            projectSelect.addEventListener('change', filterUnits);
        })();
    </script>
}
