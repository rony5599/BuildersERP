@using BuilderERP.Application.Common
@model PagedResult<BuilderERP.Application.DTOs.BookingDto>
@using BuilderERP.Shared.Constants
@using BuilderERP.Shared.Authorization

<table class="table table-striped table-hover bg-white">
    <thead>
        <tr>
            <th>Customer</th>
            <th>Project</th>
            <th>Property Unit</th>
            <th>Booking Date</th>
            <th>Amount</th>
            <th>Status</th>
            <th>Broker</th>
            <th>Collection Officer</th>
            <th>Active</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var booking in Model.Items)
        {
            <tr>
                <td>@booking.CustomerName</td>
                <td>@booking.ProjectName</td>
                <td>@booking.PropertyUnitNumber</td>
                <td>@booking.BookingDate.ToString("yyyy-MM-dd")</td>
                <td>@booking.BookingAmount</td>
                <td title="@booking.CancellationReason">@booking.Status</td>
                <td>@booking.BrokerName</td>
                <td>@booking.CollectionOfficerName</td>
                <td>
                    <span class="badge @(booking.IsActive ? "bg-success" : "bg-secondary")">
                        @(booking.IsActive ? "Active" : "Inactive")
                    </span>
                </td>
                <td class="text-end">
                    @if (User.HasClaim(PermissionClaimTypes.Permission, PermissionNames.BookingManage))
                    {
                        <a asp-action="Edit" asp-route-id="@booking.Id" class="btn btn-sm btn-outline-secondary">Edit</a>
                        <form asp-action="ToggleActive" asp-route-id="@booking.Id" asp-route-isActive="@booking.IsActive" method="post" class="d-inline">
                            <button type="submit" class="btn btn-sm btn-outline-danger">
                                @(booking.IsActive ? "Deactivate" : "Activate")
                            </button>
                        </form>
                    }
                </td>
            </tr>
        }
        @if (Model.Items.Count == 0)
        {
            <tr>
                <td colspan="10" class="text-center text-muted">No bookings found.</td>
            </tr>
        }
    </tbody>
</table>

<partial name="_Pagination" model="@(new BuilderERP.Web.Models.PaginationViewModel
{
    Page = Model.Page,
    PageSize = Model.PageSize,
    TotalPages = Model.TotalPages,
    TotalCount = Model.TotalCount,
    Action = "Index",
    RouteValues = new()
})" />
