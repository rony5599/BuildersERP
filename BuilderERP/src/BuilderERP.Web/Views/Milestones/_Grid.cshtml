@using BuilderERP.Application.Common
@model PagedResult<BuilderERP.Application.DTOs.MilestoneDto>
@using BuilderERP.Shared.Constants
@using BuilderERP.Shared.Authorization
@using BuilderERP.Domain.Enums
@{
    string StatusBadgeClass(MilestoneStatus status) => status switch
    {
        MilestoneStatus.Achieved => "bg-success",
        MilestoneStatus.Delayed => "bg-warning",
        MilestoneStatus.Cancelled => "bg-danger",
        _ => "bg-secondary"
    };
}

<table class="table table-striped table-hover bg-white">
    <thead>
        <tr>
            <th>Name</th>
            <th>Project</th>
            <th>Target Date</th>
            <th>Actual Date</th>
            <th>Status</th>
            <th>Active</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var milestone in Model.Items)
        {
            <tr>
                <td>@milestone.Name</td>
                <td>@milestone.ProjectName</td>
                <td>@milestone.TargetDate.ToShortDateString()</td>
                <td>@(milestone.ActualDate?.ToShortDateString())</td>
                <td>
                    <span class="badge @StatusBadgeClass(milestone.Status)">@milestone.Status</span>
                </td>
                <td>
                    <span class="badge @(milestone.IsActive ? "bg-success" : "bg-secondary")">
                        @(milestone.IsActive ? "Active" : "Inactive")
                    </span>
                </td>
                <td class="text-end">
                    @if (User.HasClaim(PermissionClaimTypes.Permission, PermissionNames.MilestoneManage))
                    {
                        <a asp-action="Edit" asp-route-id="@milestone.Id" class="btn btn-sm btn-outline-secondary">Edit</a>
                        <form asp-action="ToggleActive" asp-route-id="@milestone.Id" asp-route-isActive="@milestone.IsActive" method="post" class="d-inline">
                            <button type="submit" class="btn btn-sm btn-outline-danger">
                                @(milestone.IsActive ? "Deactivate" : "Activate")
                            </button>
                        </form>
                    }
                </td>
            </tr>
        }
        @if (Model.Items.Count == 0)
        {
            <tr>
                <td colspan="7" class="text-center text-muted">No milestones found.</td>
            </tr>
        }
    </tbody>
</table>

<partial name="_Pagination" model="@(new BuilderERP.Web.Models.PaginationViewModel
{
    Page = Model.Page,
    PageSize = Model.PageSize,
    TotalPages = Model.TotalPages,
    TotalCount = Model.TotalCount,
    Action = "Index",
    RouteValues = new Dictionary<string, string?> { ["projectId"] = ViewBag.SelectedProjectId?.ToString() }
})" />
