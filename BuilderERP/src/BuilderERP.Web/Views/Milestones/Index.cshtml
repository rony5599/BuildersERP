@model IReadOnlyList<BuilderERP.Application.DTOs.MilestoneDto>
@using BuilderERP.Shared.Constants
@using BuilderERP.Shared.Authorization
@using BuilderERP.Domain.Enums
@{
    ViewData["Title"] = "Milestones";

    string StatusBadgeClass(MilestoneStatus status) => status switch
    {
        MilestoneStatus.Achieved => "bg-success",
        MilestoneStatus.Delayed => "bg-warning",
        MilestoneStatus.Cancelled => "bg-danger",
        _ => "bg-secondary"
    };
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Milestones</h1>
    @if (User.HasClaim(PermissionClaimTypes.Permission, PermissionNames.MilestoneManage))
    {
        <a asp-action="Create" class="btn btn-primary">New Milestone</a>
    }
</div>

<table class="table table-striped table-hover bg-white">
    <thead>
        <tr>
            <th>Name</th>
            <th>Project</th>
            <th>Target Date</th>
            <th>Actual Date</th>
            <th>Status</th>
            <th>Active</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var milestone in Model)
        {
            <tr>
                <td>@milestone.Name</td>
                <td>@milestone.ProjectName</td>
                <td>@milestone.TargetDate.ToShortDateString()</td>
                <td>@(milestone.ActualDate?.ToShortDateString())</td>
                <td>
                    <span class="badge @StatusBadgeClass(milestone.Status)">@milestone.Status</span>
                </td>
                <td>
                    <span class="badge @(milestone.IsActive ? "bg-success" : "bg-secondary")">
                        @(milestone.IsActive ? "Active" : "Inactive")
                    </span>
                </td>
                <td class="text-end">
                    @if (User.HasClaim(PermissionClaimTypes.Permission, PermissionNames.MilestoneManage))
                    {
                        <a asp-action="Edit" asp-route-id="@milestone.Id" class="btn btn-sm btn-outline-secondary">Edit</a>
                        <form asp-action="ToggleActive" asp-route-id="@milestone.Id" asp-route-isActive="@milestone.IsActive" method="post" class="d-inline">
                            <button type="submit" class="btn btn-sm btn-outline-danger">
                                @(milestone.IsActive ? "Deactivate" : "Activate")
                            </button>
                        </form>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>
