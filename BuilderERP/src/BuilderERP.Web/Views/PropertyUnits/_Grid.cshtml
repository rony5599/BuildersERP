@using BuilderERP.Application.Common
@using BuilderERP.Shared.Constants
@using BuilderERP.Shared.Authorization
@using BuilderERP.Domain.Enums
@model PagedResult<BuilderERP.Application.DTOs.PropertyUnitDto>

@{
    string StatusBadge(BookingStatus status) => status switch
    {
        BookingStatus.Available => "bg-success",
        BookingStatus.Reserved => "bg-warning text-dark",
        BookingStatus.Booked => "bg-info",
        BookingStatus.Sold => "bg-primary",
        BookingStatus.Blocked => "bg-secondary",
        _ => "bg-secondary"
    };
}

<div class="d-flex gap-2 mb-3">
    @foreach (var group in Model.Items.GroupBy(u => u.BookingStatus).OrderBy(g => g.Key))
    {
        <span class="badge @StatusBadge(group.Key)">@group.Key: @group.Count()</span>
    }
</div>

<table class="table table-striped table-hover bg-white">
    <thead>
        <tr>
            <th>Unit #</th>
            <th>Type</th>
            <th>Project</th>
            <th>Floor</th>
            <th>Area</th>
            <th>Price</th>
            <th>Booking Status</th>
            <th>Status</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var unit in Model.Items)
        {
            <tr>
                <td>@unit.UnitNumber</td>
                <td>@unit.UnitType</td>
                <td>@unit.ProjectName</td>
                <td>@unit.FloorName</td>
                <td>@unit.Area</td>
                <td>@unit.Price</td>
                <td><span class="badge @StatusBadge(unit.BookingStatus)">@unit.BookingStatus</span></td>
                <td>
                    <span class="badge @(unit.IsActive ? "bg-success" : "bg-secondary")">
                        @(unit.IsActive ? "Active" : "Inactive")
                    </span>
                </td>
                <td class="text-end">
                    @if (User.HasClaim(PermissionClaimTypes.Permission, PermissionNames.PropertyUnitManage))
                    {
                        <a asp-action="Edit" asp-route-id="@unit.Id" class="btn btn-sm btn-outline-secondary">Edit</a>
                        <form asp-action="ToggleActive" asp-route-id="@unit.Id" asp-route-isActive="@unit.IsActive" method="post" class="d-inline">
                            <button type="submit" class="btn btn-sm btn-outline-danger">
                                @(unit.IsActive ? "Deactivate" : "Activate")
                            </button>
                        </form>
                    }
                </td>
            </tr>
        }
        @if (Model.Items.Count == 0)
        {
            <tr>
                <td colspan="9" class="text-center text-muted">No property units found.</td>
            </tr>
        }
    </tbody>
</table>

<partial name="_Pagination" model="@(new BuilderERP.Web.Models.PaginationViewModel
{
    Page = Model.Page,
    PageSize = Model.PageSize,
    TotalPages = Model.TotalPages,
    TotalCount = Model.TotalCount,
    Action = "Index",
    RouteValues = new Dictionary<string, string?> { ["projectId"] = ViewBag.SelectedProjectId?.ToString() }
})" />
