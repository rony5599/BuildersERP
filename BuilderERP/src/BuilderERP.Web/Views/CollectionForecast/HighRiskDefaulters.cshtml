@model IReadOnlyList<BuilderERP.Application.DTOs.CustomerCollectionRiskDto>
@{
    ViewData["Title"] = "High-Risk Defaulters";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">High-Risk Defaulters</h1>
    <a asp-action="Index" class="btn btn-outline-secondary">Back to Forecast Dashboard</a>
</div>

<form method="get" class="mb-3 col-md-4">
    <label class="form-label">Project</label>
    <select name="projectId" asp-items="ViewBag.Projects" class="form-select" onchange="this.form.submit()">
        <option value="">-- All Projects --</option>
    </select>
</form>

<table class="table table-striped table-hover bg-white">
    <thead>
        <tr>
            <th>Customer</th>
            <th>Phone</th>
            <th>Project</th>
            <th>Unit</th>
            <th>Overdue Amount</th>
            <th>Overdue Installments</th>
            <th>Max Days Overdue</th>
            <th>On-Time Payment Rate</th>
            <th>Risk</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var d in Model)
        {
            <tr class="@(d.IsHighRisk ? "table-danger" : "")">
                <td>@d.CustomerName</td>
                <td>@d.Phone</td>
                <td>@d.ProjectName</td>
                <td>@d.UnitNumber</td>
                <td>@d.OverdueAmount.ToString("N2")</td>
                <td>@d.OverdueInstallments</td>
                <td>@d.MaxDaysOverdue</td>
                <td>@d.OnTimePaymentRatePercent%</td>
                <td>
                    @if (d.IsHighRisk)
                    {
                        <span class="badge bg-danger">High Risk</span>
                    }
                    else
                    {
                        <span class="badge bg-warning text-dark">Watch</span>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>
