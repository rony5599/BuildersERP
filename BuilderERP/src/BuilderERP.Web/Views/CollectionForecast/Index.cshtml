@model BuilderERP.Application.DTOs.DueCollectionForecastSummaryDto
@using BuilderERP.Application.DTOs
@{
    ViewData["Title"] = "Due Collection Forecast";
    var buckets = (IReadOnlyList<DueCollectionForecastBucketDto>)ViewBag.Buckets;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Due Collection Forecast</h1>
    <div>
        <a asp-controller="CollectionForecast" asp-action="HighRiskDefaulters" class="btn btn-outline-danger">High-Risk Defaulters</a>
        <a asp-controller="CollectionTargets" asp-action="Index" class="btn btn-outline-secondary">Collection Targets</a>
        <a asp-controller="PaymentReminders" asp-action="Index" class="btn btn-outline-secondary">Payment Reminders</a>
        <a asp-controller="Reports" asp-action="ExportExcel" asp-route-key="due-collection-forecast" asp-route-projectId="@ViewBag.SelectedProjectId" class="btn btn-outline-success">Export Excel</a>
        <a asp-controller="Reports" asp-action="ExportPdf" asp-route-key="due-collection-forecast" asp-route-projectId="@ViewBag.SelectedProjectId" class="btn btn-outline-success">Export PDF</a>
    </div>
</div>

<form method="get" class="row g-2 mb-4">
    <div class="col-md-3">
        <label class="form-label">Project</label>
        <select name="projectId" asp-items="ViewBag.Projects" class="form-select">
            <option value="">-- All Projects --</option>
        </select>
    </div>
    <div class="col-md-3">
        <label class="form-label">Property Unit</label>
        <select name="propertyUnitId" asp-items="ViewBag.PropertyUnits" class="form-select">
            <option value="">-- All Units --</option>
        </select>
    </div>
    <div class="col-md-3">
        <label class="form-label">Customer</label>
        <select name="customerId" asp-items="ViewBag.Customers" class="form-select">
            <option value="">-- All Customers --</option>
        </select>
    </div>
    <div class="col-md-3">
        <label class="form-label">Collection Officer</label>
        <select name="collectionOfficerId" asp-items="ViewBag.CollectionOfficers" class="form-select">
            <option value="">-- All Officers --</option>
        </select>
    </div>
    <div class="col-md-3">
        <label class="form-label">Forecast Granularity</label>
        <select name="granularity" class="form-select">
            @foreach (var g in new[] { "Daily", "Weekly", "Monthly", "Yearly" })
            {
                if (g == (string)ViewBag.Granularity)
                {
                    <option value="@g" selected>@g</option>
                }
                else
                {
                    <option value="@g">@g</option>
                }
            }
        </select>
    </div>
    <div class="col-md-3 d-flex align-items-end">
        <button type="submit" class="btn btn-primary">Apply Filters</button>
    </div>
</form>

<div class="row g-3 mb-4">
    <div class="col">
        <div class="card">
            <div class="card-body">
                <div class="text-muted">Total Due</div>
                <div class="h4 mb-0">৳@Model.TotalDue.ToString("N0")</div>
            </div>
        </div>
    </div>
    <div class="col">
        <div class="card">
            <div class="card-body">
                <div class="text-muted">Expected This Month</div>
                <div class="h4 mb-0">৳@Model.ExpectedThisMonth.ToString("N0")</div>
            </div>
        </div>
    </div>
    <div class="col">
        <div class="card">
            <div class="card-body">
                <div class="text-muted">Likely Collection</div>
                <div class="h4 mb-0 text-primary">৳@Model.LikelyCollection.ToString("N0")</div>
            </div>
        </div>
    </div>
    <div class="col">
        <div class="card">
            <div class="card-body">
                <div class="text-muted">Overdue</div>
                <div class="h4 mb-0 text-danger">৳@Model.OverdueAmount.ToString("N0")</div>
            </div>
        </div>
    </div>
    <div class="col">
        <div class="card">
            <div class="card-body">
                <div class="text-muted">Collection Achievement</div>
                <div class="h4 mb-0 @(Model.CollectionAchievementPercent >= 80 ? "text-success" : "text-warning")">@Model.CollectionAchievementPercent%</div>
                <div class="small text-muted">Actual: ৳@Model.ActualCollectedThisMonth.ToString("N0") this month</div>
            </div>
        </div>
    </div>
</div>

<div class="card mb-4">
    <div class="card-body">
        <h2 class="h5">@ViewBag.Granularity Forecast — Expected vs Likely vs Actual</h2>
        <canvas id="forecastChart" height="90"></canvas>
    </div>
</div>

<ul class="nav nav-tabs mb-3" id="dueTabs" role="tablist">
    <li class="nav-item" role="presentation">
        <button class="nav-link active" data-bs-toggle="tab" data-bs-target="#overdue" type="button">Overdue (@Model.OverdueCount)</button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link" data-bs-toggle="tab" data-bs-target="#current" type="button">Current Due (@Model.CurrentDueCount)</button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link" data-bs-toggle="tab" data-bs-target="#future" type="button">Future Due (@Model.FutureDueCount)</button>
    </li>
</ul>

<div class="tab-content">
    <div class="tab-pane fade show active" id="overdue">
        @await Html.PartialAsync("_DueRowsTable", Model.OverdueRows)
    </div>
    <div class="tab-pane fade" id="current">
        @await Html.PartialAsync("_DueRowsTable", Model.CurrentDueRows)
    </div>
    <div class="tab-pane fade" id="future">
        @await Html.PartialAsync("_DueRowsTable", Model.FutureDueRows)
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4"></script>
    <script>
        const ctx = document.getElementById('forecastChart');
        new Chart(ctx, {
            type: 'bar',
            data: {
                labels: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(buckets.Select(b => b.PeriodLabel))),
                datasets: [
                    {
                        label: 'Expected',
                        data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(buckets.Select(b => b.ExpectedAmount))),
                        backgroundColor: 'rgba(70, 128, 255, 0.6)'
                    },
                    {
                        label: 'Likely',
                        data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(buckets.Select(b => b.LikelyAmount))),
                        backgroundColor: 'rgba(255, 193, 7, 0.6)'
                    },
                    {
                        label: 'Actual Collected',
                        data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(buckets.Select(b => b.ActualCollected))),
                        backgroundColor: 'rgba(40, 167, 69, 0.6)'
                    }
                ]
            },
            options: {
                responsive: true,
                scales: { y: { beginAtZero: true } }
            }
        });
    </script>
}
