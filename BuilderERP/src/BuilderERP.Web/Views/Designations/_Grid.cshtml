@using BuilderERP.Application.Common
@model PagedResult<BuilderERP.Application.DTOs.DesignationDto>
@using BuilderERP.Shared.Constants
@using BuilderERP.Shared.Authorization

<table class="table table-striped table-hover bg-white">
    <thead>
        <tr>
            <th>Code</th>
            <th>Name</th>
            <th>Active</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var designation in Model.Items)
        {
            <tr>
                <td>@designation.Code</td>
                <td>@designation.Name</td>
                <td>
                    <span class="badge @(designation.IsActive ? "bg-success" : "bg-secondary")">
                        @(designation.IsActive ? "Active" : "Inactive")
                    </span>
                </td>
                <td class="text-end">
                    @if (User.HasClaim(PermissionClaimTypes.Permission, PermissionNames.DesignationManage))
                    {
                        <a asp-action="Edit" asp-route-id="@designation.Id" class="btn btn-sm btn-outline-secondary">Edit</a>
                        <form asp-action="ToggleActive" asp-route-id="@designation.Id" asp-route-isActive="@designation.IsActive" method="post" class="d-inline">
                            <button type="submit" class="btn btn-sm btn-outline-danger">
                                @(designation.IsActive ? "Deactivate" : "Activate")
                            </button>
                        </form>
                    }
                </td>
            </tr>
        }
        @if (Model.Items.Count == 0)
        {
            <tr>
                <td colspan="4" class="text-center text-muted">No designations found.</td>
            </tr>
        }
    </tbody>
</table>

<partial name="_Pagination" model="@(new BuilderERP.Web.Models.PaginationViewModel
{
    Page = Model.Page,
    PageSize = Model.PageSize,
    TotalPages = Model.TotalPages,
    TotalCount = Model.TotalCount,
    Action = "Index",
    RouteValues = new()
})" />
