@using BuilderERP.Application.Common
@model PagedResult<BuilderERP.Application.DTOs.InstallmentPlanDto>
@using BuilderERP.Shared.Constants
@using BuilderERP.Shared.Authorization
@{
    ViewData["Title"] = "Installment Plans";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Installment Plans</h1>
    @if (User.HasClaim(PermissionClaimTypes.Permission, PermissionNames.InstallmentPlanManage))
    {
        <a asp-action="Create" class="btn btn-primary">New Installment Plan</a>
    }
</div>

<form method="get" class="row g-2 mb-3">
    <div class="col-md-3">
        <label class="form-label">Project</label>
        <select name="projectId" asp-items="ViewBag.Projects" class="form-select" onchange="this.form.submit()">
            <option value="">-- All Projects --</option>
        </select>
    </div>
    <div class="col-md-3">
        <label class="form-label">Property Unit</label>
        <select name="propertyUnitId" asp-items="ViewBag.PropertyUnits" class="form-select" onchange="this.form.submit()">
            <option value="">-- All Units --</option>
        </select>
    </div>
    <div class="col-md-3">
        <label class="form-label">Customer</label>
        <select name="customerId" asp-items="ViewBag.Customers" class="form-select" onchange="this.form.submit()">
            <option value="">-- All Customers --</option>
        </select>
    </div>
</form>

<div data-grid-container>
    <partial name="_Grid" model="Model" />
</div>
