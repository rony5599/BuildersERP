@model IReadOnlyList<BuilderERP.Application.DTOs.InstallmentPlanDto>
@using BuilderERP.Shared.Constants
@using BuilderERP.Shared.Authorization
@{
    ViewData["Title"] = "Installment Plans";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Installment Plans</h1>
    @if (User.HasClaim(PermissionClaimTypes.Permission, PermissionNames.InstallmentPlanManage))
    {
        <a asp-action="Create" class="btn btn-primary">New Installment Plan</a>
    }
</div>

<form method="get" class="row g-2 mb-3">
    <div class="col-md-3">
        <label class="form-label">Project</label>
        <select name="projectId" asp-items="ViewBag.Projects" class="form-select" onchange="this.form.submit()">
            <option value="">-- All Projects --</option>
        </select>
    </div>
    <div class="col-md-3">
        <label class="form-label">Property Unit</label>
        <select name="propertyUnitId" asp-items="ViewBag.PropertyUnits" class="form-select" onchange="this.form.submit()">
            <option value="">-- All Units --</option>
        </select>
    </div>
    <div class="col-md-3">
        <label class="form-label">Customer</label>
        <select name="customerId" asp-items="ViewBag.Customers" class="form-select" onchange="this.form.submit()">
            <option value="">-- All Customers --</option>
        </select>
    </div>
</form>

<table class="table table-striped table-hover bg-white">
    <thead>
        <tr>
            <th>Agreement #</th>
            <th>Customer</th>
            <th>Project</th>
            <th>Unit</th>
            <th>Total Amount</th>
            <th># Installments</th>
            <th>Start Date</th>
            <th>Interest %</th>
            <th>Status</th>
            <th>Active</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var plan in Model)
        {
            <tr>
                <td>@plan.SaleAgreementNumber</td>
                <td>@plan.CustomerName</td>
                <td>@plan.ProjectName</td>
                <td>@plan.UnitNumber</td>
                <td>@plan.TotalAmount</td>
                <td>@plan.NumberOfInstallments</td>
                <td>@plan.StartDate.ToString("yyyy-MM-dd")</td>
                <td>@plan.InterestRatePercent</td>
                <td>@plan.Status</td>
                <td>
                    <span class="badge @(plan.IsActive ? "bg-success" : "bg-secondary")">
                        @(plan.IsActive ? "Active" : "Inactive")
                    </span>
                </td>
                <td class="text-end">
                    @if (User.HasClaim(PermissionClaimTypes.Permission, PermissionNames.InstallmentPlanManage))
                    {
                        <a asp-action="Edit" asp-route-id="@plan.Id" class="btn btn-sm btn-outline-secondary">Edit</a>
                        <form asp-action="ToggleActive" asp-route-id="@plan.Id" asp-route-isActive="@plan.IsActive" method="post" class="d-inline">
                            <button type="submit" class="btn btn-sm btn-outline-danger">
                                @(plan.IsActive ? "Deactivate" : "Activate")
                            </button>
                        </form>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>
