@model BuilderERP.Application.DTOs.UpdateInstallmentPlanDto
@using BuilderERP.Domain.Enums
@{
    ViewData["Title"] = "Edit Installment Plan";
}

<h1 class="h3 mb-4">Edit Installment Plan</h1>
<p class="text-muted">Editing plan-level fields does not regenerate already-created installment rows.</p>

<form asp-action="Edit" method="post" class="col-md-6">
    <input type="hidden" asp-for="Id" />
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
    <div class="mb-3">
        <label asp-for="SaleAgreementId" class="form-label"></label>
        <select asp-for="SaleAgreementId" asp-items="ViewBag.SaleAgreements" class="form-select">
            <option value="">-- Select Sale Agreement --</option>
        </select>
        <span asp-validation-for="SaleAgreementId" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="TotalAmount" class="form-label"></label>
        <input asp-for="TotalAmount" class="form-control" />
        <span asp-validation-for="TotalAmount" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="NumberOfInstallments" class="form-label"></label>
        <input asp-for="NumberOfInstallments" class="form-control" />
        <span asp-validation-for="NumberOfInstallments" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="StartDate" class="form-label"></label>
        <input asp-for="StartDate" type="date" class="form-control" />
    </div>
    <div class="mb-3">
        <label asp-for="InterestRatePercent" class="form-label">Interest Rate % (optional)</label>
        <input asp-for="InterestRatePercent" class="form-control" />
        <span asp-validation-for="InterestRatePercent" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Status" class="form-label"></label>
        <select asp-for="Status" asp-items="Html.GetEnumSelectList<InstallmentPlanStatus>()" class="form-select"></select>
        <span asp-validation-for="Status" class="text-danger"></span>
    </div>
    <button type="submit" class="btn btn-primary">Save</button>
    <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
</form>
