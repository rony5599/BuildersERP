@using BuilderERP.Application.Common
@using BuilderERP.Shared.Constants
@using BuilderERP.Shared.Authorization
@model PagedResult<BuilderERP.Application.DTOs.InstallmentPlanDto>

<table class="table table-striped table-hover bg-white">
    <thead>
        <tr>
            <th>Agreement #</th>
            <th>Customer</th>
            <th>Project</th>
            <th>Unit</th>
            <th>Total Amount</th>
            <th># Installments</th>
            <th>Start Date</th>
            <th>Interest %</th>
            <th>Status</th>
            <th>Active</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var plan in Model.Items)
        {
            <tr>
                <td>@plan.SaleAgreementNumber</td>
                <td>@plan.CustomerName</td>
                <td>@plan.ProjectName</td>
                <td>@plan.UnitNumber</td>
                <td>@plan.TotalAmount</td>
                <td>@plan.NumberOfInstallments</td>
                <td>@plan.StartDate.ToString("yyyy-MM-dd")</td>
                <td>@plan.InterestRatePercent</td>
                <td>@plan.Status</td>
                <td>
                    <span class="badge @(plan.IsActive ? "bg-success" : "bg-secondary")">
                        @(plan.IsActive ? "Active" : "Inactive")
                    </span>
                </td>
                <td class="text-end">
                    @if (User.HasClaim(PermissionClaimTypes.Permission, PermissionNames.InstallmentPlanManage))
                    {
                        <a asp-action="Edit" asp-route-id="@plan.Id" class="btn btn-sm btn-outline-secondary">Edit</a>
                        <form asp-action="ToggleActive" asp-route-id="@plan.Id" asp-route-isActive="@plan.IsActive" method="post" class="d-inline">
                            <button type="submit" class="btn btn-sm btn-outline-danger">
                                @(plan.IsActive ? "Deactivate" : "Activate")
                            </button>
                        </form>
                    }
                </td>
            </tr>
        }
        @if (Model.Items.Count == 0)
        {
            <tr>
                <td colspan="11" class="text-center text-muted">No installment plans found.</td>
            </tr>
        }
    </tbody>
</table>

<partial name="_Pagination" model="@(new BuilderERP.Web.Models.PaginationViewModel
{
    Page = Model.Page,
    PageSize = Model.PageSize,
    TotalPages = Model.TotalPages,
    TotalCount = Model.TotalCount,
    Action = "Index",
    RouteValues = new Dictionary<string, string?>
    {
        ["projectId"] = ViewBag.SelectedProjectId?.ToString(),
        ["propertyUnitId"] = ViewBag.SelectedPropertyUnitId?.ToString(),
        ["customerId"] = ViewBag.SelectedCustomerId?.ToString()
    }
})" />
