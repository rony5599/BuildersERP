@model BuilderERP.Application.DTOs.CreateInstallmentPlanDto
@using BuilderERP.Domain.Enums
@{
    ViewData["Title"] = "New Installment Plan";
}

<h1 class="h3 mb-4">New Installment Plan</h1>
<p class="text-muted">Saving will automatically generate the individual installment rows.</p>

<form asp-action="Create" method="post" class="col-md-6">
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
    <div class="mb-3">
        <label asp-for="SaleAgreementId" class="form-label"></label>
        <div class="mc-select" data-mc-select>
            <input type="text" class="form-control mc-select-input" placeholder="-- Select Sale Agreement --" autocomplete="off" data-mc-search />
            <input type="hidden" asp-for="SaleAgreementId" data-mc-value />
            <div class="mc-select-dropdown" data-mc-dropdown>
                <table class="table table-sm table-hover mc-select-table">
                    <thead>
                        <tr>
                            <th>Agreement #</th>
                            <th>Project</th>
                        </tr>
                    </thead>
                    <tbody data-mc-body>
                        @foreach (var agreement in (IEnumerable<BuilderERP.Application.DTOs.SaleAgreementDto>)ViewBag.SaleAgreements)
                        {
                            <tr data-mc-option data-value="@agreement.Id" data-label="@agreement.AgreementNumber" data-search="@($"{agreement.AgreementNumber} {agreement.ProjectName}".ToLower())">
                                <td>@agreement.AgreementNumber</td>
                                <td>@agreement.ProjectName</td>
                            </tr>
                        }
                    </tbody>
                </table>
                <div class="mc-select-empty" style="display:none">No sale agreements found.</div>
            </div>
        </div>
        <span asp-validation-for="SaleAgreementId" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="TotalAmount" class="form-label"></label>
        <input asp-for="TotalAmount" class="form-control" />
        <span asp-validation-for="TotalAmount" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="NumberOfInstallments" class="form-label"></label>
        <input asp-for="NumberOfInstallments" class="form-control" />
        <span asp-validation-for="NumberOfInstallments" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="StartDate" class="form-label"></label>
        <input asp-for="StartDate" type="date" class="form-control" />
    </div>
    <div class="mb-3">
        <label asp-for="InterestRatePercent" class="form-label">Interest Rate % (optional)</label>
        <input asp-for="InterestRatePercent" class="form-control" />
        <span asp-validation-for="InterestRatePercent" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Status" class="form-label"></label>
        <select asp-for="Status" asp-items="Html.GetEnumSelectList<InstallmentPlanStatus>()" class="form-select"></select>
        <span asp-validation-for="Status" class="text-danger"></span>
    </div>
    <button type="submit" class="btn btn-primary">Save</button>
    <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
</form>

@section Styles {
    <link rel="stylesheet" href="~/css/multi-column-select.css" asp-append-version="true" />
}
@section Scripts {
    <script src="~/js/multi-column-select.js" asp-append-version="true"></script>
}
