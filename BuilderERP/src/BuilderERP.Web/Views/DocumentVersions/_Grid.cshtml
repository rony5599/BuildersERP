@using BuilderERP.Application.Common
@using BuilderERP.Shared.Constants
@using BuilderERP.Shared.Authorization
@model PagedResult<BuilderERP.Application.DTOs.DocumentVersionDto>

<table class="table table-striped table-hover bg-white">
    <thead>
        <tr>
            <th>Document Number</th>
            <th>Version Number</th>
            <th>Uploaded Date</th>
            <th>Change Notes</th>
            <th>Current</th>
            <th>File</th>
            <th>Active</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.Items)
        {
            <tr>
                <td>@item.DocumentNumber</td>
                <td>@item.VersionNumber</td>
                <td>@item.UploadedDate.ToString("yyyy-MM-dd")</td>
                <td>@(item.ChangeNotes is not null && item.ChangeNotes.Length > 60 ? item.ChangeNotes.Substring(0, 60) + "..." : item.ChangeNotes)</td>
                <td>
                    <span class="badge @(item.IsCurrent ? "bg-success" : "bg-secondary")">
                        @(item.IsCurrent ? "Yes" : "No")
                    </span>
                </td>
                <td><a href="@item.FilePath" target="_blank">View</a></td>
                <td>
                    <span class="badge @(item.IsActive ? "bg-success" : "bg-secondary")">
                        @(item.IsActive ? "Active" : "Inactive")
                    </span>
                </td>
                <td class="text-end">
                    @if (User.HasClaim(PermissionClaimTypes.Permission, PermissionNames.DocumentVersionManage))
                    {
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">Edit</a>
                        <form asp-action="ToggleActive" asp-route-id="@item.Id" asp-route-isActive="@item.IsActive" method="post" class="d-inline">
                            <button type="submit" class="btn btn-sm btn-outline-danger">
                                @(item.IsActive ? "Deactivate" : "Activate")
                            </button>
                        </form>
                    }
                </td>
            </tr>
        }
        @if (Model.Items.Count == 0)
        {
            <tr>
                <td colspan="8" class="text-center text-muted">No document versions found.</td>
            </tr>
        }
    </tbody>
</table>

<partial name="_Pagination" model="@(new BuilderERP.Web.Models.PaginationViewModel
{
    Page = Model.Page,
    PageSize = Model.PageSize,
    TotalPages = Model.TotalPages,
    TotalCount = Model.TotalCount,
    Action = "Index",
    RouteValues = new Dictionary<string, string?> { ["documentId"] = ViewBag.SelectedDocumentId?.ToString() }
})" />
