@model BuilderERP.Application.DTOs.CreateDocumentVersionDto
@{
    ViewData["Title"] = "New Document Version";
}

<h1 class="h3 mb-4">New Document Version</h1>

<form asp-action="Create" method="post" enctype="multipart/form-data" class="col-md-6">
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
    <div class="mb-3">
        <label asp-for="DocumentId" class="form-label"></label>
        <select asp-for="DocumentId" asp-items="ViewBag.Documents" class="form-select">
            <option value="">-- Select Document --</option>
        </select>
        <span asp-validation-for="DocumentId" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="VersionNumber" class="form-label"></label>
        <input asp-for="VersionNumber" class="form-control" />
        <span asp-validation-for="VersionNumber" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label class="form-label">File</label>
        <input type="file" name="file" class="form-control" />
    </div>
    <div class="mb-3">
        <label asp-for="UploadedDate" class="form-label"></label>
        <input asp-for="UploadedDate" class="form-control" />
        <span asp-validation-for="UploadedDate" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="ChangeNotes" class="form-label"></label>
        <textarea asp-for="ChangeNotes" class="form-control"></textarea>
        <span asp-validation-for="ChangeNotes" class="text-danger"></span>
    </div>
    <div class="mb-3 form-check">
        <input asp-for="IsCurrent" class="form-check-input" />
        <label asp-for="IsCurrent" class="form-check-label"></label>
    </div>
    <button type="submit" class="btn btn-primary">Save</button>
    <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
</form>
