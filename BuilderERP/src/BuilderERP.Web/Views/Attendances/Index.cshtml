@model IReadOnlyList<BuilderERP.Application.DTOs.AttendanceDto>
@using BuilderERP.Shared.Constants
@using BuilderERP.Shared.Authorization
@using BuilderERP.Domain.Enums
@{
    ViewData["Title"] = "Attendance";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Attendance</h1>
    @if (User.HasClaim(PermissionClaimTypes.Permission, PermissionNames.AttendanceManage))
    {
        <a asp-action="Create" class="btn btn-primary">New Attendance</a>
    }
</div>

<table class="table table-striped table-hover bg-white">
    <thead>
        <tr>
            <th>Worker</th>
            <th>Project</th>
            <th>Date</th>
            <th>Status</th>
            <th>Hours Worked</th>
            <th>Active</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var attendance in Model)
        {
            var badgeClass = attendance.Status switch
            {
                AttendanceStatus.Present => "bg-success",
                AttendanceStatus.Absent => "bg-danger",
                AttendanceStatus.HalfDay => "bg-warning",
                AttendanceStatus.OnLeave => "bg-secondary",
                _ => "bg-secondary"
            };
            <tr>
                <td>@attendance.WorkerName</td>
                <td>@attendance.ProjectName</td>
                <td>@attendance.AttendanceDate.ToString("yyyy-MM-dd")</td>
                <td><span class="badge @badgeClass">@attendance.Status</span></td>
                <td>@attendance.HoursWorked</td>
                <td>
                    <span class="badge @(attendance.IsActive ? "bg-success" : "bg-secondary")">
                        @(attendance.IsActive ? "Active" : "Inactive")
                    </span>
                </td>
                <td class="text-end">
                    @if (User.HasClaim(PermissionClaimTypes.Permission, PermissionNames.AttendanceManage))
                    {
                        <a asp-action="Edit" asp-route-id="@attendance.Id" class="btn btn-sm btn-outline-secondary">Edit</a>
                        <form asp-action="ToggleActive" asp-route-id="@attendance.Id" asp-route-isActive="@attendance.IsActive" method="post" class="d-inline">
                            <button type="submit" class="btn btn-sm btn-outline-danger">
                                @(attendance.IsActive ? "Deactivate" : "Activate")
                            </button>
                        </form>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>
