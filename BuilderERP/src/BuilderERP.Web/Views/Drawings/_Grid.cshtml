@using BuilderERP.Application.Common
@model PagedResult<BuilderERP.Application.DTOs.DrawingDto>
@using BuilderERP.Shared.Constants
@using BuilderERP.Shared.Authorization
@using BuilderERP.Domain.Enums

<table class="table table-striped table-hover bg-white">
    <thead>
        <tr>
            <th>File</th>
            <th>Drawing Number</th>
            <th>Title</th>
            <th>Project</th>
            <th>Discipline</th>
            <th>Status</th>
            <th>Uploaded Date</th>
            <th>Active</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.Items)
        {
            <tr>
                <td><a href="@item.FilePath" target="_blank">View</a></td>
                <td>@item.DrawingNumber</td>
                <td>@item.Title</td>
                <td>@item.ProjectName</td>
                <td><span class="badge bg-info text-dark">@item.Discipline</span></td>
                <td>
                    @{
                        var statusBadge = item.Status switch
                        {
                            DrawingStatus.Draft => "bg-secondary",
                            DrawingStatus.PendingApproval => "bg-warning",
                            DrawingStatus.Approved => "bg-success",
                            DrawingStatus.Rejected => "bg-danger",
                            DrawingStatus.Superseded => "bg-dark",
                            _ => "bg-secondary"
                        };
                    }
                    <span class="badge @statusBadge">@item.Status</span>
                </td>
                <td>@item.UploadedDate.ToString("yyyy-MM-dd")</td>
                <td>
                    <span class="badge @(item.IsActive ? "bg-success" : "bg-secondary")">
                        @(item.IsActive ? "Active" : "Inactive")
                    </span>
                </td>
                <td class="text-end">
                    @if (User.HasClaim(PermissionClaimTypes.Permission, PermissionNames.DrawingManage))
                    {
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">Edit</a>
                        <form asp-action="ToggleActive" asp-route-id="@item.Id" asp-route-isActive="@item.IsActive" method="post" class="d-inline">
                            <button type="submit" class="btn btn-sm btn-outline-danger">
                                @(item.IsActive ? "Deactivate" : "Activate")
                            </button>
                        </form>
                    }
                </td>
            </tr>
        }
        @if (Model.Items.Count == 0)
        {
            <tr>
                <td colspan="9" class="text-center text-muted">No drawings found.</td>
            </tr>
        }
    </tbody>
</table>

<partial name="_Pagination" model="@(new BuilderERP.Web.Models.PaginationViewModel
{
    Page = Model.Page,
    PageSize = Model.PageSize,
    TotalPages = Model.TotalPages,
    TotalCount = Model.TotalCount,
    Action = "Index",
    RouteValues = new Dictionary<string, string?> { ["projectId"] = ViewBag.SelectedProjectId?.ToString() }
})" />
