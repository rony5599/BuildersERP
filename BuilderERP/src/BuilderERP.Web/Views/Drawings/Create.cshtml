@model BuilderERP.Application.DTOs.CreateDrawingDto
@using BuilderERP.Domain.Enums
@{
    ViewData["Title"] = "New Drawing";
}

<h1 class="h3 mb-4">New Drawing</h1>

<form asp-action="Create" method="post" enctype="multipart/form-data" class="col-md-6">
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
    <div class="mb-3">
        <label asp-for="ProjectId" class="form-label"></label>
        <select asp-for="ProjectId" asp-items="ViewBag.Projects" class="form-select">
            <option value="">-- Select Project --</option>
        </select>
        <span asp-validation-for="ProjectId" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="DrawingNumber" class="form-label"></label>
        <input asp-for="DrawingNumber" class="form-control" />
        <span asp-validation-for="DrawingNumber" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Title" class="form-label"></label>
        <input asp-for="Title" class="form-control" />
        <span asp-validation-for="Title" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Discipline" class="form-label"></label>
        <select asp-for="Discipline" asp-items="Html.GetEnumSelectList<DrawingDiscipline>()" class="form-select"></select>
        <span asp-validation-for="Discipline" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label class="form-label">File</label>
        <input type="file" name="file" class="form-control" />
    </div>
    <div class="mb-3">
        <label asp-for="Status" class="form-label"></label>
        <select asp-for="Status" asp-items="Html.GetEnumSelectList<DrawingStatus>()" class="form-select"></select>
        <span asp-validation-for="Status" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="UploadedDate" class="form-label"></label>
        <input asp-for="UploadedDate" class="form-control" />
        <span asp-validation-for="UploadedDate" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Remarks" class="form-label"></label>
        <textarea asp-for="Remarks" class="form-control"></textarea>
        <span asp-validation-for="Remarks" class="text-danger"></span>
    </div>
    <button type="submit" class="btn btn-primary">Save</button>
    <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
</form>
