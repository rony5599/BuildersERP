@model IReadOnlyList<BuilderERP.Application.DTOs.DrawingDto>
@using BuilderERP.Shared.Constants
@using BuilderERP.Shared.Authorization
@using BuilderERP.Domain.Enums
@{
    ViewData["Title"] = "Drawings";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Drawings</h1>
    @if (User.HasClaim(PermissionClaimTypes.Permission, PermissionNames.DrawingManage))
    {
        <a asp-action="Create" class="btn btn-primary">New Drawing</a>
    }
</div>

<table class="table table-striped table-hover bg-white">
    <thead>
        <tr>
            <th>File</th>
            <th>Drawing Number</th>
            <th>Title</th>
            <th>Project</th>
            <th>Discipline</th>
            <th>Status</th>
            <th>Uploaded Date</th>
            <th>Active</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td><a href="@item.FilePath" target="_blank">View</a></td>
                <td>@item.DrawingNumber</td>
                <td>@item.Title</td>
                <td>@item.ProjectName</td>
                <td><span class="badge bg-info text-dark">@item.Discipline</span></td>
                <td>
                    @{
                        var statusBadge = item.Status switch
                        {
                            DrawingStatus.Draft => "bg-secondary",
                            DrawingStatus.PendingApproval => "bg-warning",
                            DrawingStatus.Approved => "bg-success",
                            DrawingStatus.Rejected => "bg-danger",
                            DrawingStatus.Superseded => "bg-dark",
                            _ => "bg-secondary"
                        };
                    }
                    <span class="badge @statusBadge">@item.Status</span>
                </td>
                <td>@item.UploadedDate.ToString("yyyy-MM-dd")</td>
                <td>
                    <span class="badge @(item.IsActive ? "bg-success" : "bg-secondary")">
                        @(item.IsActive ? "Active" : "Inactive")
                    </span>
                </td>
                <td class="text-end">
                    @if (User.HasClaim(PermissionClaimTypes.Permission, PermissionNames.DrawingManage))
                    {
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">Edit</a>
                        <form asp-action="ToggleActive" asp-route-id="@item.Id" asp-route-isActive="@item.IsActive" method="post" class="d-inline">
                            <button type="submit" class="btn btn-sm btn-outline-danger">
                                @(item.IsActive ? "Deactivate" : "Activate")
                            </button>
                        </form>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>
