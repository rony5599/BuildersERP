@model IReadOnlyList<BuilderERP.Application.DTOs.ProjectDto>
@using BuilderERP.Shared.Constants
@using BuilderERP.Shared.Authorization
@{
    ViewData["Title"] = "Projects";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Projects</h1>
    @if (User.HasClaim(PermissionClaimTypes.Permission, PermissionNames.ProjectManage))
    {
        <a asp-action="Create" class="btn btn-primary">New Project</a>
    }
</div>

<table class="table table-striped table-hover bg-white">
    <thead>
        <tr>
            <th>Name</th>
            <th>Code</th>
            <th>Branch</th>
            <th>Location</th>
            <th>Start Date</th>
            <th>End Date</th>
            <th>Status</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var project in Model)
        {
            <tr>
                <td>@project.Name</td>
                <td>@project.Code</td>
                <td>@project.BranchName</td>
                <td>@project.Location</td>
                <td>@(project.StartDate?.ToString("yyyy-MM-dd"))</td>
                <td>@(project.EndDate?.ToString("yyyy-MM-dd"))</td>
                <td>
                    <span class="badge @(project.IsActive ? "bg-success" : "bg-secondary")">
                        @(project.IsActive ? "Active" : "Inactive")
                    </span>
                </td>
                <td class="text-end">
                    @if (User.HasClaim(PermissionClaimTypes.Permission, PermissionNames.ProjectManage))
                    {
                        <a asp-action="Edit" asp-route-id="@project.Id" class="btn btn-sm btn-outline-secondary">Edit</a>
                        <form asp-action="ToggleActive" asp-route-id="@project.Id" asp-route-isActive="@project.IsActive" method="post" class="d-inline">
                            <button type="submit" class="btn btn-sm btn-outline-danger">
                                @(project.IsActive ? "Deactivate" : "Activate")
                            </button>
                        </form>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>
