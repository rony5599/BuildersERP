@using BuilderERP.Application.Common
@model PagedResult<BuilderERP.Application.DTOs.SiteVisitDto>
@using BuilderERP.Shared.Constants
@using BuilderERP.Shared.Authorization
@using BuilderERP.Domain.Enums
@{
    string StatusBadge(SiteVisitStatus status) => status switch
    {
        SiteVisitStatus.Scheduled => "bg-info",
        SiteVisitStatus.Completed => "bg-success",
        SiteVisitStatus.Cancelled => "bg-secondary",
        SiteVisitStatus.NoShow => "bg-danger",
        _ => "bg-secondary"
    };
}

<table class="table table-striped table-hover bg-white">
    <thead>
        <tr>
            <th>Visit Date</th>
            <th>Lead</th>
            <th>Property Unit</th>
            <th>Assigned To</th>
            <th>Status</th>
            <th>Active</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var visit in Model.Items)
        {
            <tr>
                <td>@visit.VisitDate.ToString("yyyy-MM-dd")</td>
                <td>@visit.LeadName</td>
                <td>@visit.PropertyUnitNumber</td>
                <td>@visit.AssignedToUserName</td>
                <td><span class="badge @StatusBadge(visit.Status)">@visit.Status</span></td>
                <td>
                    <span class="badge @(visit.IsActive ? "bg-success" : "bg-secondary")">
                        @(visit.IsActive ? "Active" : "Inactive")
                    </span>
                </td>
                <td class="text-end">
                    @if (User.HasClaim(PermissionClaimTypes.Permission, PermissionNames.SiteVisitManage))
                    {
                        <a asp-action="Edit" asp-route-id="@visit.Id" class="btn btn-sm btn-outline-secondary">Edit</a>
                        <form asp-action="ToggleActive" asp-route-id="@visit.Id" asp-route-isActive="@visit.IsActive" method="post" class="d-inline">
                            <button type="submit" class="btn btn-sm btn-outline-danger">
                                @(visit.IsActive ? "Deactivate" : "Activate")
                            </button>
                        </form>
                    }
                </td>
            </tr>
        }
        @if (Model.Items.Count == 0)
        {
            <tr>
                <td colspan="7" class="text-center text-muted">No site visits found.</td>
            </tr>
        }
    </tbody>
</table>

<partial name="_Pagination" model="@(new BuilderERP.Web.Models.PaginationViewModel
{
    Page = Model.Page,
    PageSize = Model.PageSize,
    TotalPages = Model.TotalPages,
    TotalCount = Model.TotalCount,
    Action = "Index",
    RouteValues = new()
})" />
