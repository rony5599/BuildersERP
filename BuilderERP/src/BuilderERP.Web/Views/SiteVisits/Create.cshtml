@model BuilderERP.Application.DTOs.CreateSiteVisitDto
@using BuilderERP.Domain.Enums
@{
    ViewData["Title"] = "New Site Visit";
}

<h1 class="h3 mb-4">New Site Visit</h1>

<form asp-action="Create" method="post" class="col-md-6">
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
    <div class="mb-3">
        <label asp-for="LeadId" class="form-label"></label>
        <select asp-for="LeadId" asp-items="ViewBag.Leads" class="form-select">
            <option value="">-- Select Lead --</option>
        </select>
        <span asp-validation-for="LeadId" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="PropertyUnitId" class="form-label"></label>
        <select asp-for="PropertyUnitId" asp-items="ViewBag.PropertyUnits" class="form-select">
            <option value="">-- Select Property Unit (optional) --</option>
        </select>
        <span asp-validation-for="PropertyUnitId" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="AssignedToUserId" class="form-label"></label>
        <select asp-for="AssignedToUserId" asp-items="ViewBag.Users" class="form-select">
            <option value="">-- Unassigned --</option>
        </select>
        <span asp-validation-for="AssignedToUserId" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="VisitDate" class="form-label"></label>
        <input asp-for="VisitDate" type="date" class="form-control" />
    </div>
    <div class="mb-3">
        <label asp-for="Status" class="form-label"></label>
        <select asp-for="Status" asp-items="Html.GetEnumSelectList<SiteVisitStatus>()" class="form-select"></select>
        <span asp-validation-for="Status" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Feedback" class="form-label"></label>
        <textarea asp-for="Feedback" class="form-control"></textarea>
        <span asp-validation-for="Feedback" class="text-danger"></span>
    </div>
    <button type="submit" class="btn btn-primary">Save</button>
    <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
</form>
