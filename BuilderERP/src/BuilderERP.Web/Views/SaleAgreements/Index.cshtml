@model IReadOnlyList<BuilderERP.Application.DTOs.SaleAgreementDto>
@using BuilderERP.Shared.Constants
@using BuilderERP.Shared.Authorization
@{
    ViewData["Title"] = "Sale Agreements";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Sale Agreements</h1>
    @if (User.HasClaim(PermissionClaimTypes.Permission, PermissionNames.SaleAgreementManage))
    {
        <a asp-action="Create" class="btn btn-primary">New Sale Agreement</a>
    }
</div>

<table class="table table-striped table-hover bg-white">
    <thead>
        <tr>
            <th>Agreement #</th>
            <th>Unit</th>
            <th>Sale Price</th>
            <th>Date</th>
            <th>Status</th>
            <th>Active</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var agreement in Model)
        {
            <tr>
                <td>@agreement.AgreementNumber</td>
                <td>@agreement.BookingUnitNumber</td>
                <td>@agreement.TotalSalePrice</td>
                <td>@agreement.AgreementDate.ToString("yyyy-MM-dd")</td>
                <td>@agreement.Status</td>
                <td>
                    <span class="badge @(agreement.IsActive ? "bg-success" : "bg-secondary")">
                        @(agreement.IsActive ? "Active" : "Inactive")
                    </span>
                </td>
                <td class="text-end">
                    @if (User.HasClaim(PermissionClaimTypes.Permission, PermissionNames.SaleAgreementManage))
                    {
                        <a asp-action="Edit" asp-route-id="@agreement.Id" class="btn btn-sm btn-outline-secondary">Edit</a>
                        <form asp-action="ToggleActive" asp-route-id="@agreement.Id" asp-route-isActive="@agreement.IsActive" method="post" class="d-inline">
                            <button type="submit" class="btn btn-sm btn-outline-danger">
                                @(agreement.IsActive ? "Deactivate" : "Activate")
                            </button>
                        </form>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>
