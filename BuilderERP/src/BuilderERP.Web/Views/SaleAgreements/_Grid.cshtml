@using BuilderERP.Application.Common
@model PagedResult<BuilderERP.Application.DTOs.SaleAgreementDto>
@using BuilderERP.Shared.Constants
@using BuilderERP.Shared.Authorization

<table class="table table-striped table-hover bg-white">
    <thead>
        <tr>
            <th>Agreement #</th>
            <th>Project</th>
            <th>Unit</th>
            <th>Sale Price</th>
            <th>Date</th>
            <th>Status</th>
            <th>Active</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var agreement in Model.Items)
        {
            <tr>
                <td>@agreement.AgreementNumber</td>
                <td>@agreement.ProjectName</td>
                <td>@agreement.BookingUnitNumber</td>
                <td>@agreement.TotalSalePrice</td>
                <td>@agreement.AgreementDate.ToString("yyyy-MM-dd")</td>
                <td>@agreement.Status</td>
                <td>
                    <span class="badge @(agreement.IsActive ? "bg-success" : "bg-secondary")">
                        @(agreement.IsActive ? "Active" : "Inactive")
                    </span>
                </td>
                <td class="text-end">
                    @if (User.HasClaim(PermissionClaimTypes.Permission, PermissionNames.SaleAgreementManage))
                    {
                        <a asp-action="Edit" asp-route-id="@agreement.Id" class="btn btn-sm btn-outline-secondary">Edit</a>
                        <form asp-action="ToggleActive" asp-route-id="@agreement.Id" asp-route-isActive="@agreement.IsActive" method="post" class="d-inline">
                            <button type="submit" class="btn btn-sm btn-outline-danger">
                                @(agreement.IsActive ? "Deactivate" : "Activate")
                            </button>
                        </form>
                    }
                </td>
            </tr>
        }
        @if (Model.Items.Count == 0)
        {
            <tr>
                <td colspan="8" class="text-center text-muted">No sale agreements found.</td>
            </tr>
        }
    </tbody>
</table>

<partial name="_Pagination" model="@(new BuilderERP.Web.Models.PaginationViewModel
{
    Page = Model.Page,
    PageSize = Model.PageSize,
    TotalPages = Model.TotalPages,
    TotalCount = Model.TotalCount,
    Action = "Index",
    RouteValues = new()
})" />
