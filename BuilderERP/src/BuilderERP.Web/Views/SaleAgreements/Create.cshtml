@model BuilderERP.Application.DTOs.CreateSaleAgreementDto
@using BuilderERP.Domain.Enums
@{
    ViewData["Title"] = "New Sale Agreement";
}

<h1 class="h3 mb-4">New Sale Agreement</h1>

<form asp-action="Create" method="post" class="col-md-6">
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
    <div class="mb-3">
        <label asp-for="AgreementNumber" class="form-label"></label>
        <input asp-for="AgreementNumber" class="form-control" />
        <span asp-validation-for="AgreementNumber" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label class="form-label">Project</label>
        <select id="ProjectFilter" class="form-select">
            <option value="">-- Select Project --</option>
            @foreach (var project in (IEnumerable<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>)ViewBag.Projects)
            {
                <option value="@project.Value">@project.Text</option>
            }
        </select>
    </div>
    <div class="mb-3">
        <label asp-for="BookingId" class="form-label"></label>
        <select asp-for="BookingId" class="form-select" id="BookingId">
            <option value="">-- Select Booking --</option>
            @foreach (var booking in (IEnumerable<BuilderERP.Application.DTOs.BookingDto>)ViewBag.Bookings)
            {
                <option value="@booking.Id" data-project-id="@booking.ProjectId">@booking.PropertyUnitNumber</option>
            }
        </select>
        <span asp-validation-for="BookingId" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="AgreementDate" class="form-label"></label>
        <input asp-for="AgreementDate" type="date" class="form-control" />
    </div>
    <div class="mb-3">
        <label asp-for="TotalSalePrice" class="form-label"></label>
        <input asp-for="TotalSalePrice" class="form-control" />
        <span asp-validation-for="TotalSalePrice" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Status" class="form-label"></label>
        <select asp-for="Status" asp-items="Html.GetEnumSelectList<AgreementStatus>()" class="form-select"></select>
        <span asp-validation-for="Status" class="text-danger"></span>
    </div>
    <button type="submit" class="btn btn-primary">Save</button>
    <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
</form>

@section Scripts {
    <script>
        (function () {
            var projectSelect = document.getElementById('ProjectFilter');
            var bookingSelect = document.getElementById('BookingId');
            var bookingOptions = Array.prototype.slice.call(bookingSelect.options);

            function filterBookings() {
                var projectId = projectSelect.value;
                bookingSelect.innerHTML = '';
                bookingSelect.appendChild(bookingOptions[0].cloneNode(true));
                bookingOptions.forEach(function (opt) {
                    if (opt.value === '') return;
                    if (!projectId || opt.getAttribute('data-project-id') === projectId) {
                        bookingSelect.appendChild(opt.cloneNode(true));
                    }
                });
            }

            projectSelect.addEventListener('change', filterBookings);
        })();
    </script>
}
