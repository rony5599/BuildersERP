@model BuilderERP.Application.DTOs.UpdateTowerDto
@{
    ViewData["Title"] = "Edit Tower";
}

@section Styles {
    <link rel="stylesheet" href="~/css/multicolumn-dropdown.css" asp-append-version="true" />
}

<h1 class="h3 mb-4">Edit Tower</h1>

<form asp-action="Edit" method="post" class="col-md-6">
    <input type="hidden" asp-for="Id" />
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
    <div class="mb-3">
        <label asp-for="BuildingId" class="form-label"></label>
        <div class="multicolumn-dropdown-wrapper">
            <div class="multicolumn-dropdown-container" id="building-container">
                <input type="hidden" asp-for="BuildingId" id="building" value="@Model.BuildingId" />
                <div class="multicolumn-dropdown-trigger">
                    <input type="text"
                           class="multicolumn-dropdown-filter form-control"
                           placeholder="Search Building..."
                           autocomplete="off"
                           id="building-filter" />
                    <span class="multicolumn-dropdown-icon">
                        <i class="bi bi-chevron-down"></i>
                    </span>
                </div>
                <div class="multicolumn-dropdown-menu" id="building-menu" style="display: none;">
                    <div class="multicolumn-dropdown-header">
                        <div class="multicolumn-dropdown-column">Building Name</div>
                        <div class="multicolumn-dropdown-column">Project Name</div>
                    </div>
                    <div class="multicolumn-dropdown-items">
                        @foreach (var building in (IEnumerable<dynamic>)ViewBag.Buildings ?? new List<dynamic>())
                        {
                            var parts = building.Text?.Split(" | ") ?? new[] { "", "" };
                            <div class="multicolumn-dropdown-item" data-value="@building.Value">
                                <div class="multicolumn-dropdown-column">@(parts.Length > 0 ? parts[0]?.Trim() ?? "" : "")</div>
                                <div class="multicolumn-dropdown-column">@(parts.Length > 1 ? parts[1]?.Trim() ?? "" : "")</div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
        <span asp-validation-for="BuildingId" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Name" class="form-label"></label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Code" class="form-label"></label>
        <input asp-for="Code" class="form-control" />
        <span asp-validation-for="Code" class="text-danger"></span>
    </div>
    <button type="submit" class="btn btn-primary">Save</button>
    <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
</form>

<script src="~/js/multicolumn-dropdown.js" asp-append-version="true"></script>
<script>
    document.addEventListener('DOMContentLoaded', function () {
        new MultiColumnDropdown('building-container');
    });
</script>
