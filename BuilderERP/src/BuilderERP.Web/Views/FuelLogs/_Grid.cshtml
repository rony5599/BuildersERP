@using BuilderERP.Application.Common
@using BuilderERP.Shared.Constants
@using BuilderERP.Shared.Authorization
@model PagedResult<BuilderERP.Application.DTOs.FuelLogDto>

<table class="table table-striped table-hover bg-white">
    <thead>
        <tr>
            <th>Equipment</th>
            <th>Log Date</th>
            <th>Fuel Quantity (L)</th>
            <th>Fuel Cost</th>
            <th>Meter Reading</th>
            <th>Remarks</th>
            <th>Active</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var log in Model.Items)
        {
            <tr>
                <td>@log.EquipmentName</td>
                <td>@log.LogDate.ToString("yyyy-MM-dd")</td>
                <td>@log.FuelQuantity</td>
                <td>@log.FuelCost</td>
                <td>@(log.MeterReading.HasValue ? log.MeterReading.Value.ToString() : "—")</td>
                <td>@(log.Remarks is { Length: > 40 } ? log.Remarks[..40] + "…" : log.Remarks)</td>
                <td>
                    <span class="badge @(log.IsActive ? "bg-success" : "bg-secondary")">
                        @(log.IsActive ? "Active" : "Inactive")
                    </span>
                </td>
                <td class="text-end">
                    @if (User.HasClaim(PermissionClaimTypes.Permission, PermissionNames.FuelLogManage))
                    {
                        <a asp-action="Edit" asp-route-id="@log.Id" class="btn btn-sm btn-outline-secondary">Edit</a>
                        <form asp-action="ToggleActive" asp-route-id="@log.Id" asp-route-isActive="@log.IsActive" method="post" class="d-inline">
                            <button type="submit" class="btn btn-sm btn-outline-danger">
                                @(log.IsActive ? "Deactivate" : "Activate")
                            </button>
                        </form>
                    }
                </td>
            </tr>
        }
        @if (Model.Items.Count == 0)
        {
            <tr>
                <td colspan="8" class="text-center text-muted">No fuel logs found.</td>
            </tr>
        }
    </tbody>
</table>

<partial name="_Pagination" model="@(new BuilderERP.Web.Models.PaginationViewModel
{
    Page = Model.Page,
    PageSize = Model.PageSize,
    TotalPages = Model.TotalPages,
    TotalCount = Model.TotalCount,
    Action = "Index",
    RouteValues = new()
})" />
