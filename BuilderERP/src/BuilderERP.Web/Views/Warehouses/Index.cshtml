@model IReadOnlyList<BuilderERP.Application.DTOs.WarehouseDto>
@using BuilderERP.Shared.Constants
@using BuilderERP.Shared.Authorization
@{
    ViewData["Title"] = "Warehouses";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Warehouses</h1>
    @if (User.HasClaim(PermissionClaimTypes.Permission, PermissionNames.WarehouseManage))
    {
        <a asp-action="Create" class="btn btn-primary">New Warehouse</a>
    }
</div>

<table class="table table-striped table-hover bg-white">
    <thead>
        <tr>
            <th>Code</th>
            <th>Name</th>
            <th>Branch</th>
            <th>Location</th>
            <th>Active</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var warehouse in Model)
        {
            <tr>
                <td>@warehouse.WarehouseCode</td>
                <td>@warehouse.Name</td>
                <td>@warehouse.BranchName</td>
                <td>@warehouse.Location</td>
                <td>
                    <span class="badge @(warehouse.IsActive ? "bg-success" : "bg-secondary")">
                        @(warehouse.IsActive ? "Active" : "Inactive")
                    </span>
                </td>
                <td class="text-end">
                    @if (User.HasClaim(PermissionClaimTypes.Permission, PermissionNames.WarehouseManage))
                    {
                        <a asp-action="Edit" asp-route-id="@warehouse.Id" class="btn btn-sm btn-outline-secondary">Edit</a>
                        <form asp-action="ToggleActive" asp-route-id="@warehouse.Id" asp-route-isActive="@warehouse.IsActive" method="post" class="d-inline">
                            <button type="submit" class="btn btn-sm btn-outline-danger">
                                @(warehouse.IsActive ? "Deactivate" : "Activate")
                            </button>
                        </form>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>
