@using BuilderERP.Application.Common
@model PagedResult<BuilderERP.Application.DTOs.SafetyTrainingDto>
@using BuilderERP.Shared.Constants
@using BuilderERP.Shared.Authorization

<table class="table table-striped table-hover bg-white">
    <thead>
        <tr>
            <th>Worker</th>
            <th>Training Title</th>
            <th>Training Date</th>
            <th>Trainer</th>
            <th>Duration (hrs)</th>
            <th>Certificate Number</th>
            <th>Expiry Date</th>
            <th>Active</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var training in Model.Items)
        {
            var expiryClass = training.ExpiryDate.HasValue && training.ExpiryDate.Value < DateTime.UtcNow ? "text-danger fw-bold" : "";
            <tr>
                <td>@training.WorkerName</td>
                <td>@training.TrainingTitle</td>
                <td>@training.TrainingDate.ToString("yyyy-MM-dd")</td>
                <td>@training.TrainerName</td>
                <td>@training.DurationHours</td>
                <td>@(training.CertificateNumber ?? "—")</td>
                <td class="@expiryClass">@(training.ExpiryDate.HasValue ? training.ExpiryDate.Value.ToString("yyyy-MM-dd") : "—")</td>
                <td>
                    <span class="badge @(training.IsActive ? "bg-success" : "bg-secondary")">
                        @(training.IsActive ? "Active" : "Inactive")
                    </span>
                </td>
                <td class="text-end">
                    @if (User.HasClaim(PermissionClaimTypes.Permission, PermissionNames.SafetyTrainingManage))
                    {
                        <a asp-action="Edit" asp-route-id="@training.Id" class="btn btn-sm btn-outline-secondary">Edit</a>
                        <form asp-action="ToggleActive" asp-route-id="@training.Id" asp-route-isActive="@training.IsActive" method="post" class="d-inline">
                            <button type="submit" class="btn btn-sm btn-outline-danger">
                                @(training.IsActive ? "Deactivate" : "Activate")
                            </button>
                        </form>
                    }
                </td>
            </tr>
        }
        @if (Model.Items.Count == 0)
        {
            <tr>
                <td colspan="9" class="text-center text-muted">No safety training records found.</td>
            </tr>
        }
    </tbody>
</table>

<partial name="_Pagination" model="@(new BuilderERP.Web.Models.PaginationViewModel
{
    Page = Model.Page,
    PageSize = Model.PageSize,
    TotalPages = Model.TotalPages,
    TotalCount = Model.TotalCount,
    Action = "Index",
    RouteValues = new()
})" />
