@model BuilderERP.Web.Models.EwoBillWorkflowButtonViewModel
@{
    var iconClass = Model.WorkflowAction switch
    {
        "submit" => "bi-send",
        "request" => "bi-person-check",
        "approve" => "bi-check-circle",
        "reject" => "bi-x-circle",
        "cancel" => "bi-slash-circle",
        _ => "bi-arrow-right"
    };
    var toneClass = Model.WorkflowAction is "reject" or "cancel" ? "text-danger" :
        Model.WorkflowAction == "approve" ? "text-success" : "text-primary";
}
<form asp-action="WorkflowAction" asp-route-id="@Model.Id" method="post" class="workflow-action-form">
    <input type="hidden" name="workflowAction" value="@Model.WorkflowAction" />
    <button type="submit" class="dropdown-item workflow-action @toneClass" data-workflow-action="@Model.WorkflowAction">
        <i class="bi @iconClass" aria-hidden="true"></i><span>@Model.Label</span>
    </button>
</form>
