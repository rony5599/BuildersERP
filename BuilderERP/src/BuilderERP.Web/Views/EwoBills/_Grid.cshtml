@using BuilderERP.Application.Common
@using BuilderERP.Domain.Enums
@using BuilderERP.Shared.Constants
@using BuilderERP.Shared.Authorization
@using Microsoft.AspNetCore.Mvc.Rendering
@using BuilderERP.Domain.Entities
@using BuilderERP.Web.Models
@model PagedResult<BuilderERP.Application.DTOs.EwoBillDto>
@{
    var billNumber = ViewBag.BillNumber as string;
    var supplier = ViewBag.Supplier as string;
    var status = ViewBag.Status as PoBillStatus?;
    var dateFrom = ViewBag.DateFrom as DateTime?;
    var dateTo = ViewBag.DateTo as DateTime?;
    var hasFilters = !string.IsNullOrWhiteSpace(billNumber) || !string.IsNullOrWhiteSpace(supplier) || status.HasValue || dateFrom.HasValue || dateTo.HasValue;
    var canPay = User.HasClaim(PermissionClaimTypes.Permission, PermissionNames.SupplierPaymentManage);
    var assignment = ViewBag.ActionAssignment as EwoBillActionAssignment;
}

<div class="card ewo-card ewo-filter-card mb-3">
    <div class="card-body">
        <div class="d-flex align-items-center justify-content-between mb-3">
            <div>
                <h2 class="h6 mb-1"><i class="bi bi-funnel me-2 text-primary"></i>Find bills</h2>
                <p class="small text-muted mb-0">Narrow results by document, supplier, status, or date.</p>
            </div>
            @if (hasFilters)
            {
                <span class="badge text-bg-primary rounded-pill">Filters applied</span>
            }
        </div>
        <form asp-action="Index" method="get" class="row gy-3 gx-4 align-items-end grid-search-form">
            <div class="col-12 col-sm-6 col-lg-2">
                <label class="form-label small mb-1">Bill # / EWO #</label>
                <input type="search" name="billNumber" value="@billNumber" class="form-control" placeholder="Bill # or EWO #" />
            </div>
            <div class="col-12 col-sm-6 col-lg-2">
                <label class="form-label small mb-1">Supplier</label>
                <input type="search" name="supplier" value="@supplier" class="form-control" placeholder="Supplier" />
            </div>
            <div class="col-12 col-sm-6 col-lg-2">
                <label class="form-label small mb-1">Status</label>
                <select name="status" asp-items="@(ViewBag.Statuses as SelectList)" class="form-select">
                    <option value="">All Statuses</option>
                </select>
            </div>
            <div class="col-12 col-sm-6 col-lg-2">
                <label class="form-label small mb-1">Date From</label>
                <input type="date" name="dateFrom" value="@(dateFrom?.ToString("yyyy-MM-dd"))" class="form-control" />
            </div>
            <div class="col-12 col-sm-6 col-lg-2">
                <label class="form-label small mb-1">Date To</label>
                <input type="date" name="dateTo" value="@(dateTo?.ToString("yyyy-MM-dd"))" class="form-control" />
            </div>
            <div class="col-12 col-sm-6 col-lg-2 d-flex gap-2">
                <button type="submit" class="btn btn-primary flex-grow-1"><i class="bi bi-search me-1"></i> Search</button>
                @if (hasFilters)
                {
                    <a asp-action="Index" class="btn btn-outline-secondary flex-grow-1">Clear</a>
                }
            </div>
        </form>
    </div>
</div>

<div class="card ewo-card">
    <div class="ewo-result-meta">
        <span><strong class="text-dark">@Model.TotalCount</strong> bill@(Model.TotalCount == 1 ? "" : "s") found</span>
        <span>Page @Model.Page of @Math.Max(Model.TotalPages, 1)</span>
    </div>
    <div class="table-responsive">
    <table class="table ewo-table">
        <thead>
            <tr>
                <th>Bill #</th>
                <th>Date</th>
                <th>EWO #</th>
                <th>Supplier</th>
                <th>Heads Claimed</th>
                <th class="text-end">Measured</th>
                <th class="text-end">Net Payable</th>
                <th class="text-end">Paid</th>
                <th>Status</th>
                <th>Balance</th>
                <th class="text-end">Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var bill in Model.Items)
            {
                var canEdit = assignment?.CanDraftEdit == true && bill.Status == PoBillStatus.Draft;
                var canSubmit = assignment?.CanSubmit == true && bill.Status == PoBillStatus.Draft;
                var canRequest = assignment?.CanRequestApproval == true && bill.Status == PoBillStatus.Submitted;
                var canApprove = assignment?.CanApprove == true && bill.Status == PoBillStatus.AwaitingApproval;
                var canReject = assignment?.CanReject == true && bill.Status is PoBillStatus.Submitted or PoBillStatus.AwaitingApproval or PoBillStatus.Approved;
                var canCancel = assignment?.CanCancel == true && bill.Status is PoBillStatus.Draft or PoBillStatus.Submitted or PoBillStatus.AwaitingApproval or PoBillStatus.Rejected;
                var hasWorkflowActions = canSubmit || canRequest || canApprove || canReject || canCancel;
                <tr>
                    <td>
                        <a asp-action="Print" asp-route-id="@bill.Id" target="_blank" class="ewo-document-number text-decoration-none">@bill.BillNumber</a>
                        @if (!bill.IsActive) { <div class="ewo-secondary">Inactive record</div> }
                    </td>
                    <td class="text-nowrap">@bill.BillDate.ToString("dd MMM yyyy")</td>
                    <td><span class="fw-semibold">@bill.WorkOrderNo</span><div class="ewo-secondary">@bill.ProjectName</div></td>
                    <td class="fw-semibold">@bill.SupplierName</td>
                    <td><div class="ewo-heads small">@(string.IsNullOrWhiteSpace(bill.HeadsSummary) ? "No heads claimed" : bill.HeadsSummary)</div></td>
                    <td class="text-end ewo-money">@bill.MeasuredAmount.ToString("N2")</td>
                    <td class="text-end ewo-money">@bill.NetPayable.ToString("N2")</td>
                    <td class="text-end ewo-money">@bill.PaidAmount.ToString("N2")</td>
                    <td>
                        <span class="ewo-badge @(bill.Status == PoBillStatus.Draft && !string.IsNullOrWhiteSpace(bill.RejectionReason) ? "ewo-badge-rejected" : StatusBadgeClass(bill.Status))">@(bill.Status == PoBillStatus.Draft && !string.IsNullOrWhiteSpace(bill.RejectionReason) ? "Revision Required" : HumanizeStatus(bill.Status))</span>
                        @if (!string.IsNullOrWhiteSpace(bill.RejectionReason)) { <div class="ewo-secondary text-danger mt-1">Returned: @bill.RejectionReason</div> }
                    </td>
                    <td>
                        <div class="ewo-money outstanding">@bill.Outstanding.ToString("N2")</div>
                        <span class="ewo-secondary">@(bill.IsActive ? "Outstanding" : "Inactive")</span>
                    </td>
                    <td class="text-end text-nowrap">
                        @if (canPay && bill.IsActive && bill.Status == PoBillStatus.Approved && bill.Outstanding > 0)
                        {
                            <a asp-controller="SupplierPayments" asp-action="Create" asp-route-ewoBillId="@bill.Id" class="btn btn-sm btn-success me-1"><i class="bi bi-credit-card me-1"></i>Pay</a>
                        }
                        <div class="dropdown d-inline-block ewo-actions">
                            <button class="btn btn-sm ewo-actions-trigger" type="button" data-bs-toggle="dropdown" aria-expanded="false" aria-label="Actions for @bill.BillNumber">
                                <i class="bi bi-three-dots" aria-hidden="true"></i><span class="visually-hidden">Open actions</span>
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end ewo-actions-menu">
                                <li><h6 class="dropdown-header">@bill.BillNumber</h6></li>
                                <li><a asp-action="Print" asp-route-id="@bill.Id" class="dropdown-item" target="_blank"><i class="bi bi-printer me-2"></i>Print bill</a></li>
                                <li><a asp-action="Statement" asp-route-engineerWorkOrderId="@bill.EngineerWorkOrderId" class="dropdown-item" target="_blank"><i class="bi bi-file-earmark-bar-graph me-2"></i>View statement</a></li>
                                @if (User.HasClaim(PermissionClaimTypes.Permission, PermissionNames.EwoBillManage))
                                {
                                    @if (canEdit)
                                    {
                                        <li><a asp-action="Edit" asp-route-id="@bill.Id" class="dropdown-item"><i class="bi bi-pencil me-2"></i>Edit draft</a></li>
                                    }
                                    @if (hasWorkflowActions) { <li><hr class="dropdown-divider" /></li> }
                                    @if (canSubmit) { <li><partial name="_WorkflowButton" model="@(new EwoBillWorkflowButtonViewModel(bill.Id, "submit", "Submit bill", ""))" /></li> }
                                    @if (canRequest) { <li><partial name="_WorkflowButton" model="@(new EwoBillWorkflowButtonViewModel(bill.Id, "request", "Request approval", ""))" /></li> }
                                    @if (canApprove) { <li><partial name="_WorkflowButton" model="@(new EwoBillWorkflowButtonViewModel(bill.Id, "approve", "Approve bill", ""))" /></li> }
                                    @if (canReject) { <li><partial name="_WorkflowButton" model="@(new EwoBillWorkflowButtonViewModel(bill.Id, "reject", "Reject bill", ""))" /></li> }
                                    @if (canCancel) { <li><partial name="_WorkflowButton" model="@(new EwoBillWorkflowButtonViewModel(bill.Id, "cancel", "Cancel bill", ""))" /></li> }
                                    <li><hr class="dropdown-divider" /></li>
                                    <li>
                                        <form asp-action="ToggleActive" asp-route-id="@bill.Id" asp-route-isActive="@bill.IsActive" method="post" class="ewo-toggle-form" data-bill-number="@bill.BillNumber" data-deactivating="@bill.IsActive.ToString().ToLowerInvariant()">
                                            <button type="submit" class="dropdown-item @(bill.IsActive ? "text-danger" : "text-success")">
                                                <i class="bi @(bill.IsActive ? "bi-slash-circle" : "bi-check-circle") me-2"></i>@(bill.IsActive ? "Deactivate" : "Activate")
                                            </button>
                                        </form>
                                    </li>
                                }
                            </ul>
                        </div>
                    </td>
                </tr>
            }
            @if (Model.Items.Count == 0)
            {
                <tr>
                    <td colspan="11" class="ewo-empty">
                        <i class="bi bi-receipt"></i>
                        <div class="fw-semibold text-dark">No EWO bills found</div>
                        <div class="small text-muted mt-1">Try adjusting the filters or create a new bill.</div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
    </div>
    <div class="card-body pt-2">
        <partial name="_Pagination" model="@(new BuilderERP.Web.Models.PaginationViewModel
        {
            Page = Model.Page,
            PageSize = Model.PageSize,
            TotalPages = Model.TotalPages,
            TotalCount = Model.TotalCount,
            Action = "Index",
            RouteValues = BuildFilterRouteValues(billNumber, supplier, status, dateFrom, dateTo)
        })" />
    </div>
</div>

@functions {
    private static Dictionary<string, string?> BuildFilterRouteValues(string? billNumber, string? supplier, PoBillStatus? status, DateTime? dateFrom, DateTime? dateTo)
    {
        var values = new Dictionary<string, string?>();
        if (!string.IsNullOrWhiteSpace(billNumber)) values["billNumber"] = billNumber;
        if (!string.IsNullOrWhiteSpace(supplier)) values["supplier"] = supplier;
        if (status.HasValue) values["status"] = status.Value.ToString();
        if (dateFrom.HasValue) values["dateFrom"] = dateFrom.Value.ToString("yyyy-MM-dd");
        if (dateTo.HasValue) values["dateTo"] = dateTo.Value.ToString("yyyy-MM-dd");
        return values;
    }

    private static string StatusBadgeClass(PoBillStatus status) => status switch
    {
        PoBillStatus.Draft => "ewo-badge-draft",
        PoBillStatus.Approved => "ewo-badge-approved",
        PoBillStatus.Cancelled => "ewo-badge-cancelled",
        PoBillStatus.Submitted => "ewo-badge-submitted",
        PoBillStatus.AwaitingApproval => "ewo-badge-awaiting",
        PoBillStatus.Rejected => "ewo-badge-rejected",
        _ => "ewo-badge-cancelled"
    };

    private static string HumanizeStatus(PoBillStatus status) => status == PoBillStatus.AwaitingApproval ? "Awaiting Approval" : status.ToString();
}
