@using BuilderERP.Application.Common
@model PagedResult<BuilderERP.Application.DTOs.EwoBillDto>
@using BuilderERP.Shared.Constants
@using BuilderERP.Shared.Authorization
@{
    ViewData["Title"] = "EWO Bills";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">EWO Bills</h1>
    @if (User.HasClaim(PermissionClaimTypes.Permission, PermissionNames.EwoBillManage))
    {
        <a asp-action="Create" class="btn btn-primary">New EWO Bill</a>
    }
</div>

@if (TempData["Error"] is string error)
{
    <div class="alert alert-danger">@error</div>
}

<div data-grid-container>
    <partial name="_Grid" model="Model" />
</div>
