@model IReadOnlyList<BuilderERP.Application.DTOs.EquipmentRentalDto>
@using BuilderERP.Shared.Constants
@using BuilderERP.Shared.Authorization
@using BuilderERP.Domain.Enums
@{
    ViewData["Title"] = "Equipment Rentals";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Equipment Rentals</h1>
    @if (User.HasClaim(PermissionClaimTypes.Permission, PermissionNames.EquipmentRentalManage))
    {
        <a asp-action="Create" class="btn btn-primary">New Equipment Rental</a>
    }
</div>

<table class="table table-striped table-hover bg-white">
    <thead>
        <tr>
            <th>Equipment</th>
            <th>Supplier</th>
            <th>Project</th>
            <th>Rental Start</th>
            <th>Rental End</th>
            <th>Rate/Day</th>
            <th>Total Amount</th>
            <th>Status</th>
            <th>Active</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var rental in Model)
        {
            <tr>
                <td>@rental.EquipmentName</td>
                <td>@(rental.SupplierName ?? "—")</td>
                <td>@rental.ProjectName</td>
                <td>@rental.RentalStartDate.ToString("yyyy-MM-dd")</td>
                <td>@(rental.RentalEndDate.HasValue ? rental.RentalEndDate.Value.ToString("yyyy-MM-dd") : "—")</td>
                <td>@rental.RatePerDay</td>
                <td><strong>@rental.TotalAmount</strong></td>
                <td>
                    <span class="badge @(rental.Status == RentalStatus.Active ? "bg-primary" : "bg-success")">
                        @rental.Status
                    </span>
                </td>
                <td>
                    <span class="badge @(rental.IsActive ? "bg-success" : "bg-secondary")">
                        @(rental.IsActive ? "Active" : "Inactive")
                    </span>
                </td>
                <td class="text-end">
                    @if (User.HasClaim(PermissionClaimTypes.Permission, PermissionNames.EquipmentRentalManage))
                    {
                        <a asp-action="Edit" asp-route-id="@rental.Id" class="btn btn-sm btn-outline-secondary">Edit</a>
                        <form asp-action="ToggleActive" asp-route-id="@rental.Id" asp-route-isActive="@rental.IsActive" method="post" class="d-inline">
                            <button type="submit" class="btn btn-sm btn-outline-danger">
                                @(rental.IsActive ? "Deactivate" : "Activate")
                            </button>
                        </form>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>
