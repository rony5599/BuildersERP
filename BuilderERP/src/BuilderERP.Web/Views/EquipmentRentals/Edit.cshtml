@model BuilderERP.Application.DTOs.UpdateEquipmentRentalDto
@using BuilderERP.Domain.Enums
@{
    ViewData["Title"] = "Edit Equipment Rental";
}

<h1 class="h3 mb-4">Edit Equipment Rental</h1>

<form asp-action="Edit" method="post" class="col-md-6">
    <input type="hidden" asp-for="Id" />
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
    <div class="mb-3">
        <label asp-for="EquipmentId" class="form-label"></label>
        <select asp-for="EquipmentId" asp-items="ViewBag.Equipment" class="form-select">
            <option value="">-- Select Equipment --</option>
        </select>
        <span asp-validation-for="EquipmentId" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="SupplierId" class="form-label"></label>
        <select asp-for="SupplierId" asp-items="ViewBag.Suppliers" class="form-select">
            <option value="">-- None --</option>
        </select>
        <span asp-validation-for="SupplierId" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="ProjectId" class="form-label"></label>
        <select asp-for="ProjectId" asp-items="ViewBag.Projects" class="form-select">
            <option value="">-- Select Project --</option>
        </select>
        <span asp-validation-for="ProjectId" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="RentalStartDate" class="form-label"></label>
        <input asp-for="RentalStartDate" type="date" class="form-control" />
        <span asp-validation-for="RentalStartDate" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="RentalEndDate" class="form-label"></label>
        <input asp-for="RentalEndDate" type="date" class="form-control" />
        <span asp-validation-for="RentalEndDate" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="RatePerDay" class="form-label"></label>
        <input asp-for="RatePerDay" class="form-control" />
        <span asp-validation-for="RatePerDay" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Status" class="form-label"></label>
        <select asp-for="Status" asp-items="Html.GetEnumSelectList<RentalStatus>()" class="form-select"></select>
        <span asp-validation-for="Status" class="text-danger"></span>
    </div>
    <button type="submit" class="btn btn-primary">Save</button>
    <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
</form>
