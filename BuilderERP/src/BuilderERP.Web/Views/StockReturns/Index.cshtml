@model IReadOnlyList<BuilderERP.Application.DTOs.StockReturnDto>
@using BuilderERP.Shared.Constants
@using BuilderERP.Shared.Authorization
@{
    ViewData["Title"] = "Stock Returns";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Stock Returns</h1>
    @if (User.HasClaim(PermissionClaimTypes.Permission, PermissionNames.StockReturnManage))
    {
        <a asp-action="Create" class="btn btn-primary">New Stock Return</a>
    }
</div>

<table class="table table-striped table-hover bg-white">
    <thead>
        <tr>
            <th>Return #</th>
            <th>Material</th>
            <th>Warehouse</th>
            <th>Quantity</th>
            <th>Reason</th>
            <th>Date</th>
            <th>Active</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var stockReturn in Model)
        {
            <tr>
                <td>@stockReturn.ReturnNumber</td>
                <td>@stockReturn.MaterialName</td>
                <td>@stockReturn.WarehouseName</td>
                <td>@stockReturn.Quantity</td>
                <td>@stockReturn.Reason</td>
                <td>@stockReturn.ReturnDate.ToString("yyyy-MM-dd")</td>
                <td>
                    <span class="badge @(stockReturn.IsActive ? "bg-success" : "bg-secondary")">
                        @(stockReturn.IsActive ? "Active" : "Inactive")
                    </span>
                </td>
                <td class="text-end">
                    @if (User.HasClaim(PermissionClaimTypes.Permission, PermissionNames.StockReturnManage))
                    {
                        <a asp-action="Edit" asp-route-id="@stockReturn.Id" class="btn btn-sm btn-outline-secondary">Edit</a>
                        <form asp-action="ToggleActive" asp-route-id="@stockReturn.Id" asp-route-isActive="@stockReturn.IsActive" method="post" class="d-inline">
                            <button type="submit" class="btn btn-sm btn-outline-danger">
                                @(stockReturn.IsActive ? "Deactivate" : "Activate")
                            </button>
                        </form>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>
