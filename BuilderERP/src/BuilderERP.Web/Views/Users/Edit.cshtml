@model BuilderERP.Application.DTOs.UpdateUserDto
@{
    ViewData["Title"] = "Edit User";
}

<h1 class="h3 mb-4">Edit User</h1>

<form asp-action="Edit" method="post" class="col-md-6">
    <input type="hidden" asp-for="Id" />
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
    <div class="mb-3">
        <label asp-for="FullName" class="form-label"></label>
        <input asp-for="FullName" class="form-control" />
        <span asp-validation-for="FullName" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Role" class="form-label"></label>
        <select asp-for="Role" asp-items="ViewBag.Roles" class="form-select">
        </select>
        <span asp-validation-for="Role" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="CompanyId" class="form-label"></label>
        <select asp-for="CompanyId" asp-items="ViewBag.Companies" class="form-select">
            <option value="">-- Select Company --</option>
        </select>
    </div>
    <div class="mb-3">
        <label asp-for="BranchId" class="form-label"></label>
        <select asp-for="BranchId" asp-items="ViewBag.Branches" class="form-select">
            <option value="">-- Select Branch --</option>
        </select>
    </div>
    <div class="mb-3 form-check">
        <input asp-for="IsActive" class="form-check-input" />
        <label asp-for="IsActive" class="form-check-label"></label>
    </div>
    <button type="submit" class="btn btn-primary">Save</button>
    <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
</form>
