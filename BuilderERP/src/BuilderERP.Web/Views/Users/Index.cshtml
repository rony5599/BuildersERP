@using BuilderERP.Application.Common
@model PagedResult<BuilderERP.Application.DTOs.UserDto>
@using BuilderERP.Shared.Constants
@using BuilderERP.Shared.Authorization
@{
    ViewData["Title"] = "Users";
}

@if (TempData["StatusMessage"] is string statusMessage)
{
    <div class="alert alert-success">@statusMessage</div>
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Users</h1>
    @if (User.HasClaim(PermissionClaimTypes.Permission, PermissionNames.UserManage))
    {
        <a asp-action="Create" class="btn btn-primary">New User</a>
    }
</div>

<div data-grid-container>
    <partial name="_Grid" model="Model" />
</div>
