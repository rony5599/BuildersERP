@model BuilderERP.Application.DTOs.UpdateSitePhotoDto
@{
    ViewData["Title"] = "Edit Site Photo";
}

<h1 class="h3 mb-4">Edit Site Photo</h1>

<form asp-action="Edit" method="post" enctype="multipart/form-data" class="col-md-6">
    <input type="hidden" asp-for="Id" />
    <input type="hidden" asp-for="FilePath" />
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
    <div class="mb-3">
        <img src="@Model.FilePath" style="width:120px;height:90px;object-fit:cover;" />
    </div>
    <div class="mb-3">
        <label asp-for="ProjectId" class="form-label"></label>
        <select asp-for="ProjectId" asp-items="ViewBag.Projects" class="form-select">
            <option value="">-- Select Project --</option>
        </select>
        <span asp-validation-for="ProjectId" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="DailyProgressId" class="form-label"></label>
        <select asp-for="DailyProgressId" asp-items="ViewBag.DailyProgresses" class="form-select">
            <option value="">-- None --</option>
        </select>
        <span asp-validation-for="DailyProgressId" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label class="form-label">Replace Photo</label>
        <input type="file" name="photo" class="form-control" />
    </div>
    <div class="mb-3">
        <label asp-for="Caption" class="form-label"></label>
        <input asp-for="Caption" class="form-control" />
        <span asp-validation-for="Caption" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="TakenDate" class="form-label"></label>
        <input asp-for="TakenDate" class="form-control" />
        <span asp-validation-for="TakenDate" class="text-danger"></span>
    </div>
    <button type="submit" class="btn btn-primary">Save</button>
    <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
</form>
