@model BuilderERP.Application.DTOs.UpdateApartmentMaintenanceDto
@using BuilderERP.Domain.Enums
@{
    ViewData["Title"] = "Edit Apartment Maintenance";
}

<h1 class="h3 mb-4">Edit Apartment Maintenance</h1>

<form asp-action="Edit" method="post" class="col-md-6">
    <input type="hidden" asp-for="Id" />
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
    <div class="mb-3">
        <label asp-for="PropertyUnitId" class="form-label">Property Unit</label>
        <select asp-for="PropertyUnitId" asp-items="ViewBag.PropertyUnits" class="form-select">
            <option value="">-- Select Property Unit --</option>
        </select>
        <span asp-validation-for="PropertyUnitId" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="MaintenanceNumber" class="form-label"></label>
        <input asp-for="MaintenanceNumber" class="form-control" />
        <span asp-validation-for="MaintenanceNumber" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="MaintenanceType" class="form-label"></label>
        <select asp-for="MaintenanceType" asp-items="Html.GetEnumSelectList<FacilityMaintenanceType>()" class="form-select"></select>
        <span asp-validation-for="MaintenanceType" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="ScheduledDate" class="form-label"></label>
        <input asp-for="ScheduledDate" type="date" class="form-control" />
        <span asp-validation-for="ScheduledDate" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="CompletedDate" class="form-label"></label>
        <input asp-for="CompletedDate" type="date" class="form-control" />
        <span asp-validation-for="CompletedDate" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Cost" class="form-label"></label>
        <input asp-for="Cost" type="number" step="any" class="form-control" />
        <span asp-validation-for="Cost" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Status" class="form-label"></label>
        <select asp-for="Status" asp-items="Html.GetEnumSelectList<FacilityMaintenanceStatus>()" class="form-select"></select>
        <span asp-validation-for="Status" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="AssignedTo" class="form-label"></label>
        <input asp-for="AssignedTo" class="form-control" />
        <span asp-validation-for="AssignedTo" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Remarks" class="form-label"></label>
        <textarea asp-for="Remarks" class="form-control"></textarea>
        <span asp-validation-for="Remarks" class="text-danger"></span>
    </div>
    <button type="submit" class="btn btn-primary">Save</button>
    <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
</form>
