@model BuilderERP.Application.DTOs.UpdateSecurityDepositDto
@using BuilderERP.Domain.Enums
@{
    ViewData["Title"] = "Edit Security Deposit";
}

<h1 class="h3 mb-4">Edit Security Deposit</h1>

<form asp-action="Edit" method="post" class="col-md-6">
    <input type="hidden" asp-for="Id" />
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
    <div class="mb-3">
        <label asp-for="ContractorId" class="form-label"></label>
        <select asp-for="ContractorId" asp-items="ViewBag.Contractors" class="form-select">
            <option value="">-- Select Contractor --</option>
        </select>
        <span asp-validation-for="ContractorId" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="WorkOrderId" class="form-label"></label>
        <select asp-for="WorkOrderId" asp-items="ViewBag.WorkOrders" class="form-select">
            <option value="">-- None --</option>
        </select>
        <span asp-validation-for="WorkOrderId" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="DepositAmount" class="form-label"></label>
        <input asp-for="DepositAmount" class="form-control" />
        <span asp-validation-for="DepositAmount" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="DepositDate" class="form-label"></label>
        <input asp-for="DepositDate" type="date" class="form-control" />
        <span asp-validation-for="DepositDate" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="RefundDate" class="form-label"></label>
        <input asp-for="RefundDate" type="date" class="form-control" />
        <span asp-validation-for="RefundDate" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Status" class="form-label"></label>
        <select asp-for="Status" asp-items="Html.GetEnumSelectList<SecurityDepositStatus>()" class="form-select"></select>
        <span asp-validation-for="Status" class="text-danger"></span>
    </div>
    <button type="submit" class="btn btn-primary">Save</button>
    <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
</form>
