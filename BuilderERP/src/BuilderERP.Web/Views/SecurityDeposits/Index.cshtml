@model IReadOnlyList<BuilderERP.Application.DTOs.SecurityDepositDto>
@using BuilderERP.Shared.Constants
@using BuilderERP.Shared.Authorization
@using BuilderERP.Domain.Enums
@{
    ViewData["Title"] = "Security Deposits";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Security Deposits</h1>
    @if (User.HasClaim(PermissionClaimTypes.Permission, PermissionNames.SecurityDepositManage))
    {
        <a asp-action="Create" class="btn btn-primary">New Security Deposit</a>
    }
</div>

<table class="table table-striped table-hover bg-white">
    <thead>
        <tr>
            <th>Contractor</th>
            <th>Work Order</th>
            <th>Deposit Amount</th>
            <th>Deposit Date</th>
            <th>Refund Date</th>
            <th>Status</th>
            <th>Active</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var deposit in Model)
        {
            <tr>
                <td>@deposit.ContractorName</td>
                <td>@(deposit.WorkOrderNumber ?? "—")</td>
                <td>@deposit.DepositAmount</td>
                <td>@deposit.DepositDate.ToString("yyyy-MM-dd")</td>
                <td>@(deposit.RefundDate.HasValue ? deposit.RefundDate.Value.ToString("yyyy-MM-dd") : "—")</td>
                <td>
                    <span class="badge @(deposit.Status == SecurityDepositStatus.Held ? "bg-warning" : deposit.Status == SecurityDepositStatus.Refunded ? "bg-success" : "bg-danger")">
                        @deposit.Status
                    </span>
                </td>
                <td>
                    <span class="badge @(deposit.IsActive ? "bg-success" : "bg-secondary")">
                        @(deposit.IsActive ? "Active" : "Inactive")
                    </span>
                </td>
                <td class="text-end">
                    @if (User.HasClaim(PermissionClaimTypes.Permission, PermissionNames.SecurityDepositManage))
                    {
                        <a asp-action="Edit" asp-route-id="@deposit.Id" class="btn btn-sm btn-outline-secondary">Edit</a>
                        <form asp-action="ToggleActive" asp-route-id="@deposit.Id" asp-route-isActive="@deposit.IsActive" method="post" class="d-inline">
                            <button type="submit" class="btn btn-sm btn-outline-danger">
                                @(deposit.IsActive ? "Deactivate" : "Activate")
                            </button>
                        </form>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>
