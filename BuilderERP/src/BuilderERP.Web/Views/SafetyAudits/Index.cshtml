@using BuilderERP.Application.Common
@model PagedResult<BuilderERP.Application.DTOs.SafetyAuditDto>
@using BuilderERP.Shared.Constants
@using BuilderERP.Shared.Authorization
@using BuilderERP.Domain.Enums
@{
    ViewData["Title"] = "Safety Audits";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Safety Audits</h1>
    @if (User.HasClaim(PermissionClaimTypes.Permission, PermissionNames.SafetyAuditManage))
    {
        <a asp-action="Create" class="btn btn-primary">New Safety Audit</a>
    }
</div>

<div data-grid-container>
    <partial name="_Grid" model="Model" />
</div>
