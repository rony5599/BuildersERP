@model IReadOnlyList<BuilderERP.Application.DTOs.SafetyAuditDto>
@using BuilderERP.Shared.Constants
@using BuilderERP.Shared.Authorization
@using BuilderERP.Domain.Enums
@{
    ViewData["Title"] = "Safety Audits";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Safety Audits</h1>
    @if (User.HasClaim(PermissionClaimTypes.Permission, PermissionNames.SafetyAuditManage))
    {
        <a asp-action="Create" class="btn btn-primary">New Safety Audit</a>
    }
</div>

<table class="table table-striped table-hover bg-white">
    <thead>
        <tr>
            <th>Project</th>
            <th>Audit Date</th>
            <th>Audited By</th>
            <th>Score</th>
            <th>Status</th>
            <th>Active</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.ProjectName</td>
                <td>@item.AuditDate.ToString("yyyy-MM-dd")</td>
                <td>@item.AuditedBy</td>
                <td><strong>@item.Score / 100</strong></td>
                <td>
                    <span class="badge @(item.Status switch { SafetyAuditStatus.Scheduled => "bg-secondary", SafetyAuditStatus.InProgress => "bg-warning", SafetyAuditStatus.Completed => "bg-success", _ => "bg-secondary" })">
                        @item.Status
                    </span>
                </td>
                <td>
                    <span class="badge @(item.IsActive ? "bg-success" : "bg-secondary")">
                        @(item.IsActive ? "Active" : "Inactive")
                    </span>
                </td>
                <td class="text-end">
                    @if (User.HasClaim(PermissionClaimTypes.Permission, PermissionNames.SafetyAuditManage))
                    {
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">Edit</a>
                        <form asp-action="ToggleActive" asp-route-id="@item.Id" asp-route-isActive="@item.IsActive" method="post" class="d-inline">
                            <button type="submit" class="btn btn-sm btn-outline-danger">
                                @(item.IsActive ? "Deactivate" : "Activate")
                            </button>
                        </form>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>
