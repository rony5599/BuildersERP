@using BuilderERP.Application.Common
@model PagedResult<BuilderERP.Application.DTOs.MaintenanceRecordDto>
@using BuilderERP.Shared.Constants
@using BuilderERP.Shared.Authorization
@using BuilderERP.Domain.Enums

<table class="table table-striped table-hover bg-white">
    <thead>
        <tr>
            <th>Equipment</th>
            <th>Type</th>
            <th>Maintenance Date</th>
            <th>Description</th>
            <th>Cost</th>
            <th>Status</th>
            <th>Next Service Date</th>
            <th>Active</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var record in Model.Items)
        {
            <tr>
                <td>@record.EquipmentName</td>
                <td><span class="badge bg-secondary">@record.MaintenanceType</span></td>
                <td>@record.MaintenanceDate.ToString("yyyy-MM-dd")</td>
                <td>@(record.Description.Length > 60 ? record.Description.Substring(0, 60) + "..." : record.Description)</td>
                <td>@record.Cost</td>
                <td>
                    @{
                        var statusClass = record.Status switch
                        {
                            MaintenanceStatus.Scheduled => "bg-info",
                            MaintenanceStatus.InProgress => "bg-warning",
                            MaintenanceStatus.Completed => "bg-success",
                            _ => "bg-secondary"
                        };
                    }
                    <span class="badge @statusClass">@record.Status</span>
                </td>
                <td>@(record.NextServiceDate.HasValue ? record.NextServiceDate.Value.ToString("yyyy-MM-dd") : "—")</td>
                <td>
                    <span class="badge @(record.IsActive ? "bg-success" : "bg-secondary")">
                        @(record.IsActive ? "Active" : "Inactive")
                    </span>
                </td>
                <td class="text-end">
                    @if (User.HasClaim(PermissionClaimTypes.Permission, PermissionNames.MaintenanceRecordManage))
                    {
                        <a asp-action="Edit" asp-route-id="@record.Id" class="btn btn-sm btn-outline-secondary">Edit</a>
                        <form asp-action="ToggleActive" asp-route-id="@record.Id" asp-route-isActive="@record.IsActive" method="post" class="d-inline">
                            <button type="submit" class="btn btn-sm btn-outline-danger">
                                @(record.IsActive ? "Deactivate" : "Activate")
                            </button>
                        </form>
                    }
                </td>
            </tr>
        }
        @if (Model.Items.Count == 0)
        {
            <tr>
                <td colspan="9" class="text-center text-muted">No maintenance records found.</td>
            </tr>
        }
    </tbody>
</table>

<partial name="_Pagination" model="@(new BuilderERP.Web.Models.PaginationViewModel
{
    Page = Model.Page,
    PageSize = Model.PageSize,
    TotalPages = Model.TotalPages,
    TotalCount = Model.TotalCount,
    Action = "Index",
    RouteValues = new()
})" />
