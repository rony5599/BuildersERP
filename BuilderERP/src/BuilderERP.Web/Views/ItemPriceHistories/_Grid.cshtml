@using BuilderERP.Application.Common
@using Microsoft.AspNetCore.Mvc.Rendering
@model PagedResult<BuilderERP.Application.DTOs.ItemPriceHistoryDto>
@{
    var materialId = ViewBag.SelectedMaterialId as long?;
    var supplierId = ViewBag.SelectedSupplierId as long?;
    var dateFrom = ViewBag.DateFrom as DateTime?;
    var dateTo = ViewBag.DateTo as DateTime?;
    var hasFilters = materialId.HasValue || supplierId.HasValue || dateFrom.HasValue || dateTo.HasValue;
}

<div class="card mb-3">
    <div class="card-body">
        <form asp-action="Index" method="get" class="row gy-3 gx-4 align-items-end grid-search-form">
            <div class="col-12 col-sm-6 col-lg-3">
                <label class="form-label small mb-1">Material</label>
                <select name="materialId" asp-items="@(ViewBag.Materials as SelectList)" class="form-select">
                    <option value="">All Materials</option>
                </select>
            </div>
            <div class="col-12 col-sm-6 col-lg-3">
                <label class="form-label small mb-1">Supplier</label>
                <select name="supplierId" asp-items="@(ViewBag.Suppliers as SelectList)" class="form-select">
                    <option value="">All Suppliers</option>
                </select>
            </div>
            <div class="col-12 col-sm-6 col-lg-2">
                <label class="form-label small mb-1">Date From</label>
                <input type="date" name="dateFrom" value="@(dateFrom?.ToString("yyyy-MM-dd"))" class="form-control" />
            </div>
            <div class="col-12 col-sm-6 col-lg-2">
                <label class="form-label small mb-1">Date To</label>
                <input type="date" name="dateTo" value="@(dateTo?.ToString("yyyy-MM-dd"))" class="form-control" />
            </div>
            <div class="col-12 col-sm-6 col-lg-2 d-flex gap-2">
                <button type="submit" class="btn btn-primary flex-grow-1">Filter</button>
                @if (hasFilters)
                {
                    <a asp-action="Index" class="btn btn-outline-secondary flex-grow-1">Clear</a>
                }
            </div>
        </form>
    </div>
</div>

<div class="card">
    <table class="table table-striped table-hover mb-0">
        <thead>
            <tr>
                <th>Material</th>
                <th>Supplier</th>
                <th>Effective Date</th>
                <th>Unit Price</th>
                <th>VAT %</th>
                <th>Tax %</th>
                <th>Net Price</th>
                <th>Source</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var row in Model.Items)
            {
                <tr>
                    <td>@row.MaterialName</td>
                    <td>@row.SupplierName</td>
                    <td>@row.EffectiveDate.ToString("yyyy-MM-dd")</td>
                    <td>@row.UnitPrice</td>
                    <td>@row.VatPercent</td>
                    <td>@row.TaxPercent</td>
                    <td>@row.NetPrice</td>
                    <td>@row.SourceDocumentType @row.SourceDocumentNumber</td>
                </tr>
            }
            @if (Model.Items.Count == 0)
            {
                <tr>
                    <td colspan="8" class="text-center text-muted">No price history found.</td>
                </tr>
            }
        </tbody>
    </table>
    <div class="card-body pt-2">
        <partial name="_Pagination" model="@(new BuilderERP.Web.Models.PaginationViewModel
        {
            Page = Model.Page,
            PageSize = Model.PageSize,
            TotalPages = Model.TotalPages,
            TotalCount = Model.TotalCount,
            Action = "Index",
            RouteValues = BuildFilterRouteValues(materialId, supplierId, dateFrom, dateTo)
        })" />
    </div>
</div>

@functions {
    private static Dictionary<string, string?> BuildFilterRouteValues(long? materialId, long? supplierId, DateTime? dateFrom, DateTime? dateTo)
    {
        var values = new Dictionary<string, string?>();
        if (materialId.HasValue) values["materialId"] = materialId.Value.ToString();
        if (supplierId.HasValue) values["supplierId"] = supplierId.Value.ToString();
        if (dateFrom.HasValue) values["dateFrom"] = dateFrom.Value.ToString("yyyy-MM-dd");
        if (dateTo.HasValue) values["dateTo"] = dateTo.Value.ToString("yyyy-MM-dd");
        return values;
    }
}
