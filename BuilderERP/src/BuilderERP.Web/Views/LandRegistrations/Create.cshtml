@model BuilderERP.Application.DTOs.CreateLandRegistrationDto
@using BuilderERP.Domain.Enums
@{
    ViewData["Title"] = "New Land Registration";
}

<h1 class="h3 mb-4">New Land Registration</h1>

<form asp-action="Create" method="post" class="col-md-6">
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
    <div class="mb-3">
        <label asp-for="ProjectId" class="form-label">Project</label>
        <select asp-for="ProjectId" asp-items="ViewBag.Projects" class="form-select">
            <option value="">-- Select Project --</option>
        </select>
        <span asp-validation-for="ProjectId" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="RegistrationNumber" class="form-label"></label>
        <input asp-for="RegistrationNumber" class="form-control" />
        <span asp-validation-for="RegistrationNumber" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="DeedNumber" class="form-label"></label>
        <input asp-for="DeedNumber" class="form-control" />
        <span asp-validation-for="DeedNumber" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="RegistrationDate" class="form-label"></label>
        <input asp-for="RegistrationDate" type="date" class="form-control" />
        <span asp-validation-for="RegistrationDate" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="SubRegistryOffice" class="form-label"></label>
        <input asp-for="SubRegistryOffice" class="form-control" />
        <span asp-validation-for="SubRegistryOffice" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="RegistrationFee" class="form-label"></label>
        <input asp-for="RegistrationFee" type="number" step="any" class="form-control" />
        <span asp-validation-for="RegistrationFee" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Status" class="form-label"></label>
        <select asp-for="Status" asp-items="Html.GetEnumSelectList<LandRegistrationStatus>()" class="form-select"></select>
        <span asp-validation-for="Status" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Remarks" class="form-label"></label>
        <textarea asp-for="Remarks" class="form-control"></textarea>
        <span asp-validation-for="Remarks" class="text-danger"></span>
    </div>
    <button type="submit" class="btn btn-primary">Save</button>
    <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
</form>
