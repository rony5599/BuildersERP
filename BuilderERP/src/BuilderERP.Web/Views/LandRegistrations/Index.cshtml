@model IReadOnlyList<BuilderERP.Application.DTOs.LandRegistrationDto>
@using BuilderERP.Shared.Constants
@using BuilderERP.Shared.Authorization
@{
    ViewData["Title"] = "Land Registrations";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Land Registrations</h1>
    @if (User.HasClaim(PermissionClaimTypes.Permission, PermissionNames.LandRegistrationManage))
    {
        <a asp-action="Create" class="btn btn-primary">New Land Registration</a>
    }
</div>

<div class="table-responsive">
<table class="table table-striped table-hover bg-white">
    <thead>
        <tr>
            <th>Project</th>
            <th>Registration Number</th>
            <th>Deed Number</th>
            <th>Registration Date</th>
            <th>Sub Registry Office</th>
            <th>Registration Fee</th>
            <th>Active</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.ProjectName</td>
                <td>@item.RegistrationNumber</td>
                <td>@item.DeedNumber</td>
                <td>@item.RegistrationDate</td>
                <td>@item.SubRegistryOffice</td>
                <td>@item.RegistrationFee</td>
                <td>
                    <span class="badge @(item.IsActive ? "bg-success" : "bg-secondary")">
                        @(item.IsActive ? "Active" : "Inactive")
                    </span>
                </td>
                <td class="text-end">
                    @if (User.HasClaim(PermissionClaimTypes.Permission, PermissionNames.LandRegistrationManage))
                    {
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">Edit</a>
                        <form asp-action="ToggleActive" asp-route-id="@item.Id" asp-route-isActive="@item.IsActive" method="post" class="d-inline">
                            <button type="submit" class="btn btn-sm btn-outline-danger">
                                @(item.IsActive ? "Deactivate" : "Activate")
                            </button>
                        </form>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>
</div>
