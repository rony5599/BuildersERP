@using BuilderERP.Application.Common
@model PagedResult<BuilderERP.Application.DTOs.VendorQuotationDto>
@using BuilderERP.Shared.Constants
@using BuilderERP.Shared.Authorization
@{
    ViewData["Title"] = "Vendor Quotations";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Vendor Quotations</h1>
    <div class="d-flex gap-2">
        <a asp-controller="VendorCompare" asp-action="Index" class="btn btn-outline-primary">Compare Quotations</a>
        @if (User.HasClaim(PermissionClaimTypes.Permission, PermissionNames.VendorQuotationManage))
        {
            <a asp-action="Create" class="btn btn-primary">New Vendor Quotation</a>
        }
    </div>
</div>

<div data-grid-container>
    <partial name="_Grid" model="Model" />
</div>
