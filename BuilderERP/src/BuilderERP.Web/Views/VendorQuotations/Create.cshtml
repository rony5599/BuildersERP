@model BuilderERP.Application.DTOs.CreateVendorQuotationDto
@using BuilderERP.Domain.Enums
@{
    ViewData["Title"] = "New Vendor Quotation";
}

<h1 class="h3 mb-4">New Vendor Quotation</h1>

<form asp-action="Create" method="post" class="col-md-6">
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
    <div class="mb-3">
        <label asp-for="QuotationNumber" class="form-label"></label>
        <input asp-for="QuotationNumber" class="form-control" />
        <span asp-validation-for="QuotationNumber" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="RfqId" class="form-label"></label>
        <select asp-for="RfqId" asp-items="ViewBag.Rfqs" class="form-select">
            <option value="">-- Select RFQ --</option>
        </select>
        <span asp-validation-for="RfqId" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="QuotationDate" class="form-label"></label>
        <input asp-for="QuotationDate" type="date" class="form-control" />
    </div>
    <div class="mb-3">
        <label asp-for="QuotedAmount" class="form-label"></label>
        <input asp-for="QuotedAmount" class="form-control" />
        <span asp-validation-for="QuotedAmount" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="DeliveryDays" class="form-label"></label>
        <input asp-for="DeliveryDays" class="form-control" />
        <span asp-validation-for="DeliveryDays" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Status" class="form-label"></label>
        <select asp-for="Status" asp-items="Html.GetEnumSelectList<VendorQuotationStatus>()" class="form-select"></select>
        <span asp-validation-for="Status" class="text-danger"></span>
    </div>
    <button type="submit" class="btn btn-primary">Save</button>
    <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
</form>
