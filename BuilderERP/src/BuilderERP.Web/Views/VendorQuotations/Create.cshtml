@model BuilderERP.Application.DTOs.CreateVendorQuotationDto
@using BuilderERP.Domain.Enums
@{
    ViewData["Title"] = "New Vendor Quotation";
}

<h1 class="h3 mb-4">New Vendor Quotation</h1>

<form asp-action="Create" method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
    <div class="row col-md-8">
        <div class="mb-3 col-md-4">
            <label asp-for="QuotationNumber" class="form-label"></label>
            <input asp-for="QuotationNumber" class="form-control" />
            <span asp-validation-for="QuotationNumber" class="text-danger"></span>
        </div>
        <div class="mb-3 col-md-4">
            <label asp-for="RfqId" class="form-label"></label>
            <select asp-for="RfqId" asp-items="ViewBag.Rfqs" class="form-select">
                <option value="">-- Select RFQ --</option>
            </select>
            <span asp-validation-for="RfqId" class="text-danger"></span>
        </div>
        <div class="mb-3 col-md-4">
            <label asp-for="SupplierId" class="form-label"></label>
            <select asp-for="SupplierId" asp-items="ViewBag.Suppliers" class="form-select">
                <option value="">-- Select Supplier --</option>
            </select>
            <span asp-validation-for="SupplierId" class="text-danger"></span>
        </div>
        <div class="mb-3 col-md-4">
            <label asp-for="QuotationDate" class="form-label"></label>
            <input asp-for="QuotationDate" type="date" class="form-control" />
        </div>
        <div class="mb-3 col-md-4">
            <label asp-for="DeliveryDays" class="form-label"></label>
            <input asp-for="DeliveryDays" class="form-control" />
            <span asp-validation-for="DeliveryDays" class="text-danger"></span>
        </div>
        <div class="mb-3 col-md-4">
            <label asp-for="Status" class="form-label"></label>
            <select asp-for="Status" asp-items="Html.GetEnumSelectList<VendorQuotationStatus>()" class="form-select"></select>
        </div>
    </div>

    <h5 class="mt-4">Line Items</h5>
    <table class="table table-sm" id="vq-details-table">
        <thead>
            <tr>
                <th>Material</th>
                <th>Qty</th>
                <th>Unit</th>
                <th>Unit Price</th>
                <th>Disc %</th>
                <th>VAT %</th>
                <th>Tax %</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            <tr class="detail-row-template">
                <td>
                    <select name="Details[__index__].MaterialId" asp-items="ViewBag.Materials" class="form-select form-select-sm">
                        <option value="">-- Material --</option>
                    </select>
                </td>
                <td><input name="Details[__index__].Quantity" type="number" step="0.001" class="form-control form-control-sm" /></td>
                <td>
                    <select name="Details[__index__].UnitOfMeasure" asp-items="Html.GetEnumSelectList<UnitOfMeasure>()" class="form-select form-select-sm"></select>
                </td>
                <td><input name="Details[__index__].UnitPrice" type="number" step="0.01" class="form-control form-control-sm" /></td>
                <td><input name="Details[__index__].DiscountPercent" type="number" step="0.01" value="0" class="form-control form-control-sm" /></td>
                <td><input name="Details[__index__].VatPercent" type="number" step="0.01" value="0" class="form-control form-control-sm" /></td>
                <td><input name="Details[__index__].TaxPercent" type="number" step="0.01" value="0" class="form-control form-control-sm" /></td>
                <td><button type="button" class="btn btn-sm btn-outline-danger" data-remove-row>Remove</button></td>
            </tr>
        </tbody>
    </table>
    <button type="button" class="btn btn-sm btn-outline-primary mb-3" data-add-row-for="vq-details-table">Add Row</button>

    <div>
        <button type="submit" class="btn btn-primary">Save</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
    </div>
</form>

<partial name="_DetailLineItemsScripts" />
<script>
    document.addEventListener('DOMContentLoaded', function () {
        initDetailTable('vq-details-table', 'Details');
    });
</script>
