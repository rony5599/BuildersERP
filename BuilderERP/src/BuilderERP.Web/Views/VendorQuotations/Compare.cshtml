@model IReadOnlyList<BuilderERP.Application.DTOs.VendorQuotationDto>
@using BuilderERP.Domain.Enums
@using BuilderERP.Shared.Constants
@using BuilderERP.Shared.Authorization
@{
    var requisitionNumber = Model.Count > 0 ? Model[0].RequisitionNumber : string.Empty;
    ViewData["Title"] = "Quotation Comparison";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Quotation Comparison @(string.IsNullOrEmpty(requisitionNumber) ? "" : $"— {requisitionNumber}")</h1>
    <a asp-action="Index" class="btn btn-outline-secondary">Back to Vendor Quotations</a>
</div>

@if (!Model.Any())
{
    <p class="text-muted">No quotations found for this requisition.</p>
}
else
{
    <table class="table table-striped table-hover bg-white">
        <thead>
            <tr>
                <th>Quotation #</th>
                <th>Supplier</th>
                <th>Amount</th>
                <th>Delivery (days)</th>
                <th>Status</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var quotation in Model)
            {
                <tr class="@(quotation.Status == VendorQuotationStatus.Selected ? "table-success" : "")">
                    <td>@quotation.QuotationNumber</td>
                    <td>@quotation.SupplierName</td>
                    <td>@quotation.QuotedAmount</td>
                    <td>@quotation.DeliveryDays</td>
                    <td>@quotation.Status</td>
                    <td class="text-end">
                        @if (quotation.Status != VendorQuotationStatus.Selected && User.HasClaim(PermissionClaimTypes.Permission, PermissionNames.VendorQuotationManage))
                        {
                            <form asp-action="SelectWinner" asp-route-id="@quotation.Id" asp-route-requisitionId="@quotation.PurchaseRequisitionId" method="post" class="d-inline">
                                <button type="submit" class="btn btn-sm btn-primary">Select as Winner</button>
                            </form>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
