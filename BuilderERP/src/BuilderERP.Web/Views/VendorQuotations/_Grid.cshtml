@using BuilderERP.Application.Common
@using BuilderERP.Shared.Constants
@using BuilderERP.Shared.Authorization
@using Microsoft.AspNetCore.Mvc.Rendering
@model PagedResult<BuilderERP.Application.DTOs.VendorQuotationDto>
@{
    var quotationNumber = ViewBag.QuotationNumber as string;
    var projectId = ViewBag.ProjectId as long?;
    var status = ViewBag.Status as BuilderERP.Domain.Enums.VendorQuotationStatus?;
    var dateFrom = ViewBag.DateFrom as DateTime?;
    var dateTo = ViewBag.DateTo as DateTime?;
    var hasFilters = !string.IsNullOrWhiteSpace(quotationNumber) || projectId.HasValue || status.HasValue || dateFrom.HasValue || dateTo.HasValue;
}

<div class="card mb-3">
    <div class="card-body">
        <form asp-action="Index" method="get" class="row gy-3 gx-4 align-items-end grid-search-form">
            <div class="col-12 col-sm-6 col-lg-2">
                <label class="form-label small mb-1">Quotation #</label>
                <input type="search" name="quotationNumber" value="@quotationNumber" class="form-control" placeholder="Quotation #" />
            </div>
            <div class="col-12 col-sm-6 col-lg-2">
                <label class="form-label small mb-1">Project</label>
                <select name="projectId" asp-items="@(ViewBag.Projects as SelectList)" class="form-select">
                    <option value="">All Projects</option>
                </select>
            </div>
            <div class="col-12 col-sm-6 col-lg-2">
                <label class="form-label small mb-1">Status</label>
                <select name="status" asp-items="@(ViewBag.Statuses as SelectList)" class="form-select">
                    <option value="">All Statuses</option>
                </select>
            </div>
            <div class="col-12 col-sm-6 col-lg-2">
                <label class="form-label small mb-1">Date From</label>
                <input type="date" name="dateFrom" value="@(dateFrom?.ToString("yyyy-MM-dd"))" class="form-control" />
            </div>
            <div class="col-12 col-sm-6 col-lg-2">
                <label class="form-label small mb-1">Date To</label>
                <input type="date" name="dateTo" value="@(dateTo?.ToString("yyyy-MM-dd"))" class="form-control" />
            </div>
            <div class="col-12 col-sm-6 col-lg-2 d-flex gap-2">
                <button type="submit" class="btn btn-primary flex-grow-1">Filter</button>
                @if (hasFilters)
                {
                    <a asp-action="Index" class="btn btn-outline-secondary flex-grow-1">Clear</a>
                }
            </div>
        </form>
    </div>
</div>

<div class="card">
    <table class="table table-striped table-hover mb-0">
        <thead>
            <tr>
                <th>Quotation #</th>
                <th>RFQ</th>
                <th>Requisition</th>
                <th>Supplier</th>
                <th>Amount</th>
                <th>Delivery (days)</th>
                <th>Status</th>
                <th>Active</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var quotation in Model.Items)
            {
                <tr>
                    <td>@quotation.QuotationNumber</td>
                    <td>@quotation.RfqNumber</td>
                    <td>
                        <a asp-action="Compare" asp-route-requisitionId="@quotation.PurchaseRequisitionId">@quotation.RequisitionNumber</a>
                    </td>
                    <td>@quotation.SupplierName</td>
                    <td>@quotation.QuotedAmount</td>
                    <td>@quotation.DeliveryDays</td>
                    <td>
                        <span class="badge @StatusBadgeClass(quotation.Status)"><span class="badge-dot"></span>@quotation.Status</span>
                    </td>
                    <td>
                        <span class="badge @(quotation.IsActive ? "bg-success" : "bg-secondary")">
                            <span class="badge-dot"></span>@(quotation.IsActive ? "Active" : "Inactive")
                        </span>
                    </td>
                    <td class="text-end">
                        @if (User.HasClaim(PermissionClaimTypes.Permission, PermissionNames.VendorQuotationManage))
                        {
                            <a asp-action="Edit" asp-route-id="@quotation.Id" class="btn btn-sm btn-outline-secondary">Edit</a>
                            <form asp-action="ToggleActive" asp-route-id="@quotation.Id" asp-route-isActive="@quotation.IsActive" method="post" class="d-inline">
                                <button type="submit" class="btn btn-sm btn-outline-danger">
                                    @(quotation.IsActive ? "Deactivate" : "Activate")
                                </button>
                            </form>
                        }
                    </td>
                </tr>
            }
            @if (Model.Items.Count == 0)
            {
                <tr>
                    <td colspan="9" class="text-center text-muted">No vendor quotations found.</td>
                </tr>
            }
        </tbody>
    </table>
    <div class="card-body pt-2">
        <partial name="_Pagination" model="@(new BuilderERP.Web.Models.PaginationViewModel
        {
            Page = Model.Page,
            PageSize = Model.PageSize,
            TotalPages = Model.TotalPages,
            TotalCount = Model.TotalCount,
            Action = "Index",
            RouteValues = BuildFilterRouteValues(quotationNumber, projectId, status, dateFrom, dateTo)
        })" />
    </div>
</div>

@functions {
    private static Dictionary<string, string?> BuildFilterRouteValues(string? quotationNumber, long? projectId, BuilderERP.Domain.Enums.VendorQuotationStatus? status, DateTime? dateFrom, DateTime? dateTo)
    {
        var values = new Dictionary<string, string?>();
        if (!string.IsNullOrWhiteSpace(quotationNumber)) values["quotationNumber"] = quotationNumber;
        if (projectId.HasValue) values["projectId"] = projectId.Value.ToString();
        if (status.HasValue) values["status"] = status.Value.ToString();
        if (dateFrom.HasValue) values["dateFrom"] = dateFrom.Value.ToString("yyyy-MM-dd");
        if (dateTo.HasValue) values["dateTo"] = dateTo.Value.ToString("yyyy-MM-dd");
        return values;
    }

    private static string StatusBadgeClass(BuilderERP.Domain.Enums.VendorQuotationStatus status) => status switch
    {
        BuilderERP.Domain.Enums.VendorQuotationStatus.Received => "bg-warning",
        BuilderERP.Domain.Enums.VendorQuotationStatus.UnderReview => "bg-info",
        BuilderERP.Domain.Enums.VendorQuotationStatus.Selected => "bg-success",
        BuilderERP.Domain.Enums.VendorQuotationStatus.Rejected => "bg-danger",
        _ => "bg-secondary"
    };
}
