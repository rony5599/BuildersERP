@using BuilderERP.Application.Common
@using BuilderERP.Shared.Constants
@using BuilderERP.Shared.Authorization
@model PagedResult<BuilderERP.Application.DTOs.RateContractDto>

<table class="table table-striped table-hover bg-white">
    <thead>
        <tr>
            <th>Contract #</th>
            <th>Contractor</th>
            <th>Project</th>
            <th>Item Description</th>
            <th>Unit</th>
            <th>Rate</th>
            <th>Effective Date</th>
            <th>Expiry Date</th>
            <th>Active</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var contract in Model.Items)
        {
            <tr>
                <td>@contract.ContractNumber</td>
                <td>@contract.ContractorName</td>
                <td>@(contract.ProjectName ?? "—")</td>
                <td>@contract.ItemDescription</td>
                <td>@contract.UnitOfMeasure</td>
                <td>@contract.Rate</td>
                <td>@contract.EffectiveDate.ToString("yyyy-MM-dd")</td>
                <td>@(contract.ExpiryDate.HasValue ? contract.ExpiryDate.Value.ToString("yyyy-MM-dd") : "—")</td>
                <td>
                    <span class="badge @(contract.IsActive ? "bg-success" : "bg-secondary")">
                        @(contract.IsActive ? "Active" : "Inactive")
                    </span>
                </td>
                <td class="text-end">
                    @if (User.HasClaim(PermissionClaimTypes.Permission, PermissionNames.RateContractManage))
                    {
                        <a asp-action="Edit" asp-route-id="@contract.Id" class="btn btn-sm btn-outline-secondary">Edit</a>
                        <form asp-action="ToggleActive" asp-route-id="@contract.Id" asp-route-isActive="@contract.IsActive" method="post" class="d-inline">
                            <button type="submit" class="btn btn-sm btn-outline-danger">
                                @(contract.IsActive ? "Deactivate" : "Activate")
                            </button>
                        </form>
                    }
                </td>
            </tr>
        }
        @if (Model.Items.Count == 0)
        {
            <tr>
                <td colspan="10" class="text-center text-muted">No rate contracts found.</td>
            </tr>
        }
    </tbody>
</table>

<partial name="_Pagination" model="@(new BuilderERP.Web.Models.PaginationViewModel
{
    Page = Model.Page,
    PageSize = Model.PageSize,
    TotalPages = Model.TotalPages,
    TotalCount = Model.TotalCount,
    Action = "Index",
    RouteValues = new()
})" />
