@model IReadOnlyList<BuilderERP.Application.DTOs.DelayEventDto>
@using BuilderERP.Shared.Constants
@using BuilderERP.Shared.Authorization
@{
    ViewData["Title"] = "Delay Events";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Delay Events</h1>
    @if (User.HasClaim(PermissionClaimTypes.Permission, PermissionNames.DelayEventManage))
    {
        <a asp-action="Create" class="btn btn-primary">New Delay Event</a>
    }
</div>

<table class="table table-striped table-hover bg-white">
    <thead>
        <tr>
            <th>Reported Date</th>
            <th>Project</th>
            <th>WBS Task</th>
            <th>Description</th>
            <th>Delay Days</th>
            <th>Reason</th>
            <th>Active</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var delayEvent in Model)
        {
            <tr>
                <td>@delayEvent.ReportedDate.ToString("yyyy-MM-dd")</td>
                <td>@delayEvent.ProjectName</td>
                <td>@delayEvent.WbsTaskCode</td>
                <td>@delayEvent.Description</td>
                <td>@delayEvent.DelayDays</td>
                <td><span class="badge bg-warning text-dark">@delayEvent.Reason</span></td>
                <td>
                    <span class="badge @(delayEvent.IsActive ? "bg-success" : "bg-secondary")">
                        @(delayEvent.IsActive ? "Active" : "Inactive")
                    </span>
                </td>
                <td class="text-end">
                    @if (User.HasClaim(PermissionClaimTypes.Permission, PermissionNames.DelayEventManage))
                    {
                        <a asp-action="Edit" asp-route-id="@delayEvent.Id" class="btn btn-sm btn-outline-secondary">Edit</a>
                        <form asp-action="ToggleActive" asp-route-id="@delayEvent.Id" asp-route-isActive="@delayEvent.IsActive" method="post" class="d-inline">
                            <button type="submit" class="btn btn-sm btn-outline-danger">
                                @(delayEvent.IsActive ? "Deactivate" : "Activate")
                            </button>
                        </form>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>
