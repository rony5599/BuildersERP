@model BuilderERP.Application.DTOs.UpdateDelayEventDto
@using BuilderERP.Domain.Enums
@{
    ViewData["Title"] = "Edit Delay Event";
}

<h1 class="h3 mb-4">Edit Delay Event</h1>

<form asp-action="Edit" method="post" class="col-md-6">
    <input type="hidden" asp-for="Id" />
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
    <div class="mb-3">
        <label asp-for="ProjectId" class="form-label"></label>
        <select asp-for="ProjectId" asp-items="ViewBag.Projects" class="form-select">
            <option value="">-- Select Project --</option>
        </select>
        <span asp-validation-for="ProjectId" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="WbsTaskId" class="form-label"></label>
        <select asp-for="WbsTaskId" asp-items="ViewBag.WbsTasks" class="form-select">
            <option value="">-- None --</option>
        </select>
        <span asp-validation-for="WbsTaskId" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Description" class="form-label"></label>
        <textarea asp-for="Description" class="form-control"></textarea>
        <span asp-validation-for="Description" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="DelayDays" class="form-label"></label>
        <input asp-for="DelayDays" class="form-control" />
        <span asp-validation-for="DelayDays" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Reason" class="form-label"></label>
        <select asp-for="Reason" asp-items="Html.GetEnumSelectList<DelayReason>()" class="form-select"></select>
        <span asp-validation-for="Reason" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="ReportedDate" class="form-label"></label>
        <input asp-for="ReportedDate" type="date" class="form-control" />
        <span asp-validation-for="ReportedDate" class="text-danger"></span>
    </div>
    <button type="submit" class="btn btn-primary">Save</button>
    <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
</form>
