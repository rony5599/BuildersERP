@model BuilderERP.Application.DTOs.RolePermissionsDto
@{
    ViewData["Title"] = $"Permissions - {Model.RoleName}";
}

<h1 class="h3 mb-4">Permissions for @Model.RoleName</h1>

<form asp-action="Permissions" asp-route-id="@Model.RoleId" method="post">
    @foreach (var group in Model.Groups)
    {
        <div class="card mb-3">
            <div class="card-header fw-semibold">@group.Module</div>
            <div class="card-body">
                @foreach (var permission in group.Permissions)
                {
                    <div class="form-check">
                        <input type="checkbox" class="form-check-input" name="selectedPermissionIds" value="@permission.Id" id="perm-@permission.Id" checked="@permission.IsGranted" />
                        <label class="form-check-label" for="perm-@permission.Id">@permission.Name</label>
                    </div>
                }
            </div>
        </div>
    }
    <button type="submit" class="btn btn-primary">Save Permissions</button>
    <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
</form>
