@model IReadOnlyList<BuilderERP.Application.DTOs.RoleDto>
@using BuilderERP.Shared.Constants
@using BuilderERP.Shared.Authorization
@{
    ViewData["Title"] = "Roles";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Roles</h1>
    @if (User.HasClaim(PermissionClaimTypes.Permission, PermissionNames.RoleManage))
    {
        <a asp-action="Create" class="btn btn-primary">New Role</a>
    }
</div>

<table class="table table-striped table-hover bg-white">
    <thead>
        <tr>
            <th>Name</th>
            <th>Description</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var role in Model)
        {
            <tr>
                <td>@role.Name</td>
                <td>@role.Description</td>
                <td class="text-end">
                    @if (User.HasClaim(PermissionClaimTypes.Permission, PermissionNames.RoleManage))
                    {
                        <a asp-action="Edit" asp-route-id="@role.Id" class="btn btn-sm btn-outline-secondary">Edit</a>
                        <a asp-action="Permissions" asp-route-id="@role.Id" class="btn btn-sm btn-outline-primary">Permissions</a>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>
