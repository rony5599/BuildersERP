@using BuilderERP.Application.Common
@using BuilderERP.Shared.Constants
@using BuilderERP.Shared.Authorization
@model PagedResult<BuilderERP.Application.DTOs.ContractorLedgerDto>

<table class="table table-striped table-hover bg-white">
    <thead>
        <tr>
            <th>Contractor</th>
            <th>Transaction Date</th>
            <th>Description</th>
            <th>Debit</th>
            <th>Credit</th>
            <th>Balance</th>
            <th>Active</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var entry in Model.Items)
        {
            <tr>
                <td>@entry.ContractorName</td>
                <td>@entry.TransactionDate.ToString("yyyy-MM-dd")</td>
                <td>@entry.Description</td>
                <td>@entry.DebitAmount</td>
                <td>@entry.CreditAmount</td>
                <td><strong>@entry.Balance</strong></td>
                <td>
                    <span class="badge @(entry.IsActive ? "bg-success" : "bg-secondary")">
                        @(entry.IsActive ? "Active" : "Inactive")
                    </span>
                </td>
                <td class="text-end">
                    @if (User.HasClaim(PermissionClaimTypes.Permission, PermissionNames.ContractorLedgerManage))
                    {
                        <a asp-action="Edit" asp-route-id="@entry.Id" class="btn btn-sm btn-outline-secondary">Edit</a>
                        <form asp-action="ToggleActive" asp-route-id="@entry.Id" asp-route-isActive="@entry.IsActive" method="post" class="d-inline">
                            <button type="submit" class="btn btn-sm btn-outline-danger">
                                @(entry.IsActive ? "Deactivate" : "Activate")
                            </button>
                        </form>
                    }
                </td>
            </tr>
        }
        @if (Model.Items.Count == 0)
        {
            <tr>
                <td colspan="8" class="text-center text-muted">No ledger entries found.</td>
            </tr>
        }
    </tbody>
</table>

<partial name="_Pagination" model="@(new BuilderERP.Web.Models.PaginationViewModel
{
    Page = Model.Page,
    PageSize = Model.PageSize,
    TotalPages = Model.TotalPages,
    TotalCount = Model.TotalCount,
    Action = "Index",
    RouteValues = new Dictionary<string, string?> { ["contractorId"] = ViewBag.SelectedContractorId?.ToString() }
})" />
