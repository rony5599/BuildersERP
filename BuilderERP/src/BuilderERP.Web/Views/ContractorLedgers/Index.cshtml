@model IReadOnlyList<BuilderERP.Application.DTOs.ContractorLedgerDto>
@using BuilderERP.Shared.Constants
@using BuilderERP.Shared.Authorization
@{
    ViewData["Title"] = "Contractor Ledger";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Contractor Ledger</h1>
    @if (User.HasClaim(PermissionClaimTypes.Permission, PermissionNames.ContractorLedgerManage))
    {
        <a asp-action="Create" class="btn btn-primary">New Ledger Entry</a>
    }
</div>

<table class="table table-striped table-hover bg-white">
    <thead>
        <tr>
            <th>Contractor</th>
            <th>Transaction Date</th>
            <th>Description</th>
            <th>Debit</th>
            <th>Credit</th>
            <th>Balance</th>
            <th>Active</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var entry in Model)
        {
            <tr>
                <td>@entry.ContractorName</td>
                <td>@entry.TransactionDate.ToString("yyyy-MM-dd")</td>
                <td>@entry.Description</td>
                <td>@entry.DebitAmount</td>
                <td>@entry.CreditAmount</td>
                <td><strong>@entry.Balance</strong></td>
                <td>
                    <span class="badge @(entry.IsActive ? "bg-success" : "bg-secondary")">
                        @(entry.IsActive ? "Active" : "Inactive")
                    </span>
                </td>
                <td class="text-end">
                    @if (User.HasClaim(PermissionClaimTypes.Permission, PermissionNames.ContractorLedgerManage))
                    {
                        <a asp-action="Edit" asp-route-id="@entry.Id" class="btn btn-sm btn-outline-secondary">Edit</a>
                        <form asp-action="ToggleActive" asp-route-id="@entry.Id" asp-route-isActive="@entry.IsActive" method="post" class="d-inline">
                            <button type="submit" class="btn btn-sm btn-outline-danger">
                                @(entry.IsActive ? "Deactivate" : "Activate")
                            </button>
                        </form>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>
