@model BuilderERP.Application.DTOs.CreateContractorLedgerDto
@{
    ViewData["Title"] = "New Ledger Entry";
}

<h1 class="h3 mb-4">New Ledger Entry</h1>

<form asp-action="Create" method="post" class="col-md-6">
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
    <div class="mb-3">
        <label asp-for="ContractorId" class="form-label"></label>
        <select asp-for="ContractorId" asp-items="ViewBag.Contractors" class="form-select">
            <option value="">-- Select Contractor --</option>
        </select>
        <span asp-validation-for="ContractorId" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="TransactionDate" class="form-label"></label>
        <input asp-for="TransactionDate" type="date" class="form-control" />
        <span asp-validation-for="TransactionDate" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Description" class="form-label"></label>
        <input asp-for="Description" class="form-control" />
        <span asp-validation-for="Description" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="DebitAmount" class="form-label"></label>
        <input asp-for="DebitAmount" class="form-control" />
        <span asp-validation-for="DebitAmount" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="CreditAmount" class="form-label"></label>
        <input asp-for="CreditAmount" class="form-control" />
        <span asp-validation-for="CreditAmount" class="text-danger"></span>
    </div>
    <button type="submit" class="btn btn-primary">Save</button>
    <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
</form>
