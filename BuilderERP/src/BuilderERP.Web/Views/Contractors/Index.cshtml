@model IReadOnlyList<BuilderERP.Application.DTOs.ContractorDto>
@using BuilderERP.Shared.Constants
@using BuilderERP.Shared.Authorization
@{
    ViewData["Title"] = "Contractors";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Contractors</h1>
    @if (User.HasClaim(PermissionClaimTypes.Permission, PermissionNames.ContractorManage))
    {
        <a asp-action="Create" class="btn btn-primary">New Contractor</a>
    }
</div>

<table class="table table-striped table-hover bg-white">
    <thead>
        <tr>
            <th>Code</th>
            <th>Name</th>
            <th>Contact Person</th>
            <th>Phone</th>
            <th>Specialization</th>
            <th>Active</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var contractor in Model)
        {
            <tr>
                <td>@contractor.ContractorCode</td>
                <td>@contractor.Name</td>
                <td>@contractor.ContactPerson</td>
                <td>@contractor.Phone</td>
                <td>@contractor.Specialization</td>
                <td>
                    <span class="badge @(contractor.IsActive ? "bg-success" : "bg-secondary")">
                        @(contractor.IsActive ? "Active" : "Inactive")
                    </span>
                </td>
                <td class="text-end">
                    @if (User.HasClaim(PermissionClaimTypes.Permission, PermissionNames.ContractorManage))
                    {
                        <a asp-action="Edit" asp-route-id="@contractor.Id" class="btn btn-sm btn-outline-secondary">Edit</a>
                        <form asp-action="ToggleActive" asp-route-id="@contractor.Id" asp-route-isActive="@contractor.IsActive" method="post" class="d-inline">
                            <button type="submit" class="btn btn-sm btn-outline-danger">
                                @(contractor.IsActive ? "Deactivate" : "Activate")
                            </button>
                        </form>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>
