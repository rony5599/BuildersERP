@model IReadOnlyList<BuilderERP.Application.DTOs.RiskAssessmentDto>
@using BuilderERP.Domain.Enums
@using BuilderERP.Shared.Constants
@using BuilderERP.Shared.Authorization
@{
    ViewData["Title"] = "Risk Assessments";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Risk Assessments</h1>
    @if (User.HasClaim(PermissionClaimTypes.Permission, PermissionNames.RiskAssessmentManage))
    {
        <a asp-action="Create" class="btn btn-primary">New Risk Assessment</a>
    }
</div>

<table class="table table-striped table-hover bg-white">
    <thead>
        <tr>
            <th>Project</th>
            <th>Assessment Date</th>
            <th>Assessed By</th>
            <th>Hazard Description</th>
            <th>Risk Level</th>
            <th>Review Date</th>
            <th>Active</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var assessment in Model)
        {
            <tr>
                <td>@assessment.ProjectName</td>
                <td>@assessment.AssessmentDate.ToString("yyyy-MM-dd")</td>
                <td>@assessment.AssessedBy</td>
                <td>@(assessment.HazardDescription.Length > 60 ? assessment.HazardDescription.Substring(0, 60) + "..." : assessment.HazardDescription)</td>
                <td>
                    @{
                        var riskBadge = assessment.RiskLevel switch
                        {
                            RiskLevel.Low => "bg-success",
                            RiskLevel.Medium => "bg-info",
                            RiskLevel.High => "bg-warning",
                            RiskLevel.Critical => "bg-danger",
                            _ => "bg-secondary"
                        };
                    }
                    <span class="badge @riskBadge">@assessment.RiskLevel</span>
                </td>
                <td>@(assessment.ReviewDate.HasValue ? assessment.ReviewDate.Value.ToString("yyyy-MM-dd") : "—")</td>
                <td>
                    <span class="badge @(assessment.IsActive ? "bg-success" : "bg-secondary")">
                        @(assessment.IsActive ? "Active" : "Inactive")
                    </span>
                </td>
                <td class="text-end">
                    @if (User.HasClaim(PermissionClaimTypes.Permission, PermissionNames.RiskAssessmentManage))
                    {
                        <a asp-action="Edit" asp-route-id="@assessment.Id" class="btn btn-sm btn-outline-secondary">Edit</a>
                        <form asp-action="ToggleActive" asp-route-id="@assessment.Id" asp-route-isActive="@assessment.IsActive" method="post" class="d-inline">
                            <button type="submit" class="btn btn-sm btn-outline-danger">
                                @(assessment.IsActive ? "Deactivate" : "Activate")
                            </button>
                        </form>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>
