@model BuilderERP.Application.DTOs.CreateFloorDto
@{
    ViewData["Title"] = "New Floor";
}

<h1 class="h3 mb-4">New Floor</h1>

<form asp-action="Create" method="post" class="col-md-6">
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
    <div class="mb-3">
        <label asp-for="TowerId" class="form-label"></label>
        <select asp-for="TowerId" asp-items="ViewBag.Towers" class="form-select">
            <option value="">-- Select Tower --</option>
        </select>
        <span asp-validation-for="TowerId" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Name" class="form-label"></label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="FloorNumber" class="form-label"></label>
        <input asp-for="FloorNumber" class="form-control" />
        <span asp-validation-for="FloorNumber" class="text-danger"></span>
    </div>
    <button type="submit" class="btn btn-primary">Save</button>
    <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
</form>
