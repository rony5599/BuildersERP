@model IReadOnlyList<BuilderERP.Application.DTOs.FloorDto>
@using BuilderERP.Shared.Constants
@using BuilderERP.Shared.Authorization
@{
    ViewData["Title"] = "Floors";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Floors</h1>
    @if (User.HasClaim(PermissionClaimTypes.Permission, PermissionNames.FloorManage))
    {
        <a asp-action="Create" class="btn btn-primary">New Floor</a>
    }
</div>

<table class="table table-striped table-hover bg-white">
    <thead>
        <tr>
            <th>Name</th>
            <th>Tower</th>
            <th>Floor Number</th>
            <th>Status</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var floor in Model)
        {
            <tr>
                <td>@floor.Name</td>
                <td>@floor.TowerName</td>
                <td>@floor.FloorNumber</td>
                <td>
                    <span class="badge @(floor.IsActive ? "bg-success" : "bg-secondary")">
                        @(floor.IsActive ? "Active" : "Inactive")
                    </span>
                </td>
                <td class="text-end">
                    @if (User.HasClaim(PermissionClaimTypes.Permission, PermissionNames.FloorManage))
                    {
                        <a asp-action="Edit" asp-route-id="@floor.Id" class="btn btn-sm btn-outline-secondary">Edit</a>
                        <form asp-action="ToggleActive" asp-route-id="@floor.Id" asp-route-isActive="@floor.IsActive" method="post" class="d-inline">
                            <button type="submit" class="btn btn-sm btn-outline-danger">
                                @(floor.IsActive ? "Deactivate" : "Activate")
                            </button>
                        </form>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>
