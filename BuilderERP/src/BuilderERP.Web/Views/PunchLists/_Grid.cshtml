@using BuilderERP.Application.Common
@using BuilderERP.Shared.Constants
@using BuilderERP.Shared.Authorization
@using BuilderERP.Domain.Enums
@model PagedResult<BuilderERP.Application.DTOs.PunchListDto>

<table class="table table-striped table-hover bg-white">
    <thead>
        <tr>
            <th>Item Number</th>
            <th>Project</th>
            <th>Location</th>
            <th>Description</th>
            <th>Status</th>
            <th>Assigned To</th>
            <th>Due Date</th>
            <th>Active</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.Items)
        {
            var isOverdue = item.DueDate.HasValue && item.DueDate.Value.Date < DateTime.UtcNow.Date
                && item.Status != PunchListStatus.Completed && item.Status != PunchListStatus.Verified;
            <tr>
                <td>@item.ItemNumber</td>
                <td>@item.ProjectName</td>
                <td>@item.Location</td>
                <td>@(item.Description.Length > 60 ? item.Description.Substring(0, 60) + "..." : item.Description)</td>
                <td>
                    @{
                        var statusBadge = item.Status switch
                        {
                            PunchListStatus.Open => "bg-danger",
                            PunchListStatus.InProgress => "bg-warning",
                            PunchListStatus.Completed => "bg-info",
                            PunchListStatus.Verified => "bg-success",
                            _ => "bg-secondary"
                        };
                    }
                    <span class="badge @statusBadge">@item.Status</span>
                </td>
                <td>@item.AssignedTo</td>
                <td class="@(isOverdue ? "text-danger" : "")">
                    @(item.DueDate.HasValue ? item.DueDate.Value.ToString("yyyy-MM-dd") : "—")
                </td>
                <td>
                    <span class="badge @(item.IsActive ? "bg-success" : "bg-secondary")">
                        @(item.IsActive ? "Active" : "Inactive")
                    </span>
                </td>
                <td class="text-end">
                    @if (User.HasClaim(PermissionClaimTypes.Permission, PermissionNames.PunchListManage))
                    {
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">Edit</a>
                        <form asp-action="ToggleActive" asp-route-id="@item.Id" asp-route-isActive="@item.IsActive" method="post" class="d-inline">
                            <button type="submit" class="btn btn-sm btn-outline-danger">
                                @(item.IsActive ? "Deactivate" : "Activate")
                            </button>
                        </form>
                    }
                </td>
            </tr>
        }
        @if (Model.Items.Count == 0)
        {
            <tr>
                <td colspan="9" class="text-center text-muted">No punch list items found.</td>
            </tr>
        }
    </tbody>
</table>

<partial name="_Pagination" model="@(new BuilderERP.Web.Models.PaginationViewModel
{
    Page = Model.Page,
    PageSize = Model.PageSize,
    TotalPages = Model.TotalPages,
    TotalCount = Model.TotalCount,
    Action = "Index",
    RouteValues = new Dictionary<string, string?> { ["projectId"] = ViewBag.SelectedProjectId?.ToString() }
})" />
