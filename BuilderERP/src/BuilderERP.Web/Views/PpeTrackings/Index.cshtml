@model IReadOnlyList<BuilderERP.Application.DTOs.PpeTrackingDto>
@using BuilderERP.Shared.Constants
@using BuilderERP.Shared.Authorization
@using BuilderERP.Domain.Enums
@{
    ViewData["Title"] = "PPE Tracking";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">PPE Tracking</h1>
    @if (User.HasClaim(PermissionClaimTypes.Permission, PermissionNames.PpeTrackingManage))
    {
        <a asp-action="Create" class="btn btn-primary">New PPE Record</a>
    }
</div>

<table class="table table-striped table-hover bg-white">
    <thead>
        <tr>
            <th>Worker</th>
            <th>PPE Type</th>
            <th>Issue Date</th>
            <th>Expiry Date</th>
            <th>Status</th>
            <th>Active</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.WorkerName</td>
                <td><span class="badge bg-info text-dark">@item.PpeType</span></td>
                <td>@item.IssueDate.ToString("yyyy-MM-dd")</td>
                <td>
                    @if (item.ExpiryDate.HasValue)
                    {
                        <span class="@(item.ExpiryDate.Value.Date < DateTime.UtcNow.Date ? "text-danger" : "")">@item.ExpiryDate.Value.ToString("yyyy-MM-dd")</span>
                    }
                    else
                    {
                        <span>&mdash;</span>
                    }
                </td>
                <td>
                    <span class="badge @(item.Status switch { PpeStatus.Issued => "bg-success", PpeStatus.Returned => "bg-secondary", PpeStatus.Lost => "bg-danger", PpeStatus.Damaged => "bg-warning", _ => "bg-secondary" })">
                        @item.Status
                    </span>
                </td>
                <td>
                    <span class="badge @(item.IsActive ? "bg-success" : "bg-secondary")">
                        @(item.IsActive ? "Active" : "Inactive")
                    </span>
                </td>
                <td class="text-end">
                    @if (User.HasClaim(PermissionClaimTypes.Permission, PermissionNames.PpeTrackingManage))
                    {
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">Edit</a>
                        <form asp-action="ToggleActive" asp-route-id="@item.Id" asp-route-isActive="@item.IsActive" method="post" class="d-inline">
                            <button type="submit" class="btn btn-sm btn-outline-danger">
                                @(item.IsActive ? "Deactivate" : "Activate")
                            </button>
                        </form>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>
