@model IReadOnlyList<BuilderERP.Application.DTOs.DailyProgressDto>
@using BuilderERP.Shared.Constants
@using BuilderERP.Shared.Authorization
@{
    ViewData["Title"] = "Daily Progress";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Daily Progress</h1>
    @if (User.HasClaim(PermissionClaimTypes.Permission, PermissionNames.DailyProgressManage))
    {
        <a asp-action="Create" class="btn btn-primary">New Daily Progress</a>
    }
</div>

<table class="table table-striped table-hover bg-white">
    <thead>
        <tr>
            <th>Progress Date</th>
            <th>Project</th>
            <th>Description</th>
            <th>% Complete</th>
            <th>Manpower Count</th>
            <th>Active</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.ProgressDate.ToString("yyyy-MM-dd")</td>
                <td>@item.ProjectName</td>
                <td>@(item.Description.Length > 80 ? item.Description.Substring(0, 80) + "..." : item.Description)</td>
                <td>@item.PercentComplete.ToString("N1")%</td>
                <td>@item.ManpowerCount</td>
                <td>
                    <span class="badge @(item.IsActive ? "bg-success" : "bg-secondary")">
                        @(item.IsActive ? "Active" : "Inactive")
                    </span>
                </td>
                <td class="text-end">
                    @if (User.HasClaim(PermissionClaimTypes.Permission, PermissionNames.DailyProgressManage))
                    {
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">Edit</a>
                        <form asp-action="ToggleActive" asp-route-id="@item.Id" asp-route-isActive="@item.IsActive" method="post" class="d-inline">
                            <button type="submit" class="btn btn-sm btn-outline-danger">
                                @(item.IsActive ? "Deactivate" : "Activate")
                            </button>
                        </form>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>
