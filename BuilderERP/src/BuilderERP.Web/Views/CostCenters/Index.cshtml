@model IReadOnlyList<BuilderERP.Application.DTOs.CostCenterDto>
@using BuilderERP.Shared.Constants
@using BuilderERP.Shared.Authorization
@{
    ViewData["Title"] = "Cost Centers";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Cost Centers</h1>
    @if (User.HasClaim(PermissionClaimTypes.Permission, PermissionNames.CostCenterManage))
    {
        <a asp-action="Create" class="btn btn-primary">New Cost Center</a>
    }
</div>

<table class="table table-striped table-hover bg-white">
    <thead>
        <tr>
            <th>Name</th>
            <th>Code</th>
            <th>Project</th>
            <th>Status</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var costCenter in Model)
        {
            <tr>
                <td>@costCenter.Name</td>
                <td>@costCenter.Code</td>
                <td>@costCenter.ProjectName</td>
                <td>
                    <span class="badge @(costCenter.IsActive ? "bg-success" : "bg-secondary")">
                        @(costCenter.IsActive ? "Active" : "Inactive")
                    </span>
                </td>
                <td class="text-end">
                    @if (User.HasClaim(PermissionClaimTypes.Permission, PermissionNames.CostCenterManage))
                    {
                        <a asp-action="Edit" asp-route-id="@costCenter.Id" class="btn btn-sm btn-outline-secondary">Edit</a>
                        <form asp-action="ToggleActive" asp-route-id="@costCenter.Id" asp-route-isActive="@costCenter.IsActive" method="post" class="d-inline">
                            <button type="submit" class="btn btn-sm btn-outline-danger">
                                @(costCenter.IsActive ? "Deactivate" : "Activate")
                            </button>
                        </form>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>
