@model BuilderERP.Application.DTOs.UpdateCashRequisitionDto
@using BuilderERP.Domain.Enums
@{
    ViewData["Title"] = "Edit Cash Requisition";
}

@section Styles {
    <link rel="stylesheet" href="~/css/multicolumn-dropdown.css" asp-append-version="true" />
}

<h1 class="h3 mb-4">Edit Cash Requisition</h1>

<form asp-action="Edit" method="post">
    <input type="hidden" asp-for="Id" />
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
    <div class="row col-md-8">
        <div class="mb-3 col-md-4">
            <label asp-for="RequisitionNumber" class="form-label"></label>
            <input asp-for="RequisitionNumber" class="form-control" />
            <span asp-validation-for="RequisitionNumber" class="text-danger"></span>
        </div>
        <div class="mb-3 col-md-4">
            <label asp-for="RequesterEmployeeId" class="form-label"></label>
            <select asp-for="RequesterEmployeeId" asp-items="ViewBag.Employees" class="form-select">
                <option value="">-- Select Employee --</option>
            </select>
            <span asp-validation-for="RequesterEmployeeId" class="text-danger"></span>
        </div>
        <div class="mb-3 col-md-4">
            <label asp-for="PaymentMethod" class="form-label"></label>
            <select asp-for="PaymentMethod" asp-items="Html.GetEnumSelectList<PaymentMethod>()" class="form-select"></select>
        </div>
        <div class="mb-3 col-md-4">
            <label asp-for="DepartmentId" class="form-label"></label>
            <select asp-for="DepartmentId" asp-items="ViewBag.Departments" class="form-select">
                <option value="">-- Select Department --</option>
            </select>
            <span asp-validation-for="DepartmentId" class="text-danger"></span>
        </div>
        <div class="mb-3 col-md-4">
            <label asp-for="ProjectId" class="form-label"></label>
            <select asp-for="ProjectId" asp-items="ViewBag.Projects" class="form-select">
                <option value="">-- Select Project --</option>
            </select>
            <span asp-validation-for="ProjectId" class="text-danger"></span>
        </div>
        <div class="mb-3 col-md-4">
            <label asp-for="Status" class="form-label"></label>
            <select asp-for="Status" asp-items="Html.GetEnumSelectList<RequisitionStatus>()" class="form-select" disabled></select>
        </div>
        <div class="mb-3 col-md-4">
            <label asp-for="RequestDate" class="form-label"></label>
            <input asp-for="RequestDate" type="date" class="form-control" />
        </div>
        <div class="mb-3 col-md-4">
            <label asp-for="RequiredByDate" class="form-label"></label>
            <input asp-for="RequiredByDate" type="date" class="form-control" />
            <span asp-validation-for="RequiredByDate" class="text-danger"></span>
        </div>
        <div class="mb-3 col-md-8">
            <label asp-for="Description" class="form-label"></label>
            <textarea asp-for="Description" class="form-control"></textarea>
        </div>
    </div>

    <h5 class="mt-4">Line Items</h5>
    <table class="table table-sm" id="cr-details-table">
        <thead>
            <tr>
                <th style="width: 25%;">Material</th>
                <th style="width: 10%;">Qty</th>
                <th style="width: 10%;">Unit</th>
                <th style="width: 15%;">Est. Unit Price</th>
                <th style="width: 25%;">Remarks</th>
                <th style="width: 9%;"></th>
            </tr>
        </thead>
        <tbody>
            @for (var i = 0; i < Model.Details.Count; i++)
            {
                <tr class="detail-row">
                    <td>
                        <div class="multicolumn-dropdown-wrapper">
                            <div class="multicolumn-dropdown-container" id="material-existing-@i-container">
                                <input type="hidden" asp-for="Details[i].MaterialId" id="material-existing-@i" value="@Model.Details[i].MaterialId" />
                                <div class="multicolumn-dropdown-trigger">
                                    <input type="text"
                                           class="multicolumn-dropdown-filter form-control form-control-sm"
                                           placeholder="Search Material..."
                                           autocomplete="off"
                                           id="material-existing-@i-filter" />
                                    <span class="multicolumn-dropdown-icon">
                                        <i class="bi bi-chevron-down"></i>
                                    </span>
                                </div>
                                <div class="multicolumn-dropdown-menu" id="material-existing-@i-menu" style="display: none;">
                                    <div class="multicolumn-dropdown-header">
                                        <div class="multicolumn-dropdown-column">Code</div>
                                        <div class="multicolumn-dropdown-column">Name</div>
                                        <div class="multicolumn-dropdown-column">Category</div>
                                    </div>
                                    <div class="multicolumn-dropdown-items">
                                        @foreach(var material in (IEnumerable<dynamic>)ViewBag.Materials ?? new List<dynamic>())
                                        {
                                            var parts = material.Text?.Split(" | ") ?? new[] { "", "", "" };
                                            <div class="multicolumn-dropdown-item" data-value="@material.Value">
                                                <div class="multicolumn-dropdown-column">@(parts.Length > 0 ? parts[0]?.Trim() ?? "" : "")</div>
                                                <div class="multicolumn-dropdown-column">@(parts.Length > 1 ? parts[1]?.Trim() ?? "" : "")</div>
                                                <div class="multicolumn-dropdown-column">@(parts.Length > 2 ? parts[2]?.Trim() ?? "" : "")</div>
                                            </div>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    </td>
                    <td><input name="Details[@i].Quantity" type="number" step="0.001" value="@Model.Details[i].Quantity" class="form-control form-control-sm" /></td>
                    <td>
                        <select asp-for="Details[i].UnitOfMeasure" asp-items="Html.GetEnumSelectList<UnitOfMeasure>()" class="form-select form-select-sm"></select>
                    </td>
                    <td><input name="Details[@i].EstimatedUnitPrice" type="number" step="0.01" value="@Model.Details[i].EstimatedUnitPrice" class="form-control form-control-sm" /></td>
                    <td><input name="Details[@i].Remarks" value="@Model.Details[i].Remarks" class="form-control form-control-sm" /></td>
                    <td><button type="button" class="btn btn-sm btn-outline-danger" data-remove-row>Remove</button></td>
                </tr>
            }
            <tr class="detail-row-template">
                <td>
                    <div class="multicolumn-dropdown-wrapper material-dropdown-template">
                        <div class="multicolumn-dropdown-container" id="material-__index__-container">
                            <input type="hidden" name="Details[__index__].MaterialId" id="material-__index__" value="" />
                            <div class="multicolumn-dropdown-trigger">
                                <input type="text"
                                       class="multicolumn-dropdown-filter form-control form-control-sm"
                                       placeholder="Search Material..."
                                       autocomplete="off"
                                       id="material-__index__-filter" />
                                <span class="multicolumn-dropdown-icon">
                                    <i class="bi bi-chevron-down"></i>
                                </span>
                            </div>
                            <div class="multicolumn-dropdown-menu" id="material-__index__-menu" style="display: none;">
                                <div class="multicolumn-dropdown-header">
                                    <div class="multicolumn-dropdown-column">Code</div>
                                    <div class="multicolumn-dropdown-column">Name</div>
                                    <div class="multicolumn-dropdown-column">Category</div>
                                </div>
                                <div class="multicolumn-dropdown-items">
                                    @foreach(var material in (IEnumerable<dynamic>)ViewBag.Materials ?? new List<dynamic>())
                                    {
                                        var parts = material.Text?.Split(" | ") ?? new[] { "", "", "" };
                                        <div class="multicolumn-dropdown-item" data-value="@material.Value">
                                            <div class="multicolumn-dropdown-column">@(parts.Length > 0 ? parts[0]?.Trim() ?? "" : "")</div>
                                            <div class="multicolumn-dropdown-column">@(parts.Length > 1 ? parts[1]?.Trim() ?? "" : "")</div>
                                            <div class="multicolumn-dropdown-column">@(parts.Length > 2 ? parts[2]?.Trim() ?? "" : "")</div>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                </td>
                <td><input name="Details[__index__].Quantity" type="number" step="0.001" class="form-control form-control-sm" /></td>
                <td>
                    <select name="Details[__index__].UnitOfMeasure" asp-items="Html.GetEnumSelectList<UnitOfMeasure>()" class="form-select form-select-sm"></select>
                </td>
                <td><input name="Details[__index__].EstimatedUnitPrice" type="number" step="0.01" class="form-control form-control-sm" /></td>
                <td><input name="Details[__index__].Remarks" class="form-control form-control-sm" /></td>
                <td><button type="button" class="btn btn-sm btn-outline-danger" data-remove-row>Remove</button></td>
            </tr>
        </tbody>
    </table>
    <button type="button" class="btn btn-sm btn-outline-primary mb-3" data-add-row-for="cr-details-table">Add Row</button>

    <div>
        <button type="submit" class="btn btn-primary">Save</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
    </div>
</form>

<partial name="_DetailLineItemsScripts" />
<script src="~/js/multicolumn-dropdown.js" asp-append-version="true"></script>
<script>
    document.addEventListener('DOMContentLoaded', function () {
        initDetailTable('cr-details-table', 'Details');
        initializeAllDropdowns();
    });

    // Initialize material dropdowns in a specific row
    function initializeDropdownsInRow(row) {
        const containers = row.querySelectorAll('[id$="-container"]');
        containers.forEach(container => {
            if (container.id.includes('material-')) {
                new MultiColumnDropdown(container.id);
            }
        });
    }

    // Initialize all existing dropdowns
    function initializeAllDropdowns() {
        const rows = document.querySelectorAll('#cr-details-table tbody tr.detail-row');
        rows.forEach(row => {
            initializeDropdownsInRow(row);
        });
    }

    // Hook into the row addition process
    const addBtn = document.querySelector('[data-add-row-for="cr-details-table"]');
    if (addBtn) {
        addBtn.addEventListener('click', function () {
            setTimeout(() => {
                const rows = document.querySelectorAll('#cr-details-table tbody tr.detail-row');
                const lastRow = rows[rows.length - 1];
                if (lastRow) {
                    initializeDropdownsInRow(lastRow);
                }
            }, 10);
        });
    }
</script>
