@model BuilderERP.Application.DTOs.UpdatePurchaseReturnDto
@using BuilderERP.Domain.Enums
@{
    ViewData["Title"] = "Edit Purchase Return";
}

<h1 class="h3 mb-4">Edit Purchase Return</h1>

<form asp-action="Edit" method="post">
    <input type="hidden" asp-for="Id" />
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
    <div class="row col-md-8">
        <div class="mb-3 col-md-4">
            <label asp-for="ReturnNumber" class="form-label"></label>
            <input asp-for="ReturnNumber" class="form-control" />
            <span asp-validation-for="ReturnNumber" class="text-danger"></span>
        </div>
        <div class="mb-3 col-md-4">
            <label asp-for="GoodsReceiveId" class="form-label"></label>
            <select asp-for="GoodsReceiveId" asp-items="ViewBag.GoodsReceives" class="form-select" id="goodsReceiveSelect">
                <option value="">-- Select Goods Receive --</option>
            </select>
            <span asp-validation-for="GoodsReceiveId" class="text-danger"></span>
        </div>
        <div class="mb-3 col-md-4">
            <label asp-for="Status" class="form-label"></label>
            <select asp-for="Status" asp-items="Html.GetEnumSelectList<PurchaseReturnStatus>()" class="form-select"></select>
        </div>
        <div class="mb-3 col-md-4">
            <label asp-for="ReturnDate" class="form-label"></label>
            <input asp-for="ReturnDate" type="date" class="form-control" />
        </div>
        <div class="mb-3 col-md-8">
            <label asp-for="Reason" class="form-label"></label>
            <textarea asp-for="Reason" class="form-control"></textarea>
            <span asp-validation-for="Reason" class="text-danger"></span>
        </div>
    </div>

    <div class="mb-2">
        <button type="button" class="btn btn-sm btn-outline-secondary" id="loadGrnLinesBtn">Reload Received Lines from GRN</button>
    </div>

    <h5 class="mt-3">Line Items</h5>
    <table class="table table-sm" id="ret-details-table">
        <thead>
            <tr>
                <th>GRN Line</th>
                <th>Material</th>
                <th>Qty</th>
                <th>Unit</th>
                <th>Unit Price</th>
                <th>VAT %</th>
                <th>Tax %</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @for (var i = 0; i < Model.Details.Count; i++)
            {
                <tr class="detail-row">
                    <td>
                        <input type="hidden" name="Details[@i].GoodsReceiveDetailId" class="grn-detail-id" value="@Model.Details[i].GoodsReceiveDetailId" />
                        <input type="hidden" name="Details[@i].MaterialId" class="material-id" value="@Model.Details[i].MaterialId" />
                        <span class="grn-line-label text-muted small">line</span>
                    </td>
                    <td><span class="material-name"></span></td>
                    <td><input name="Details[@i].ReturnQuantity" type="number" step="0.001" value="@Model.Details[i].ReturnQuantity" class="form-control form-control-sm" /></td>
                    <td>
                        <select name="Details[@i].UnitOfMeasure" asp-items="Html.GetEnumSelectList<UnitOfMeasure>()" class="form-select form-select-sm"></select>
                    </td>
                    <td><input name="Details[@i].UnitPrice" type="number" step="0.01" value="@Model.Details[i].UnitPrice" class="form-control form-control-sm" /></td>
                    <td><input name="Details[@i].VatPercent" type="number" step="0.01" value="@Model.Details[i].VatPercent" class="form-control form-control-sm" /></td>
                    <td><input name="Details[@i].TaxPercent" type="number" step="0.01" value="@Model.Details[i].TaxPercent" class="form-control form-control-sm" /></td>
                    <td><button type="button" class="btn btn-sm btn-outline-danger" data-remove-row>Remove</button></td>
                </tr>
            }
            <tr class="detail-row-template">
                <td>
                    <input type="hidden" name="Details[__index__].GoodsReceiveDetailId" class="grn-detail-id" />
                    <input type="hidden" name="Details[__index__].MaterialId" class="material-id" />
                    <span class="grn-line-label text-muted small">-- pick from list --</span>
                </td>
                <td><span class="material-name"></span></td>
                <td><input name="Details[__index__].ReturnQuantity" type="number" step="0.001" class="form-control form-control-sm" /></td>
                <td>
                    <select name="Details[__index__].UnitOfMeasure" asp-items="Html.GetEnumSelectList<UnitOfMeasure>()" class="form-select form-select-sm"></select>
                </td>
                <td><input name="Details[__index__].UnitPrice" type="number" step="0.01" class="form-control form-control-sm" /></td>
                <td><input name="Details[__index__].VatPercent" type="number" step="0.01" value="0" class="form-control form-control-sm" /></td>
                <td><input name="Details[__index__].TaxPercent" type="number" step="0.01" value="0" class="form-control form-control-sm" /></td>
                <td><button type="button" class="btn btn-sm btn-outline-danger" data-remove-row>Remove</button></td>
            </tr>
        </tbody>
    </table>

    <div>
        <button type="submit" class="btn btn-primary">Save</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
    </div>
</form>

<partial name="_DetailLineItemsScripts" />
<script>
    document.addEventListener('DOMContentLoaded', function () {
        initDetailTable('ret-details-table', 'Details');

        document.getElementById('loadGrnLinesBtn').addEventListener('click', function () {
            var grnId = document.getElementById('goodsReceiveSelect').value;
            if (!grnId) {
                alert('Select a goods receive first.');
                return;
            }

            fetch('@Url.Action("GetReceivedLines")?goodsReceiveId=' + grnId)
                .then(function (r) { return r.json(); })
                .then(function (lines) {
                    var table = document.getElementById('ret-details-table');
                    var tbody = table.querySelector('tbody');
                    tbody.querySelectorAll('tr.detail-row').forEach(function (row) { row.remove(); });
                    var template = tbody.querySelector('tr.detail-row-template');

                    lines.forEach(function (line) {
                        var clone = template.cloneNode(true);
                        clone.classList.remove('d-none');
                        clone.classList.add('detail-row');
                        clone.querySelector('.grn-detail-id').value = line.goodsReceiveDetailId;
                        clone.querySelector('.material-id').value = line.materialId;
                        clone.querySelector('.grn-line-label').textContent = line.materialName + ' (received ' + line.receivedQuantity + ')';
                        clone.querySelector('.material-name').textContent = line.materialName;
                        clone.querySelector('input[name*="UnitPrice"]').value = line.unitPrice;
                        tbody.appendChild(clone);
                    });

                    initDetailTable('ret-details-table', 'Details');
                });
        });
    });
</script>
