@model IReadOnlyList<BuilderERP.Application.DTOs.PurchaseReturnDto>
@using BuilderERP.Shared.Constants
@using BuilderERP.Shared.Authorization
@{
    ViewData["Title"] = "Purchase Returns";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Purchase Returns</h1>
    @if (User.HasClaim(PermissionClaimTypes.Permission, PermissionNames.PurchaseReturnManage))
    {
        <a asp-action="Create" class="btn btn-primary">New Purchase Return</a>
    }
</div>

<table class="table table-striped table-hover bg-white">
    <thead>
        <tr>
            <th>Return #</th>
            <th>GRN</th>
            <th>Amount</th>
            <th>Reason</th>
            <th>Status</th>
            <th>Active</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var purchaseReturn in Model)
        {
            <tr>
                <td>@purchaseReturn.ReturnNumber</td>
                <td>@purchaseReturn.GrnNumber</td>
                <td>@purchaseReturn.ReturnAmount</td>
                <td>@purchaseReturn.Reason</td>
                <td>@purchaseReturn.Status</td>
                <td>
                    <span class="badge @(purchaseReturn.IsActive ? "bg-success" : "bg-secondary")">
                        @(purchaseReturn.IsActive ? "Active" : "Inactive")
                    </span>
                </td>
                <td class="text-end">
                    @if (User.HasClaim(PermissionClaimTypes.Permission, PermissionNames.PurchaseReturnManage))
                    {
                        <a asp-action="Edit" asp-route-id="@purchaseReturn.Id" class="btn btn-sm btn-outline-secondary">Edit</a>
                        <form asp-action="ToggleActive" asp-route-id="@purchaseReturn.Id" asp-route-isActive="@purchaseReturn.IsActive" method="post" class="d-inline">
                            <button type="submit" class="btn btn-sm btn-outline-danger">
                                @(purchaseReturn.IsActive ? "Deactivate" : "Activate")
                            </button>
                        </form>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>
