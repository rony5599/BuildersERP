@using BuilderERP.Application.Common
@using BuilderERP.Shared.Constants
@using BuilderERP.Shared.Authorization
@model PagedResult<BuilderERP.Application.DTOs.PurchaseRequisitionDto>

<table class="table table-striped table-hover bg-white">
    <thead>
        <tr>
            <th>Requisition #</th>
            <th>Department</th>
            <th>Required By</th>
            <th>Estimated Amount</th>
            <th>Status</th>
            <th>Active</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var requisition in Model.Items)
        {
            <tr>
                <td>@requisition.RequisitionNumber</td>
                <td>@requisition.DepartmentName</td>
                <td>@requisition.RequiredByDate.ToString("yyyy-MM-dd")</td>
                <td>@requisition.EstimatedAmount</td>
                <td>@requisition.Status</td>
                <td>
                    <span class="badge @(requisition.IsActive ? "bg-success" : "bg-secondary")">
                        @(requisition.IsActive ? "Active" : "Inactive")
                    </span>
                </td>
                <td class="text-end">
                    @if (User.HasClaim(PermissionClaimTypes.Permission, PermissionNames.PurchaseRequisitionManage))
                    {
                        <a asp-action="Edit" asp-route-id="@requisition.Id" class="btn btn-sm btn-outline-secondary">Edit</a>
                        <form asp-action="ToggleActive" asp-route-id="@requisition.Id" asp-route-isActive="@requisition.IsActive" method="post" class="d-inline">
                            <button type="submit" class="btn btn-sm btn-outline-danger">
                                @(requisition.IsActive ? "Deactivate" : "Activate")
                            </button>
                        </form>
                    }
                </td>
            </tr>
        }
        @if (Model.Items.Count == 0)
        {
            <tr>
                <td colspan="7" class="text-center text-muted">No purchase requisitions found.</td>
            </tr>
        }
    </tbody>
</table>

<partial name="_Pagination" model="@(new BuilderERP.Web.Models.PaginationViewModel
{
    Page = Model.Page,
    PageSize = Model.PageSize,
    TotalPages = Model.TotalPages,
    TotalCount = Model.TotalCount,
    Action = "Index",
    RouteValues = new()
})" />
