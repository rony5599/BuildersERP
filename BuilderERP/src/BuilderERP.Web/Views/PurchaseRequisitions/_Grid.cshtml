@using BuilderERP.Application.Common
@using BuilderERP.Shared.Constants
@using BuilderERP.Shared.Authorization
@using Microsoft.AspNetCore.Mvc.Rendering
@using BuilderERP.Domain.Entities
@using BuilderERP.Web.Models
@model PagedResult<BuilderERP.Application.DTOs.PurchaseRequisitionDto>
@{
    var assignment = ViewBag.ActionAssignment as PurchaseRequisitionActionAssignment;
    var requisitionNumber = ViewBag.RequisitionNumber as string;
    var projectId = ViewBag.ProjectId as long?;
    var status = ViewBag.Status as BuilderERP.Domain.Enums.RequisitionStatus?;
    var dateFrom = ViewBag.DateFrom as DateTime?;
    var dateTo = ViewBag.DateTo as DateTime?;
    var hasFilters = !string.IsNullOrWhiteSpace(requisitionNumber) || projectId.HasValue || status.HasValue || dateFrom.HasValue || dateTo.HasValue;
}

<div class="procurement-filter-card mb-4">
    <div>
        <form asp-action="Index" method="get" class="row gy-3 gx-4 align-items-end grid-search-form">
            <div class="col-12 col-sm-6 col-lg-2">
                <label class="form-label small mb-1">Requisition #</label>
                <input type="search" name="requisitionNumber" value="@requisitionNumber" class="form-control" placeholder="Requisition #" />
            </div>
            <div class="col-12 col-sm-6 col-lg-2">
                <label class="form-label small mb-1">Project</label>
                <select name="projectId" asp-items="@(ViewBag.Projects as SelectList)" class="form-select">
                    <option value="">All Projects</option>
                </select>
            </div>
            <div class="col-12 col-sm-6 col-lg-2">
                <label class="form-label small mb-1">Status</label>
                <select name="status" asp-items="@(ViewBag.Statuses as SelectList)" class="form-select">
                    <option value="">All Statuses</option>
                </select>
            </div>
            <div class="col-12 col-sm-6 col-lg-2">
                <label class="form-label small mb-1">Date From</label>
                <input type="date" name="dateFrom" value="@(dateFrom?.ToString("yyyy-MM-dd"))" class="form-control" />
            </div>
            <div class="col-12 col-sm-6 col-lg-2">
                <label class="form-label small mb-1">Date To</label>
                <input type="date" name="dateTo" value="@(dateTo?.ToString("yyyy-MM-dd"))" class="form-control" />
            </div>
            <div class="col-12 col-sm-6 col-lg-2 d-flex gap-2">
                <button type="submit" class="btn btn-primary flex-grow-1"><i class="bi bi-funnel"></i> Filter</button>
                @if (hasFilters)
                {
                    <a asp-action="Index" class="btn btn-outline-secondary flex-grow-1">Reset</a>
                }
            </div>
        </form>
    </div>
</div>

<div class="procurement-table-card">
    <div class="table-responsive">
    <table class="table procurement-table mb-0">
        <thead>
            <tr>
                <th>Requisition #</th>
                <th>Department</th>
                <th>Required By</th>
                <th>Estimated Amount</th>
                <th>Status</th>
                <th>Active</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var requisition in Model.Items)
            {
                <tr>
                    <td><a asp-action="Print" asp-route-id="@requisition.Id" target="_blank" class="document-number">@requisition.RequisitionNumber</a><span class="document-subtitle">@requisition.ProjectName</span></td>
                    <td class="fw-medium">@requisition.DepartmentName</td>
                    <td>@requisition.RequiredByDate.ToString("yyyy-MM-dd")</td>
                    <td class="amount-cell">@requisition.EstimatedAmount.ToString("N2")</td>
                    <td>
                        <span class="procurement-status @StatusBadgeClass(requisition.Status)"><span class="badge-dot"></span>@HumanizeStatus(requisition.Status)</span>
                    </td>
                    <td>
                        <span class="procurement-status @(requisition.IsActive ? "status-success" : "status-neutral")">
                            <span class="badge-dot"></span>@(requisition.IsActive ? "Active" : "Inactive")
                        </span>
                    </td>
                    <td class="text-end">
                        <div class="procurement-actions"><a asp-action="Print" asp-route-id="@requisition.Id" class="btn btn-sm btn-light" target="_blank" title="Print"><i class="bi bi-printer"></i></a>
                        @if (User.HasClaim(PermissionClaimTypes.Permission, PermissionNames.PurchaseRequisitionManage))
                        {
                            @if (assignment?.CanDraftEdit == true && requisition.Status == BuilderERP.Domain.Enums.RequisitionStatus.Draft)
                            {
                                <a asp-action="Edit" asp-route-id="@requisition.Id" class="btn btn-sm btn-light" title="Edit"><i class="bi bi-pencil"></i></a>
                            }
                            @if (assignment?.CanSubmit == true && requisition.Status == BuilderERP.Domain.Enums.RequisitionStatus.Draft)
                            {
                                <partial name="_WorkflowButton" model="@(new PurchaseRequisitionWorkflowButtonViewModel(requisition.Id, "submit", "Submit", "btn-outline-primary"))" />
                            }
                            @if (assignment?.CanRequestApproval == true && requisition.Status == BuilderERP.Domain.Enums.RequisitionStatus.Submitted)
                            {
                                <partial name="_WorkflowButton" model="@(new PurchaseRequisitionWorkflowButtonViewModel(requisition.Id, "request", "Request approval", "btn-outline-primary"))" />
                            }
                            @if (assignment?.CanApprove == true && requisition.Status == BuilderERP.Domain.Enums.RequisitionStatus.AwaitingApproval)
                            {
                                <partial name="_WorkflowButton" model="@(new PurchaseRequisitionWorkflowButtonViewModel(requisition.Id, "approve", "Approve", "btn-success"))" />
                            }
                            @if (assignment?.CanReject == true && requisition.Status == BuilderERP.Domain.Enums.RequisitionStatus.AwaitingApproval)
                            {
                                <partial name="_WorkflowButton" model="@(new PurchaseRequisitionWorkflowButtonViewModel(requisition.Id, "reject", "Reject", "btn-outline-danger"))" />
                            }
                            @if (assignment?.CanCancel == true && requisition.Status is BuilderERP.Domain.Enums.RequisitionStatus.Draft or BuilderERP.Domain.Enums.RequisitionStatus.Submitted or BuilderERP.Domain.Enums.RequisitionStatus.AwaitingApproval or BuilderERP.Domain.Enums.RequisitionStatus.Rejected)
                            {
                                <partial name="_WorkflowButton" model="@(new PurchaseRequisitionWorkflowButtonViewModel(requisition.Id, "cancel", "Cancel", "btn-outline-danger"))" />
                            }
                            <form asp-action="ToggleActive" asp-route-id="@requisition.Id" asp-route-isActive="@requisition.IsActive" method="post" class="d-inline">
                                <button type="submit" class="btn btn-sm btn-light @(requisition.IsActive ? "text-danger" : "text-success")" title="@(requisition.IsActive ? "Deactivate" : "Activate")">
                                    <i class="bi @(requisition.IsActive ? "bi-pause-circle" : "bi-play-circle")"></i>
                                </button>
                            </form>
                        }
                        </div>
                    </td>
                </tr>
            }
            @if (Model.Items.Count == 0)
            {
                <tr>
                    <td colspan="7" class="procurement-empty"><i class="bi bi-inbox"></i><strong>No purchase requisitions found</strong><span>Try adjusting the filters or create a new requisition.</span></td>
                </tr>
            }
        </tbody>
    </table>
    </div>
    <div class="procurement-pagination">
        <partial name="_Pagination" model="@(new BuilderERP.Web.Models.PaginationViewModel
        {
            Page = Model.Page,
            PageSize = Model.PageSize,
            TotalPages = Model.TotalPages,
            TotalCount = Model.TotalCount,
            Action = "Index",
            RouteValues = BuildFilterRouteValues(requisitionNumber, projectId, status, dateFrom, dateTo)
        })" />
    </div>
</div>

@functions {
    private static Dictionary<string, string?> BuildFilterRouteValues(string? requisitionNumber, long? projectId, BuilderERP.Domain.Enums.RequisitionStatus? status, DateTime? dateFrom, DateTime? dateTo)
    {
        var values = new Dictionary<string, string?>();
        if (!string.IsNullOrWhiteSpace(requisitionNumber)) values["requisitionNumber"] = requisitionNumber;
        if (projectId.HasValue) values["projectId"] = projectId.Value.ToString();
        if (status.HasValue) values["status"] = status.Value.ToString();
        if (dateFrom.HasValue) values["dateFrom"] = dateFrom.Value.ToString("yyyy-MM-dd");
        if (dateTo.HasValue) values["dateTo"] = dateTo.Value.ToString("yyyy-MM-dd");
        return values;
    }

    private static string StatusBadgeClass(BuilderERP.Domain.Enums.RequisitionStatus status) => status switch
    {
        BuilderERP.Domain.Enums.RequisitionStatus.Draft => "status-neutral",
        BuilderERP.Domain.Enums.RequisitionStatus.Submitted => "status-warning",
        BuilderERP.Domain.Enums.RequisitionStatus.AwaitingApproval => "status-warning",
        BuilderERP.Domain.Enums.RequisitionStatus.Approved => "status-success",
        BuilderERP.Domain.Enums.RequisitionStatus.Rejected => "status-danger",
        BuilderERP.Domain.Enums.RequisitionStatus.Converted => "status-info",
        BuilderERP.Domain.Enums.RequisitionStatus.Cancelled => "status-danger",
        _ => "status-neutral"
    };

    private static string HumanizeStatus(BuilderERP.Domain.Enums.RequisitionStatus status) =>
        status == BuilderERP.Domain.Enums.RequisitionStatus.AwaitingApproval ? "Awaiting Approval" : status.ToString();
}
