@using BuilderERP.Application.Common
@using BuilderERP.Shared.Constants
@using BuilderERP.Shared.Authorization
@model PagedResult<BuilderERP.Application.DTOs.InquiryDto>

<table class="table table-striped table-hover bg-white">
    <thead>
        <tr>
            <th>Lead</th>
            <th>Property Unit</th>
            <th>Message</th>
            <th>Date</th>
            <th>Active</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var inquiry in Model.Items)
        {
            <tr>
                <td>@inquiry.LeadName</td>
                <td>@inquiry.PropertyUnitNumber</td>
                <td>@inquiry.Message</td>
                <td>@inquiry.InquiryDate.ToString("yyyy-MM-dd")</td>
                <td>
                    <span class="badge @(inquiry.IsActive ? "bg-success" : "bg-secondary")">
                        @(inquiry.IsActive ? "Active" : "Inactive")
                    </span>
                </td>
                <td class="text-end">
                    @if (User.HasClaim(PermissionClaimTypes.Permission, PermissionNames.InquiryManage))
                    {
                        <a asp-action="Edit" asp-route-id="@inquiry.Id" class="btn btn-sm btn-outline-secondary">Edit</a>
                        <form asp-action="ToggleActive" asp-route-id="@inquiry.Id" asp-route-isActive="@inquiry.IsActive" method="post" class="d-inline">
                            <button type="submit" class="btn btn-sm btn-outline-danger">
                                @(inquiry.IsActive ? "Deactivate" : "Activate")
                            </button>
                        </form>
                    }
                </td>
            </tr>
        }
        @if (Model.Items.Count == 0)
        {
            <tr>
                <td colspan="6" class="text-center text-muted">No inquiries found.</td>
            </tr>
        }
    </tbody>
</table>

<partial name="_Pagination" model="@(new BuilderERP.Web.Models.PaginationViewModel
{
    Page = Model.Page,
    PageSize = Model.PageSize,
    TotalPages = Model.TotalPages,
    TotalCount = Model.TotalCount,
    Action = "Index",
    RouteValues = new()
})" />
