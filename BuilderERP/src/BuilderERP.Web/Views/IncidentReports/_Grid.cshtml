@using BuilderERP.Application.Common
@using BuilderERP.Domain.Enums
@using BuilderERP.Shared.Constants
@using BuilderERP.Shared.Authorization
@model PagedResult<BuilderERP.Application.DTOs.IncidentReportDto>

<table class="table table-striped table-hover bg-white">
    <thead>
        <tr>
            <th>Project</th>
            <th>Incident Date</th>
            <th>Reported By</th>
            <th>Description</th>
            <th>Severity</th>
            <th>Status</th>
            <th>Active</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var report in Model.Items)
        {
            <tr>
                <td>@report.ProjectName</td>
                <td>@report.IncidentDate.ToString("yyyy-MM-dd")</td>
                <td>@report.ReportedBy</td>
                <td>@(report.Description.Length > 60 ? report.Description.Substring(0, 60) + "..." : report.Description)</td>
                <td>
                    @{
                        var severityBadge = report.Severity switch
                        {
                            IncidentSeverity.Minor => "bg-info",
                            IncidentSeverity.Major => "bg-warning",
                            IncidentSeverity.Critical => "bg-danger",
                            IncidentSeverity.Fatal => "bg-dark",
                            _ => "bg-secondary"
                        };
                    }
                    <span class="badge @severityBadge">@report.Severity</span>
                </td>
                <td>
                    @{
                        var statusBadge = report.Status switch
                        {
                            IncidentStatus.Reported => "bg-danger",
                            IncidentStatus.UnderInvestigation => "bg-warning",
                            IncidentStatus.Closed => "bg-success",
                            _ => "bg-secondary"
                        };
                    }
                    <span class="badge @statusBadge">@report.Status</span>
                </td>
                <td>
                    <span class="badge @(report.IsActive ? "bg-success" : "bg-secondary")">
                        @(report.IsActive ? "Active" : "Inactive")
                    </span>
                </td>
                <td class="text-end">
                    @if (User.HasClaim(PermissionClaimTypes.Permission, PermissionNames.IncidentReportManage))
                    {
                        <a asp-action="Edit" asp-route-id="@report.Id" class="btn btn-sm btn-outline-secondary">Edit</a>
                        <form asp-action="ToggleActive" asp-route-id="@report.Id" asp-route-isActive="@report.IsActive" method="post" class="d-inline">
                            <button type="submit" class="btn btn-sm btn-outline-danger">
                                @(report.IsActive ? "Deactivate" : "Activate")
                            </button>
                        </form>
                    }
                </td>
            </tr>
        }
        @if (Model.Items.Count == 0)
        {
            <tr>
                <td colspan="8" class="text-center text-muted">No incident reports found.</td>
            </tr>
        }
    </tbody>
</table>

<partial name="_Pagination" model="@(new BuilderERP.Web.Models.PaginationViewModel
{
    Page = Model.Page,
    PageSize = Model.PageSize,
    TotalPages = Model.TotalPages,
    TotalCount = Model.TotalCount,
    Action = "Index",
    RouteValues = new()
})" />
