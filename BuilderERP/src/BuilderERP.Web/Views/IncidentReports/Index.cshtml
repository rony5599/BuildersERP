@using BuilderERP.Application.Common
@model PagedResult<BuilderERP.Application.DTOs.IncidentReportDto>
@using BuilderERP.Domain.Enums
@using BuilderERP.Shared.Constants
@using BuilderERP.Shared.Authorization
@{
    ViewData["Title"] = "Incident Reports";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Incident Reports</h1>
    @if (User.HasClaim(PermissionClaimTypes.Permission, PermissionNames.IncidentReportManage))
    {
        <a asp-action="Create" class="btn btn-primary">New Incident Report</a>
    }
</div>

<div data-grid-container>
    <partial name="_Grid" model="Model" />
</div>
