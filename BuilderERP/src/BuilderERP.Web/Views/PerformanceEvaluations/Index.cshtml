@model IReadOnlyList<BuilderERP.Application.DTOs.PerformanceEvaluationDto>
@using BuilderERP.Shared.Constants
@using BuilderERP.Shared.Authorization
@{
    ViewData["Title"] = "Performance Evaluations";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Performance Evaluations</h1>
    @if (User.HasClaim(PermissionClaimTypes.Permission, PermissionNames.PerformanceEvaluationManage))
    {
        <a asp-action="Create" class="btn btn-primary">New Performance Evaluation</a>
    }
</div>

<table class="table table-striped table-hover bg-white">
    <thead>
        <tr>
            <th>Contractor</th>
            <th>Project</th>
            <th>Evaluation Date</th>
            <th>Quality</th>
            <th>Timeliness</th>
            <th>Safety</th>
            <th>Overall Score</th>
            <th>Active</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var evaluation in Model)
        {
            <tr>
                <td>@evaluation.ContractorName</td>
                <td>@(evaluation.ProjectName ?? "—")</td>
                <td>@evaluation.EvaluationDate.ToString("yyyy-MM-dd")</td>
                <td>@evaluation.QualityScore</td>
                <td>@evaluation.TimelinessScore</td>
                <td>@evaluation.SafetyScore</td>
                <td><strong>@evaluation.OverallScore.ToString("0.00") / 5</strong></td>
                <td>
                    <span class="badge @(evaluation.IsActive ? "bg-success" : "bg-secondary")">
                        @(evaluation.IsActive ? "Active" : "Inactive")
                    </span>
                </td>
                <td class="text-end">
                    @if (User.HasClaim(PermissionClaimTypes.Permission, PermissionNames.PerformanceEvaluationManage))
                    {
                        <a asp-action="Edit" asp-route-id="@evaluation.Id" class="btn btn-sm btn-outline-secondary">Edit</a>
                        <form asp-action="ToggleActive" asp-route-id="@evaluation.Id" asp-route-isActive="@evaluation.IsActive" method="post" class="d-inline">
                            <button type="submit" class="btn btn-sm btn-outline-danger">
                                @(evaluation.IsActive ? "Deactivate" : "Activate")
                            </button>
                        </form>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>
