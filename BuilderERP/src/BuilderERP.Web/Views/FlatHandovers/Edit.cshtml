@model BuilderERP.Application.DTOs.UpdateFlatHandoverDto
@using BuilderERP.Domain.Enums
@{
    ViewData["Title"] = "Edit Flat Handover";
}

<h1 class="h3 mb-4">Edit Flat Handover</h1>

<form asp-action="Edit" method="post" class="col-md-6">
    <input type="hidden" asp-for="Id" />
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
    <div class="mb-3">
        <label asp-for="PropertyUnitId" class="form-label">Property Unit</label>
        <select asp-for="PropertyUnitId" asp-items="ViewBag.PropertyUnits" class="form-select">
            <option value="">-- Select Property Unit --</option>
        </select>
        <span asp-validation-for="PropertyUnitId" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="CustomerId" class="form-label">Customer</label>
        <select asp-for="CustomerId" asp-items="ViewBag.Customers" class="form-select">
            <option value="">-- Select Customer --</option>
        </select>
        <span asp-validation-for="CustomerId" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="HandoverNumber" class="form-label"></label>
        <input asp-for="HandoverNumber" class="form-control" />
        <span asp-validation-for="HandoverNumber" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="HandoverDate" class="form-label"></label>
        <input asp-for="HandoverDate" type="date" class="form-control" />
        <span asp-validation-for="HandoverDate" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="KeyIssuedTo" class="form-label"></label>
        <input asp-for="KeyIssuedTo" class="form-control" />
        <span asp-validation-for="KeyIssuedTo" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Status" class="form-label"></label>
        <select asp-for="Status" asp-items="Html.GetEnumSelectList<HandoverStatus>()" class="form-select"></select>
        <span asp-validation-for="Status" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Remarks" class="form-label"></label>
        <textarea asp-for="Remarks" class="form-control"></textarea>
        <span asp-validation-for="Remarks" class="text-danger"></span>
    </div>
    <button type="submit" class="btn btn-primary">Save</button>
    <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
</form>
