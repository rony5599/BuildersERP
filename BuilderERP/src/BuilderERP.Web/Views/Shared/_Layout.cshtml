<!DOCTYPE html>
<html lang="en">
@using BuilderERP.Shared.Constants
@using BuilderERP.Shared.Authorization
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - BuilderERP</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    @if (User.Identity?.IsAuthenticated == true)
    {
        <div class="d-flex" id="app-shell">
            <nav class="sidebar bg-dark text-white p-3">
                <a class="d-flex align-items-center mb-4 text-white text-decoration-none" asp-controller="Home" asp-action="Index">
                    <span class="fs-5 fw-semibold">BuilderERP</span>
                </a>
                <ul class="nav nav-pills flex-column mb-auto">
                    <li class="nav-item">
                        <a asp-controller="Home" asp-action="Index" class="nav-link text-white">Dashboard</a>
                    </li>
                </ul>
                @if (User.HasClaim(PermissionClaimTypes.Permission, PermissionNames.CompanyView)
                    || User.HasClaim(PermissionClaimTypes.Permission, PermissionNames.BranchView)
                    || User.HasClaim(PermissionClaimTypes.Permission, PermissionNames.DepartmentView)
                    || User.HasClaim(PermissionClaimTypes.Permission, PermissionNames.ProjectView)
                    || User.HasClaim(PermissionClaimTypes.Permission, PermissionNames.CostCenterView)
                    || User.HasClaim(PermissionClaimTypes.Permission, PermissionNames.UserView)
                    || User.HasClaim(PermissionClaimTypes.Permission, PermissionNames.RoleView))
                {
                    <div class="text-uppercase small text-white-50 mt-4 mb-2 px-2">Administration</div>
                    <ul class="nav nav-pills flex-column mb-auto">
                        @if (User.HasClaim(PermissionClaimTypes.Permission, PermissionNames.CompanyView))
                        {
                            <li class="nav-item"><a asp-controller="Companies" asp-action="Index" class="nav-link text-white">Companies</a></li>
                        }
                        @if (User.HasClaim(PermissionClaimTypes.Permission, PermissionNames.BranchView))
                        {
                            <li class="nav-item"><a asp-controller="Branches" asp-action="Index" class="nav-link text-white">Branches</a></li>
                        }
                        @if (User.HasClaim(PermissionClaimTypes.Permission, PermissionNames.DepartmentView))
                        {
                            <li class="nav-item"><a asp-controller="Departments" asp-action="Index" class="nav-link text-white">Departments</a></li>
                        }
                        @if (User.HasClaim(PermissionClaimTypes.Permission, PermissionNames.ProjectView))
                        {
                            <li class="nav-item"><a asp-controller="Projects" asp-action="Index" class="nav-link text-white">Projects</a></li>
                        }
                        @if (User.HasClaim(PermissionClaimTypes.Permission, PermissionNames.CostCenterView))
                        {
                            <li class="nav-item"><a asp-controller="CostCenters" asp-action="Index" class="nav-link text-white">Cost Centers</a></li>
                        }
                        @if (User.HasClaim(PermissionClaimTypes.Permission, PermissionNames.UserView))
                        {
                            <li class="nav-item"><a asp-controller="Users" asp-action="Index" class="nav-link text-white">Users</a></li>
                        }
                        @if (User.HasClaim(PermissionClaimTypes.Permission, PermissionNames.RoleView))
                        {
                            <li class="nav-item"><a asp-controller="Roles" asp-action="Index" class="nav-link text-white">Roles</a></li>
                        }
                    </ul>
                }
                @if (User.HasClaim(PermissionClaimTypes.Permission, PermissionNames.BuildingView)
                    || User.HasClaim(PermissionClaimTypes.Permission, PermissionNames.TowerView)
                    || User.HasClaim(PermissionClaimTypes.Permission, PermissionNames.FloorView)
                    || User.HasClaim(PermissionClaimTypes.Permission, PermissionNames.PropertyUnitView))
                {
                    <div class="text-uppercase small text-white-50 mt-4 mb-2 px-2">Property Management</div>
                    <ul class="nav nav-pills flex-column mb-auto">
                        @if (User.HasClaim(PermissionClaimTypes.Permission, PermissionNames.BuildingView))
                        {
                            <li class="nav-item"><a asp-controller="Buildings" asp-action="Index" class="nav-link text-white">Buildings</a></li>
                        }
                        @if (User.HasClaim(PermissionClaimTypes.Permission, PermissionNames.TowerView))
                        {
                            <li class="nav-item"><a asp-controller="Towers" asp-action="Index" class="nav-link text-white">Towers</a></li>
                        }
                        @if (User.HasClaim(PermissionClaimTypes.Permission, PermissionNames.FloorView))
                        {
                            <li class="nav-item"><a asp-controller="Floors" asp-action="Index" class="nav-link text-white">Floors</a></li>
                        }
                        @if (User.HasClaim(PermissionClaimTypes.Permission, PermissionNames.PropertyUnitView))
                        {
                            <li class="nav-item"><a asp-controller="PropertyUnits" asp-action="Index" class="nav-link text-white">Property Units</a></li>
                        }
                    </ul>
                }
                @if (User.HasClaim(PermissionClaimTypes.Permission, PermissionNames.LeadView)
                    || User.HasClaim(PermissionClaimTypes.Permission, PermissionNames.InquiryView)
                    || User.HasClaim(PermissionClaimTypes.Permission, PermissionNames.FollowUpView)
                    || User.HasClaim(PermissionClaimTypes.Permission, PermissionNames.CustomerView))
                {
                    <div class="text-uppercase small text-white-50 mt-4 mb-2 px-2">CRM</div>
                    <ul class="nav nav-pills flex-column mb-auto">
                        @if (User.HasClaim(PermissionClaimTypes.Permission, PermissionNames.LeadView))
                        {
                            <li class="nav-item"><a asp-controller="Leads" asp-action="Index" class="nav-link text-white">Leads</a></li>
                        }
                        @if (User.HasClaim(PermissionClaimTypes.Permission, PermissionNames.InquiryView))
                        {
                            <li class="nav-item"><a asp-controller="Inquiries" asp-action="Index" class="nav-link text-white">Inquiries</a></li>
                        }
                        @if (User.HasClaim(PermissionClaimTypes.Permission, PermissionNames.FollowUpView))
                        {
                            <li class="nav-item"><a asp-controller="FollowUps" asp-action="Index" class="nav-link text-white">Follow-ups</a></li>
                        }
                        @if (User.HasClaim(PermissionClaimTypes.Permission, PermissionNames.CustomerView))
                        {
                            <li class="nav-item"><a asp-controller="Customers" asp-action="Index" class="nav-link text-white">Customers</a></li>
                        }
                    </ul>
                }
                @if (User.HasClaim(PermissionClaimTypes.Permission, PermissionNames.QuotationView)
                    || User.HasClaim(PermissionClaimTypes.Permission, PermissionNames.BookingView)
                    || User.HasClaim(PermissionClaimTypes.Permission, PermissionNames.SaleAgreementView))
                {
                    <div class="text-uppercase small text-white-50 mt-4 mb-2 px-2">Sales</div>
                    <ul class="nav nav-pills flex-column mb-auto">
                        @if (User.HasClaim(PermissionClaimTypes.Permission, PermissionNames.QuotationView))
                        {
                            <li class="nav-item"><a asp-controller="Quotations" asp-action="Index" class="nav-link text-white">Quotations</a></li>
                        }
                        @if (User.HasClaim(PermissionClaimTypes.Permission, PermissionNames.BookingView))
                        {
                            <li class="nav-item"><a asp-controller="Bookings" asp-action="Index" class="nav-link text-white">Bookings</a></li>
                        }
                        @if (User.HasClaim(PermissionClaimTypes.Permission, PermissionNames.SaleAgreementView))
                        {
                            <li class="nav-item"><a asp-controller="SaleAgreements" asp-action="Index" class="nav-link text-white">Sale Agreements</a></li>
                        }
                    </ul>
                }
                @if (User.HasClaim(PermissionClaimTypes.Permission, PermissionNames.InstallmentPlanView)
                    || User.HasClaim(PermissionClaimTypes.Permission, PermissionNames.InstallmentView)
                    || User.HasClaim(PermissionClaimTypes.Permission, PermissionNames.ReceiptView))
                {
                    <div class="text-uppercase small text-white-50 mt-4 mb-2 px-2">Installments</div>
                    <ul class="nav nav-pills flex-column mb-auto">
                        @if (User.HasClaim(PermissionClaimTypes.Permission, PermissionNames.InstallmentPlanView))
                        {
                            <li class="nav-item"><a asp-controller="InstallmentPlans" asp-action="Index" class="nav-link text-white">Installment Plans</a></li>
                        }
                        @if (User.HasClaim(PermissionClaimTypes.Permission, PermissionNames.InstallmentView))
                        {
                            <li class="nav-item"><a asp-controller="Installments" asp-action="Index" class="nav-link text-white">Installments</a></li>
                        }
                        @if (User.HasClaim(PermissionClaimTypes.Permission, PermissionNames.ReceiptView))
                        {
                            <li class="nav-item"><a asp-controller="Receipts" asp-action="Index" class="nav-link text-white">Receipts</a></li>
                        }
                    </ul>
                }
                @if (User.HasClaim(PermissionClaimTypes.Permission, PermissionNames.SupplierView)
                    || User.HasClaim(PermissionClaimTypes.Permission, PermissionNames.PurchaseRequisitionView)
                    || User.HasClaim(PermissionClaimTypes.Permission, PermissionNames.RfqView)
                    || User.HasClaim(PermissionClaimTypes.Permission, PermissionNames.VendorQuotationView)
                    || User.HasClaim(PermissionClaimTypes.Permission, PermissionNames.PurchaseOrderView)
                    || User.HasClaim(PermissionClaimTypes.Permission, PermissionNames.GoodsReceiveView)
                    || User.HasClaim(PermissionClaimTypes.Permission, PermissionNames.PurchaseReturnView))
                {
                    <div class="text-uppercase small text-white-50 mt-4 mb-2 px-2">Procurement</div>
                    <ul class="nav nav-pills flex-column mb-auto">
                        @if (User.HasClaim(PermissionClaimTypes.Permission, PermissionNames.SupplierView))
                        {
                            <li class="nav-item"><a asp-controller="Suppliers" asp-action="Index" class="nav-link text-white">Suppliers</a></li>
                        }
                        @if (User.HasClaim(PermissionClaimTypes.Permission, PermissionNames.PurchaseRequisitionView))
                        {
                            <li class="nav-item"><a asp-controller="PurchaseRequisitions" asp-action="Index" class="nav-link text-white">Purchase Requisitions</a></li>
                        }
                        @if (User.HasClaim(PermissionClaimTypes.Permission, PermissionNames.RfqView))
                        {
                            <li class="nav-item"><a asp-controller="Rfqs" asp-action="Index" class="nav-link text-white">RFQs</a></li>
                        }
                        @if (User.HasClaim(PermissionClaimTypes.Permission, PermissionNames.VendorQuotationView))
                        {
                            <li class="nav-item"><a asp-controller="VendorQuotations" asp-action="Index" class="nav-link text-white">Vendor Quotations</a></li>
                        }
                        @if (User.HasClaim(PermissionClaimTypes.Permission, PermissionNames.PurchaseOrderView))
                        {
                            <li class="nav-item"><a asp-controller="PurchaseOrders" asp-action="Index" class="nav-link text-white">Purchase Orders</a></li>
                        }
                        @if (User.HasClaim(PermissionClaimTypes.Permission, PermissionNames.GoodsReceiveView))
                        {
                            <li class="nav-item"><a asp-controller="GoodsReceives" asp-action="Index" class="nav-link text-white">Goods Receives</a></li>
                        }
                        @if (User.HasClaim(PermissionClaimTypes.Permission, PermissionNames.PurchaseReturnView))
                        {
                            <li class="nav-item"><a asp-controller="PurchaseReturns" asp-action="Index" class="nav-link text-white">Purchase Returns</a></li>
                        }
                    </ul>
                }
            </nav>
            <div class="flex-grow-1">
                <header class="topbar d-flex justify-content-end align-items-center border-bottom bg-white px-3 py-2">
                    <partial name="_LoginPartial" />
                </header>
                <main role="main" class="p-4">
                    @RenderBody()
                </main>
            </div>
        </div>
    }
    else
    {
        <main role="main">
            @RenderBody()
        </main>
    }

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
