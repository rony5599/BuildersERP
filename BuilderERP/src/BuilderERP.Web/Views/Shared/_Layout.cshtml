                    </div>
                }
                @if (User.HasClaim(PermissionClaimTypes.Permission, PermissionNames.DashboardView))
                {
                    <div class="nav-section">
                        <button type="button" class="nav-section-title">Dashboard &amp; Analytics<i class="bi bi-chevron-down nav-section-caret"></i></button>
                        <ul class="nav flex-column mb-0 nav-section-body">
                        <li class="nav-item"><a asp-controller="Dashboard" asp-action="Index" class="@NavClass("Dashboard")"><i class="bi bi-speedometer2"></i> Management Dashboard</a></li>
                    </ul>
                    </div>
                }
                @if (User.HasClaim(PermissionClaimTypes.Permission, PermissionNames.ReportView))
                {
                    <div class="nav-section">
                        <button type="button" class="nav-section-title">Reports<i class="bi bi-chevron-down nav-section-caret"></i></button>
                        <ul class="nav flex-column mb-0 nav-section-body">
                        <li class="nav-item"><a asp-controller="Reports" asp-action="Index" class="@NavClass("Reports")"><i class="bi bi-file-earmark-bar-graph"></i> Report Catalog</a></li>
                    </ul>
                    </div>
                }
                @if (User.HasClaim(PermissionClaimTypes.Permission, PermissionNames.AuditTrailView))
                {
                    <div class="nav-section">
                        <button type="button" class="nav-section-title">Audit<i class="bi bi-chevron-down nav-section-caret"></i></button>
                        <ul class="nav flex-column mb-0 nav-section-body">
                        <li class="nav-item"><a asp-controller="AuditTrail" asp-action="Index" class="@NavClass("AuditTrail")"><i class="bi bi-clock-history"></i> Audit Trail</a></li>
                    </ul>
                    </div>
                }
            </nav>

            <div class="app-content">
                <main role="main" class="app-content-inner">
                    @RenderBody()
                </main>
            </div>
        </div>
    }
    else
    {
        <main role="main">
            @RenderBody()
        </main>
    }

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/pagination-ajax.js" asp-append-version="true"></script>
    <script>
        (function () {
            var toggle = document.getElementById('sidebarToggle');
            var shell = document.getElementById('app-shell');
            if (toggle && shell) {
                toggle.addEventListener('click', function () {
                    shell.classList.toggle('sidebar-collapsed');
                });
            }
        })();

        (function () {
            var sidebar = document.querySelector('.app-sidebar');
            if (!sidebar) return;
            var storageKey = 'sidebarScrollTop';

            var savedScroll = sessionStorage.getItem(storageKey);
            if (savedScroll !== null) {
                sidebar.scrollTop = parseInt(savedScroll, 10) || 0;
            }

            sidebar.addEventListener('click', function (e) {
                var link = e.target.closest('a');
                if (link) {
                    sessionStorage.setItem(storageKey, sidebar.scrollTop);
                }
            });

            sidebar.addEventListener('scroll', function () {
                sessionStorage.setItem(storageKey, sidebar.scrollTop);
            });
        })();

        (function () {
            var sidebar = document.querySelector('.app-sidebar');
            if (!sidebar) return;
            var sections = Array.prototype.slice.call(sidebar.querySelectorAll('.nav-section'));
            if (!sections.length) return;
            var storageKey = 'sidebarOpenSections';

            var openTitles;
            try {
                openTitles = JSON.parse(sessionStorage.getItem(storageKey) || '[]');
            } catch (e) {
                openTitles = [];
            }

            function titleOf(section) {
                return section.querySelector('.nav-section-title').textContent.trim();
            }

            function saveState() {
                var open = sections
                    .filter(function (s) { return !s.classList.contains('collapsed'); })
                    .map(titleOf);
                sessionStorage.setItem(storageKey, JSON.stringify(open));
            }

            sections.forEach(function (section) {
                var hasActive = !!section.querySelector('.nav-link.active');
                var wasOpen = openTitles.indexOf(titleOf(section)) !== -1;
                var hasSavedState = sessionStorage.getItem(storageKey) !== null;

                var shouldOpen = hasActive || (hasSavedState ? wasOpen : false);
                section.classList.toggle('collapsed', !shouldOpen);

                section.querySelector('.nav-section-title').addEventListener('click', function () {
                    section.classList.toggle('collapsed');
                    saveState();
                });
            });

            saveState();
        })();
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
