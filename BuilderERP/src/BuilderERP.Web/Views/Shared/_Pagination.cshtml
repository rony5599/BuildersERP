@model BuilderERP.Web.Models.PaginationViewModel
@{
    var window = 2;
    var start = Math.Max(1, Model.Page - window);
    var end = Math.Min(Model.TotalPages, Model.Page + window);
}
<div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mt-2">
    <p class="text-muted small mb-0">@Model.TotalCount total record(s).</p>
    @if (Model.TotalPages > 1)
    {
        <nav aria-label="Page navigation">
            <ul class="pagination pagination-ajax mb-0">
                <li class="page-item @(Model.Page <= 1 ? "disabled" : "")">
                    <a class="page-link" asp-action="@Model.Action" asp-all-route-data="@PaginationHelper.RouteFor(Model, Model.Page - 1)" aria-label="Previous">&laquo;</a>
                </li>
                @if (start > 1)
                {
                    <li class="page-item"><a class="page-link" asp-action="@Model.Action" asp-all-route-data="@PaginationHelper.RouteFor(Model, 1)">1</a></li>
                    if (start > 2)
                    {
                        <li class="page-item disabled"><span class="page-link">&hellip;</span></li>
                    }
                }
                @for (var p = start; p <= end; p++)
                {
                    <li class="page-item @(p == Model.Page ? "active" : "")">
                        <a class="page-link" asp-action="@Model.Action" asp-all-route-data="@PaginationHelper.RouteFor(Model, p)">@p</a>
                    </li>
                }
                @if (end < Model.TotalPages)
                {
                    if (end < Model.TotalPages - 1)
                    {
                        <li class="page-item disabled"><span class="page-link">&hellip;</span></li>
                    }
                    <li class="page-item"><a class="page-link" asp-action="@Model.Action" asp-all-route-data="@PaginationHelper.RouteFor(Model, Model.TotalPages)">@Model.TotalPages</a></li>
                }
                <li class="page-item @(Model.Page >= Model.TotalPages ? "disabled" : "")">
                    <a class="page-link" asp-action="@Model.Action" asp-all-route-data="@PaginationHelper.RouteFor(Model, Model.Page + 1)" aria-label="Next">&raquo;</a>
                </li>
            </ul>
        </nav>
    }
</div>

@functions {
    private static class PaginationHelper
    {
        public static Dictionary<string, string?> RouteFor(BuilderERP.Web.Models.PaginationViewModel model, int page)
        {
            var values = new Dictionary<string, string?>(model.RouteValues)
            {
                ["page"] = page.ToString(),
                ["pageSize"] = model.PageSize.ToString()
            };
            return values;
        }
    }
}
