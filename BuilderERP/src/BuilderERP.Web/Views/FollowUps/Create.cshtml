@model BuilderERP.Application.DTOs.CreateFollowUpDto
@using BuilderERP.Domain.Enums
@{
    ViewData["Title"] = "New Follow Up";
}

<h1 class="h3 mb-4">New Follow Up</h1>

<form asp-action="Create" method="post" class="col-md-6">
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
    <div class="mb-3">
        <label asp-for="LeadId" class="form-label"></label>
        <select asp-for="LeadId" asp-items="ViewBag.Leads" class="form-select">
            <option value="">-- Select Lead --</option>
        </select>
        <span asp-validation-for="LeadId" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="FollowUpDate" class="form-label"></label>
        <input asp-for="FollowUpDate" type="date" class="form-control" />
    </div>
    <div class="mb-3">
        <label asp-for="NextFollowUpDate" class="form-label"></label>
        <input asp-for="NextFollowUpDate" type="date" class="form-control" />
    </div>
    <div class="mb-3">
        <label asp-for="Outcome" class="form-label"></label>
        <select asp-for="Outcome" asp-items="Html.GetEnumSelectList<FollowUpOutcome>()" class="form-select">
            <option value="">-- Not set --</option>
        </select>
    </div>
    <div class="mb-3">
        <label asp-for="Notes" class="form-label"></label>
        <textarea asp-for="Notes" class="form-control"></textarea>
    </div>
    <button type="submit" class="btn btn-primary">Save</button>
    <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
</form>
