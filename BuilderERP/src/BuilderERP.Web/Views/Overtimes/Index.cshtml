@model IReadOnlyList<BuilderERP.Application.DTOs.OvertimeDto>
@using BuilderERP.Shared.Constants
@using BuilderERP.Shared.Authorization
@{
    ViewData["Title"] = "Overtime";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Overtime</h1>
    @if (User.HasClaim(PermissionClaimTypes.Permission, PermissionNames.OvertimeManage))
    {
        <a asp-action="Create" class="btn btn-primary">New Overtime</a>
    }
</div>

<table class="table table-striped table-hover bg-white">
    <thead>
        <tr>
            <th>Worker</th>
            <th>Project</th>
            <th>Overtime Date</th>
            <th>Hours</th>
            <th>Rate/Hour</th>
            <th>Amount</th>
            <th>Active</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.WorkerName</td>
                <td>@(string.IsNullOrEmpty(item.ProjectName) ? "—" : item.ProjectName)</td>
                <td>@item.OvertimeDate.ToString("yyyy-MM-dd")</td>
                <td>@item.Hours</td>
                <td>@item.RatePerHour</td>
                <td><strong>@item.Amount.ToString("C")</strong></td>
                <td>
                    <span class="badge @(item.IsActive ? "bg-success" : "bg-secondary")">
                        @(item.IsActive ? "Active" : "Inactive")
                    </span>
                </td>
                <td class="text-end">
                    @if (User.HasClaim(PermissionClaimTypes.Permission, PermissionNames.OvertimeManage))
                    {
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">Edit</a>
                        <form asp-action="ToggleActive" asp-route-id="@item.Id" asp-route-isActive="@item.IsActive" method="post" class="d-inline">
                            <button type="submit" class="btn btn-sm btn-outline-danger">
                                @(item.IsActive ? "Deactivate" : "Activate")
                            </button>
                        </form>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>
