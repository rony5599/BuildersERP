@model BuilderERP.Application.DTOs.CreateRfqDto
@using BuilderERP.Domain.Enums
@using BuilderERP.Application.DTOs
@{
    ViewData["Title"] = "New RFQ";
    var suppliers = (IEnumerable<SupplierDto>)ViewBag.Suppliers;
}

<h1 class="h3 mb-4">New RFQ</h1>

<form asp-action="Create" method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
    <div class="row col-md-8">
        <div class="mb-3 col-md-4">
            <label asp-for="RfqNumber" class="form-label"></label>
            <input asp-for="RfqNumber" class="form-control" />
            <span asp-validation-for="RfqNumber" class="text-danger"></span>
        </div>
        <div class="mb-3 col-md-4">
            <label asp-for="PurchaseRequisitionId" class="form-label"></label>
            <select asp-for="PurchaseRequisitionId" asp-items="ViewBag.PurchaseRequisitions" class="form-select">
                <option value="">-- Select Purchase Requisition --</option>
            </select>
            <span asp-validation-for="PurchaseRequisitionId" class="text-danger"></span>
        </div>
        <div class="mb-3 col-md-4">
            <label asp-for="Status" class="form-label"></label>
            <select asp-for="Status" asp-items="Html.GetEnumSelectList<RfqStatus>()" class="form-select"></select>
        </div>
        <div class="mb-3 col-md-4">
            <label asp-for="IssueDate" class="form-label"></label>
            <input asp-for="IssueDate" type="date" class="form-control" />
        </div>
        <div class="mb-3 col-md-4">
            <label asp-for="ClosingDate" class="form-label"></label>
            <input asp-for="ClosingDate" type="date" class="form-control" />
            <span asp-validation-for="ClosingDate" class="text-danger"></span>
        </div>
    </div>

    <div class="mb-3">
        <label class="form-label">Invited Vendors</label>
        <div class="border rounded p-3" style="max-height: 200px; overflow-y: auto;">
            @foreach (var supplier in suppliers)
            {
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" name="SupplierIds" value="@supplier.Id" id="supplier-@supplier.Id" />
                    <label class="form-check-label" for="supplier-@supplier.Id">@supplier.Name</label>
                </div>
            }
        </div>
    </div>

    <h5 class="mt-4">Line Items</h5>
    <table class="table table-sm" id="rfq-details-table">
        <thead>
            <tr>
                <th>Material</th>
                <th>Quantity</th>
                <th>Unit</th>
                <th>Specification</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            <tr class="detail-row-template">
                <td>
                    <select name="Details[__index__].MaterialId" asp-items="ViewBag.Materials" class="form-select form-select-sm">
                        <option value="">-- Material --</option>
                    </select>
                </td>
                <td><input name="Details[__index__].Quantity" type="number" step="0.001" class="form-control form-control-sm" /></td>
                <td>
                    <select name="Details[__index__].UnitOfMeasure" asp-items="Html.GetEnumSelectList<UnitOfMeasure>()" class="form-select form-select-sm"></select>
                </td>
                <td><input name="Details[__index__].Specification" class="form-control form-control-sm" /></td>
                <td><button type="button" class="btn btn-sm btn-outline-danger" data-remove-row>Remove</button></td>
            </tr>
        </tbody>
    </table>
    <button type="button" class="btn btn-sm btn-outline-primary mb-3" data-add-row-for="rfq-details-table">Add Row</button>

    <div>
        <button type="submit" class="btn btn-primary">Save</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
    </div>
</form>

<partial name="_DetailLineItemsScripts" />
<script>
    document.addEventListener('DOMContentLoaded', function () {
        initDetailTable('rfq-details-table', 'Details');
    });
</script>
