@model BuilderERP.Application.DTOs.UpdateRfqDto
@using BuilderERP.Domain.Enums
@using BuilderERP.Application.DTOs
@{
    ViewData["Title"] = "Edit RFQ";
    var suppliers = (IEnumerable<SupplierDto>)ViewBag.Suppliers;
}

@section Styles {
    <link rel="stylesheet" href="~/css/multicolumn-dropdown.css" asp-append-version="true" />
}

<h1 class="h3 mb-4">Edit RFQ</h1>

<form asp-action="Edit" method="post">
    <input type="hidden" asp-for="Id" />
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
    <div class="row col-md-8">
        <div class="mb-3 col-md-4">
            <label asp-for="RfqNumber" class="form-label"></label>
            <input asp-for="RfqNumber" class="form-control" />
            <span asp-validation-for="RfqNumber" class="text-danger"></span>
        </div>
        <div class="mb-3 col-md-4">
            <label asp-for="PurchaseRequisitionId" class="form-label"></label>
            <div class="multicolumn-dropdown-wrapper">
                <div class="multicolumn-dropdown-container" id="purchaseRequisition-container">
                    <input type="hidden" asp-for="PurchaseRequisitionId" id="purchaseRequisition" value="@Model.PurchaseRequisitionId" />
                    <div class="multicolumn-dropdown-trigger">
                        <input type="text"
                               class="multicolumn-dropdown-filter form-control"
                               placeholder="Search Purchase Requisition..."
                               autocomplete="off"
                               id="purchaseRequisition-filter" />
                        <span class="multicolumn-dropdown-icon">
                            <i class="bi bi-chevron-down"></i>
                        </span>
                    </div>
                    <div class="multicolumn-dropdown-menu" id="purchaseRequisition-menu" style="display: none;">
                        <div class="multicolumn-dropdown-header">
                            <div class="multicolumn-dropdown-column">Purchase Requisition</div>
                            <div class="multicolumn-dropdown-column">Project</div>
                        </div>
                        <div class="multicolumn-dropdown-items">
                            @foreach (var requisition in (IEnumerable<dynamic>)ViewBag.PurchaseRequisitions ?? new List<dynamic>())
                            {
                                var parts = requisition.Text?.Split(" | ") ?? new[] { "", "" };
                                <div class="multicolumn-dropdown-item" data-value="@requisition.Value">
                                    <div class="multicolumn-dropdown-column">@(parts.Length > 0 ? parts[0]?.Trim() ?? "" : "")</div>
                                    <div class="multicolumn-dropdown-column">@(parts.Length > 1 ? parts[1]?.Trim() ?? "" : "")</div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
            <span asp-validation-for="PurchaseRequisitionId" class="text-danger"></span>
        </div>
        <div class="mb-3 col-md-4">
            <label asp-for="Status" class="form-label"></label>
            <select asp-for="Status" asp-items="Html.GetEnumSelectList<RfqStatus>()" class="form-select"></select>
        </div>
        <div class="mb-3 col-md-4">
            <label asp-for="IssueDate" class="form-label"></label>
            <input asp-for="IssueDate" type="date" class="form-control" />
        </div>
        <div class="mb-3 col-md-4">
            <label asp-for="ClosingDate" class="form-label"></label>
            <input asp-for="ClosingDate" type="date" class="form-control" />
            <span asp-validation-for="ClosingDate" class="text-danger"></span>
        </div>
    </div>

    <div class="mb-3">
        <label class="form-label">Invited Vendors</label>
        <div class="border rounded p-3" style="max-height: 200px; overflow-y: auto;">
            @foreach (var supplier in suppliers)
            {
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" name="SupplierIds" value="@supplier.Id" id="supplier-@supplier.Id" checked="@Model.SupplierIds.Contains(supplier.Id)" />
                    <label class="form-check-label" for="supplier-@supplier.Id">@supplier.Name</label>
                </div>
            }
        </div>
    </div>

    <h5 class="mt-4">Line Items</h5>
    <table class="table table-sm" id="rfq-details-table">
        <thead>
            <tr>
                <th style="width: 30%;">Material</th>
                <th style="width: 12%;">Quantity</th>
                <th style="width: 12%;">Unit</th>
                <th style="width: 30%;">Specification</th>
                <th style="width: 10%;"></th>
            </tr>
        </thead>
        <tbody>
            @for (var i = 0; i < Model.Details.Count; i++)
            {
                <tr class="detail-row">
                    <td>
                        <div class="multicolumn-dropdown-wrapper">
                            <div class="multicolumn-dropdown-container" id="material-existing-@i-container">
                                <input type="hidden" asp-for="Details[i].MaterialId" id="material-existing-@i" value="@Model.Details[i].MaterialId" />
                                <div class="multicolumn-dropdown-trigger">
                                    <input type="text" 
                                           class="multicolumn-dropdown-filter form-control form-control-sm" 
                                           placeholder="Search Material..."
                                           autocomplete="off"
                                           id="material-existing-@i-filter" />
                                    <span class="multicolumn-dropdown-icon">
                                        <i class="bi bi-chevron-down"></i>
                                    </span>
                                </div>
                                <div class="multicolumn-dropdown-menu" id="material-existing-@i-menu" style="display: none;">
                                    <div class="multicolumn-dropdown-header">
                                        <div class="multicolumn-dropdown-column">Code</div>
                                        <div class="multicolumn-dropdown-column">Name</div>
                                        <div class="multicolumn-dropdown-column">Category</div>
                                    </div>
                                    <div class="multicolumn-dropdown-items">
                                        @foreach(var material in (IEnumerable<dynamic>)ViewBag.Materials ?? new List<dynamic>())
                                        {
                                            var parts = material.Text?.Split(" | ") ?? new[] { "", "", "" };
                                            <div class="multicolumn-dropdown-item" data-value="@material.Value">
                                                <div class="multicolumn-dropdown-column">@(parts.Length > 0 ? parts[0]?.Trim() ?? "" : "")</div>
                                                <div class="multicolumn-dropdown-column">@(parts.Length > 1 ? parts[1]?.Trim() ?? "" : "")</div>
                                                <div class="multicolumn-dropdown-column">@(parts.Length > 2 ? parts[2]?.Trim() ?? "" : "")</div>
                                            </div>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    </td>
                    <td><input name="Details[@i].Quantity" type="number" step="0.001" value="@Model.Details[i].Quantity" class="form-control form-control-sm" /></td>
                    <td>
                        <select asp-for="Details[i].UnitOfMeasure" asp-items="Html.GetEnumSelectList<UnitOfMeasure>()" class="form-select form-select-sm"></select>
                    </td>
                    <td><input name="Details[@i].Specification" value="@Model.Details[i].Specification" class="form-control form-control-sm" /></td>
                    <td><button type="button" class="btn btn-sm btn-outline-danger" data-remove-row>Remove</button></td>
                </tr>
            }
            <tr class="detail-row-template">
                <td>
                    <div class="multicolumn-dropdown-wrapper material-dropdown-template">
                        <div class="multicolumn-dropdown-container" id="material-__index__-container">
                            <input type="hidden" name="Details[__index__].MaterialId" id="material-__index__" value="" />
                            <div class="multicolumn-dropdown-trigger">
                                <input type="text" 
                                       class="multicolumn-dropdown-filter form-control form-control-sm" 
                                       placeholder="Search Material..."
                                       autocomplete="off"
                                       id="material-__index__-filter" />
                                <span class="multicolumn-dropdown-icon">
                                    <i class="bi bi-chevron-down"></i>
                                </span>
                            </div>
                            <div class="multicolumn-dropdown-menu" id="material-__index__-menu" style="display: none;">
                                <div class="multicolumn-dropdown-header">
                                    <div class="multicolumn-dropdown-column">Code</div>
                                    <div class="multicolumn-dropdown-column">Name</div>
                                    <div class="multicolumn-dropdown-column">Category</div>
                                </div>
                                <div class="multicolumn-dropdown-items">
                                    @foreach(var material in (IEnumerable<dynamic>)ViewBag.Materials ?? new List<dynamic>())
                                    {
                                        var parts = material.Text?.Split(" | ") ?? new[] { "", "", "" };
                                        <div class="multicolumn-dropdown-item" data-value="@material.Value">
                                            <div class="multicolumn-dropdown-column">@(parts.Length > 0 ? parts[0]?.Trim() ?? "" : "")</div>
                                            <div class="multicolumn-dropdown-column">@(parts.Length > 1 ? parts[1]?.Trim() ?? "" : "")</div>
                                            <div class="multicolumn-dropdown-column">@(parts.Length > 2 ? parts[2]?.Trim() ?? "" : "")</div>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                </td>
                <td><input name="Details[__index__].Quantity" type="number" step="0.001" class="form-control form-control-sm" /></td>
                <td>
                    <select name="Details[__index__].UnitOfMeasure" asp-items="Html.GetEnumSelectList<UnitOfMeasure>()" class="form-select form-select-sm"></select>
                </td>
                <td><input name="Details[__index__].Specification" class="form-control form-control-sm" /></td>
                <td><button type="button" class="btn btn-sm btn-outline-danger" data-remove-row>Remove</button></td>
            </tr>
        </tbody>
    </table>
    <button type="button" class="btn btn-sm btn-outline-primary mb-3" data-add-row-for="rfq-details-table">Add Row</button>

    <div>
        <button type="submit" class="btn btn-primary">Save</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
    </div>
</form>

<partial name="_DetailLineItemsScripts" />
<script src="~/js/multicolumn-dropdown.js" asp-append-version="true"></script>
<script>
    // Initialize material dropdowns in a specific row
    function initializeDropdownsInRow(row) {
        const containers = row.querySelectorAll('[id$="-container"]');
        containers.forEach(container => {
            if (container.id.includes('material-')) {
                new MultiColumnDropdown(container.id);
            }
        });
    }

    document.addEventListener('DOMContentLoaded', function () {
        new MultiColumnDropdown('purchaseRequisition-container');

        // Initialize detail table first
        initDetailTable('rfq-details-table', 'Details');

        // Initialize all existing dropdowns
        setTimeout(() => {
            const rows = document.querySelectorAll('#rfq-details-table tbody tr.detail-row');
            rows.forEach(row => {
                initializeDropdownsInRow(row);
            });
        }, 100);

        // Hook into the row addition process
        const addBtn = document.querySelector('[data-add-row-for="rfq-details-table"]');
        if (addBtn) {
            addBtn.addEventListener('click', function () {
                setTimeout(() => {
                    const rows = document.querySelectorAll('#rfq-details-table tbody tr.detail-row');
                    const lastRow = rows[rows.length - 1];
                    if (lastRow) {
                        initializeDropdownsInRow(lastRow);
                    }
                }, 10);
            });
        }
    });
</script>

<partial name="_DetailLineItemsScripts" />
<script>
    document.addEventListener('DOMContentLoaded', function () {
        initDetailTable('rfq-details-table', 'Details');
    });
</script>
