@model IReadOnlyList<BuilderERP.Application.DTOs.OperatorAssignmentDto>
@using BuilderERP.Shared.Constants
@using BuilderERP.Shared.Authorization
@{
    ViewData["Title"] = "Operator Assignments";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Operator Assignments</h1>
    @if (User.HasClaim(PermissionClaimTypes.Permission, PermissionNames.OperatorAssignmentManage))
    {
        <a asp-action="Create" class="btn btn-primary">New Operator Assignment</a>
    }
</div>

<table class="table table-striped table-hover bg-white">
    <thead>
        <tr>
            <th>Equipment</th>
            <th>Operator</th>
            <th>Project</th>
            <th>Start Date</th>
            <th>End Date</th>
            <th>Active</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var assignment in Model)
        {
            <tr>
                <td>@assignment.EquipmentName</td>
                <td>@assignment.WorkerName</td>
                <td>@assignment.ProjectName</td>
                <td>@assignment.AssignmentStartDate.ToString("yyyy-MM-dd")</td>
                <td>@(assignment.AssignmentEndDate.HasValue ? assignment.AssignmentEndDate.Value.ToString("yyyy-MM-dd") : "Ongoing")</td>
                <td>
                    <span class="badge @(assignment.IsActive ? "bg-success" : "bg-secondary")">
                        @(assignment.IsActive ? "Active" : "Inactive")
                    </span>
                </td>
                <td class="text-end">
                    @if (User.HasClaim(PermissionClaimTypes.Permission, PermissionNames.OperatorAssignmentManage))
                    {
                        <a asp-action="Edit" asp-route-id="@assignment.Id" class="btn btn-sm btn-outline-secondary">Edit</a>
                        <form asp-action="ToggleActive" asp-route-id="@assignment.Id" asp-route-isActive="@assignment.IsActive" method="post" class="d-inline">
                            <button type="submit" class="btn btn-sm btn-outline-danger">
                                @(assignment.IsActive ? "Deactivate" : "Activate")
                            </button>
                        </form>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>
