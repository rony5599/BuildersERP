@using BuilderERP.Application.Common
@model PagedResult<BuilderERP.Application.DTOs.WorkerDto>
@using BuilderERP.Shared.Constants
@using BuilderERP.Shared.Authorization

<table class="table table-striped table-hover bg-white">
    <thead>
        <tr>
            <th>Code</th>
            <th>Name</th>
            <th>Phone</th>
            <th>Trade</th>
            <th>Daily Wage Rate</th>
            <th>Contractor</th>
            <th>Join Date</th>
            <th>Active</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var worker in Model.Items)
        {
            <tr>
                <td>@worker.WorkerCode</td>
                <td>@worker.Name</td>
                <td>@worker.Phone</td>
                <td>@worker.Trade</td>
                <td>@worker.DailyWageRate</td>
                <td>@(worker.ContractorName ?? "Direct")</td>
                <td>@worker.JoinDate.ToString("yyyy-MM-dd")</td>
                <td>
                    <span class="badge @(worker.IsActive ? "bg-success" : "bg-secondary")">
                        @(worker.IsActive ? "Active" : "Inactive")
                    </span>
                </td>
                <td class="text-end">
                    @if (User.HasClaim(PermissionClaimTypes.Permission, PermissionNames.WorkerManage))
                    {
                        <a asp-action="Edit" asp-route-id="@worker.Id" class="btn btn-sm btn-outline-secondary">Edit</a>
                        <form asp-action="ToggleActive" asp-route-id="@worker.Id" asp-route-isActive="@worker.IsActive" method="post" class="d-inline">
                            <button type="submit" class="btn btn-sm btn-outline-danger">
                                @(worker.IsActive ? "Deactivate" : "Activate")
                            </button>
                        </form>
                    }
                </td>
            </tr>
        }
        @if (Model.Items.Count == 0)
        {
            <tr>
                <td colspan="9" class="text-center text-muted">No workers found.</td>
            </tr>
        }
    </tbody>
</table>

<partial name="_Pagination" model="@(new BuilderERP.Web.Models.PaginationViewModel
{
    Page = Model.Page,
    PageSize = Model.PageSize,
    TotalPages = Model.TotalPages,
    TotalCount = Model.TotalCount,
    Action = "Index",
    RouteValues = new()
})" />
