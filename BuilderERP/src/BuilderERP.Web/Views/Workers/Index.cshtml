@model IReadOnlyList<BuilderERP.Application.DTOs.WorkerDto>
@using BuilderERP.Shared.Constants
@using BuilderERP.Shared.Authorization
@{
    ViewData["Title"] = "Workers";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Workers</h1>
    @if (User.HasClaim(PermissionClaimTypes.Permission, PermissionNames.WorkerManage))
    {
        <a asp-action="Create" class="btn btn-primary">New Worker</a>
    }
</div>

<table class="table table-striped table-hover bg-white">
    <thead>
        <tr>
            <th>Code</th>
            <th>Name</th>
            <th>Phone</th>
            <th>Trade</th>
            <th>Daily Wage Rate</th>
            <th>Contractor</th>
            <th>Join Date</th>
            <th>Active</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var worker in Model)
        {
            <tr>
                <td>@worker.WorkerCode</td>
                <td>@worker.Name</td>
                <td>@worker.Phone</td>
                <td>@worker.Trade</td>
                <td>@worker.DailyWageRate</td>
                <td>@(worker.ContractorName ?? "Direct")</td>
                <td>@worker.JoinDate.ToString("yyyy-MM-dd")</td>
                <td>
                    <span class="badge @(worker.IsActive ? "bg-success" : "bg-secondary")">
                        @(worker.IsActive ? "Active" : "Inactive")
                    </span>
                </td>
                <td class="text-end">
                    @if (User.HasClaim(PermissionClaimTypes.Permission, PermissionNames.WorkerManage))
                    {
                        <a asp-action="Edit" asp-route-id="@worker.Id" class="btn btn-sm btn-outline-secondary">Edit</a>
                        <form asp-action="ToggleActive" asp-route-id="@worker.Id" asp-route-isActive="@worker.IsActive" method="post" class="d-inline">
                            <button type="submit" class="btn btn-sm btn-outline-danger">
                                @(worker.IsActive ? "Deactivate" : "Activate")
                            </button>
                        </form>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>
