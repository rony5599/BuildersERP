@model IReadOnlyList<BuilderERP.Application.DTOs.PurchaseOrderDto>
@using BuilderERP.Shared.Constants
@using BuilderERP.Shared.Authorization
@{
    ViewData["Title"] = "Purchase Orders";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Purchase Orders</h1>
    @if (User.HasClaim(PermissionClaimTypes.Permission, PermissionNames.PurchaseOrderManage))
    {
        <a asp-action="Create" class="btn btn-primary">New Purchase Order</a>
    }
</div>

<table class="table table-striped table-hover bg-white">
    <thead>
        <tr>
            <th>PO #</th>
            <th>Supplier</th>
            <th>Quotation</th>
            <th>Total</th>
            <th>Received</th>
            <th>Delivery Date</th>
            <th>Status</th>
            <th>Active</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var order in Model)
        {
            <tr>
                <td>@order.PONumber</td>
                <td>@order.SupplierName</td>
                <td>@order.QuotationNumber</td>
                <td>@order.TotalAmount</td>
                <td>@order.ReceivedAmount</td>
                <td>@order.DeliveryDate.ToString("yyyy-MM-dd")</td>
                <td>@order.Status</td>
                <td>
                    <span class="badge @(order.IsActive ? "bg-success" : "bg-secondary")">
                        @(order.IsActive ? "Active" : "Inactive")
                    </span>
                </td>
                <td class="text-end">
                    @if (User.HasClaim(PermissionClaimTypes.Permission, PermissionNames.PurchaseOrderManage))
                    {
                        <a asp-action="Edit" asp-route-id="@order.Id" class="btn btn-sm btn-outline-secondary">Edit</a>
                        <form asp-action="ToggleActive" asp-route-id="@order.Id" asp-route-isActive="@order.IsActive" method="post" class="d-inline">
                            <button type="submit" class="btn btn-sm btn-outline-danger">
                                @(order.IsActive ? "Deactivate" : "Activate")
                            </button>
                        </form>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>
