@using BuilderERP.Application.Common
@model PagedResult<BuilderERP.Application.DTOs.PurchaseOrderDto>
@using BuilderERP.Shared.Constants
@using BuilderERP.Shared.Authorization
@{
    ViewData["Title"] = "Purchase Orders";
}

@section Styles {
    <link rel="stylesheet" href="~/css/procurement.css" asp-append-version="true" />
}

@if (TempData["StatusMessage"] is string statusMessage)
{
    <div class="alert alert-success">@statusMessage</div>
}
@if (TempData["ErrorMessage"] is string errorMessage)
{
    <div class="alert alert-danger">@errorMessage</div>
}

<div class="procurement-page-header">
    <div>
        <div class="page-eyebrow"><i class="bi bi-receipt"></i> Procurement</div>
        <div class="d-flex align-items-center gap-3">
            <h1>Purchase Orders</h1>
            <partial name="_ProcureToPayHelp" />
        </div>
        <p>Manage supplier commitments, delivery dates and receiving progress.</p>
    </div>
    @if (User.HasClaim(PermissionClaimTypes.Permission, PermissionNames.PurchaseOrderManage)
        && (ViewBag.ActionAssignment?.CanDraftEdit ?? false))
    {
        <a asp-action="Create" class="btn btn-primary procurement-primary-action"><i class="bi bi-plus-lg"></i> New Purchase Order</a>
    }
</div>

<form method="get" asp-action="Index" class="procurement-filter-card row g-3 align-items-end grid-search-form">
    <div class="col-md-2">
        <label class="form-label small mb-1">PO No</label>
        <input type="text" name="poNumber" value="@ViewBag.PONumber" class="form-control" placeholder="PO No" />
    </div>
    <div class="col-md-2">
        <label class="form-label small mb-1">PO Date From</label>
        <input type="date" name="orderDateFrom" value="@(((DateTime?)ViewBag.OrderDateFrom)?.ToString("yyyy-MM-dd"))" class="form-control" />
    </div>
    <div class="col-md-2">
        <label class="form-label small mb-1">PO Date To</label>
        <input type="date" name="orderDateTo" value="@(((DateTime?)ViewBag.OrderDateTo)?.ToString("yyyy-MM-dd"))" class="form-control" />
    </div>
    <div class="col-md-2">
        <label class="form-label small mb-1">Delivery Date From</label>
        <input type="date" name="deliveryDateFrom" value="@(((DateTime?)ViewBag.DeliveryDateFrom)?.ToString("yyyy-MM-dd"))" class="form-control" />
    </div>
    <div class="col-md-2">
        <label class="form-label small mb-1">Delivery Date To</label>
        <input type="date" name="deliveryDateTo" value="@(((DateTime?)ViewBag.DeliveryDateTo)?.ToString("yyyy-MM-dd"))" class="form-control" />
    </div>
    <div class="col-md-2 d-flex gap-2 align-items-end">
        <button type="submit" class="btn btn-primary flex-fill"><i class="bi bi-funnel"></i> Filter</button>
        <a asp-action="Index" class="btn btn-outline-secondary flex-fill">Reset</a>
    </div>
</form>

<div data-grid-container>
    <partial name="_Grid" model="Model" />
</div>

<div class="modal fade" id="reject-po-modal" tabindex="-1" aria-labelledby="reject-po-title" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered"><div class="modal-content">
        <form asp-action="WorkflowAction" method="post" id="reject-po-form">
            <div class="modal-header"><div><h2 class="modal-title fs-5" id="reject-po-title">Return PO for revision</h2><p class="small text-muted mb-0">The purchase order will return to Draft for correction and resubmission.</p></div><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button></div>
            <div class="modal-body">
                <input type="hidden" name="id" id="reject-po-id" /><input type="hidden" name="workflowAction" value="reject" />
                <label for="po-rejection-reason" class="form-label fw-semibold">Reason for rejection <span class="text-danger">*</span></label>
                <textarea id="po-rejection-reason" name="rejectionReason" class="form-control" rows="4" maxlength="1000" required placeholder="Explain what must be corrected before resubmission."></textarea>
                <div class="form-text">This reason will be visible to the PO preparer.</div>
            </div>
            <div class="modal-footer"><button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Keep pending</button><button type="submit" class="btn btn-danger"><i class="bi bi-arrow-counterclockwise me-1"></i> Return to Draft</button></div>
        </form>
    </div></div>
</div>

@section Scripts {
    <script>
        document.getElementById('reject-po-modal')?.addEventListener('show.bs.modal', function (event) {
            document.getElementById('reject-po-id').value = event.relatedTarget.getAttribute('data-order-id');
            document.getElementById('po-rejection-reason').value = '';
        });
        document.getElementById('reject-po-modal')?.addEventListener('shown.bs.modal', function () { document.getElementById('po-rejection-reason').focus(); });

        document.addEventListener('submit', function (event) {
            const form = event.target;
            if (!form.classList.contains('workflow-action-form')) return;
            if (form.dataset.submitting === 'true') {
                event.preventDefault();
                return;
            }

            form.dataset.submitting = 'true';
            const button = form.querySelector('button[type="submit"]');
            if (button) {
                button.disabled = true;
                button.setAttribute('aria-busy', 'true');
            }
        });
    </script>
}
