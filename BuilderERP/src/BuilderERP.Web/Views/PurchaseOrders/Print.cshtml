@model BuilderERP.Application.DTOs.PurchaseOrderPrintDto
@{
    Layout = null;
    const int itemsPerPage = 10;
    var pages = Model.Lines
        .Select((line, index) => (line, index))
        .GroupBy(x => x.index / itemsPerPage)
        .Select(g => g.Select(x => x.line).ToList())
        .ToList();
    if (pages.Count == 0)
    {
        pages.Add(new List<BuilderERP.Application.DTOs.PurchaseOrderPrintLineDto>());
    }
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Purchase Order @Model.PONumber</title>
    <style>
        * { box-sizing: border-box; }
        body {
            font-family: 'Segoe UI', Arial, sans-serif;
            color: #222;
            margin: 0;
            background: #e9ecef;
        }
        .toolbar {
            padding: 12px 24px;
            background: #fff;
            border-bottom: 1px solid #dee2e6;
            display: flex;
            gap: 8px;
        }
        .toolbar a, .toolbar button {
            display: inline-block;
            padding: 8px 16px;
            border-radius: 4px;
            border: 1px solid #0d6efd;
            background: #0d6efd;
            color: #fff;
            text-decoration: none;
            font-size: 14px;
            cursor: pointer;
        }
        .toolbar a.secondary, .toolbar button.secondary {
            background: #fff;
            color: #0d6efd;
        }
        .sheet {
            max-width: 800px;
            margin: 24px auto;
            background: #fff;
            padding: 48px;
            box-shadow: 0 0 8px rgba(0,0,0,0.1);
        }
        .sheet + .sheet {
            margin-top: 40px;
        }
        .page-footer {
            margin-top: 12px;
            text-align: right;
            font-size: 11px;
            color: #888;
            font-style: italic;
        }
        .title {
            text-align: center;
            font-size: 32px;
            font-weight: 800;
            letter-spacing: 1px;
            margin: 0 0 24px;
        }
        .company-name {
            font-size: 18px;
            font-weight: 700;
            margin: 0 0 4px;
        }
        .company-details, .party-details {
            font-size: 13px;
            line-height: 1.5;
            color: #333;
        }
        hr {
            border: none;
            border-top: 1px solid #dee2e6;
            margin: 24px 0;
        }
        .meta-row {
            display: flex;
            justify-content: space-between;
            gap: 24px;
        }
        .meta-row .party {
            flex: 1;
        }
        .meta-row .po-info {
            text-align: right;
        }
        .section-label {
            font-weight: 700;
            font-size: 14px;
            margin-bottom: 6px;
        }
        .po-info table {
            margin-left: auto;
        }
        .po-info td {
            padding: 2px 0 2px 12px;
            font-size: 14px;
        }
        .po-info td.label {
            font-weight: 700;
        }
        table.items {
            width: 100%;
            border-collapse: collapse;
            margin-top: 32px;
        }
        table.items th {
            background: #0d6efd;
            color: #fff;
            text-align: left;
            padding: 10px 8px;
            font-size: 13px;
        }
        table.items th.num, table.items td.num {
            text-align: right;
        }
        table.items td {
            padding: 10px 8px;
            font-size: 13px;
            border-bottom: 1px solid #eceff1;
        }
        .totals {
            width: 100%;
            margin-top: 16px;
        }
        .totals table {
            margin-left: auto;
            width: 260px;
            border-collapse: collapse;
        }
        .totals td {
            padding: 8px 0;
            font-size: 14px;
        }
        .totals td.label {
            font-weight: 700;
        }
        .totals td.value {
            text-align: right;
        }
        .totals tr.grand td {
            border-top: 1px solid #333;
            font-size: 16px;
            font-weight: 800;
        }
        .signature-row {
            margin-top: 80px;
            display: flex;
            justify-content: space-between;
            gap: 24px;
        }
        .signature-row .signature {
            flex: 1;
            text-align: center;
        }
        .signature-row .signature .line {
            display: block;
            border-bottom: 1px solid #333;
            height: 40px;
        }
        .signature-row .signature .caption {
            font-weight: 700;
            margin-top: 4px;
        }
        .signature-row .signature .subcaption {
            font-size: 12px;
            color: #555;
        }

        @@page {
            margin: 10mm;
        }

        @@media print {
            body { background: #fff; }
            .toolbar { display: none; }
            .sheet { box-shadow: none; margin: 0; max-width: none; padding: 12px; page-break-after: always; }
            .sheet:last-of-type { page-break-after: auto; }
            .title { font-size: 24px; margin-bottom: 12px; }
            table.items { margin-top: 16px; }
            table.items tr { page-break-inside: avoid; }
            .signature-row { margin-top: 40px; }
        }
    </style>
</head>
<body>
    <div class="toolbar">
        <button onclick="window.print()">Print</button>
        <a class="secondary" asp-action="PrintPdf" asp-route-id="@ViewContext.RouteData.Values["id"]">Download PDF</a>
    </div>

    @for (var pageIndex = 0; pageIndex < pages.Count; pageIndex++)
    {
        var pageLines = pages[pageIndex];
        var startSl = pageIndex * itemsPerPage + 1;
        var isLastPage = pageIndex == pages.Count - 1;

        <div class="sheet">
            <div class="title">PURCHASE ORDER</div>

            <div class="company-name">@Model.CompanyName</div>
            <div class="company-details">
                @if (!string.IsNullOrWhiteSpace(Model.CompanyAddress))
                {
                    <div>@Model.CompanyAddress</div>
                }
                @if (!string.IsNullOrWhiteSpace(Model.CompanyPhone))
                {
                    <div>Mobile: @Model.CompanyPhone</div>
                }
                @if (!string.IsNullOrWhiteSpace(Model.CompanyEmail))
                {
                    <div>Email: @Model.CompanyEmail</div>
                }
            </div>

            <hr />

            @if (!string.IsNullOrWhiteSpace(Model.TermsOfPayment) || !string.IsNullOrWhiteSpace(Model.DispatchedThrough) || !string.IsNullOrWhiteSpace(Model.Destination))
            {
                <div class="meta-row">
                    @if (!string.IsNullOrWhiteSpace(Model.TermsOfPayment))
                    {
                        <div class="party">
                            <div class="section-label">Terms of Payment / Delivery</div>
                            <div class="party-details">@Model.TermsOfPayment</div>
                        </div>
                    }
                    @if (!string.IsNullOrWhiteSpace(Model.DispatchedThrough))
                    {
                        <div class="party">
                            <div class="section-label">Dispatched Through</div>
                            <div class="party-details">@Model.DispatchedThrough</div>
                        </div>
                    }
                    @if (!string.IsNullOrWhiteSpace(Model.Destination))
                    {
                        <div class="party">
                            <div class="section-label">Destination</div>
                            <div class="party-details">@Model.Destination</div>
                        </div>
                    }
                </div>
                <hr />
            }

            <div class="meta-row">
                <div class="party">
                    <div class="section-label">Consignee &mdash; Ship To</div>
                    <div class="party-details">
                        <div>@Model.CompanyName</div>
                        @if (!string.IsNullOrWhiteSpace(Model.CompanyAddress))
                        {
                            <div>@Model.CompanyAddress</div>
                        }
                    </div>
                </div>
                <div class="party">
                    <div class="section-label">Supplier &mdash; Bill From</div>
                    <div class="party-details">
                        <div>@Model.SupplierName</div>
                        @if (!string.IsNullOrWhiteSpace(Model.SupplierAddress))
                        {
                            <div>@Model.SupplierAddress</div>
                        }
                        @if (!string.IsNullOrWhiteSpace(Model.SupplierPhone))
                        {
                            <div>Phone: @Model.SupplierPhone</div>
                        }
                        @if (!string.IsNullOrWhiteSpace(Model.SupplierEmail))
                        {
                            <div>Email: @Model.SupplierEmail</div>
                        }
                    </div>
                </div>
                <div class="po-info">
                    <table>
                        <tr>
                            <td class="label">PO No :</td>
                            <td>@Model.PONumber</td>
                        </tr>
                        <tr>
                            <td class="label">Order Date :</td>
                            <td>@Model.OrderDate.ToString("MMM dd, yyyy")</td>
                        </tr>
                    </table>
                </div>
            </div>

            <table class="items">
                <thead>
                    <tr>
                        <th style="width: 40px;">Sl.</th>
                        <th>Description</th>
                        <th class="num" style="width: 60px;">Qty</th>
                        <th class="num" style="width: 100px;">Rate</th>
                        <th class="num" style="width: 110px;">Amount</th>
                    </tr>
                </thead>
                <tbody>
                    @{ var sl = startSl; }
                    @foreach (var line in pageLines)
                    {
                        <tr>
                            <td>@sl</td>
                            <td>@line.Description</td>
                            <td class="num">@line.Quantity.ToString("0.##")</td>
                            <td class="num">@line.Rate.ToString("N2")</td>
                            <td class="num">@line.Amount.ToString("N2")</td>
                        </tr>
                        sl++;
                    }
                </tbody>
            </table>

            @if (!isLastPage)
            {
                <div class="page-footer">Continued on next page&hellip; (Page @(pageIndex + 1) of @pages.Count)</div>
            }
            else
            {
                <div class="totals">
                    <table>
                        <tr>
                            <td class="label">Subtotal</td>
                            <td class="value">@Model.Subtotal.ToString("N2")</td>
                        </tr>
                        <tr class="grand">
                            <td class="label">Total</td>
                            <td class="value">@Model.Total.ToString("N2")</td>
                        </tr>
                    </table>
                </div>

                @if (!string.IsNullOrWhiteSpace(Model.Remarks))
                {
                    <div class="section-label" style="margin-top: 24px;">Remarks</div>
                    <div class="party-details">@Model.Remarks</div>
                }

                <div class="signature-row">
                    <div class="signature">
                        <div class="line"></div>
                        <div class="caption">Sr. Executive</div>
                        <div class="subcaption">Procurement Dept.</div>
                    </div>
                    <div class="signature">
                        <div class="line"></div>
                        <div class="caption">Sr. Manager</div>
                        <div class="subcaption">Procurement Dept.</div>
                    </div>
                    <div class="signature">
                        <div class="line"></div>
                        <div class="caption">Authorized Signatory</div>
                        <div class="subcaption">@Model.CompanyName</div>
                    </div>
                </div>

                @if (pages.Count > 1)
                {
                    <div class="page-footer">Page @(pageIndex + 1) of @pages.Count</div>
                }
            }
        </div>
    }
</body>
</html>
