@model BuilderERP.Application.DTOs.UpdatePurchaseOrderDto
@using BuilderERP.Domain.Entities
@using BuilderERP.Domain.Enums
@{
    ViewData["Title"] = "Edit Purchase Order";
    var assignment = ViewBag.ActionAssignment as PurchaseOrderActionAssignment;
}

@section Styles {
    <link rel="stylesheet" href="~/css/multicolumn-dropdown.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/procurement.css" asp-append-version="true" />
}

<div class="procurement-form-header">
    <a asp-action="Index" class="procurement-back"><i class="bi bi-arrow-left"></i></a>
    <div><div class="page-eyebrow">Purchase Order</div><h1>Edit Purchase Order</h1><p>Review supplier, delivery and commercial details for this order.</p></div>
</div>

@if (!string.IsNullOrWhiteSpace(Model.RejectionReason))
{
    <div class="alert alert-danger d-flex gap-3 align-items-start" role="alert">
        <i class="bi bi-arrow-counterclockwise fs-4"></i>
        <div><div class="fw-semibold">Returned for revision</div><div>@Model.RejectionReason</div>
        @if (Model.RejectedAt.HasValue) { <div class="small mt-1 opacity-75">Returned by @(Model.RejectedBy ?? "Approver") on @Model.RejectedAt.Value.ToLocalTime().ToString("dd MMM yyyy, hh:mm tt")</div> }
        </div>
    </div>
}

<form asp-action="Edit" method="post" class="procurement-form po-editor-form">
    <input type="hidden" asp-for="Id" />
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
    <div class="po-editor-layout">
    <div class="po-editor-main">
    <div class="procurement-form-card po-details-card">
        <div class="po-card-heading">
            <h5>Purchase order details</h5>
            <p>Supplier, dates, commercial terms and delivery information.</p>
        </div>
        <div class="row g-3 po-details-grid">
        <div class="mb-3 col-md-4">
            <label asp-for="PONumber" class="form-label"></label>
            <input asp-for="PONumber" class="form-control" />
            <span asp-validation-for="PONumber" class="text-danger"></span>
        </div>
        <div class="mb-3 col-md-4">
            <label asp-for="VendorQuotationId" class="form-label"></label>
            <div class="multicolumn-dropdown-wrapper">
                <div class="multicolumn-dropdown-container" id="vendorQuotation-container">
                    <input type="hidden" asp-for="VendorQuotationId" id="vendorQuotation" value="@Model.VendorQuotationId" />
                    <div class="multicolumn-dropdown-trigger">
                        <input type="text"
                               class="multicolumn-dropdown-filter form-control"
                               placeholder="Search Vendor Quotation..."
                               autocomplete="off"
                               id="vendorQuotation-filter" />
                        <span class="multicolumn-dropdown-icon">
                            <i class="bi bi-chevron-down"></i>
                        </span>
                    </div>
                    <div class="multicolumn-dropdown-menu" id="vendorQuotation-menu" style="display: none;">
                        <div class="multicolumn-dropdown-header">
                            <div class="multicolumn-dropdown-column" style="flex: 0 0 120px;">PO Req No</div>
                            <div class="multicolumn-dropdown-column" style="flex: 0 0 120px;">VQ No</div>
                            <div class="multicolumn-dropdown-column" style="flex: 1;">Project Name</div>
                        </div>
                        <div class="multicolumn-dropdown-items">
                            @foreach (var quotation in (IEnumerable<dynamic>)ViewBag.VendorQuotations ?? new List<dynamic>())
                            {
                                var parts = quotation.Text?.Split(" | ") ?? new[] { "", "", "" };
                                <div class="multicolumn-dropdown-item" data-value="@quotation.Value">
                                    <div class="multicolumn-dropdown-column" style="flex: 0 0 120px;">@(parts.Length > 0 ? parts[0]?.Trim() ?? "" : "")</div>
                                    <div class="multicolumn-dropdown-column" style="flex: 0 0 120px;">@(parts.Length > 1 ? parts[1]?.Trim() ?? "" : "")</div>
                                    <div class="multicolumn-dropdown-column" style="flex: 1;">@(parts.Length > 2 ? parts[2]?.Trim() ?? "" : "")</div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
            <span asp-validation-for="VendorQuotationId" class="text-danger"></span>
            <button type="button" id="load-quotation-btn" class="btn btn-sm btn-outline-secondary mt-2">Load Items</button>
        </div>
        <input asp-for="Status" type="hidden" value="@PurchaseOrderStatus.Draft" />
        <div class="mb-3 col-md-4">
            <label asp-for="OrderDate" class="form-label"></label>
            <input asp-for="OrderDate" type="date" class="form-control" />
        </div>
        <div class="mb-3 col-md-4">
            <label asp-for="DeliveryDate" class="form-label"></label>
            <input asp-for="DeliveryDate" type="date" class="form-control" />
            <span asp-validation-for="DeliveryDate" class="text-danger"></span>
        </div>
        <div class="mb-3 col-md-4">
            <label asp-for="TermsOfPayment" class="form-label">Terms of Payment / Delivery</label>
            <input asp-for="TermsOfPayment" class="form-control" />
        </div>
        <div class="mb-3 col-md-4">
            <label asp-for="DispatchedThrough" class="form-label">Dispatched Through</label>
            <input asp-for="DispatchedThrough" class="form-control" />
        </div>
        <div class="mb-3 col-md-4">
            <label asp-for="Destination" class="form-label">Destination</label>
            <input asp-for="Destination" class="form-control" />
        </div>
        <div class="mb-3 col-md-8">
            <label asp-for="Remarks" class="form-label">Remarks</label>
            <textarea asp-for="Remarks" class="form-control" rows="2"></textarea>
        </div>
        </div>
    </div>

    <div class="procurement-lines po-lines-card"><div class="procurement-section-heading"><div><h5>Line Items</h5><p>Review quantities, prices, discounts and applicable taxes.</p></div><button type="button" class="btn btn-sm btn-outline-primary" data-add-row-for="po-details-table"><i class="bi bi-plus-lg"></i> Add Item</button></div><table class="table table-sm" id="po-details-table">
        <thead>
            <tr>
                <th style="width: 25%;">Material</th>
                <th style="width: 10%;">Qty</th>
                <th style="width: 10%;">Unit</th>
                <th style="width: 12%;">Unit Price</th>
                <th style="width: 8%;">Disc %</th>
                <th style="width: 8%;">VAT %</th>
                <th style="width: 8%;">Tax %</th>
                <th style="width: 12%;">Line Total</th>
                <th style="width: 9%;"></th>
            </tr>
        </thead>
        <tbody>
            @for (var i = 0; i < Model.Details.Count; i++)
            {
                <tr class="detail-row">
                    <td>
                        <div class="multicolumn-dropdown-wrapper">
                            <div class="multicolumn-dropdown-container" id="material-existing-@i-container">
                                <input type="hidden" asp-for="Details[i].MaterialId" id="material-existing-@i" value="@Model.Details[i].MaterialId" />
                                <div class="multicolumn-dropdown-trigger">
                                    <input type="text" 
                                           class="multicolumn-dropdown-filter form-control form-control-sm" 
                                           placeholder="Search Material..."
                                           autocomplete="off"
                                           id="material-existing-@i-filter" />
                                    <span class="multicolumn-dropdown-icon">
                                        <i class="bi bi-chevron-down"></i>
                                    </span>
                                </div>
                                <div class="multicolumn-dropdown-menu" id="material-existing-@i-menu" style="display: none;">
                                    <div class="multicolumn-dropdown-header">
                                        <div class="multicolumn-dropdown-column">Code</div>
                                        <div class="multicolumn-dropdown-column">Name</div>
                                        <div class="multicolumn-dropdown-column">Category</div>
                                    </div>
                                    <div class="multicolumn-dropdown-items">
                                        @foreach(var material in (IEnumerable<dynamic>)ViewBag.Materials ?? new List<dynamic>())
                                        {
                                            var parts = material.Text?.Split(" | ") ?? new[] { "", "", "" };
                                            <div class="multicolumn-dropdown-item" data-value="@material.Value">
                                                <div class="multicolumn-dropdown-column">@(parts.Length > 0 ? parts[0]?.Trim() ?? "" : "")</div>
                                                <div class="multicolumn-dropdown-column">@(parts.Length > 1 ? parts[1]?.Trim() ?? "" : "")</div>
                                                <div class="multicolumn-dropdown-column">@(parts.Length > 2 ? parts[2]?.Trim() ?? "" : "")</div>
                                            </div>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    </td>
                    <td><input name="Details[@i].OrderedQuantity" type="number" step="0.001" value="@Model.Details[i].OrderedQuantity" class="form-control form-control-sm" /></td>
                    <td>
                        <select asp-for="Details[i].UnitOfMeasure" asp-items="Html.GetEnumSelectList<UnitOfMeasure>()" class="form-select form-select-sm"></select>
                    </td>
                    <td><input name="Details[@i].UnitPrice" type="number" step="0.01" value="@Model.Details[i].UnitPrice" class="form-control form-control-sm" /></td>
                    <td><input name="Details[@i].DiscountPercent" type="number" step="0.01" value="@Model.Details[i].DiscountPercent" class="form-control form-control-sm" /></td>
                    <td><input name="Details[@i].VatPercent" type="number" step="0.01" value="@Model.Details[i].VatPercent" class="form-control form-control-sm" /></td>
                    <td><input name="Details[@i].TaxPercent" type="number" step="0.01" value="@Model.Details[i].TaxPercent" class="form-control form-control-sm" /></td>
                    <td class="po-line-total">৳ 0.00</td>
                    <td><button type="button" class="btn btn-sm btn-outline-danger" data-remove-row>Remove</button></td>
                </tr>
            }
            <tr class="detail-row-template">
                <td>
                    <div class="multicolumn-dropdown-wrapper material-dropdown-template">
                        <div class="multicolumn-dropdown-container" id="material-__index__-container">
                            <input type="hidden" name="Details[__index__].MaterialId" id="material-__index__" value="" />
                            <div class="multicolumn-dropdown-trigger">
                                <input type="text" 
                                       class="multicolumn-dropdown-filter form-control form-control-sm" 
                                       placeholder="Search Material..."
                                       autocomplete="off"
                                       id="material-__index__-filter" />
                                <span class="multicolumn-dropdown-icon">
                                    <i class="bi bi-chevron-down"></i>
                                </span>
                            </div>
                            <div class="multicolumn-dropdown-menu" id="material-__index__-menu" style="display: none;">
                                <div class="multicolumn-dropdown-header">
                                    <div class="multicolumn-dropdown-column">Code</div>
                                    <div class="multicolumn-dropdown-column">Name</div>
                                    <div class="multicolumn-dropdown-column">Category</div>
                                </div>
                                <div class="multicolumn-dropdown-items">
                                    @foreach(var material in (IEnumerable<dynamic>)ViewBag.Materials ?? new List<dynamic>())
                                    {
                                        var parts = material.Text?.Split(" | ") ?? new[] { "", "", "" };
                                        <div class="multicolumn-dropdown-item" data-value="@material.Value">
                                            <div class="multicolumn-dropdown-column">@(parts.Length > 0 ? parts[0]?.Trim() ?? "" : "")</div>
                                            <div class="multicolumn-dropdown-column">@(parts.Length > 1 ? parts[1]?.Trim() ?? "" : "")</div>
                                            <div class="multicolumn-dropdown-column">@(parts.Length > 2 ? parts[2]?.Trim() ?? "" : "")</div>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                </td>
                <td><input name="Details[__index__].OrderedQuantity" type="number" step="0.001" class="form-control form-control-sm" /></td>
                <td>
                    <select name="Details[__index__].UnitOfMeasure" asp-items="Html.GetEnumSelectList<UnitOfMeasure>()" class="form-select form-select-sm"></select>
                </td>
                <td><input name="Details[__index__].UnitPrice" type="number" step="0.01" class="form-control form-control-sm" /></td>
                <td><input name="Details[__index__].DiscountPercent" type="number" step="0.01" value="0" class="form-control form-control-sm" /></td>
                <td><input name="Details[__index__].VatPercent" type="number" step="0.01" value="0" class="form-control form-control-sm" /></td>
                <td><input name="Details[__index__].TaxPercent" type="number" step="0.01" value="0" class="form-control form-control-sm" /></td>
                <td class="po-line-total">৳ 0.00</td>
                <td><button type="button" class="btn btn-sm btn-outline-danger" data-remove-row>Remove</button></td>
            </tr>
        </tbody>
    </table></div>
    </div>
    <partial name="_EditorSidebar" />
    </div>

    <div class="procurement-form-actions">
        <a asp-action="Index" class="btn btn-outline-secondary">Discard changes</a>
        <button type="submit" class="btn btn-outline-primary"><i class="bi bi-check2"></i> Save draft</button>
        @if (assignment?.CanSubmit == true && Model.Status == PurchaseOrderStatus.Draft)
        {
            <button type="submit" form="submit-purchase-order-form" class="btn btn-outline-primary"><i class="bi bi-send"></i> Submit</button>
        }
        @if (assignment?.CanApprove == true && Model.Status == PurchaseOrderStatus.AwaitingApproval)
        {
            <button type="submit" form="approve-purchase-order-form" class="btn btn-success"><i class="bi bi-check-lg"></i> Approve</button>
        }
        @if (assignment?.CanReject == true && Model.Status == PurchaseOrderStatus.AwaitingApproval)
        {
            <button type="submit" form="reject-purchase-order-form" class="btn btn-outline-danger"><i class="bi bi-x-lg"></i> Reject</button>
        }
        @if (assignment?.CanCancel == true && Model.Status is PurchaseOrderStatus.Draft or PurchaseOrderStatus.Submitted or PurchaseOrderStatus.AwaitingApproval or PurchaseOrderStatus.Rejected)
        {
            <button type="submit" form="cancel-purchase-order-form" class="btn btn-outline-danger"><i class="bi bi-slash-circle"></i> Cancel Order</button>
        }
    </div>
</form>

@if (assignment?.CanSubmit == true && Model.Status == PurchaseOrderStatus.Draft)
{
    <form id="submit-purchase-order-form" asp-action="WorkflowAction" asp-route-id="@Model.Id" method="post" class="d-none workflow-action-form">
        <input type="hidden" name="workflowAction" value="submit" />
    </form>
}
@if (assignment?.CanApprove == true && Model.Status == PurchaseOrderStatus.AwaitingApproval)
{
    <form id="approve-purchase-order-form" asp-action="WorkflowAction" asp-route-id="@Model.Id" method="post" class="d-none workflow-action-form">
        <input type="hidden" name="workflowAction" value="approve" />
    </form>
}
@if (assignment?.CanReject == true && Model.Status == PurchaseOrderStatus.AwaitingApproval)
{
    <form id="reject-purchase-order-form" asp-action="WorkflowAction" asp-route-id="@Model.Id" method="post" class="d-none workflow-action-form">
        <input type="hidden" name="workflowAction" value="reject" />
    </form>
}
@if (assignment?.CanCancel == true && Model.Status is PurchaseOrderStatus.Draft or PurchaseOrderStatus.Submitted or PurchaseOrderStatus.AwaitingApproval or PurchaseOrderStatus.Rejected)
{
    <form id="cancel-purchase-order-form" asp-action="WorkflowAction" asp-route-id="@Model.Id" method="post" class="d-none workflow-action-form">
        <input type="hidden" name="workflowAction" value="cancel" />
    </form>
}

<partial name="_DetailLineItemsScripts" />
<script src="~/js/multicolumn-dropdown.js" asp-append-version="true"></script>
<script>
    document.addEventListener('DOMContentLoaded', function () {
        new MultiColumnDropdown('vendorQuotation-container');
        initDetailTable('po-details-table', 'Details');
        initializeAllDropdowns();
        updatePurchaseOrderSummary();
    });

    function updatePurchaseOrderSummary() {
        let subtotal = 0, discount = 0, vat = 0, tax = 0;
        const money = value => `৳ ${value.toLocaleString('en-BD', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`;
        const roundMoney = value => Math.round((value + Number.EPSILON) * 100) / 100;
        document.querySelectorAll('#po-details-table tbody tr.detail-row').forEach(row => {
            const value = suffix => Number(row.querySelector(`[name$=".${suffix}"]`)?.value || 0);
            const gross = value('OrderedQuantity') * value('UnitPrice');
            const lineDiscount = roundMoney(gross * value('DiscountPercent') / 100);
            const taxable = gross - lineDiscount;
            const lineVat = roundMoney(taxable * value('VatPercent') / 100);
            const lineTax = roundMoney(taxable * value('TaxPercent') / 100);
            subtotal += gross;
            discount += lineDiscount;
            vat += lineVat;
            tax += lineTax;
            const lineTotal = taxable + lineVat + lineTax;
            const lineTotalCell = row.querySelector('.po-line-total');
            if (lineTotalCell) lineTotalCell.textContent = money(lineTotal);
        });
        document.getElementById('po-summary-subtotal').textContent = money(subtotal);
        document.getElementById('po-summary-discount').textContent = `− ${money(discount)}`;
        document.getElementById('po-summary-vat').textContent = money(vat);
        document.getElementById('po-summary-tax').textContent = money(tax);
        document.getElementById('po-summary-total').textContent = money(subtotal - discount + vat + tax);
    }

    document.getElementById('po-details-table').addEventListener('input', updatePurchaseOrderSummary);
    document.getElementById('po-details-table').addEventListener('change', updatePurchaseOrderSummary);
    document.getElementById('po-details-table').addEventListener('click', function (event) {
        if (event.target.closest('[data-remove-row]')) setTimeout(updatePurchaseOrderSummary, 0);
    });

    document.addEventListener('submit', function (event) {
        const form = event.target;
        if (!form.classList.contains('workflow-action-form')) return;
        if (form.dataset.submitting === 'true') {
            event.preventDefault();
            return;
        }

        form.dataset.submitting = 'true';
        const button = form.querySelector('button[type="submit"]')
            || document.querySelector(`button[form="${form.id}"]`);
        if (button) {
            button.disabled = true;
            button.setAttribute('aria-busy', 'true');
        }
    });

    // Initialize material dropdowns in a specific row
    function initializeDropdownsInRow(row) {
        const containers = row.querySelectorAll('[id$="-container"]');
        containers.forEach(container => {
            if (container.id.includes('material-')) {
                new MultiColumnDropdown(container.id);
            }
        });
    }

    // Initialize all existing dropdowns
    function initializeAllDropdowns() {
        const rows = document.querySelectorAll('#po-details-table tbody tr.detail-row');
        rows.forEach(row => {
            initializeDropdownsInRow(row);
        });
    }

    // Hook into the row addition process
    const addBtn = document.querySelector('[data-add-row-for="po-details-table"]');
    if (addBtn) {
        addBtn.addEventListener('click', function () {
            setTimeout(() => {
                const rows = document.querySelectorAll('#po-details-table tbody tr.detail-row');
                const lastRow = rows[rows.length - 1];
                if (lastRow) {
                    initializeDropdownsInRow(lastRow);
                }
            }, 10);
        });
    }

    // Load line items from the selected Vendor Quotation
    document.addEventListener('DOMContentLoaded', function () {
        const loadBtn = document.getElementById('load-quotation-btn');
        if (loadBtn) {
            loadBtn.addEventListener('click', function () {
                const vendorQuotationId = document.getElementById('vendorQuotation').value;
                if (!vendorQuotationId) {
                    alert('Please select a Vendor Quotation first.');
                    return;
                }

                fetch(`@Url.Action("GetVendorQuotationDetails")?id=${vendorQuotationId}`)
                    .then(response => {
                        if (!response.ok) throw new Error('Failed to load vendor quotation items.');
                        return response.json();
                    })
                    .then(items => {
                        clearDetailRows('po-details-table', 'Details');
                        items.forEach(item => {
                            const row = addDetailRow('po-details-table', 'Details', {
                                MaterialId: item.materialId,
                                OrderedQuantity: item.orderedQuantity,
                                UnitOfMeasure: item.unitOfMeasure,
                                UnitPrice: item.unitPrice,
                                DiscountPercent: item.discountPercent,
                                VatPercent: item.vatPercent,
                                TaxPercent: item.taxPercent
                            });
                            if (row) {
                                initializeDropdownsInRow(row);
                            }
                        });
                        if (items.length === 0) {
                            initDetailTable('po-details-table', 'Details');
                        }
                        updatePurchaseOrderSummary();
                    })
                    .catch(() => alert('Failed to load Vendor Quotation items.'));
            });
        }
    });
</script>
