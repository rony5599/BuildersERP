@using BuilderERP.Application.Common
@using BuilderERP.Shared.Constants
@using BuilderERP.Shared.Authorization
@using BuilderERP.Domain.Entities
@using BuilderERP.Web.Models
@model PagedResult<BuilderERP.Application.DTOs.PurchaseOrderDto>
@{
    var assignment = ViewBag.ActionAssignment as PurchaseOrderActionAssignment;
}

<div class="procurement-table-card">
<div class="table-responsive">

<table class="table procurement-table mb-0">
    <thead>
        <tr>
            <th>PO #</th>
            <th>Supplier</th>
            <th>Quotation</th>
            <th>Total</th>
            <th>Received</th>
            <th>Delivery Date</th>
            <th>Status</th>
            <th>Active</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var order in Model.Items)
        {
            <tr>
                <td>
                    <a asp-action="Details" asp-route-id="@order.Id" class="document-number" title="View purchase order">@order.PONumber</a>
                    <span class="document-subtitle">@order.ProjectName</span>
                </td>
                <td class="fw-medium">@order.SupplierName</td>
                <td><span class="reference-chip">@order.QuotationNumber</span></td>
                <td class="amount-cell">@order.TotalAmount.ToString("N2")</td>
                <td class="amount-cell">@order.ReceivedAmount.ToString("N2")</td>
                <td>@order.DeliveryDate.ToString("yyyy-MM-dd")</td>
                <td>
                    <span class="procurement-status @(order.Status == BuilderERP.Domain.Enums.PurchaseOrderStatus.Draft && !string.IsNullOrWhiteSpace(order.RejectionReason) ? "status-danger" : StatusBadgeClass(order.Status))"><span class="badge-dot"></span>@(order.Status == BuilderERP.Domain.Enums.PurchaseOrderStatus.Draft && !string.IsNullOrWhiteSpace(order.RejectionReason) ? "Revision Required" : HumanizeStatus(order.Status))</span>
                    @if (!string.IsNullOrWhiteSpace(order.RejectionReason)) { <span class="document-subtitle text-danger mt-1" title="@order.RejectionReason"><i class="bi bi-arrow-counterclockwise"></i> Returned: @order.RejectionReason</span> }
                </td>
                <td>
                    <span class="procurement-status @(order.IsActive ? "status-success" : "status-neutral")">
                        <span class="badge-dot"></span>@(order.IsActive ? "Active" : "Inactive")
                    </span>
                </td>
                <td class="text-end">
                    <div class="procurement-actions"><a asp-action="Details" asp-route-id="@order.Id" class="btn btn-sm btn-light" title="View"><i class="bi bi-eye"></i></a><a asp-action="Print" asp-route-id="@order.Id" class="btn btn-sm btn-light" target="_blank" title="Print"><i class="bi bi-printer"></i></a>
                    @if (User.HasClaim(PermissionClaimTypes.Permission, PermissionNames.PurchaseOrderManage))
                    {
                        @if (assignment?.CanDraftEdit == true && order.Status == BuilderERP.Domain.Enums.PurchaseOrderStatus.Draft)
                        {
                            <a asp-action="Edit" asp-route-id="@order.Id" class="btn btn-sm btn-light" title="Edit"><i class="bi bi-pencil"></i></a>
                        }
                        @if (assignment?.CanSubmit == true && order.Status == BuilderERP.Domain.Enums.PurchaseOrderStatus.Draft)
                        {
                            <partial name="_WorkflowButton" model="@(new PurchaseOrderWorkflowButtonViewModel(order.Id, "submit", "Submit", "btn-outline-primary"))" />
                        }
                        @if (assignment?.CanRequestApproval == true && order.Status == BuilderERP.Domain.Enums.PurchaseOrderStatus.Submitted)
                        {
                            <partial name="_WorkflowButton" model="@(new PurchaseOrderWorkflowButtonViewModel(order.Id, "request", "Request approval", "btn-outline-primary"))" />
                        }
                        @if (assignment?.CanApprove == true && order.Status == BuilderERP.Domain.Enums.PurchaseOrderStatus.AwaitingApproval)
                        {
                            <partial name="_WorkflowButton" model="@(new PurchaseOrderWorkflowButtonViewModel(order.Id, "approve", "Approve", "btn-success"))" />
                        }
                        @if (assignment?.CanReject == true && order.Status is BuilderERP.Domain.Enums.PurchaseOrderStatus.Submitted
                            or BuilderERP.Domain.Enums.PurchaseOrderStatus.AwaitingApproval
                            or BuilderERP.Domain.Enums.PurchaseOrderStatus.Approved)
                        {
                            <partial name="_WorkflowButton" model="@(new PurchaseOrderWorkflowButtonViewModel(order.Id, "reject", "Reject", "btn-outline-danger"))" />
                        }
                        @if (assignment?.CanCancel == true && order.Status is BuilderERP.Domain.Enums.PurchaseOrderStatus.Draft or BuilderERP.Domain.Enums.PurchaseOrderStatus.Submitted or BuilderERP.Domain.Enums.PurchaseOrderStatus.AwaitingApproval or BuilderERP.Domain.Enums.PurchaseOrderStatus.Rejected)
                        {
                            <partial name="_WorkflowButton" model="@(new PurchaseOrderWorkflowButtonViewModel(order.Id, "cancel", "Cancel", "btn-outline-danger"))" />
                        }
                        <form asp-action="ToggleActive" asp-route-id="@order.Id" asp-route-isActive="@order.IsActive" method="post" class="d-inline">
                            <button type="submit" class="btn btn-sm btn-light @(order.IsActive ? "text-danger" : "text-success")" title="@(order.IsActive ? "Deactivate" : "Activate")">
                                <i class="bi @(order.IsActive ? "bi-pause-circle" : "bi-play-circle")"></i>
                            </button>
                        </form>
                    }
                    </div>
                </td>
            </tr>
        }
        @if (Model.Items.Count == 0)
        {
            <tr>
                <td colspan="9" class="procurement-empty"><i class="bi bi-inbox"></i><strong>No purchase orders found</strong><span>Try adjusting the filters or create a new purchase order.</span></td>
            </tr>
        }
    </tbody>
</table>
</div>

<div class="procurement-pagination">
<partial name="_Pagination" model="@(new BuilderERP.Web.Models.PaginationViewModel
{
    Page = Model.Page,
    PageSize = Model.PageSize,
    TotalPages = Model.TotalPages,
    TotalCount = Model.TotalCount,
    Action = "Index",
    RouteValues = (Dictionary<string, string?>)(ViewBag.FilterRouteValues ?? new Dictionary<string, string?>())
})" />
</div>
</div>

@functions {
    private static string StatusBadgeClass(BuilderERP.Domain.Enums.PurchaseOrderStatus status) => status switch
    {
        BuilderERP.Domain.Enums.PurchaseOrderStatus.Draft => "status-neutral",
        BuilderERP.Domain.Enums.PurchaseOrderStatus.Submitted => "status-info",
        BuilderERP.Domain.Enums.PurchaseOrderStatus.AwaitingApproval => "status-warning",
        BuilderERP.Domain.Enums.PurchaseOrderStatus.Approved => "status-success",
        BuilderERP.Domain.Enums.PurchaseOrderStatus.Rejected => "status-danger",
        BuilderERP.Domain.Enums.PurchaseOrderStatus.PartiallyReceived => "status-warning",
        BuilderERP.Domain.Enums.PurchaseOrderStatus.Received => "status-success",
        BuilderERP.Domain.Enums.PurchaseOrderStatus.Closed => "status-success",
        BuilderERP.Domain.Enums.PurchaseOrderStatus.Cancelled => "status-danger",
        _ => "status-neutral"
    };

    private static string HumanizeStatus(BuilderERP.Domain.Enums.PurchaseOrderStatus status) =>
        status switch
        {
            BuilderERP.Domain.Enums.PurchaseOrderStatus.PartiallyReceived => "Partially Received",
            BuilderERP.Domain.Enums.PurchaseOrderStatus.AwaitingApproval => "Awaiting Approval",
            _ => status.ToString()
        };
}
