@using BuilderERP.Application.Common
@model PagedResult<BuilderERP.Application.DTOs.CashPurchaseOrderDto>
@using BuilderERP.Shared.Constants
@using BuilderERP.Shared.Authorization
@{
    ViewData["Title"] = "Cash Purchase Orders";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div class="d-flex align-items-center gap-3">
        <h1 class="h3 mb-0">Cash Purchase Orders</h1>
        <partial name="_CashWorkflowHelp" />
    </div>
    @if (User.HasClaim(PermissionClaimTypes.Permission, PermissionNames.CashPurchaseOrderManage))
    {
        <a asp-action="Create" class="btn btn-primary">New Cash Purchase Order</a>
    }
</div>

<div data-grid-container>
    <partial name="_Grid" model="Model" />
</div>
