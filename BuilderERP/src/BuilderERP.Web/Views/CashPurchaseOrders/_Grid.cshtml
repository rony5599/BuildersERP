@using BuilderERP.Application.Common
@using BuilderERP.Shared.Constants
@using BuilderERP.Shared.Authorization
@using Microsoft.AspNetCore.Mvc.Rendering
@using BuilderERP.Domain.Entities
@using BuilderERP.Web.Models
@model PagedResult<BuilderERP.Application.DTOs.CashPurchaseOrderDto>
@{
    var assignment = ViewBag.ActionAssignment as CashPurchaseOrderActionAssignment;
    var cpoNumber = ViewBag.CpoNumber as string;
    var projectId = ViewBag.ProjectId as long?;
    var status = ViewBag.Status as BuilderERP.Domain.Enums.PurchaseOrderStatus?;
    var dateFrom = ViewBag.DateFrom as DateTime?;
    var dateTo = ViewBag.DateTo as DateTime?;
    var hasFilters = !string.IsNullOrWhiteSpace(cpoNumber) || projectId.HasValue || status.HasValue || dateFrom.HasValue || dateTo.HasValue;
}

<div class="card mb-3">
    <div class="card-body">
        <form asp-action="Index" method="get" class="row gy-3 gx-4 align-items-end grid-search-form">
            <div class="col-12 col-sm-6 col-lg-2">
                <label class="form-label small mb-1">CPO #</label>
                <input type="search" name="cpoNumber" value="@cpoNumber" class="form-control" placeholder="CPO #" />
            </div>
            <div class="col-12 col-sm-6 col-lg-2">
                <label class="form-label small mb-1">Project</label>
                <select name="projectId" asp-items="@(ViewBag.Projects as SelectList)" class="form-select">
                    <option value="">All Projects</option>
                </select>
            </div>
            <div class="col-12 col-sm-6 col-lg-2">
                <label class="form-label small mb-1">Status</label>
                <select name="status" asp-items="@(ViewBag.Statuses as SelectList)" class="form-select">
                    <option value="">All Statuses</option>
                </select>
            </div>
            <div class="col-12 col-sm-6 col-lg-2">
                <label class="form-label small mb-1">Date From</label>
                <input type="date" name="dateFrom" value="@(dateFrom?.ToString("yyyy-MM-dd"))" class="form-control" />
            </div>
            <div class="col-12 col-sm-6 col-lg-2">
                <label class="form-label small mb-1">Date To</label>
                <input type="date" name="dateTo" value="@(dateTo?.ToString("yyyy-MM-dd"))" class="form-control" />
            </div>
            <div class="col-12 col-sm-6 col-lg-2 d-flex gap-2">
                <button type="submit" class="btn btn-primary flex-grow-1">Filter</button>
                @if (hasFilters)
                {
                    <a asp-action="Index" class="btn btn-outline-secondary flex-grow-1">Clear</a>
                }
            </div>
        </form>
    </div>
</div>

<div class="card">
    <table class="table table-striped table-hover mb-0">
        <thead>
            <tr>
                <th>CPO #</th>
                <th>Supplier</th>
                <th>Requisition</th>
                <th>Project</th>
                <th>Total</th>
                <th>Received</th>
                <th>Delivery Date</th>
                <th>Status</th>
                <th>Active</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var order in Model.Items)
            {
                <tr>
                    <td>@order.CPONumber</td>
                    <td>@order.SupplierName</td>
                    <td>@order.RequisitionNumber</td>
                    <td>@order.ProjectName</td>
                    <td>@order.TotalAmount</td>
                    <td>@order.ReceivedAmount</td>
                    <td>@order.DeliveryDate.ToString("yyyy-MM-dd")</td>
                    <td>
                        <span class="badge @(order.Status == BuilderERP.Domain.Enums.PurchaseOrderStatus.Draft && !string.IsNullOrWhiteSpace(order.RejectionReason) ? "bg-danger" : StatusBadgeClass(order.Status))"><span class="badge-dot"></span>@(order.Status == BuilderERP.Domain.Enums.PurchaseOrderStatus.Draft && !string.IsNullOrWhiteSpace(order.RejectionReason) ? "Revision Required" : HumanizeStatus(order.Status))</span>
                        @if (!string.IsNullOrWhiteSpace(order.RejectionReason)) { <div class="small text-danger mt-1" title="@order.RejectionReason">Returned: @order.RejectionReason</div> }
                    </td>
                    <td>
                        <span class="badge @(order.IsActive ? "bg-success" : "bg-secondary")">
                            <span class="badge-dot"></span>@(order.IsActive ? "Active" : "Inactive")
                        </span>
                    </td>
                    <td class="text-end">
                        <a asp-action="Print" asp-route-id="@order.Id" class="btn btn-sm btn-outline-primary" target="_blank">Print</a>
                        @if (User.HasClaim(PermissionClaimTypes.Permission, PermissionNames.CashPurchaseOrderManage))
                        {
                            @if (assignment?.CanDraftEdit == true && order.Status == BuilderERP.Domain.Enums.PurchaseOrderStatus.Draft) { <a asp-action="Edit" asp-route-id="@order.Id" class="btn btn-sm btn-outline-secondary">Edit</a> }
                            @if (assignment?.CanSubmit == true && order.Status == BuilderERP.Domain.Enums.PurchaseOrderStatus.Draft) { <partial name="_WorkflowButton" model="@(new CashPurchaseOrderWorkflowButtonViewModel(order.Id, "submit", "Submit", "btn-outline-primary"))" /> }
                            @if (assignment?.CanRequestApproval == true && order.Status == BuilderERP.Domain.Enums.PurchaseOrderStatus.Submitted) { <partial name="_WorkflowButton" model="@(new CashPurchaseOrderWorkflowButtonViewModel(order.Id, "request", "Request approval", "btn-outline-primary"))" /> }
                            @if (assignment?.CanApprove == true && order.Status == BuilderERP.Domain.Enums.PurchaseOrderStatus.AwaitingApproval) { <partial name="_WorkflowButton" model="@(new CashPurchaseOrderWorkflowButtonViewModel(order.Id, "approve", "Approve", "btn-success"))" /> }
                            @if (assignment?.CanReject == true && order.Status is BuilderERP.Domain.Enums.PurchaseOrderStatus.Submitted or BuilderERP.Domain.Enums.PurchaseOrderStatus.AwaitingApproval or BuilderERP.Domain.Enums.PurchaseOrderStatus.Approved) { <partial name="_WorkflowButton" model="@(new CashPurchaseOrderWorkflowButtonViewModel(order.Id, "reject", "Reject", "btn-outline-danger"))" /> }
                            @if (assignment?.CanCancel == true && order.Status is BuilderERP.Domain.Enums.PurchaseOrderStatus.Draft or BuilderERP.Domain.Enums.PurchaseOrderStatus.Submitted or BuilderERP.Domain.Enums.PurchaseOrderStatus.AwaitingApproval or BuilderERP.Domain.Enums.PurchaseOrderStatus.Rejected) { <partial name="_WorkflowButton" model="@(new CashPurchaseOrderWorkflowButtonViewModel(order.Id, "cancel", "Cancel", "btn-outline-danger"))" /> }
                            <form asp-action="ToggleActive" asp-route-id="@order.Id" asp-route-isActive="@order.IsActive" method="post" class="d-inline">
                                <button type="submit" class="btn btn-sm btn-outline-danger">
                                    @(order.IsActive ? "Deactivate" : "Activate")
                                </button>
                            </form>
                        }
                    </td>
                </tr>
            }
            @if (Model.Items.Count == 0)
            {
                <tr>
                    <td colspan="10" class="text-center text-muted">No cash purchase orders found.</td>
                </tr>
            }
        </tbody>
    </table>
    <div class="card-body pt-2">
        <partial name="_Pagination" model="@(new BuilderERP.Web.Models.PaginationViewModel
        {
            Page = Model.Page,
            PageSize = Model.PageSize,
            TotalPages = Model.TotalPages,
            TotalCount = Model.TotalCount,
            Action = "Index",
            RouteValues = BuildFilterRouteValues(cpoNumber, projectId, status, dateFrom, dateTo)
        })" />
    </div>
</div>

@functions {
    private static Dictionary<string, string?> BuildFilterRouteValues(string? cpoNumber, long? projectId, BuilderERP.Domain.Enums.PurchaseOrderStatus? status, DateTime? dateFrom, DateTime? dateTo)
    {
        var values = new Dictionary<string, string?>();
        if (!string.IsNullOrWhiteSpace(cpoNumber)) values["cpoNumber"] = cpoNumber;
        if (projectId.HasValue) values["projectId"] = projectId.Value.ToString();
        if (status.HasValue) values["status"] = status.Value.ToString();
        if (dateFrom.HasValue) values["dateFrom"] = dateFrom.Value.ToString("yyyy-MM-dd");
        if (dateTo.HasValue) values["dateTo"] = dateTo.Value.ToString("yyyy-MM-dd");
        return values;
    }

    private static string StatusBadgeClass(BuilderERP.Domain.Enums.PurchaseOrderStatus status) => status switch
    {
        BuilderERP.Domain.Enums.PurchaseOrderStatus.Draft => "bg-secondary",
        BuilderERP.Domain.Enums.PurchaseOrderStatus.Submitted => "bg-primary",
        BuilderERP.Domain.Enums.PurchaseOrderStatus.AwaitingApproval => "bg-warning",
        BuilderERP.Domain.Enums.PurchaseOrderStatus.Approved => "bg-primary",
        BuilderERP.Domain.Enums.PurchaseOrderStatus.Rejected => "bg-danger",
        BuilderERP.Domain.Enums.PurchaseOrderStatus.PartiallyReceived => "bg-warning",
        BuilderERP.Domain.Enums.PurchaseOrderStatus.Received => "bg-success",
        BuilderERP.Domain.Enums.PurchaseOrderStatus.Closed => "bg-secondary",
        BuilderERP.Domain.Enums.PurchaseOrderStatus.Cancelled => "bg-danger",
        _ => "bg-secondary"
    };
    private static string HumanizeStatus(BuilderERP.Domain.Enums.PurchaseOrderStatus status) => status switch
    {
        BuilderERP.Domain.Enums.PurchaseOrderStatus.AwaitingApproval => "Awaiting Approval",
        BuilderERP.Domain.Enums.PurchaseOrderStatus.PartiallyReceived => "Partially Received",
        _ => status.ToString()
    };
}
