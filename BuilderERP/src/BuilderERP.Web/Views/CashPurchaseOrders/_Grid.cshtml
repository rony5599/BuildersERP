@using BuilderERP.Application.Common
@model PagedResult<BuilderERP.Application.DTOs.CashPurchaseOrderDto>
@using BuilderERP.Shared.Constants
@using BuilderERP.Shared.Authorization

<table class="table table-striped table-hover bg-white">
    <thead>
        <tr>
            <th>CPO #</th>
            <th>Supplier</th>
            <th>Requisition</th>
            <th>Total</th>
            <th>Received</th>
            <th>Delivery Date</th>
            <th>Status</th>
            <th>Active</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var order in Model.Items)
        {
            <tr>
                <td>@order.CPONumber</td>
                <td>@order.SupplierName</td>
                <td>@order.RequisitionNumber</td>
                <td>@order.TotalAmount</td>
                <td>@order.ReceivedAmount</td>
                <td>@order.DeliveryDate.ToString("yyyy-MM-dd")</td>
                <td>@order.Status</td>
                <td>
                    <span class="badge @(order.IsActive ? "bg-success" : "bg-secondary")">
                        @(order.IsActive ? "Active" : "Inactive")
                    </span>
                </td>
                <td class="text-end">
                    <a asp-action="Print" asp-route-id="@order.Id" class="btn btn-sm btn-outline-primary" target="_blank">Print</a>
                    @if (User.HasClaim(PermissionClaimTypes.Permission, PermissionNames.CashPurchaseOrderManage))
                    {
                        <a asp-action="Edit" asp-route-id="@order.Id" class="btn btn-sm btn-outline-secondary">Edit</a>
                        <form asp-action="ToggleActive" asp-route-id="@order.Id" asp-route-isActive="@order.IsActive" method="post" class="d-inline">
                            <button type="submit" class="btn btn-sm btn-outline-danger">
                                @(order.IsActive ? "Deactivate" : "Activate")
                            </button>
                        </form>
                    }
                </td>
            </tr>
        }
        @if (Model.Items.Count == 0)
        {
            <tr>
                <td colspan="9" class="text-center text-muted">No cash purchase orders found.</td>
            </tr>
        }
    </tbody>
</table>

<partial name="_Pagination" model="@(new BuilderERP.Web.Models.PaginationViewModel
{
    Page = Model.Page,
    PageSize = Model.PageSize,
    TotalPages = Model.TotalPages,
    TotalCount = Model.TotalCount,
    Action = "Index",
    RouteValues = new()
})" />
