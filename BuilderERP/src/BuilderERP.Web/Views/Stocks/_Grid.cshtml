@using BuilderERP.Application.Common
@using BuilderERP.Shared.Constants
@using BuilderERP.Shared.Authorization
@model PagedResult<BuilderERP.Application.DTOs.StockDto>

<table class="table table-striped table-hover bg-white">
    <thead>
        <tr>
            <th>Material</th>
            <th>Project</th>
            <th>Warehouse</th>
            <th>Quantity On Hand</th>
            <th>Reorder Level</th>
            <th>Active</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var stock in Model.Items)
        {
            <tr class="@(stock.IsBelowReorderLevel ? "table-warning" : "")">
                <td>@stock.MaterialCode - @stock.MaterialName</td>
                <td>@stock.ProjectName</td>
                <td>@stock.WarehouseName</td>
                <td>@stock.QuantityOnHand</td>
                <td>
                    @stock.ReorderLevel
                    @if (stock.IsBelowReorderLevel)
                    {
                        <span class="badge bg-warning text-dark">Below Reorder Level</span>
                    }
                </td>
                <td>
                    <span class="badge @(stock.IsActive ? "bg-success" : "bg-secondary")">
                        @(stock.IsActive ? "Active" : "Inactive")
                    </span>
                </td>
                <td class="text-end">
                    @if (User.HasClaim(PermissionClaimTypes.Permission, PermissionNames.StockManage))
                    {
                        <form asp-action="ToggleActive" asp-route-id="@stock.Id" asp-route-isActive="@stock.IsActive" method="post" class="d-inline">
                            <button type="submit" class="btn btn-sm btn-outline-danger">
                                @(stock.IsActive ? "Deactivate" : "Activate")
                            </button>
                        </form>
                    }
                </td>
            </tr>
        }
        @if (Model.Items.Count == 0)
        {
            <tr>
                <td colspan="7" class="text-center text-muted">No stock records found.</td>
            </tr>
        }
    </tbody>
</table>

<partial name="_Pagination" model="@(new BuilderERP.Web.Models.PaginationViewModel
{
    Page = Model.Page,
    PageSize = Model.PageSize,
    TotalPages = Model.TotalPages,
    TotalCount = Model.TotalCount,
    Action = "Index",
    RouteValues = new Dictionary<string, string?> { ["projectId"] = ViewBag.SelectedProjectId?.ToString() }
})" />
