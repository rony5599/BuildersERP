@using BuilderERP.Application.Common
@using BuilderERP.Shared.Constants
@using BuilderERP.Shared.Authorization
@using Microsoft.AspNetCore.Mvc.Rendering
@model PagedResult<BuilderERP.Application.DTOs.StockDto>
@{
    var projectId = ViewBag.SelectedProjectId as long?;
    var materialId = ViewBag.SelectedMaterialId as long?;
    var warehouseId = ViewBag.SelectedWarehouseId as long?;
    var isActive = ViewBag.IsActive as bool?;
    var hasFilters = projectId.HasValue || materialId.HasValue || warehouseId.HasValue || isActive.HasValue;
}

<div class="card mb-3">
    <div class="card-body">
        <form asp-action="Index" method="get" class="row gy-3 gx-4 align-items-end grid-search-form">
            <div class="col-12 col-sm-6 col-lg-2">
                <label class="form-label small mb-1">Project</label>
                <select name="projectId" asp-items="@(ViewBag.Projects as SelectList)" class="form-select">
                    <option value="">All Projects</option>
                </select>
            </div>
            <div class="col-12 col-sm-6 col-lg-2">
                <label class="form-label small mb-1">Material</label>
                <select name="materialId" asp-items="@(ViewBag.Materials as SelectList)" class="form-select">
                    <option value="">All Materials</option>
                </select>
            </div>
            <div class="col-12 col-sm-6 col-lg-2">
                <label class="form-label small mb-1">Warehouse</label>
                <select name="warehouseId" asp-items="@(ViewBag.Warehouses as SelectList)" class="form-select">
                    <option value="">All Warehouses</option>
                </select>
            </div>
            <div class="col-12 col-sm-6 col-lg-2">
                <label class="form-label small mb-1">Status</label>
                <select name="isActive" class="form-select">
                    <option value="">All Statuses</option>
                    @if (isActive == true)
                    {
                        <option value="true" selected>Active</option>
                    }
                    else
                    {
                        <option value="true">Active</option>
                    }
                    @if (isActive == false)
                    {
                        <option value="false" selected>Inactive</option>
                    }
                    else
                    {
                        <option value="false">Inactive</option>
                    }
                </select>
            </div>
            <div class="col-12 col-sm-6 col-lg-2 d-flex gap-2">
                <button type="submit" class="btn btn-primary flex-grow-1">Filter</button>
                @if (hasFilters)
                {
                    <a asp-action="Index" class="btn btn-outline-secondary flex-grow-1">Clear</a>
                }
            </div>
        </form>
    </div>
</div>

<div class="card">
    <table class="table table-striped table-hover mb-0">
        <thead>
            <tr>
                <th>Material</th>
                <th>Project</th>
                <th>Warehouse</th>
                <th>Quantity On Hand</th>
                <th>Reorder Level</th>
                <th>Active</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var stock in Model.Items)
            {
                <tr class="@(stock.IsBelowReorderLevel ? "table-warning" : "")">
                    <td>@stock.MaterialCode - @stock.MaterialName</td>
                    <td>@stock.ProjectName</td>
                    <td>@stock.WarehouseName</td>
                    <td>@stock.QuantityOnHand</td>
                    <td>
                        @stock.ReorderLevel
                        @if (stock.IsBelowReorderLevel)
                        {
                            <span class="badge bg-warning text-dark">Below Reorder Level</span>
                        }
                    </td>
                    <td>
                        <span class="badge @(stock.IsActive ? "bg-success" : "bg-secondary")">
                            <span class="badge-dot"></span>@(stock.IsActive ? "Active" : "Inactive")
                        </span>
                    </td>
                    <td class="text-end">
                        @if (User.HasClaim(PermissionClaimTypes.Permission, PermissionNames.StockManage))
                        {
                            <form asp-action="ToggleActive" asp-route-id="@stock.Id" asp-route-isActive="@stock.IsActive" method="post" class="d-inline">
                                <button type="submit" class="btn btn-sm btn-outline-danger">
                                    @(stock.IsActive ? "Deactivate" : "Activate")
                                </button>
                            </form>
                        }
                    </td>
                </tr>
            }
            @if (Model.Items.Count == 0)
            {
                <tr>
                    <td colspan="7" class="text-center text-muted">No stock records found.</td>
                </tr>
            }
        </tbody>
    </table>
    <div class="card-body pt-2">
        <partial name="_Pagination" model="@(new BuilderERP.Web.Models.PaginationViewModel
        {
            Page = Model.Page,
            PageSize = Model.PageSize,
            TotalPages = Model.TotalPages,
            TotalCount = Model.TotalCount,
            Action = "Index",
            RouteValues = BuildFilterRouteValues(projectId, materialId, warehouseId, isActive)
        })" />
    </div>
</div>

@functions {
    private static Dictionary<string, string?> BuildFilterRouteValues(long? projectId, long? materialId, long? warehouseId, bool? isActive)
    {
        var values = new Dictionary<string, string?>();
        if (projectId.HasValue) values["projectId"] = projectId.Value.ToString();
        if (materialId.HasValue) values["materialId"] = materialId.Value.ToString();
        if (warehouseId.HasValue) values["warehouseId"] = warehouseId.Value.ToString();
        if (isActive.HasValue) values["isActive"] = isActive.Value.ToString();
        return values;
    }
}
