@model IReadOnlyList<BuilderERP.Application.DTOs.StockDto>
@using BuilderERP.Shared.Constants
@using BuilderERP.Shared.Authorization
@{
    ViewData["Title"] = "Stock";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Stock</h1>
</div>

<table class="table table-striped table-hover bg-white">
    <thead>
        <tr>
            <th>Material</th>
            <th>Warehouse</th>
            <th>Quantity On Hand</th>
            <th>Reorder Level</th>
            <th>Active</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var stock in Model)
        {
            <tr class="@(stock.IsBelowReorderLevel ? "table-warning" : "")">
                <td>@stock.MaterialCode - @stock.MaterialName</td>
                <td>@stock.WarehouseName</td>
                <td>@stock.QuantityOnHand</td>
                <td>
                    @stock.ReorderLevel
                    @if (stock.IsBelowReorderLevel)
                    {
                        <span class="badge bg-warning text-dark">Below Reorder Level</span>
                    }
                </td>
                <td>
                    <span class="badge @(stock.IsActive ? "bg-success" : "bg-secondary")">
                        @(stock.IsActive ? "Active" : "Inactive")
                    </span>
                </td>
                <td class="text-end">
                    @if (User.HasClaim(PermissionClaimTypes.Permission, PermissionNames.StockManage))
                    {
                        <form asp-action="ToggleActive" asp-route-id="@stock.Id" asp-route-isActive="@stock.IsActive" method="post" class="d-inline">
                            <button type="submit" class="btn btn-sm btn-outline-danger">
                                @(stock.IsActive ? "Deactivate" : "Activate")
                            </button>
                        </form>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>
