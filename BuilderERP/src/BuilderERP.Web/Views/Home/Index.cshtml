@using BuilderERP.Shared.Constants
@using BuilderERP.Shared.Authorization
@{
    ViewData["Title"] = "Dashboard";
}

<div class="page-hero">
    <div class="app-breadcrumb mb-2"><i class="bi bi-house-door me-1"></i>Home <span class="mx-1">/</span> Dashboard</div>
    <h1>Dashboard</h1>
    <p class="mb-0 opacity-75">Welcome back, @User.Identity?.Name.</p>
</div>

<div class="row g-3 mb-4">
    <div class="col-sm-6 col-xl-3">
        <div class="stat-card">
            <div class="stat-card-body">
                <div>
                    <div class="stat-value">—</div>
                    <div class="stat-label">Active Projects</div>
                </div>
                <span class="stat-icon stat-card-indigo"><i class="bi bi-kanban"></i></span>
            </div>
            <a asp-controller="Projects" asp-action="Index" class="stat-footer stat-card-indigo">
                View projects <i class="bi bi-arrow-right"></i>
            </a>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="stat-card">
            <div class="stat-card-body">
                <div>
                    <div class="stat-value">—</div>
                    <div class="stat-label">Customers</div>
                </div>
                <span class="stat-icon stat-card-success"><i class="bi bi-person-badge"></i></span>
            </div>
            <a asp-controller="Customers" asp-action="Index" class="stat-footer stat-card-success">
                View customers <i class="bi bi-arrow-right"></i>
            </a>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="stat-card">
            <div class="stat-card-body">
                <div>
                    <div class="stat-value">—</div>
                    <div class="stat-label">Open Purchase Orders</div>
                </div>
                <span class="stat-icon stat-card-danger"><i class="bi bi-cart-check"></i></span>
            </div>
            <a asp-controller="PurchaseOrders" asp-action="Index" class="stat-footer stat-card-danger">
                View orders <i class="bi bi-arrow-right"></i>
            </a>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="stat-card">
            <div class="stat-card-body">
                <div>
                    <div class="stat-value">—</div>
                    <div class="stat-label">Pending Installments</div>
                </div>
                <span class="stat-icon stat-card-primary"><i class="bi bi-cash-stack"></i></span>
            </div>
            <a asp-controller="Installments" asp-action="Index" class="stat-footer stat-card-primary">
                View installments <i class="bi bi-arrow-right"></i>
            </a>
        </div>
    </div>
</div>

<div class="card">
    <div class="card-body">
        <h2 class="h6 mb-3">Quick Links</h2>
        <div class="row g-3">
            @if (User.HasClaim(PermissionClaimTypes.Permission, PermissionNames.CustomerView))
            {
                <div class="col-sm-6 col-lg-4 col-xl-3">
                    <a asp-controller="Customers" asp-action="Index" class="quick-link-tile">
                        <span class="quick-link-icon"><i class="bi bi-person-badge"></i></span>
                        <span>
                            <span class="d-block quick-link-title">Customers</span>
                            <span class="quick-link-subtitle">CRM</span>
                        </span>
                    </a>
                </div>
            }
            @if (User.HasClaim(PermissionClaimTypes.Permission, PermissionNames.ProjectView))
            {
                <div class="col-sm-6 col-lg-4 col-xl-3">
                    <a asp-controller="Projects" asp-action="Index" class="quick-link-tile">
                        <span class="quick-link-icon"><i class="bi bi-kanban"></i></span>
                        <span>
                            <span class="d-block quick-link-title">Projects</span>
                            <span class="quick-link-subtitle">Administration</span>
                        </span>
                    </a>
                </div>
            }
            @if (User.HasClaim(PermissionClaimTypes.Permission, PermissionNames.PropertyUnitView))
            {
                <div class="col-sm-6 col-lg-4 col-xl-3">
                    <a asp-controller="PropertyUnits" asp-action="Index" class="quick-link-tile">
                        <span class="quick-link-icon"><i class="bi bi-door-closed"></i></span>
                        <span>
                            <span class="d-block quick-link-title">Property Units</span>
                            <span class="quick-link-subtitle">Property Management</span>
                        </span>
                    </a>
                </div>
            }
            @if (User.HasClaim(PermissionClaimTypes.Permission, PermissionNames.PurchaseOrderView))
            {
                <div class="col-sm-6 col-lg-4 col-xl-3">
                    <a asp-controller="PurchaseOrders" asp-action="Index" class="quick-link-tile">
                        <span class="quick-link-icon"><i class="bi bi-cart-check"></i></span>
                        <span>
                            <span class="d-block quick-link-title">Purchase Orders</span>
                            <span class="quick-link-subtitle">Procurement</span>
                        </span>
                    </a>
                </div>
            }
            @if (User.HasClaim(PermissionClaimTypes.Permission, PermissionNames.MaterialView))
            {
                <div class="col-sm-6 col-lg-4 col-xl-3">
                    <a asp-controller="Materials" asp-action="Index" class="quick-link-tile">
                        <span class="quick-link-icon"><i class="bi bi-boxes"></i></span>
                        <span>
                            <span class="d-block quick-link-title">Materials</span>
                            <span class="quick-link-subtitle">Inventory</span>
                        </span>
                    </a>
                </div>
            }
            @if (User.HasClaim(PermissionClaimTypes.Permission, PermissionNames.InstallmentView))
            {
                <div class="col-sm-6 col-lg-4 col-xl-3">
                    <a asp-controller="Installments" asp-action="Index" class="quick-link-tile">
                        <span class="quick-link-icon"><i class="bi bi-cash-stack"></i></span>
                        <span>
                            <span class="d-block quick-link-title">Installments</span>
                            <span class="quick-link-subtitle">Installments</span>
                        </span>
                    </a>
                </div>
            }
            @if (User.HasClaim(PermissionClaimTypes.Permission, PermissionNames.QuotationView))
            {
                <div class="col-sm-6 col-lg-4 col-xl-3">
                    <a asp-controller="Quotations" asp-action="Index" class="quick-link-tile">
                        <span class="quick-link-icon"><i class="bi bi-file-earmark-text"></i></span>
                        <span>
                            <span class="d-block quick-link-title">Quotations</span>
                            <span class="quick-link-subtitle">Sales</span>
                        </span>
                    </a>
                </div>
            }
            @if (User.HasClaim(PermissionClaimTypes.Permission, PermissionNames.SupplierView))
            {
                <div class="col-sm-6 col-lg-4 col-xl-3">
                    <a asp-controller="Suppliers" asp-action="Index" class="quick-link-tile">
                        <span class="quick-link-icon"><i class="bi bi-truck"></i></span>
                        <span>
                            <span class="d-block quick-link-title">Suppliers</span>
                            <span class="quick-link-subtitle">Procurement</span>
                        </span>
                    </a>
                </div>
            }
        </div>
    </div>
</div>
