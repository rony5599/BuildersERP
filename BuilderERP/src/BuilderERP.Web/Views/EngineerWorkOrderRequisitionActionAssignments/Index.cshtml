@model BuilderERP.Web.Models.EngineerWorkOrderRequisitionActionAssignmentPageViewModel
@{ ViewData["Title"] = "EWO Requisition Action Assignment"; }

<div class="d-flex justify-content-between align-items-start mb-4">
    <div><div class="text-primary small mb-1">Administration / Action Assignment</div><h1 class="h3 mb-1">User-wise Action Assignment</h1><p class="text-muted mb-0">Control who can move Engineer Work Order Requisitions through each approval stage.</p></div>
    <a asp-controller="Users" asp-action="Create" asp-route-returnUrl="@Url.Action("Index", "EngineerWorkOrderRequisitionActionAssignments")" class="btn btn-primary"><i class="bi bi-person-plus"></i> Add new user</a>
</div>
@if (TempData["StatusMessage"] is string statusMessage) { <div class="alert alert-success">@statusMessage</div> }
<div class="card shadow-sm border-0">
    <div class="card-header bg-white py-3"><h2 class="h6 mb-1">EWO Requisition permission matrix</h2><div class="small text-muted">Tick the actions each active user may perform. Permissions are enforced on the server.</div></div>
    <form asp-action="Index" method="post">
        <div class="table-responsive"><table class="table table-hover align-middle mb-0"><thead class="table-light small text-uppercase"><tr><th>User</th><th>Role</th><th class="text-center">Draft / Edit</th><th class="text-center">Submit</th><th class="text-center">Request approval</th><th class="text-center">Approve</th><th class="text-center">Reject</th><th class="text-center">Cancel</th></tr></thead><tbody>
        @for (var i = 0; i < Model.Users.Count; i++)
        {
            <tr><td><input asp-for="Users[i].UserId" type="hidden" /><div class="fw-semibold">@Model.Users[i].FullName</div><div class="small text-muted">@Model.Users[i].Email</div></td><td><span class="badge bg-secondary">@Model.Users[i].Role</span></td><td class="text-center"><input asp-for="Users[i].CanDraftEdit" class="form-check-input" /></td><td class="text-center"><input asp-for="Users[i].CanSubmit" class="form-check-input" /></td><td class="text-center"><input asp-for="Users[i].CanRequestApproval" class="form-check-input" /></td><td class="text-center"><input asp-for="Users[i].CanApprove" class="form-check-input" /></td><td class="text-center"><input asp-for="Users[i].CanReject" class="form-check-input" /></td><td class="text-center"><input asp-for="Users[i].CanCancel" class="form-check-input" /></td></tr>
        }
        </tbody></table></div>
        <div class="card-footer bg-white d-flex justify-content-between align-items-center py-3"><span class="small text-muted"><strong>Recommended:</strong> keep requesters and approvers as different users.</span><button type="submit" class="btn btn-primary"><i class="bi bi-check2"></i> Save assignments</button></div>
    </form>
</div>
<div class="card shadow-sm border-0 mt-3"><div class="card-body"><h2 class="h6">Workflow route</h2><div class="d-flex flex-wrap align-items-center gap-2 small"><span class="badge bg-secondary">Draft</span><i class="bi bi-chevron-right"></i><span class="badge bg-primary">Submitted</span><i class="bi bi-chevron-right"></i><span class="badge bg-warning">Awaiting approval</span><i class="bi bi-chevron-right"></i><span class="badge bg-success">Approved</span><span class="text-muted ms-2">or</span><span class="badge bg-danger">Rejected / Cancelled</span></div></div></div>
