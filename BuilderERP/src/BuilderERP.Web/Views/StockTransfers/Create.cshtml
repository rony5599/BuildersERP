@model BuilderERP.Application.DTOs.CreateStockTransferDto
@{
    ViewData["Title"] = "New Stock Transfer";
}

@section Styles {
    <link rel="stylesheet" href="~/css/multicolumn-dropdown.css" asp-append-version="true" />
}

<h1 class="h3 mb-4">New Stock Transfer</h1>

<form asp-action="Create" method="post" class="col-md-6">
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
    <div class="mb-3">
        <label asp-for="TransferNumber" class="form-label"></label>
        <input asp-for="TransferNumber" class="form-control" />
        <span asp-validation-for="TransferNumber" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="MaterialId" class="form-label"></label>
        <div class="multicolumn-dropdown-wrapper">
            <div class="multicolumn-dropdown-container" id="material-container">
                <input type="hidden" asp-for="MaterialId" id="material" value="" />
                <div class="multicolumn-dropdown-trigger">
                    <input type="text"
                           class="multicolumn-dropdown-filter form-control"
                           placeholder="Search Material..."
                           autocomplete="off"
                           id="material-filter" />
                    <span class="multicolumn-dropdown-icon">
                        <i class="bi bi-chevron-down"></i>
                    </span>
                </div>
                <div class="multicolumn-dropdown-menu" id="material-menu" style="display: none;">
                    <div class="multicolumn-dropdown-header">
                        <div class="multicolumn-dropdown-column">Code</div>
                        <div class="multicolumn-dropdown-column">Name</div>
                        <div class="multicolumn-dropdown-column">Category</div>
                    </div>
                    <div class="multicolumn-dropdown-items">
                        @foreach (var material in (IEnumerable<dynamic>)ViewBag.Materials ?? new List<dynamic>())
                        {
                            var parts = material.Text?.Split(" | ") ?? new[] { "", "", "" };
                            <div class="multicolumn-dropdown-item" data-value="@material.Value">
                                <div class="multicolumn-dropdown-column">@(parts.Length > 0 ? parts[0]?.Trim() ?? "" : "")</div>
                                <div class="multicolumn-dropdown-column">@(parts.Length > 1 ? parts[1]?.Trim() ?? "" : "")</div>
                                <div class="multicolumn-dropdown-column">@(parts.Length > 2 ? parts[2]?.Trim() ?? "" : "")</div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
        <span asp-validation-for="MaterialId" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="FromWarehouseId" class="form-label"></label>
        <div class="multicolumn-dropdown-wrapper">
            <div class="multicolumn-dropdown-container" id="fromWarehouse-container">
                <input type="hidden" asp-for="FromWarehouseId" id="fromWarehouse" value="" />
                <div class="multicolumn-dropdown-trigger">
                    <input type="text"
                           class="multicolumn-dropdown-filter form-control"
                           placeholder="Search Warehouse..."
                           autocomplete="off"
                           id="fromWarehouse-filter" />
                    <span class="multicolumn-dropdown-icon">
                        <i class="bi bi-chevron-down"></i>
                    </span>
                </div>
                <div class="multicolumn-dropdown-menu" id="fromWarehouse-menu" style="display: none;">
                    <div class="multicolumn-dropdown-header">
                        <div class="multicolumn-dropdown-column">Warehouse Name</div>
                        <div class="multicolumn-dropdown-column">Project Name</div>
                    </div>
                    <div class="multicolumn-dropdown-items">
                        @foreach (var warehouse in (IEnumerable<dynamic>)ViewBag.Warehouses ?? new List<dynamic>())
                        {
                            var parts = warehouse.Text?.Split(" | ") ?? new[] { "", "" };
                            <div class="multicolumn-dropdown-item" data-value="@warehouse.Value">
                                <div class="multicolumn-dropdown-column">@(parts.Length > 0 ? parts[0]?.Trim() ?? "" : "")</div>
                                <div class="multicolumn-dropdown-column">@(parts.Length > 1 ? parts[1]?.Trim() ?? "" : "")</div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
        <span asp-validation-for="FromWarehouseId" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="ToWarehouseId" class="form-label"></label>
        <div class="multicolumn-dropdown-wrapper">
            <div class="multicolumn-dropdown-container" id="toWarehouse-container">
                <input type="hidden" asp-for="ToWarehouseId" id="toWarehouse" value="" />
                <div class="multicolumn-dropdown-trigger">
                    <input type="text"
                           class="multicolumn-dropdown-filter form-control"
                           placeholder="Search Warehouse..."
                           autocomplete="off"
                           id="toWarehouse-filter" />
                    <span class="multicolumn-dropdown-icon">
                        <i class="bi bi-chevron-down"></i>
                    </span>
                </div>
                <div class="multicolumn-dropdown-menu" id="toWarehouse-menu" style="display: none;">
                    <div class="multicolumn-dropdown-header">
                        <div class="multicolumn-dropdown-column">Warehouse Name</div>
                        <div class="multicolumn-dropdown-column">Project Name</div>
                    </div>
                    <div class="multicolumn-dropdown-items">
                        @foreach (var warehouse in (IEnumerable<dynamic>)ViewBag.Warehouses ?? new List<dynamic>())
                        {
                            var parts = warehouse.Text?.Split(" | ") ?? new[] { "", "" };
                            <div class="multicolumn-dropdown-item" data-value="@warehouse.Value">
                                <div class="multicolumn-dropdown-column">@(parts.Length > 0 ? parts[0]?.Trim() ?? "" : "")</div>
                                <div class="multicolumn-dropdown-column">@(parts.Length > 1 ? parts[1]?.Trim() ?? "" : "")</div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
        <span asp-validation-for="ToWarehouseId" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="TransferDate" class="form-label"></label>
        <input asp-for="TransferDate" type="date" class="form-control" />
    </div>
    <div class="mb-3">
        <label asp-for="Quantity" class="form-label"></label>
        <input asp-for="Quantity" class="form-control" />
        <span asp-validation-for="Quantity" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Remarks" class="form-label"></label>
        <textarea asp-for="Remarks" class="form-control"></textarea>
        <span asp-validation-for="Remarks" class="text-danger"></span>
    </div>
    <button type="submit" class="btn btn-primary">Save</button>
    <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
</form>

<script src="~/js/multicolumn-dropdown.js" asp-append-version="true"></script>
<script>
    document.addEventListener('DOMContentLoaded', function () {
        new MultiColumnDropdown('material-container');
        new MultiColumnDropdown('fromWarehouse-container');
        new MultiColumnDropdown('toWarehouse-container');
    });
</script>
