@model BuilderERP.Application.DTOs.CreateStockTransferDto
@{
    ViewData["Title"] = "New Stock Transfer";
}

<h1 class="h3 mb-4">New Stock Transfer</h1>

<form asp-action="Create" method="post" class="col-md-6">
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
    <div class="mb-3">
        <label asp-for="TransferNumber" class="form-label"></label>
        <input asp-for="TransferNumber" class="form-control" />
        <span asp-validation-for="TransferNumber" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="MaterialId" class="form-label"></label>
        <select asp-for="MaterialId" asp-items="ViewBag.Materials" class="form-select">
            <option value="">-- Select Material --</option>
        </select>
        <span asp-validation-for="MaterialId" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="FromWarehouseId" class="form-label"></label>
        <select asp-for="FromWarehouseId" asp-items="ViewBag.Warehouses" class="form-select">
            <option value="">-- Select Warehouse --</option>
        </select>
        <span asp-validation-for="FromWarehouseId" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="ToWarehouseId" class="form-label"></label>
        <select asp-for="ToWarehouseId" asp-items="ViewBag.Warehouses" class="form-select">
            <option value="">-- Select Warehouse --</option>
        </select>
        <span asp-validation-for="ToWarehouseId" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="TransferDate" class="form-label"></label>
        <input asp-for="TransferDate" type="date" class="form-control" />
    </div>
    <div class="mb-3">
        <label asp-for="Quantity" class="form-label"></label>
        <input asp-for="Quantity" class="form-control" />
        <span asp-validation-for="Quantity" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Remarks" class="form-label"></label>
        <textarea asp-for="Remarks" class="form-control"></textarea>
        <span asp-validation-for="Remarks" class="text-danger"></span>
    </div>
    <button type="submit" class="btn btn-primary">Save</button>
    <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
</form>
