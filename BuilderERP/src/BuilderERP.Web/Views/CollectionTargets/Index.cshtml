@model IReadOnlyList<BuilderERP.Application.DTOs.CollectionTargetDto>
@using BuilderERP.Shared.Constants
@using BuilderERP.Shared.Authorization
@{
    ViewData["Title"] = "Collection Targets";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Collection Officer Targets</h1>
    @if (User.HasClaim(PermissionClaimTypes.Permission, PermissionNames.CollectionTargetManage))
    {
        <a asp-action="Create" class="btn btn-primary">New Target</a>
    }
</div>

<table class="table table-striped table-hover bg-white">
    <thead>
        <tr>
            <th>Officer</th>
            <th>Period</th>
            <th>Target</th>
            <th>Actual Collected</th>
            <th>Achievement</th>
            <th>Active</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var target in Model)
        {
            <tr>
                <td>@target.CollectionOfficerName</td>
                <td>@target.Year-@target.Month.ToString("D2")</td>
                <td>@target.TargetAmount.ToString("N2")</td>
                <td>@target.ActualCollected.ToString("N2")</td>
                <td>
                    <div class="progress" style="height: 18px; min-width: 100px;">
                        <div class="progress-bar @(target.AchievementPercent >= 100 ? "bg-success" : target.AchievementPercent >= 50 ? "bg-primary" : "bg-warning")" role="progressbar"
                             style="width: @(Math.Min(target.AchievementPercent, 100))%;">
                            @target.AchievementPercent%
                        </div>
                    </div>
                </td>
                <td>
                    <span class="badge @(target.IsActive ? "bg-success" : "bg-secondary")">
                        @(target.IsActive ? "Active" : "Inactive")
                    </span>
                </td>
                <td class="text-end">
                    @if (User.HasClaim(PermissionClaimTypes.Permission, PermissionNames.CollectionTargetManage))
                    {
                        <a asp-action="Edit" asp-route-id="@target.Id" class="btn btn-sm btn-outline-secondary">Edit</a>
                        <form asp-action="ToggleActive" asp-route-id="@target.Id" asp-route-isActive="@target.IsActive" method="post" class="d-inline">
                            <button type="submit" class="btn btn-sm btn-outline-danger">
                                @(target.IsActive ? "Deactivate" : "Activate")
                            </button>
                        </form>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>
