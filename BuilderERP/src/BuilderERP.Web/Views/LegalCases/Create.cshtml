@model BuilderERP.Application.DTOs.CreateLegalCaseDto
@using BuilderERP.Domain.Enums
@{
    ViewData["Title"] = "New Legal Case";
}

<h1 class="h3 mb-4">New Legal Case</h1>

<form asp-action="Create" method="post" class="col-md-6">
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
    <div class="mb-3">
        <label asp-for="ProjectId" class="form-label">Project</label>
        <select asp-for="ProjectId" asp-items="ViewBag.Projects" class="form-select">
            <option value="">-- Select Project --</option>
        </select>
        <span asp-validation-for="ProjectId" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="CaseNumber" class="form-label"></label>
        <input asp-for="CaseNumber" class="form-control" />
        <span asp-validation-for="CaseNumber" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="CaseTitle" class="form-label"></label>
        <input asp-for="CaseTitle" class="form-control" />
        <span asp-validation-for="CaseTitle" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="CourtName" class="form-label"></label>
        <input asp-for="CourtName" class="form-control" />
        <span asp-validation-for="CourtName" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="CaseType" class="form-label"></label>
        <select asp-for="CaseType" asp-items="Html.GetEnumSelectList<LegalCaseType>()" class="form-select"></select>
        <span asp-validation-for="CaseType" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="FilingDate" class="form-label"></label>
        <input asp-for="FilingDate" type="date" class="form-control" />
        <span asp-validation-for="FilingDate" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Status" class="form-label"></label>
        <select asp-for="Status" asp-items="Html.GetEnumSelectList<LegalCaseStatus>()" class="form-select"></select>
        <span asp-validation-for="Status" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="OpposingParty" class="form-label"></label>
        <input asp-for="OpposingParty" class="form-control" />
        <span asp-validation-for="OpposingParty" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="LawyerName" class="form-label"></label>
        <input asp-for="LawyerName" class="form-control" />
        <span asp-validation-for="LawyerName" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="NextHearingDate" class="form-label"></label>
        <input asp-for="NextHearingDate" type="date" class="form-control" />
        <span asp-validation-for="NextHearingDate" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Remarks" class="form-label"></label>
        <textarea asp-for="Remarks" class="form-control"></textarea>
        <span asp-validation-for="Remarks" class="text-danger"></span>
    </div>
    <button type="submit" class="btn btn-primary">Save</button>
    <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
</form>
