@model BuilderERP.Application.Features.Accounting.LedgerAccountInput
@{ ViewData["Title"] = Model.Id.HasValue ? "Edit Account" : "New Account"; }
<h1 class="h3 mb-3">@ViewData["Title"]</h1><form method="post" class="card card-body"><div asp-validation-summary="ModelOnly" class="text-danger"></div><input asp-for="Id" type="hidden" />
<div class="row g-3"><div class="col-md-3"><label asp-for="Code" class="form-label"></label><input asp-for="Code" class="form-control" /></div><div class="col-md-5"><label asp-for="Name" class="form-label"></label><input asp-for="Name" class="form-control" /></div><div class="col-md-4"><label asp-for="AccountType" class="form-label">Type</label><select asp-for="AccountType" asp-items="Html.GetEnumSelectList<BuilderERP.Domain.Entities.AccountType>()" class="form-select"></select></div>
<div class="col-md-6"><label asp-for="ParentId" class="form-label">Parent account</label><select asp-for="ParentId" asp-items="ViewBag.Parents" class="form-select"><option value="">None</option></select></div><div class="col-md-3 form-check mt-5 ms-2"><input asp-for="AllowPosting" class="form-check-input" /><label asp-for="AllowPosting" class="form-check-label">Allow posting</label></div><div class="col-md-2 form-check mt-5"><input asp-for="IsActive" class="form-check-input" /><label asp-for="IsActive" class="form-check-label">Active</label></div></div>
<div class="mt-4"><button class="btn btn-primary">Save</button> <a asp-action="Accounts" class="btn btn-outline-secondary">Cancel</a></div></form>
