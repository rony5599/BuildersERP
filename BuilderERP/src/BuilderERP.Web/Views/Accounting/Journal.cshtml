@model BuilderERP.Domain.Entities.JournalVoucher
@{ ViewData["Title"] = Model.VoucherNumber; }
@if(TempData["Success"] is string s){<div class="alert alert-success">@s</div>} @if(TempData["Error"] is string e){<div class="alert alert-danger">@e</div>}
<div class="d-flex justify-content-between"><div><h1 class="h3">@Model.VoucherNumber</h1><p class="text-muted">@Model.VoucherDate.ToString("dd-MMM-yyyy") · @Model.Status</p></div><a asp-action="Journals" class="btn btn-outline-secondary align-self-start">Back</a></div><div class="card card-body"><p>@Model.Narration</p><table class="table"><thead><tr><th>Account</th><th>Description</th><th class="text-end">Debit</th><th class="text-end">Credit</th></tr></thead><tbody>@foreach(var l in Model.Lines.OrderBy(x=>x.LineNumber)){<tr><td>@l.LedgerAccount.Code - @l.LedgerAccount.Name</td><td>@l.Description</td><td class="text-end">@l.Debit.ToString("N2")</td><td class="text-end">@l.Credit.ToString("N2")</td></tr>}</tbody><tfoot><tr class="fw-bold"><td colspan="2">Total</td><td class="text-end">@Model.Lines.Sum(x=>x.Debit).ToString("N2")</td><td class="text-end">@Model.Lines.Sum(x=>x.Credit).ToString("N2")</td></tr></tfoot></table>
@if(Model.Status==BuilderERP.Domain.Entities.JournalVoucherStatus.Draft){<form asp-action="Post" method="post"><input type="hidden" name="id" value="@Model.Id"/><button class="btn btn-success">Post voucher</button></form>}
@if(Model.Status==BuilderERP.Domain.Entities.JournalVoucherStatus.Posted){<form asp-action="Reverse" method="post" class="row g-2 mt-2"><input type="hidden" name="id" value="@Model.Id"/><div class="col-md-3"><input type="date" name="reversalDate" value="@DateTime.Today.ToString("yyyy-MM-dd")" class="form-control" required/></div><div class="col-md-6"><input name="reason" class="form-control" placeholder="Reason for reversal" required/></div><div class="col-md-3"><button class="btn btn-danger">Reverse</button></div></form>}
</div>
