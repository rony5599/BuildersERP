@model BuilderERP.Application.Features.Accounting.JournalVoucherInput
@{ ViewData["Title"] = "New Journal Voucher"; }
<h1 class="h3 mb-3">New Journal Voucher</h1><form method="post" class="card card-body"><div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
<div class="row g-3 mb-3"><div class="col-md-3"><label asp-for="VoucherDate" class="form-label">Voucher date</label><input asp-for="VoucherDate" type="date" class="form-control" /></div><div class="col-md-9"><label asp-for="Narration" class="form-label"></label><input asp-for="Narration" class="form-control" required /></div></div>
<div class="table-responsive"><table class="table" id="lines"><thead><tr><th>Account</th><th>Description</th><th>Debit</th><th>Credit</th><th></th></tr></thead><tbody>
@for (var i=0; i<Model.Lines.Count; i++) { <tr><td><select asp-for="Lines[i].LedgerAccountId" asp-items="ViewBag.Accounts" class="form-select"><option value="">Select account</option></select></td><td><input asp-for="Lines[i].Description" class="form-control" /></td><td><input asp-for="Lines[i].Debit" class="form-control text-end" type="number" min="0" step="0.01" /></td><td><input asp-for="Lines[i].Credit" class="form-control text-end" type="number" min="0" step="0.01" /></td><td><button type="button" class="btn btn-outline-danger remove">×</button></td></tr> }
</tbody></table></div><button type="button" id="add" class="btn btn-sm btn-outline-primary align-self-start">Add line</button><div class="mt-4"><button class="btn btn-primary">Save draft</button> <a asp-action="Journals" class="btn btn-outline-secondary">Cancel</a></div></form>
<script>
document.getElementById('add').onclick=()=>{const b=document.querySelector('#lines tbody'),i=b.rows.length,r=b.rows[0].cloneNode(true);r.querySelectorAll('select,input').forEach(e=>{e.name=e.name.replace(/\[\d+\]/,`[${i}]`);e.value=e.tagName==='SELECT'?'':'0';});b.appendChild(r)};
document.addEventListener('click',e=>{if(e.target.classList.contains('remove')&&document.querySelectorAll('#lines tbody tr').length>2)e.target.closest('tr').remove()});
</script>
